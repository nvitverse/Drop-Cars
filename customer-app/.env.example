# Firebase (Google Sign-In + Phone Auth) - see utils/firebaseClient.ts.
# Get these from Firebase Console -> Project Settings -> General -> Your apps
# (add a Web app even for the native builds - Expo's JS SDK usage needs the
# web config regardless of platform).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth Client IDs (Google Cloud Console -> APIs & Services
# -> Credentials -> Create Credentials -> OAuth client ID). Create one of
# each type that applies; expo-auth-session picks the right one per platform.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccb\u0ca1\u0cbf \u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 (\u0c96\u0cb0\u0ccd\u0c9a\u0cbf\u0cb2\u0ccd\u0cb2).",Masked:"\u0cae\u0cb0\u0cc6\u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Masked Call":"\u0cae\u0cb0\u0cc6\u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0c95\u0cb0\u0cc6",Max:"\u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0","Max 3 Bookings Reached":"\u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0 3 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca4\u0cb2\u0cc1\u0caa\u0cbf\u0ca6\u0cc6","Max Redeemable: \u20b9":"\u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0 \u0cb0\u0cbf\u0ca1\u0cc0\u0cae\u0ccd: \u20b9","Maximum withdrawal allowed is \u20b9{0}. A minimum balance of \u20b9{1} must stay in your wallet.":"\u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0 \u20b9{0} \u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0cb9\u0cbf\u0c82\u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 \u20b9{1} \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1.",Membership:"\u0cb8\u0ca6\u0cb8\u0ccd\u0caf\u0ca4\u0ccd\u0cb5","MESSAGE ABOUT A TRIP":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0cb8\u0c82\u0ca6\u0cc7\u0cb6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf","Microphone access needed":"\u0cae\u0cc8\u0c95\u0ccd\u0cb0\u0ccb\u0cab\u0ccb\u0ca8\u0ccd \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6 \u0cac\u0cc7\u0c95\u0cc1","Minimum Year":"\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 \u0cb5\u0cb0\u0ccd\u0cb7","Missing Driver":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c87\u0cb2\u0ccd\u0cb2","Missing Fields":"\u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0c95\u0cbe\u0ca3\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0cb5\u0cc6","Missing required Razorpay parameters for verification":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cc6 \u0cac\u0cc7\u0c95\u0cbe\u0ca6 Razorpay \u0caa\u0ccd\u0caf\u0cbe\u0cb0\u0cbe\u0cae\u0cc0\u0c9f\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2","Missing Route":"\u0cae\u0cbe\u0cb0\u0ccd\u0c97 \u0c87\u0cb2\u0ccd\u0cb2","Missing Vehicle":"\u0cb5\u0cbe\u0cb9\u0ca8 \u0c87\u0cb2\u0ccd\u0cb2","Mobile number":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Mobile number not found. Please check your mobile number or sign up first.":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb8\u0cc8\u0ca8\u0ccd \u0c85\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Mobile number updated. Use the new number next time you log in.":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 \u0cac\u0cbe\u0cb0\u0cbf \u0cb9\u0cca\u0cb8 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Money you collected":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cb9\u0ca3","Monthly Plan - active":"\u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6 - \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf","Multi-City":"\u0cac\u0cb9\u0cc1 \u0ca8\u0c97\u0cb0","Multi-City (One Way)":"\u0cac\u0cb9\u0cc1 \u0ca8\u0c97\u0cb0 (\u0c92\u0ca8\u0ccd \u0cb5\u0cc7)","Must assign driver & vehicle within 15 mins to avoid cancellation penalty.":"\u0cb0\u0ca6\u0ccd\u0ca6\u0ca4\u0cbf \u0ca6\u0c82\u0ca1 \u0ca4\u0caa\u0ccd\u0caa\u0cbf\u0cb8\u0cb2\u0cc1 15 \u0ca8\u0cbf\u0cae\u0cbf\u0cb7\u0c97\u0cb3\u0cca\u0cb3\u0c97\u0cc6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd & \u0cb5\u0cbe\u0cb9\u0ca8 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1.",Mute:"\u0cae\u0ccd\u0caf\u0cc2\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Mute Notifications":"\u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0ccd\u0caf\u0cc2\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",Muted:"\u0cae\u0ccd\u0caf\u0cc2\u0c9f\u0ccd \u0c86\u0c97\u0cbf\u0ca6\u0cc6","My Bookings - Bookings You Posted":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 - \u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0cb5\u0cc1","My Details":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","My Documents & Verification":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 & \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6","My Performance":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c95\u0ccd\u0cb7\u0cae\u0ca4\u0cc6","My Profile":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd","My Rides - Drop Cars Trips":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1 - Drop Cars \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1","My Trips":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1","Name as per bank records":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0c82\u0ca4\u0cc6 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","Name per bank record":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","Need assistance with this booking? You can contact Drop Cars Support Helpline directly.":"\u0c88 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cb9\u0cbe\u0caf \u0cac\u0cc7\u0c95\u0cc7? Drop Cars \u0cb9\u0cc6\u0cb2\u0ccd\u0caa\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Need Help":"\u0cb8\u0cb9\u0cbe\u0caf \u0cac\u0cc7\u0c95\u0cc1","Need Help / Contact Support":"\u0cb8\u0cb9\u0cbe\u0caf \u0cac\u0cc7\u0c95\u0cc1 / \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf","Need Help?":"\u0cb8\u0cb9\u0cbe\u0caf \u0cac\u0cc7\u0c95\u0cc7?",Needs:"\u0cac\u0cc7\u0c95\u0cc1","Needs {0} \u2022 View Options":"{0} \u0cac\u0cc7\u0c95\u0cc1 \u2022 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccb\u0ca1\u0cbf","Needs a {0} ({1} Seats)":"{0} ({1} \u0cb8\u0cc0\u0c9f\u0cc1) \u0cac\u0cc7\u0c95\u0cc1","Needs Review":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cac\u0cc7\u0c95\u0cc1","Net Earning From Posting":"\u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cb5\u0ccd\u0cb5\u0cb3 \u0c97\u0cb3\u0cbf\u0c95\u0cc6","Network Error":"\u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0ca6\u0ccb\u0cb7","Network error while uploading. Please check your connection and try again.":"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cbe\u0c97 \u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0ca6\u0ccb\u0cb7. \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Network error. Please check your internet connection.":"\u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0ca6\u0ccb\u0cb7. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0c82\u0c9f\u0cb0\u0ccd\u0ca8\u0cc6\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","Never miss a booking":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca4\u0caa\u0ccd\u0caa\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cc7\u0ca1\u0cbf","Never miss a booking again":"\u0c87\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cbe\u0cb5 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c95\u0cc2\u0ca1 \u0ca4\u0caa\u0ccd\u0caa\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cc7\u0ca1\u0cbf","New 10-Digit Primary Mobile Number":"\u0cb9\u0cca\u0cb8 10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0caa\u0ccd\u0cb0\u0cbe\u0ca5\u0cae\u0cbf\u0c95 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","New Booking Bubble":"\u0cb9\u0cca\u0cb8 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cac\u0cac\u0cb2\u0ccd","New bookings in your city will automatically appear here in real-time":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0c97\u0cb0\u0ca6 \u0cb9\u0cca\u0cb8 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb0\u0cbf\u0caf\u0cb2\u0ccd \u0c9f\u0cc8\u0cae\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0ca4\u0cbe\u0ca8\u0cbe\u0c97\u0cbf \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6","New Email Address":"\u0cb9\u0cca\u0cb8 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8","New Fleet?":"\u0cb9\u0cca\u0cb8 \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0\u0cc7?","New Mobile Number":"\u0cb9\u0cca\u0cb8 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","New Password":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd","Next 24 Hrs":"\u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 24 \u0c97\u0c82\u0c9f\u0cc6","Next 3 Days":"\u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 3 \u0ca6\u0cbf\u0ca8","Next 7 Days":"\u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 7 \u0ca6\u0cbf\u0ca8","Night Allowance":"\u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf \u0cad\u0ca4\u0ccd\u0caf\u0cc6","Night Charges":"\u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95",No:"\u0c87\u0cb2\u0ccd\u0cb2","No {0} Upcoming Rides":"{0} \u0cae\u0cc1\u0c82\u0cac\u0cb0\u0cc1\u0cb5 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2","No access token received from server":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6 \u0c9f\u0ccb\u0c95\u0ca8\u0ccd \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No active assignment found for this booking.":"\u0c88 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0ca8\u0cc6 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","No active trips right now - once you accept a booking, its Vendor/Owner chat and the customer's call option will appear here.":"\u0c88\u0c97 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2 - \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0c82\u0ca1 \u0ca4\u0c95\u0ccd\u0cb7\u0ca3, \u0c85\u0ca6\u0cb0 \u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd/\u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0 \u0c9a\u0cbe\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0c95\u0cb0\u0cc6 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","No address registered":"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2","No authentication token found":"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0c9f\u0ccb\u0c95\u0ca8\u0ccd \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","No authentication token found. Please login first.":"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0c9f\u0ccb\u0c95\u0ca8\u0ccd \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","No available drivers found. Add a driver first in My Drivers.":"\u0cb2\u0cad\u0ccd\u0caf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2. \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf.","No available drivers found. Please complete verification or add a driver first.":"\u0cb2\u0cad\u0ccd\u0caf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2. \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf.","No available vehicles found. Add a car first in My Cabs.":"\u0cb2\u0cad\u0ccd\u0caf \u0cb5\u0cbe\u0cb9\u0ca8\u0c97\u0cb3\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2. \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca8\u0ca8\u0ccd\u0ca8 \u0c95\u0ccd\u0caf\u0cbe\u0cac\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf.","No cars available. Add vehicles in My Cars.":"\u0c95\u0cbe\u0cb0\u0cc1\u0c97\u0cb3\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2. \u0ca8\u0ca8\u0ccd\u0ca8 \u0c95\u0cbe\u0cb0\u0cc1\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb5\u0cbe\u0cb9\u0ca8 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf.","No chats match your search.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbe\u0c9f\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cc1\u0cb5 \u0c9a\u0cbe\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2.","No chats yet":"\u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0c9a\u0cbe\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No Completed Rides Yet":"\u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0cae\u0cc1\u0c97\u0cbf\u0ca6 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No Confirmed Trips Yet":"\u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0ca6\u0cc3\u0ca2\u0caa\u0c9f\u0ccd\u0c9f \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No driver & vehicle assigned yet.":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd & \u0cb5\u0cbe\u0cb9\u0ca8 \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2.","No driver logged in":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0c86\u0c97\u0cbf\u0cb2\u0ccd\u0cb2","No drivers available.":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2.","No drivers registered. Add a driver first in Drivers tab.":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2. \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c9f\u0ccd\u0caf\u0cbe\u0cac\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf.","No exact cached match for \"":"\u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cc1\u0cb5 \u0c95\u0ccd\u0caf\u0cbe\u0cb6\u0ccd \u0cab\u0cb2\u0cbf\u0ca4\u0cbe\u0c82\u0cb6 \u0c87\u0cb2\u0ccd\u0cb2: \"","No expiry set":"\u0c85\u0cb5\u0ca7\u0cbf \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2","No External Dealing Policy:":"\u0cb9\u0cca\u0cb0\u0c97\u0cc6 \u0ca8\u0cc7\u0cb0 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0c87\u0cb2\u0ccd\u0cb2 \u0ca8\u0cc0\u0ca4\u0cbf:","No Fleet Cars Found":"\u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0c95\u0cbe\u0cb0\u0cc1\u0c97\u0cb3\u0cc1 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","No number":"\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c87\u0cb2\u0ccd\u0cb2","No OTP was requested yet. Please request a code first.":"\u0c87\u0ca8\u0ccd\u0ca8\u0cc2 OTP \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2. \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c95\u0ccb\u0ca1\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cbf.","No pending bookings available":"\u0cac\u0cbe\u0c95\u0cbf \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No Pending Seat Requests":"\u0cac\u0cbe\u0c95\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from driver deletion":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c85\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cbf\u0c95\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from driver fetch":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0cb5\u0cbf\u0c95\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from profile update":"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0ca6\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from Razorpay order creation":"Razorpay \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0cb0\u0c9a\u0ca8\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from Razorpay payment verification":"Razorpay \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from signin":"\u0cb8\u0cc8\u0ca8\u0ccd \u0c87\u0ca8\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from signup":"\u0cb8\u0cc8\u0ca8\u0ccd \u0c85\u0caa\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from trip payment":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from wallet addition":"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cb8\u0cc7\u0cb0\u0ccd\u0caa\u0ca1\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from wallet balance fetch":"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0cb5\u0cbf\u0c95\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No response data received from wallet deduction":"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0c95\u0ca1\u0cbf\u0ca4\u0ca6\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca1\u0cc7\u0c9f\u0cbe \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No Reviews Yet":"\u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0cb5\u0cbf\u0cae\u0cb0\u0ccd\u0cb6\u0cc6\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No Running Trips":"\u0ca8\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No Sent Bids":"\u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6 \u0cac\u0cbf\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No Upcoming Duty Bookings":"\u0cae\u0cc1\u0c82\u0cac\u0cb0\u0cc1\u0cb5 \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No user data found. Please login again.":"\u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0 \u0ca1\u0cc7\u0c9f\u0cbe \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","No Vehicles Currently Marked Vacant":"\u0cb8\u0ca6\u0ccd\u0caf \u0c96\u0cbe\u0cb2\u0cbf \u0c8e\u0c82\u0ca6\u0cc1 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb5\u0cbe\u0cb9\u0ca8\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No, Keep It":"\u0cac\u0cc7\u0ca1, \u0c87\u0c9f\u0ccd\u0c9f\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf","Non CNG Vehicle Only":"CNG \u0c85\u0cb2\u0ccd\u0cb2\u0ca6 \u0cb5\u0cbe\u0cb9\u0ca8 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0","Not authenticated/authorized. Please login as Driver.":"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3/\u0c85\u0ca7\u0cbf\u0c95\u0cbe\u0cb0 \u0c87\u0cb2\u0ccd\u0cb2. \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c86\u0c97\u0cbf \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Not configured":"\u0c95\u0cbe\u0ca8\u0ccd\u0cab\u0cbf\u0c97\u0cb0\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0cb2\u0ccd\u0cb2","Not enough wallet balance available to accept this booking. Please top up your wallet.":"\u0c88 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cbe\u0c95\u0cb7\u0ccd\u0c9f\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0c87\u0cb2\u0ccd\u0cb2. \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0c9f\u0cbe\u0caa\u0ccd \u0c85\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Not in the fare - charged on actuals":"\u0ca6\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0cb2\u0ccd\u0cb2 - \u0ca8\u0cbf\u0c9c\u0cb5\u0cbe\u0ca6 \u0c96\u0cb0\u0ccd\u0c9a\u0cbf\u0ca8\u0c82\u0ca4\u0cc6 \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf","Not in the fare - enter what you collected":"\u0ca6\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0cb2\u0ccd\u0cb2 - \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Not needed for self-sourced bookings \u2014 you can complete the trip directly.":"\u0cb8\u0ccd\u0cb5\u0c82\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0caa\u0ca1\u0cc6\u0ca6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cac\u0cc7\u0c95\u0cbf\u0cb2\u0ccd\u0cb2 \u2014 \u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Not now":"\u0c88\u0c97 \u0cac\u0cc7\u0ca1","Not Now":"\u0c88\u0c97 \u0cac\u0cc7\u0ca1","Not provided":"\u0ca8\u0cc0\u0ca1\u0cbf\u0cb2\u0ccd\u0cb2","Not Registered as a Driver":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c86\u0c97\u0cbf \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2","Not selected":"\u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf\u0cb2\u0ccd\u0cb2","Not set":"\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2","Not Set":"\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2","Not set - tap to choose":"\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2 - \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf","Note:":"\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6:","Notification Inbox":"\u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0c87\u0ca8\u0ccd\u200c\u0cac\u0cbe\u0c95\u0ccd\u0cb8\u0ccd","Notifications stay on by default so you never miss a booking. Pick a duration to go quiet for a while.":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca4\u0caa\u0ccd\u0caa\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0ca6\u0c82\u0ca4\u0cc6 \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0c86\u0ca8\u0ccd \u0c87\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6. \u0cb8\u0ccd\u0cb5\u0cb2\u0ccd\u0caa \u0cb9\u0cca\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb6\u0cbe\u0c82\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cb2\u0cc1 \u0c85\u0cb5\u0ca7\u0cbf \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.","Number Masked & Protected":"\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cae\u0cb0\u0cc6\u0cae\u0cbe\u0ca1\u0cbf \u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Odometer Reading Check:":"\u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6:","Odometer Required":"\u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cac\u0cc7\u0c95\u0cc1","Odometer start \u2192 end":"\u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0c86\u0cb0\u0c82\u0cad \u2192 \u0c85\u0c82\u0ca4\u0ccd\u0caf","of 2":"2 \u0cb0\u0cb2\u0ccd\u0cb2\u0cbf","Off - pay manually via Razorpay/UPI each year when due":"\u0c86\u0cab\u0ccd - \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cb5\u0cb0\u0ccd\u0cb7 Razorpay/UPI \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cc0\u0cb5\u0cc7 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf","OFF DUTY":"\u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0c87\u0cb2\u0ccd\u0cb2","Off Duty / Offline Mode":"\u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0c87\u0cb2\u0ccd\u0cb2 / \u0c86\u0cab\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cae\u0ccb\u0ca1\u0ccd","Offer a vehicle from your fleet. Once requested, you can chat directly with the vendor and get instant approval.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0c92\u0c82\u0ca6\u0cc1 \u0cb5\u0cbe\u0cb9\u0ca8 \u0ca8\u0cc0\u0ca1\u0cbf. \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd\u200c\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0c9a\u0cbe\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0ca4\u0c95\u0ccd\u0cb7\u0ca3 \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6 \u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Offer Empty Seats":"\u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cbf","Offer price (\u20b9{0}) cannot be less than 50% of customer target (Min allowed bid: \u20b9{1}).":"\u0c86\u0cab\u0cb0\u0ccd \u0cac\u0cc6\u0cb2\u0cc6 (\u20b9{0}) \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0c97\u0cc1\u0cb0\u0cbf\u0caf 50% \u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0c95\u0ca1\u0cbf\u0cae\u0cc6 \u0c87\u0cb0\u0cac\u0cbe\u0cb0\u0ca6\u0cc1 (\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 \u0cac\u0cbf\u0ca1\u0ccd: \u20b9{1}).","Offer price (\u20b9{0}) cannot exceed 2.5x customer target price (Max allowed bid: \u20b9{1}). Please enter a realistic offer.":"\u0c86\u0cab\u0cb0\u0ccd \u0cac\u0cc6\u0cb2\u0cc6 (\u20b9{0}) \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0c97\u0cc1\u0cb0\u0cbf \u0cac\u0cc6\u0cb2\u0cc6\u0caf 2.5 \u0caa\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cc0\u0cb0\u0cac\u0cbe\u0cb0\u0ca6\u0cc1 (\u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0 \u0cac\u0cbf\u0ca1\u0ccd: \u20b9{1}). \u0cb5\u0cbe\u0cb8\u0ccd\u0ca4\u0cb5\u0cbf\u0c95 \u0c86\u0cab\u0cb0\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Offer Too High":"\u0c86\u0cab\u0cb0\u0ccd \u0ca4\u0cc1\u0c82\u0cac\u0cbe \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1","Offer Too Low":"\u0c86\u0cab\u0cb0\u0ccd \u0ca4\u0cc1\u0c82\u0cac\u0cbe \u0c95\u0ca1\u0cbf\u0cae\u0cc6",Offers:"\u0c86\u0cab\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1","Official Platform Agreement":"\u0c85\u0ca7\u0cbf\u0c95\u0cc3\u0ca4 \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0c82\u0ca6","On - a floating bubble shows new bookings even outside the app":"\u0c86\u0ca8\u0ccd - \u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cb9\u0cca\u0cb0\u0c97\u0cc2 \u0cb9\u0cca\u0cb8 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc7\u0cb2\u0cc1\u0cb5 \u0cac\u0cac\u0cb2\u0ccd \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","On - but \"Display over other apps\" permission is not granted yet":"\u0c86\u0ca8\u0ccd - \u0c86\u0ca6\u0cb0\u0cc6 \"\u0c87\u0ca4\u0cb0 \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0c97\u0cb3 \u0cae\u0cc7\u0cb2\u0cc6 \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cc1\" \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0ca8\u0cc0\u0ca1\u0cbf\u0cb2\u0ccd\u0cb2","On - the yearly fee is debited from your wallet automatically when due":"\u0c86\u0ca8\u0ccd - \u0cb5\u0cbe\u0cb0\u0ccd\u0cb7\u0cbf\u0c95 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0cac\u0cbe\u0c95\u0cbf \u0cac\u0c82\u0ca6\u0cbe\u0c97 \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0ca4\u0cbe\u0ca8\u0cbe\u0c97\u0cbf \u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","ON DUTY":"\u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf","One last step":"\u0c95\u0cca\u0ca8\u0cc6\u0caf \u0cb9\u0c82\u0ca4","ONE WAY":"\u0c92\u0ca8\u0ccd \u0cb5\u0cc7","One-Way":"\u0c92\u0ca8\u0ccd-\u0cb5\u0cc7","ONLINE & READY FOR DISPATCH":"\u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd & \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0cbf\u0ca6\u0ccd\u0ca7","Online \u2022 Drop Cars Team":"\u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u2022 Drop Cars \u0ca4\u0c82\u0ca1","Only for Trusted Partners":"\u0c9f\u0ccd\u0cb0\u0cb8\u0ccd\u0c9f\u0cc6\u0ca1\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0","Only Trusted Partners can post bookings.":"\u0c9f\u0ccd\u0cb0\u0cb8\u0ccd\u0c9f\u0cc6\u0ca1\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Oops!":"\u0c85\u0caf\u0ccd\u0caf\u0ccb!","Open My Bookings":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf","Open My Fleet":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf","Opening that booking's chat...":"\u0c86 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0ca8 \u0c9a\u0cbe\u0c9f\u0ccd \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Operating City":"\u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0ca3\u0cbe \u0ca8\u0c97\u0cb0","Optional for self-sourced bookings \u2014 you can start the trip directly.":"\u0cb8\u0ccd\u0cb5\u0c82\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0caa\u0ca1\u0cc6\u0ca6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95 \u2014 \u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","or newer":"\u0c85\u0ca5\u0cb5\u0cbe \u0cb9\u0cca\u0cb8\u0ca6\u0cc1","Or share the link":"\u0c85\u0ca5\u0cb5\u0cbe \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf","Or type custom cancellation reason...":"\u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0cb5\u0c82\u0ca4 \u0cb0\u0ca6\u0ccd\u0ca6\u0ca4\u0cbf \u0c95\u0cbe\u0cb0\u0ca3 \u0cac\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf...","Order #":"\u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd #","Order Details in Bold Styling":"\u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0ca6\u0caa\u0ccd\u0caa \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf","Other (type your own reason)":"\u0c87\u0ca4\u0cb0\u0cc6 (\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cbe\u0cb0\u0ca3 \u0cac\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf)","Other extras collected":"\u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0c87\u0ca4\u0cb0 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1","Outstation & drop bookings are managed in Open Bookings. This Live Radar is dedicated to high-frequency point-to-point local bookings.":"\u0c94\u0c9f\u0ccd\u200c\u0cb8\u0ccd\u0c9f\u0cc7\u0cb7\u0ca8\u0ccd & \u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 Open Bookings \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c88 \u0cb2\u0cc8\u0cb5\u0ccd \u0cb0\u0cc7\u0ca1\u0cbe\u0cb0\u0ccd \u0c86\u0c97\u0cbe\u0c97\u0ccd\u0c97\u0cc6 \u0cac\u0cb0\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd-\u0c9f\u0cc1-\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6.","Owner Profile \xb7 Email Address Missing":"\u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \xb7 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c87\u0cb2\u0ccd\u0cb2","\ud83c\udd7f\ufe0f Fastag & Tolls":"\ud83c\udd7f\ufe0f \u0cab\u0cbe\u0cb8\u0ccd\u0c9f\u0ccd\u0caf\u0cbe\u0c97\u0ccd & \u0c9f\u0ccb\u0cb2\u0ccd","PAN Card (Tax Proof)":"PAN \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd (\u0ca4\u0cc6\u0cb0\u0cbf\u0c97\u0cc6 \u0caa\u0cc1\u0cb0\u0cbe\u0cb5\u0cc6)","PAN Card Verification":"PAN \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6","PAN Number":"PAN \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","PAN number is required":"PAN \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cac\u0cc7\u0c95\u0cc1",Partner:"\u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd","Partner Mobile":"\u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd","Passenger has visually confirmed the final closing meter reading":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0\u0cc1 \u0c95\u0ca3\u0ccd\u0ca3\u0cbe\u0cb0\u0cc6 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6","Passenger has visually confirmed the starting meter reading":"\u0c86\u0cb0\u0c82\u0cad\u0cbf\u0c95 \u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0\u0cc1 \u0c95\u0ca3\u0ccd\u0ca3\u0cbe\u0cb0\u0cc6 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6","passenger seats":"\u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0 \u0cb8\u0cc0\u0c9f\u0cc1\u0c97\u0cb3\u0cc1","passenger seats.":"\u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0 \u0cb8\u0cc0\u0c9f\u0cc1\u0c97\u0cb3\u0cc1.","Password Mismatch":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2","Pay the full yearly fee once and stop the monthly auto-debit":"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb5\u0cbe\u0cb0\u0ccd\u0cb7\u0cbf\u0c95 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0cae\u0ccd\u0cae\u0cc6\u0c97\u0cc7 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf \u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0ca8\u0cbf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf","Payment & Bank Details":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf & \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","Payment could not be processed":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Payment Details":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","Payment verification failed":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1","Payout Account":"\u0caa\u0cc7\u0c94\u0c9f\u0ccd \u0c96\u0cbe\u0ca4\u0cc6","Payout Amount (\u0ba4\u0bca\u0b95\u0bc8)":"\u0caa\u0cc7\u0c94\u0c9f\u0ccd \u0cae\u0cca\u0ca4\u0ccd\u0ca4","Payout bank account & payment details saved successfully.":"\u0caa\u0cc7\u0c94\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 & \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Payout Method (\u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0bb1\u0bc8)":"\u0caa\u0cc7\u0c94\u0c9f\u0ccd \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8","Payout Requested":"\u0caa\u0cc7\u0c94\u0c9f\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Payouts, account credits/debits, and wallet balance updates":"\u0caa\u0cc7\u0c94\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1, \u0c96\u0cbe\u0ca4\u0cc6 \u0c95\u0ccd\u0cb0\u0cc6\u0ca1\u0cbf\u0c9f\u0ccd/\u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd, \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c97\u0cb3\u0cc1",Pending:"\u0cac\u0cbe\u0c95\u0cbf","Pending orders endpoint not found.":"\u0cac\u0cbe\u0c95\u0cbf \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0c8e\u0c82\u0ca1\u0ccd\u200c\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Pending Passenger Requests (":"\u0cac\u0cbe\u0c95\u0cbf \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cc1 (","PENDING SEAT REQUEST":"\u0cac\u0cbe\u0c95\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf","Pending Verification":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cac\u0cbe\u0c95\u0cbf","Per KM Rate":"\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0c95\u0cbf.\u0cae\u0cc0. \u0ca6\u0cb0","Per-Km Booking (10% Commission):":"\u0c95\u0cbf.\u0cae\u0cc0. \u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd (10% \u0c95\u0cae\u0cbf\u0cb7\u0ca8\u0ccd):","Permission Denied":"\u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Permission needed":"\u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0cac\u0cc7\u0c95\u0cc1","Permit Charges":"\u0caa\u0cb0\u0ccd\u0cae\u0cbf\u0c9f\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95","Personal & Business Info":"\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 & \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf","Personal, KYC & Account details":"\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95, KYC & \u0c96\u0cbe\u0ca4\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","Pet Friendly Vehicle":"\u0cb8\u0cbe\u0c95\u0cc1\u0caa\u0ccd\u0cb0\u0cbe\u0ca3\u0cbf \u0cb8\u0ccd\u0ca8\u0cc7\u0cb9\u0cbf \u0cb5\u0cbe\u0cb9\u0ca8","Phone Number":"\u0cab\u0ccb\u0ca8\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Phone sign-in isn\u2019t available on this build yet. Please use Mobile Number + Password.":"\u0c88 \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cab\u0ccb\u0ca8\u0ccd \u0cb8\u0cc8\u0ca8\u0ccd-\u0c87\u0ca8\u0ccd \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 + \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0cb3\u0cb8\u0cbf.","Photo Captured":"\u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Photo doesn't clearly match the licence photo ({0}%).":"\u0cab\u0ccb\u0c9f\u0ccb \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cab\u0ccb\u0c9f\u0ccb\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f\u0cb5\u0cbe\u0c97\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2 ({0}%).","Photo library permission is required to select photos.":"\u0cab\u0ccb\u0c9f\u0ccb \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cab\u0ccb\u0c9f\u0ccb \u0cb2\u0cc8\u0cac\u0ccd\u0cb0\u0cb0\u0cbf \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0cac\u0cc7\u0c95\u0cc1.","Photo Saved":"\u0cab\u0ccb\u0c9f\u0ccb \u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",Pick:"\u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf","Pick up a Drop Cars booking from the open list and assign it to yourself to manage and execute the trip directly here.":"\u0c93\u0caa\u0ca8\u0ccd \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf\u0cbf\u0c82\u0ca6 Drop Cars \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0ca8\u0cbf\u0cae\u0c97\u0cc7 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf, \u0c87\u0cb2\u0ccd\u0cb2\u0cbf\u0caf\u0cc7 \u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cbf.",Pickup:"\u0caa\u0cbf\u0c95\u0caa\u0ccd","Pickup (From City)":"\u0caa\u0cbf\u0c95\u0caa\u0ccd (\u0cb9\u0cca\u0cb0\u0ca1\u0cc1\u0cb5 \u0ca8\u0c97\u0cb0)","Pickup Address / Landmark (Optional)":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 / \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1 (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)","Pickup Date":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95","Pickup Date & Time:":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 & \u0cb8\u0cae\u0caf:","Pickup Note / Instructions:":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0c9f\u0cbf\u0caa\u0ccd\u0caa\u0ca3\u0cbf / \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cc1:","Pickup Notes / Driver Instructions:":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0c9f\u0cbf\u0caa\u0ccd\u0caa\u0ca3\u0cbf\u0c97\u0cb3\u0cc1 / \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cc1:","Pickup Schedule":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cb5\u0cc7\u0cb3\u0cbe\u0caa\u0c9f\u0ccd\u0c9f\u0cbf","Pickup:":"\u0caa\u0cbf\u0c95\u0caa\u0ccd:","Place Offer / Bid (Target: \u20b9":"\u0c86\u0cab\u0cb0\u0ccd / \u0cac\u0cbf\u0ca1\u0ccd \u0cb9\u0cbe\u0c95\u0cbf (\u0c97\u0cc1\u0cb0\u0cbf: \u20b9","Platform Commission (Est. 10%):":"\u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0c95\u0cae\u0cbf\u0cb7\u0ca8\u0ccd (\u0c85\u0c82\u0ca6\u0cbe\u0c9c\u0cc1 10%):","Platform fee":"\u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95","Platform Fee":"\u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95","Platform fee (":"\u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 (","Please accept the booking terms and cancellation penalty policy to proceed.":"\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cb2\u0cc1 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 & \u0cb0\u0ca6\u0ccd\u0ca6\u0ca4\u0cbf \u0ca6\u0c82\u0ca1 \u0ca8\u0cc0\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.","Please assign a driver for this request.":"\u0c88 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cc6 \u0c92\u0cac\u0ccd\u0cac \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf.","Please capture Back Seat photo.":"\u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 \u0cb8\u0cc0\u0c9f\u0cbf\u0ca8 \u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf.","Please capture Car Front photo.":"\u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf.","Please capture Interior Cleanliness photo.":"\u0c92\u0cb3\u0cad\u0cbe\u0c97\u0ca6 \u0cb8\u0ccd\u0cb5\u0c9a\u0ccd\u0c9b\u0ca4\u0cc6\u0caf \u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf.","Please capture the back photo of the document.":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf \u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf.","Please capture the front photo of the document.":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0caf \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf.","Please check driver information: {0}":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf: {0}","Please check your connection and try again.":"\u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Please check your internet connection and try again":"\u0c87\u0c82\u0c9f\u0cb0\u0ccd\u0ca8\u0cc6\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf","Please complete Driver Selfie Check before starting trip.":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc6\u0cb2\u0ccd\u0cab\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf.","Please complete the driving licence number (State+RTO, Year, Serial).":"\u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0cb5\u0cbe\u0c97\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0cb0\u0cbe\u0c9c\u0ccd\u0caf+RTO, \u0cb5\u0cb0\u0ccd\u0cb7, \u0c95\u0ccd\u0cb0\u0cae\u0cbe\u0c82\u0c95).","Please confirm your password.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf.","Please detail what information you need updated.":"\u0caf\u0cbe\u0cb5 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1 \u0c8e\u0c82\u0ca6\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf.","Please enter a name with at least 2 characters.":"\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 2 \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0ca6 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please enter a valid 10-digit mobile number starting with 6, 7, 8, or 9.":"6, 7, 8 \u0c85\u0ca5\u0cb5\u0cbe 9 \u0cb0\u0cbf\u0c82\u0ca6 \u0c86\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cc1\u0cb5 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please enter a valid 10-digit UPI Mobile Number":"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 10 \u0c85\u0c82\u0c95\u0cbf\u0caf UPI \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Please enter a valid password (at least 6 characters).":"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 6 \u0c85\u0c95\u0ccd\u0cb7\u0cb0).","Please enter a valid payout amount.":"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0caa\u0cc7\u0c94\u0c9f\u0ccd \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please enter a valid Travels / Business Name.":"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c9f\u0ccd\u0cb0\u0cbe\u0cb5\u0cc6\u0cb2\u0ccd\u0cb8\u0ccd / \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please enter both mobile number and password.":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c8e\u0cb0\u0ca1\u0ca8\u0ccd\u0ca8\u0cc2 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please enter initial odometer reading.":"\u0c86\u0cb0\u0c82\u0cad\u0cbf\u0c95 \u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please enter the 12-digit Aadhaar number.":"12 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please enter the 6-digit verification code sent to your email.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6 6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please enter valid 4-digit Customer Start OTP.":"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 4 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0c86\u0cb0\u0c82\u0cad\u0ca6 OTP \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please enter your valid full name as per Government ID.":"\u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cc0\u0c9f\u0cbf\u0caf\u0c82\u0ca4\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please explain the reason for requesting profile updates.":"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0c95\u0ccb\u0cb0\u0cb2\u0cc1 \u0c95\u0cbe\u0cb0\u0ca3 \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf.","Please give the customer a star rating before you finish.":"\u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0cb8\u0ccd\u0c9f\u0cbe\u0cb0\u0ccd \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cc0\u0ca1\u0cbf.","Please place a regular phone call.":"\u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cab\u0ccb\u0ca8\u0ccd \u0c95\u0cb0\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf.","Please rate the customer and confirm the amount collected to finish this trip.":"\u0c88 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cb2\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cc0\u0ca1\u0cbf \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf.","Please rate your Drop Cars trip: {0}":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae Drop Cars \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cc6 \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cc0\u0ca1\u0cbf: {0}","Please select a Drop (To City).":"\u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd (\u0ca4\u0cb2\u0cc1\u0caa\u0cc1\u0cb5 \u0ca8\u0c97\u0cb0) \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.","Please select a Pickup (From City).":"\u0caa\u0cbf\u0c95\u0caa\u0ccd (\u0cb9\u0cca\u0cb0\u0ca1\u0cc1\u0cb5 \u0ca8\u0c97\u0cb0) \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.","Please select a valid expiry date for this document.":"\u0c88 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cc6 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c85\u0cb5\u0ca7\u0cbf \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.","Please select a vehicle for this request.":"\u0c88 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cc6 \u0c92\u0c82\u0ca6\u0cc1 \u0cb5\u0cbe\u0cb9\u0ca8 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.","Please select or type a cancellation reason.":"\u0cb0\u0ca6\u0ccd\u0ca6\u0ca4\u0cbf \u0c95\u0cbe\u0cb0\u0ca3 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf.","Please select or type a reason for cancelling this booking.":"\u0c88 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cb2\u0cc1 \u0c95\u0cbe\u0cb0\u0ca3 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf.","Please take a live selfie before continuing.":"\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb2\u0cc8\u0cb5\u0ccd \u0cb8\u0cc6\u0cb2\u0ccd\u0cab\u0cbf \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf.","Please try again.":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Please upload both the Aadhaar FRONT and BACK photos.":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97 & \u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97 \u0c8e\u0cb0\u0ca1\u0cc2 \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Please upload the Licence BACK side photo too - both sides are required.":"\u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf\u0caf \u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0c95\u0cc2\u0ca1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf - \u0c8e\u0cb0\u0ca1\u0cc2 \u0cac\u0ca6\u0cbf \u0cac\u0cc7\u0c95\u0cc1.","Please verify your":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae","Please verify your email address by tapping \"Verify Email\" before completing registration.":"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf\" \u0c92\u0ca4\u0ccd\u0ca4\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","Please wait for approval":"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0c95\u0cbe\u0caf\u0cbf\u0cb0\u0cbf","plus \u20b9":"\u0c9c\u0cca\u0ca4\u0cc6\u0c97\u0cc6 \u20b9","Pollution Certificate (PUC)":"\u0cae\u0cbe\u0cb2\u0cbf\u0ca8\u0ccd\u0caf \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ca4\u0ccd\u0cb0 (PUC)","Post Booking & Dispatch":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Posted by you":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1","Posting Earning (for sourcing this trip)":"\u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0c97\u0cb3\u0cbf\u0c95\u0cc6 (\u0c88 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca4\u0c82\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0c95\u0ccd\u0c95\u0cc6)","Pre-book and guarantee priority dispatch for your available fleet! When a passenger books a trip on your requested route, our system auto-matches it with a 10-second alert window.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb2\u0cad\u0ccd\u0caf \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0cae\u0cc1\u0c82\u0c97\u0ca1\u0cb5\u0cbe\u0c97\u0cbf \u0cac\u0cc1\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd \u0c96\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf\u0caa\u0ca1\u0cbf\u0cb8\u0cbf! \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0\u0cc1 \u0cac\u0cc1\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0cbe\u0c97, \u0ca8\u0cae\u0ccd\u0cae \u0cb5\u0ccd\u0caf\u0cb5\u0cb8\u0ccd\u0ca5\u0cc6 10 \u0cb8\u0cc6\u0c95\u0cc6\u0c82\u0ca1\u0ccd \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0caf\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca4\u0cbe\u0ca8\u0cbe\u0c97\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",Preferences:"\u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0c97\u0cb3\u0cc1","Preview:":"\u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0ca3\u0cc6:","Price per KM":"\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0c95\u0cbf.\u0cae\u0cc0. \u0cac\u0cc6\u0cb2\u0cc6","Primary Mobile":"\u0caa\u0ccd\u0cb0\u0cbe\u0ca5\u0cae\u0cbf\u0c95 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd","Primary Mobile Number":"\u0caa\u0ccd\u0cb0\u0cbe\u0ca5\u0cae\u0cbf\u0c95 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Priority trip dispatch & subscriber analytics":"\u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd & \u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cb0 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb2\u0cc7\u0cb7\u0ca3\u0cc6","Privacy & Security":"\u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6 & \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cc6",Profile:"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd","Profile & Account Details":"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd & \u0c96\u0cbe\u0ca4\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","Profile Photo":"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cab\u0ccb\u0c9f\u0ccb","Profile Photo Required":"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cab\u0ccb\u0c9f\u0ccb \u0cac\u0cc7\u0c95\u0cc1","Profile update failed: {0}":"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0cab\u0cb2: {0}","Push notification permission is required for this feature.":"\u0c88 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0caa\u0cc1\u0cb6\u0ccd \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0cac\u0cc7\u0c95\u0cc1.","Push Notifications":"\u0caa\u0cc1\u0cb6\u0ccd \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cc1","Push notifications only work on physical devices":"\u0caa\u0cc1\u0cb6\u0ccd \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cc1 \u0ca8\u0cbf\u0c9c\u0cb5\u0cbe\u0ca6 \u0cb8\u0cbe\u0ca7\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c95\u0cc6\u0cb2\u0cb8 \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6","Quick Additions:":"\u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0cb8\u0cc7\u0cb0\u0ccd\u0caa\u0ca1\u0cc6\u0c97\u0cb3\u0cc1:","Quick Duration Presets":"\u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0c85\u0cb5\u0ca7\u0cbf\u0c97\u0cb3\u0cc1","Quick options:":"\u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0cc1:","QUICK QUESTIONS":"\u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cc1","Radar Radius: 15 KM":"\u0cb0\u0cc7\u0ca1\u0cbe\u0cb0\u0ccd \u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0ccd\u0ca4\u0cbf: 15 \u0c95\u0cbf.\u0cae\u0cc0.","Range Active":"\u0cb6\u0ccd\u0cb0\u0cc7\u0ca3\u0cbf \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf","Rate the customer":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cc0\u0ca1\u0cbf","Razorpay order created successfully":"Razorpay \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Razorpay order created successfully (mock)":"Razorpay \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 (\u0cae\u0cbe\u0c95\u0ccd)","Razorpay payment verified successfully":"Razorpay \u0caa\u0cbe\u0cb5\u0ca4\u0cb
\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf & \u0caa\u0ccd\u0cb0\u0c95\u0c9f\u0cbf\u0cb8\u0cbf"},languageSelect:{title:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cad\u0cbe\u0cb7\u0cc6 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",subtitle:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cbe\u0cb5\u0cbe\u0c97 \u0cac\u0cc7\u0c95\u0cbe\u0ca6\u0cb0\u0cc2 \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1",continue:"\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf",skip:"\u0c88\u0c97 \u0cac\u0cc7\u0ca1"},common:{brand:"Drop Cars"},languageNames:{en:"English",ta:"\u0ba4\u0bae\u0bbf\u0bb4\u0bcd",te:"\u0c24\u0c46\u0c32\u0c41\u0c17\u0c41",hi:"\u0939\u093f\u0928\u094d\u0926\u0940",kn:"\u0c95\u0ca8\u0ccd\u0ca8\u0ca1"}}},2627,[]);
__d(function(e,t,a,i,r,o,l){r.exports={common:{brand:"Drop Cars"},tabBar:{home:"\u0939\u094b\u092e",myRides:"\u092e\u0947\u0930\u0940 \u0938\u0935\u093e\u0930\u093f\u092f\u093e\u0902",dropMarket:"\u0921\u094d\u0930\u0949\u092a \u092e\u093e\u0930\u094d\u0915\u0947\u091f",chats:"\u091a\u0948\u091f",duty:"\u0921\u094d\u092f\u0942\u091f\u0940"},languageNames:{en:"English",ta:"\u0ba4\u0bae\u0bbf\u0bb4\u0bcd",te:"\u0c24\u0c46\u0c32\u0c41\u0c17\u0c41",hi:"\u0939\u093f\u0928\u094d\u0926\u0940"},terms:{modalTitle:"\u0928\u093f\u092f\u092e \u090f\u0935\u0902 \u0936\u0930\u094d\u0924\u0947\u0902",body:"\u0921\u094d\u0930\u0949\u092a \u0915\u093e\u0930\u094d\u0938 \u2013 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0935 \u092b\u094d\u0932\u0940\u091f \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e\n\u0928\u093f\u092f\u092e \u090f\u0935\u0902 \u0936\u0930\u094d\u0924\u0947\u0902 \u0924\u0925\u093e \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u0940\u0924\u093f\n\nDrop Cars \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0910\u092a \u092a\u0930 \u0916\u093e\u0924\u093e \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u0930\u0928\u0947 \u092f\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u092a\u0930, \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e (\u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915, \u0935\u093e\u0939\u0928 \u092e\u093e\u0932\u093f\u0915, \u092f\u093e \u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915) \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0915\u093e\u0928\u0942\u0928\u0940 \u0930\u0942\u092a \u0938\u0947 \u092c\u093e\u0927\u094d\u092f\u0915\u093e\u0930\u0940 \u0936\u0930\u094d\u0924\u094b\u0902 \u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964\n\n1. \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0924\u091f\u0938\u094d\u0925\u0924\u093e \u090f\u0935\u0902 \u0936\u0942\u0928\u094d\u092f \u0926\u093e\u092f\u093f\u0924\u094d\u0935 \u0938\u094d\u0925\u093f\u0924\u093f (Zero Liability)\nDrop Cars \u0915\u0947\u0935\u0932 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915\u094b\u0902/\u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u094b \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u093f\u0930\u093e\u090f \u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927\u094b\u0902 \u0938\u0947 \u091c\u094b\u0921\u093c\u0928\u0947 \u0935\u093e\u0932\u093e \u090f\u0915 \u0921\u093f\u091c\u093f\u091f\u0932 \u0924\u0915\u0928\u0940\u0915 \u092e\u0927\u094d\u092f\u0938\u094d\u0925 \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0939\u0948\u0964 Drop Cars \u0915\u094b\u0908 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u0930\u094d\u091f \u0915\u0902\u092a\u0928\u0940 \u092f\u093e \u0928\u093f\u092f\u094b\u0915\u094d\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0935\u093e\u0939\u0928 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f, \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0906\u091a\u0930\u0923, \u0938\u0921\u093c\u0915 \u0926\u0941\u0930\u094d\u0918\u091f\u0928\u093e\u0913\u0902, \u092f\u093e\u0924\u094d\u0930\u0940 \u091a\u094b\u091f, \u0938\u0902\u092a\u0924\u094d\u0924\u093f \u0915\u0947 \u0928\u0941\u0915\u0938\u093e\u0928 \u092f\u093e \u0915\u093e\u0928\u0942\u0928\u0940 \u0935\u093f\u0935\u093e\u0926\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f Drop Cars \u0915\u0940 \u0936\u0942\u0928\u094d\u092f \u0926\u093e\u092f\u093f\u0924\u094d\u0935 (ZERO Liability) \u0938\u094d\u0925\u093f\u0924\u093f \u0930\u0939\u0947\u0917\u0940\u0964\n\n2. \u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915 \u0915\u0940 \u092a\u0942\u0930\u094d\u0923 \u0914\u0930 \u092a\u0942\u0930\u094d\u0923 \u091c\u093c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 (Absolute Liability)\nDrop Cars \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u092a\u0930 \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915, \u091f\u094d\u0930\u093f\u092a \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0932\u0947\u0915\u0930 \u092a\u0942\u0930\u093e \u0939\u094b\u0928\u0947 \u0924\u0915 \u0909\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0940 100% \u092a\u0942\u0930\u094d\u0923 \u0915\u093e\u0928\u0942\u0928\u0940, \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0914\u0930 \u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u091c\u093c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0932\u0947\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u091c\u093c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915 \u092a\u0930 \u0932\u093e\u0917\u0942 \u0939\u094b\u0917\u0940, \u092d\u0932\u0947 \u0939\u0940 \u0935\u0939 \u0938\u094d\u0935\u092f\u0902 \u0917\u093e\u0921\u093c\u0940 \u091a\u0932\u093e\u090f \u092f\u093e \u0915\u093f\u0938\u0940 \u0905\u0938\u093e\u0907\u0928 \u0915\u093f\u090f \u0917\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u094b \u0926\u0947\u0964\n\n3. \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u0935\u093e\u0939\u0928 \u0935 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092c\u0926\u0932\u093e\u0935 (\u0938\u0916\u094d\u0924 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927)\n3.1. \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u091f\u094d\u0930\u093f\u092a \u0915\u0947\u0935\u0932 \u0910\u092a \u092e\u0947\u0902 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0905\u0938\u093e\u0907\u0928 \u0915\u093f\u090f \u0917\u090f \u0938\u091f\u0940\u0915 \u0935\u093e\u0939\u0928 \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u0940 \u092a\u0942\u0930\u0940 \u0915\u0940 \u091c\u093e\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964\n3.2. \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u092c\u0926\u0932\u093e\u0935 / \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923: \u092f\u0926\u093f \u0915\u094b\u0908 \u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915 \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0910\u092a \u092e\u0947\u0902 \u0905\u0938\u093e\u0907\u0928 \u0915\u093f\u090f \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092f\u093e \u0935\u093e\u0939\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948, \u0924\u094b \u0909\u0938\u0938\u0947 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0926\u0941\u0930\u094d\u0918\u091f\u0928\u093e, \u092e\u0943\u0924\u094d\u092f\u0941, \u091a\u094b\u091f, \u091a\u094b\u0930\u0940, \u0935\u093e\u0939\u0928 \u0915\u094d\u0937\u0924\u093f \u092f\u093e \u0915\u093e\u0928\u0942\u0928\u0940 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 100% \u092a\u0942\u0930\u094d\u0923 \u0938\u093f\u0935\u093f\u0932 \u0935 \u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u0926\u093e\u092f\u093f\u0924\u094d\u0935 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915 \u0915\u093e \u0939\u0940 \u0939\u094b\u0917\u093e\u0964 Drop Cars \u0938\u092d\u0940 \u0926\u093e\u0935\u094b\u0902 \u0938\u0947 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092e\u0941\u0915\u094d\u0924 \u0939\u0948\u0964\n3.3. \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u092a\u0930 \u20b910,000 \u0924\u0915 \u0915\u093e \u0924\u0924\u094d\u0915\u093e\u0932 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e, \u0938\u094d\u0925\u093e\u092f\u0940 \u0916\u093e\u0924\u093e \u092c\u094d\u0932\u0949\u0915 \u0914\u0930 \u0915\u093e\u0928\u0942\u0928\u0940 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0939\u094b\u0917\u0940\u0964\n\n4. \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u0915\u0940 \u0935\u0948\u0927\u0924\u093e \u090f\u0935\u0902 \u0905\u0928\u0941\u092a\u093e\u0932\u0928\n4.1. \u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915\u094b\u0902 \u0915\u094b \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938, RC, \u0915\u092e\u0930\u094d\u0936\u093f\u092f\u0932 \u0907\u0902\u0936\u094d\u092f\u094b\u0930\u0947\u0902\u0938, \u092b\u093f\u091f\u0928\u0947\u0938 \u0938\u0930\u094d\u091f\u093f\u092b\u093f\u0915\u0947\u091f \u0914\u0930 \u092a\u0930\u092e\u093f\u091f \u0935\u0948\u0927 \u0930\u0916\u0928\u0947 \u0939\u094b\u0902\u0917\u0947\u0964\n4.2. \u090f\u0915\u094d\u0938\u092a\u093e\u092f\u0930\u094d\u0921 \u092f\u093e \u0928\u0915\u0932\u0940 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c: \u090f\u0915\u094d\u0938\u092a\u093e\u092f\u0930\u094d\u0921 \u092f\u093e \u0928\u0915\u0932\u0940 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u091f\u094d\u0930\u093f\u092a \u091a\u0932\u093e\u0928\u0947 \u092a\u0930 \u0938\u092d\u0940 \u091f\u094d\u0930\u0948\u092b\u093f\u0915 \u091a\u093e\u0932\u093e\u0928, \u0915\u093e\u0928\u0942\u0928\u0940 \u0939\u0930\u094d\u091c\u093e\u0928\u0947 \u0914\u0930 \u0907\u0902\u0936\u094d\u092f\u094b\u0930\u0947\u0902\u0938 \u0915\u094d\u0932\u0947\u092e \u0930\u093f\u091c\u0947\u0915\u094d\u0936\u0928 \u0915\u0940 \u092a\u0942\u0930\u0940 \u091c\u093c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915 \u0915\u0940 \u0939\u094b\u0917\u0940\u0964\n\n5. \u0915\u094d\u0937\u0924\u093f\u092a\u0942\u0930\u094d\u0924\u093f \u090f\u0935\u0902 \u092e\u0941\u0915\u094d\u0924\u093f \u0938\u092e\u091d\u094c\u0924\u093e (Indemnification)\n\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0926\u0941\u0930\u094d\u0918\u091f\u0928\u093e\u0913\u0902, \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u0921\u094d\u0930\u093e\u0907\u0935\u0930/\u0935\u093e\u0939\u0928 \u092c\u0926\u0932\u093e\u0935, \u0905\u092e\u093e\u0928\u094d\u092f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u092f\u093e \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0926\u0941\u0930\u094d\u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u092d\u0940 \u0928\u0941\u0915\u0938\u093e\u0928\u094b\u0902 \u0914\u0930 \u0915\u093e\u0928\u0942\u0928\u0940 \u0916\u0930\u094d\u091a\u094b\u0902 \u0938\u0947 Drop Cars \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092e\u0924 \u0939\u0948\u0964\n\n6. \u0936\u0941\u0932\u094d\u0915 \u0935 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e\n\u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0905\u091f\u0948\u091a\u092e\u0947\u0902\u091f \u0936\u0941\u0932\u094d\u0915, 10% \u0915\u092e\u0940\u0936\u0928 \u0914\u0930 \u0915\u093e\u091f\u0947 \u0917\u090f \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u0947 \u0935\u093e\u092a\u0938 \u0928\u0939\u0940\u0902 \u0915\u093f\u090f \u091c\u093e\u0924\u0947\u0964\n- \u0905\u0928\u090f\u0932\u094b\u0915\u0947\u0936\u0928 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e: \u20b92,000 \u0924\u0915\n- \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u0935\u093e\u0939\u0928/\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092c\u0926\u0932\u093e\u0935 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e: \u20b910,000 \u0924\u0915 \u0914\u0930 \u0938\u094d\u0925\u093e\u092f\u0940 \u092c\u094d\u0932\u0949\u0915\n\n7. \u0938\u0939\u093e\u092f\u0924\u093e \u0935 \u0938\u0902\u092a\u0930\u094d\u0915\n\u0908\u092e\u0947\u0932: support@dropcars.com | \u092b\u094b\u0928: +917200217986\n"},welcome:{steps:[{title:"Drop Cars \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948!",subtitle:"\u092a\u094d\u0930\u092e\u0941\u0916 \u092b\u094d\u0932\u0940\u091f \u0935 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e",description:"\u092a\u0942\u0930\u0947 \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u0947 \u0905\u092a\u0928\u0947 \u0935\u093e\u0939\u0928\u094b\u0902 \u0915\u094b \u091c\u094b\u0921\u093c\u0947\u0902\u0964 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u0930\u093f\u0935\u0939\u0928 \u0938\u0947\u0935\u093e\u090f\u0902 \u0926\u0947\u0915\u0930 \u092d\u0930\u094b\u0938\u0947\u092e\u0902\u0926 \u0915\u092e\u093e\u0908 \u0915\u0930\u0947\u0902\u0964"},{title:"\u091a\u0930\u0923 1: \u092b\u094d\u0932\u0940\u091f \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u091c\u094b\u0921\u093c\u0947\u0902",subtitle:"\u0938\u092d\u0940 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0935\u0948\u0927 \u0914\u0930 \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0916\u0947\u0902",description:"\u0935\u0948\u0927 RC, \u0907\u0902\u0936\u094d\u092f\u094b\u0930\u0947\u0902\u0938, \u092a\u0930\u092e\u093f\u091f \u0914\u0930 \u092b\u093f\u091f\u0928\u0947\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0935\u093e\u0939\u0928 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u0930\u0947\u0902\u0964 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u094b \u091c\u094b\u0921\u093c\u0947\u0902\u0964"},{title:"\u091a\u0930\u0923 2: \u091f\u094d\u0930\u093f\u092a \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902 \u0935 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902",subtitle:"\u0938\u091f\u0940\u0915 \u0935\u093e\u0939\u0928 \u0935 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f",description:"\u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0910\u092a \u0915\u0947 \u091c\u093c\u0930\u093f\u090f \u0938\u091f\u0940\u0915 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0935\u093e\u0939\u0928 \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u094b \u0939\u0940 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902\u0964 \u092c\u093f\u0928\u093e \u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u0935\u093e\u0939\u0928 \u092f\u093e \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092c\u0926\u0932\u0928\u093e \u0938\u0916\u094d\u0924 \u092e\u0928\u093e \u0939\u0948\u0964"},{title:"\u091a\u0930\u0923 3: \u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915 \u0915\u0940 \u092a\u0942\u0930\u094d\u0923 \u091c\u093c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940",subtitle:"100% \u092a\u0942\u0930\u0940 \u091c\u093c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u0940",description:"\u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u091f\u094d\u0930\u093f\u092a \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u0928, \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u0915\u0940 \u0935\u0
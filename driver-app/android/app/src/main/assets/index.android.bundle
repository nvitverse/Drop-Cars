\u0cb8\u0cbf. \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca8\u0cbf\u0cb2\u0ccd\u0cb2\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2 - \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 Drop Cars \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cbe\u0cb0\u0ca3 \u0ca8\u0ccb\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6.","You earned":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c97\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1","You have a car that fits this":"\u0c87\u0ca6\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cc1\u0cb5 \u0c95\u0cbe\u0cb0\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6","You have already accepted {0} bookings. Please assign driver and car to your accepted bookings before accepting new ones.":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 {0} \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf. \u0cb9\u0cca\u0cb8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0ca6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd & \u0c95\u0cbe\u0cb0\u0cc1 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf.","You have an assigned trip active or scheduled within 1 hour. You must remain On Duty until the trip is completed.":"1 \u0c97\u0c82\u0c9f\u0cc6\u0caf\u0cca\u0cb3\u0c97\u0cc6 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4 \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cbf\u0c97\u0ca6\u0cbf\u0ca4 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c87\u0ca6\u0cc6. \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0caf\u0cc1\u0cb5\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1.","You haven't submitted any bids yet. Switch to the Live tab to place bids on customer requests!":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0caf\u0cbe\u0cb5 \u0cac\u0cbf\u0ca1\u0ccd \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2. \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cac\u0cbf\u0ca1\u0ccd \u0cb9\u0cbe\u0c95\u0cb2\u0cc1 \u0cb2\u0cc8\u0cb5\u0ccd \u0c9f\u0ccd\u0caf\u0cbe\u0cac\u0ccd\u200c\u0c97\u0cc6 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf!","You keep":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c87\u0c9f\u0ccd\u0c9f\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1","You must add and verify an email address before resetting or changing your password.":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cb0\u0cc1\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cc1\u0cb5 \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1.",Your:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae","Your account is ready. Start exploring the app!":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c86\u0ccd\u0caf\u0caa\u0ccd \u0c85\u0ca8\u0ccd\u0cb5\u0cc7\u0cb7\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf!","Your alternate mobile number request (+91 {0}) has been submitted for Admin Review.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cb0\u0ccd\u0caf\u0cbe\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf (+91 {0}) \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Your bank account / IFSC change request has been submitted to the Admin Review Queue and is pending approval.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 / IFSC \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cbe \u0cb8\u0cb0\u0ca4\u0cbf\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6 \u0cac\u0cbe\u0c95\u0cbf \u0c87\u0ca6\u0cc6.","Your Bid: \u20b9":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0cbf\u0ca1\u0ccd: \u20b9","Your city (e.g. Chennai)":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0c97\u0cb0 (\u0c89\u0ca6\u0cbe. \u0c9a\u0cc6\u0ca8\u0ccd\u0ca8\u0cc8)","Your current password":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd","Your Earning":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c97\u0cb3\u0cbf\u0c95\u0cc6","Your Email Address":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8","Your email address has been successfully verified.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Your email is verified and saved. You can now reset your password with it.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c88\u0c97 \u0c85\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cb0\u0cc1\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Your empty trips carry":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0cb2\u0cbf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb9\u0cca\u0ca4\u0ccd\u0ca4\u0cbf\u0cb5\u0cc6","Your fare:":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca6\u0cb0:","Your Fleet Partner account has been upgraded to {0} Trusted Partner status!":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 {0} \u0c9f\u0ccd\u0cb0\u0cb8\u0ccd\u0c9f\u0cc6\u0ca1\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd \u0cb8\u0ccd\u0ca5\u0cbe\u0ca8\u0c95\u0ccd\u0c95\u0cc6 \u0c85\u0caa\u0ccd\u200c\u0c97\u0ccd\u0cb0\u0cc7\u0ca1\u0ccd \u0c86\u0c97\u0cbf\u0ca6\u0cc6!","Your KYC (Aadhar + PAN) must be verified before you can accept bookings. Check Settings > Profile.":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae KYC (\u0c86\u0ca7\u0cbe\u0cb0\u0ccd + PAN) \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cac\u0cc7\u0c95\u0cc1. \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 > \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0ca8\u0ccb\u0ca1\u0cbf.","Your message has been created as a Chat thread in Drop Cars Admin App. Our support team will review your account (+91":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0c82\u0ca6\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 Drop Cars \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c9a\u0cbe\u0c9f\u0ccd \u0ca5\u0ccd\u0cb0\u0cc6\u0ca1\u0ccd \u0c86\u0c97\u0cbf \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca8\u0cae\u0ccd\u0cae \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0ca4\u0c82\u0ca1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 (+91","Your mobile number change request (+91 {0}) has been submitted to Drop Cars Admin for review & approval.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf (+91 {0}) Drop Cars \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd\u200c\u0c97\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 & \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Your name as driver":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c86\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","Your name is updated. It now shows on your trips and reviews.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c87\u0ca6\u0cc1 \u0c87\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cae\u0cb0\u0ccd\u0cb6\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Your offer of \u20b9{0}{1} has been sent to {2}.":"\u20b9{0}{1} \u0c86\u0cab\u0cb0\u0ccd {2} \u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Your ownership of '{0}' was verified! The request has been submitted for final Admin Review.":"'{0}' \u0cae\u0cc7\u0cb2\u0cbf\u0ca8 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0ca4\u0ccd\u0cb5 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6! \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Your password has been changed successfully.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cbe\u0cb
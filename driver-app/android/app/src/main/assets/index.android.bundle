u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02.","Could not submit name update request.":"\u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02.","Could not submit payment detail update. Please try again.":"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32 \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02. \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Could not submit secondary mobile request.":"\u0c30\u0c46\u0c02\u0c21\u0c35 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02.","Could not submit the payout request.":"\u0c2a\u0c47\u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c28\u0c41 \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02.","Could not switch to driver mode.":"\u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c2e\u0c4b\u0c21\u0c4d\u200c\u0c15\u0c41 \u0c2e\u0c3e\u0c30\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02.","Could not switch to Duty mode":"\u0c21\u0c4d\u0c2f\u0c42\u0c1f\u0c40 \u0c2e\u0c4b\u0c21\u0c4d\u200c\u0c15\u0c41 \u0c2e\u0c3e\u0c30\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02","Could not switch to Duty mode.":"\u0c21\u0c4d\u0c2f\u0c42\u0c1f\u0c40 \u0c2e\u0c4b\u0c21\u0c4d\u200c\u0c15\u0c41 \u0c2e\u0c3e\u0c30\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02.","Could not update":"\u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02","Could not update auto-renew. Please try again.":"\u0c06\u0c1f\u0c4b-\u0c30\u0c46\u0c28\u0c4d\u0c2f\u0c42\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02. \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Could not update mobile number":"\u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02","Could not upgrade to Yearly. Please try again.":"\u0c35\u0c3e\u0c30\u0c4d\u0c37\u0c3f\u0c15 \u0c2a\u0c4d\u0c32\u0c3e\u0c28\u0c4d\u200c\u0c15\u0c41 \u0c2e\u0c3e\u0c30\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02. \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Could not verify code.":"\u0c15\u0c4b\u0c21\u0c4d\u200c\u0c28\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02.","Couldn't Load Reviews":"\u0c30\u0c3f\u0c35\u0c4d\u0c2f\u0c42\u0c32\u0c28\u0c41 \u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02","Couldn't Start Duty Session":"\u0c21\u0c4d\u0c2f\u0c42\u0c1f\u0c40 \u0c38\u0c46\u0c37\u0c28\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c2f\u0c3e\u0c02","Create Password":"\u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Create password (min 6 chars)":"\u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f (\u0c15\u0c28\u0c40\u0c38\u0c02 6 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32\u0c41)","Create Password and Confirm Password do not match. Please enter matching passwords.":"\
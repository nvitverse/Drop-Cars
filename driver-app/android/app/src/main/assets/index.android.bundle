092c\u0948\u091c \u0917\u094d\u0930\u093e\u0939\u0915 \u0910\u092a \u092e\u0947\u0902 \u0926\u093f\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 15% \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0915\u092e\u0940\u0936\u0928 + GST \u0932\u093e\u0917\u0942\u0964","Balance Due on Trip":"\u091f\u094d\u0930\u093f\u092a \u092e\u0947\u0902 \u0926\u0947\u092f \u0936\u0947\u0937","Bank account / UPI saved - tap to update":"\u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e / UPI \u0938\u0947\u0935 \u0939\u0948 - \u0905\u092a\u0921\u0947\u091f \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902","Bank Account & Payout Details":"\u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0914\u0930 \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0935\u0930\u0923","Bank Account Holder Name":"\u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915 \u0915\u093e \u0928\u093e\u092e","Bank Account Number":"\u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0938\u0902\u0916\u094d\u092f\u093e","Bank account or UPI ID where trip earnings and balance payouts are credited.":"\u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u092f\u093e UPI ID \u091c\u0939\u093e\u0901 \u091f\u094d\u0930\u093f\u092a \u0915\u0940 \u0915\u092e\u093e\u0908 \u0914\u0930 \u0936\u0947\u0937 \u0930\u093e\u0936\u093f \u091c\u092e\u093e \u0939\u094b\u0917\u0940\u0964","Bank Account:":"\u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e:","Bank IFSC":"\u092c\u0948\u0902\u0915 IFSC","Bank IFSC Code":"\u092c\u0948\u0902\u0915 IFSC \u0915\u094b\u0921","Bank Name, A/C No, IFSC Code":"\u092c\u0948\u0902\u0915 \u0915\u093e \u0928\u093e\u092e, \u0916\u093e\u0924\u093e \u0938\u0902\u0916\u094d\u092f\u093e, IFSC \u0915\u094b\u0921","Bank Transfer":"\u092c\u0948\u0902\u0915 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930","Base Fare (":"\u092e\u0942\u0932 \u0915\u093f\u0930\u093e\u092f\u093e (","Base Rate per km":"\u092a\u094d\u0930\u0924\u093f \u0915\u093f\u092e\u0940 \u092e\u0942\u0932 \u0926\u0930",Bata:"\u092c\u0924\u094d\u0924\u093e","Become a Trusted Partner":"\u092d\u0930\u094b\u0938\u0947\u092e\u0902\u0926 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u092c\u0928\u0947\u0902","Become a Trusted Partner instantly. Auto-debited every month - cannot be cancelled, only upgraded to Yearly.":"\u0924\u0941\u0930\u0902\u0924 \u092d\u0930\u094b\u0938\u0947\u092e\u0902\u0926 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u092c\u0928\u0947\u0902\u0964 \u0939\u0930 \u092e\u0939\u0940\u0928\u0947 \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u091f\u0947\u0917\u093e - \u0930\u0926\u094d\u0926 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e, \u0915\u0947\u0935\u0932 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u092e\u0947\u0902 \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Best Day:":"\u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u0926\u093f\u0928:","Bill says \u20b9{0} was due. Change it only if the customer paid a different amount.":"\u092c\u093f\u0932 \u092e\u0947\u0902 \u20b9{0} \u0926\u0947\u092f \u0939\u0948\u0964 \u0917\u094d\u0930\u093e\u0939\u0915 \u0928\u0947 \u0905\u0932\u0917 \u0930\u093e\u0936\u093f \u0926\u0940 \u0939\u094b \u0924\u092d\u0940 \u092c\u0926\u0932\u0947\u0902\u0964","Binding Offer & Cancellation Policy Notice":"\u092c\u093e\u0927\u094d\u092f\u0915\u093e\u0930\u0940 \u0911\u092b\u093c\u0930 \u0914\u0930 \u0930\u0926\u094d\u0926\u0940\u0915\u0930\u0923 \u0928\u0940\u0924\u093f \u0938\u0942\u091a\u0928\u093e","Boarding:":"\u092c\u094b\u0930\u094d\u0921\u093f\u0902\u0917:",Booking:"\u092c\u0941\u0915\u093f\u0902\u0917","Booking #":"\u092c\u0941\u0915\u093f\u0902\u0917 #","Booking #{0} has been cancelled.":"\u092c\u0941\u0915\u093f\u0902\u0917 #{0} \u0930\u0926\u094d\u0926 \u0915\u0930 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964","Booking #{0} has been cancelled. A mandatory \u20b9500 cancellation penalty fee has been debited from your fleet wallet.":"\u092c\u0941\u0915\u093f\u0902\u0917 #{0} \u0930\u0926\u094d\u0926 \u0915\u0930 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964 \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u20b9500 \u0930\u0926\u094d\u0926\u0940\u0915\u0930\u0923 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e \u0906\u092a\u0915\u0947 \u092b\u094d\u0932\u0940\u091f \u0935\u0949\u0932\u0947\u091f \u0938\u0947 \u0915\u093e\u091f \u0932\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964","Booking #{0} will be removed and no driver will see it anymore. There is no fee.":"\u092c\u0941\u0915\u093f\u0902\u0917 #{0} \u0939\u091f\u093e \u0926\u0940 \u091c\u093e\u090f\u0917\u0940 \u0914\u0930 \u0905\u092c \u0915\u094b\u0908 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0907\u0938\u0947 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u0947\u0917\u093e\u0964 \u0915\u094b\u0908 \u0936\u0941\u0932\u094d\u0915 \u0928\u0939\u0940\u0902\u0964","Booking Accepted":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0939\u0941\u0908","Booking accepted successfully! Assign driver & car in Unassigned.":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0939\u0941\u0908! \u0905\u0938\u093e\u0907\u0928 \u0928\u0939\u0940\u0902 \u0915\u093f\u090f \u0917\u090f \u092e\u0947\u0902 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0917\u093e\u0921\u093c\u0940 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902\u0964","Booking Alert Sound Tone":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0905\u0932\u0930\u094d\u091f \u0927\u094d\u0935\u0928\u093f","Booking alert sound tone set to \"{0}\".":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0905\u0932\u0930\u094d\u091f \u0927\u094d\u0935\u0928\u093f \"{0}\" \u092a\u0930 \u0938\u0947\u091f \u0915\u0940 \u0917\u0908\u0964","Booking Alerts":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0905\u0932\u0930\u094d\u091f","Booking Already Taken":"\u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u0939\u09
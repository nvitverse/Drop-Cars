\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Ask the customer for the 4-digit code shown on their booking confirmation.":"\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c23\u0c32\u0c4b \u0c1a\u0c42\u0c2a\u0c3f\u0c28 4 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c15\u0c4b\u0c21\u0c4d \u0c05\u0c21\u0c17\u0c02\u0c21\u0c3f.","Ask the customer for the 4-digit completion code from their SMS or booking page.":"\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d SMS \u0c32\u0c47\u0c26\u0c3e \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c2a\u0c47\u0c1c\u0c40\u0c32\u0c4b\u0c28\u0c3f 4 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c15\u0c4b\u0c21\u0c4d \u0c05\u0c21\u0c17\u0c02\u0c21\u0c3f.","Ask the customer for the trip end code from their confirmation email.":"\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c23 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c4b\u0c21\u0c4d \u0c05\u0c21\u0c17\u0c02\u0c21\u0c3f.","Ask the customer for the trip start code from their confirmation email.":"\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c23 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d\u200c\u0c32\u0c4b\u0c28\u0c3f \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d \u0c15\u0c4b\u0c21\u0c4d \u0c05\u0c21\u0c17\u0c02\u0c21\u0c3f.","Assign Driver":"\u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Assign Driver & Cab":"\u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d & \u0c15\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d\u200c\u0c28\u0c41 \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Assign driver & car in {0}":"{0} \u0c32\u0c4b\u0c2a\u0c41 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d & \u0c15\u0c3e
936\u0941\u0930\u0941\u0906\u0924\u0940 OTP \u0932\u0947\u0902\u0964","Collect from the customer":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947 \u0935\u0938\u0942\u0932\u0928\u093e \u0939\u0948","Collected extra: {0}":"\u0935\u0938\u0942\u0932\u093e \u0917\u092f\u093e \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924: {0}","Commission on KM fare:":"\u0915\u093f\u092e\u0940 \u0915\u093f\u0930\u093e\u092f\u0947 \u092a\u0930 \u0915\u092e\u0940\u0936\u0928:","Completed (":"\u092a\u0942\u0930\u0940 \u0939\u0941\u0908 (","Completed on":"\u092a\u0942\u0930\u093e \u0939\u094b\u0928\u0947 \u0915\u0940 \u0924\u093e\u0930\u0940\u0916\u093c","Completed Trip - Final Summary":"\u092a\u0942\u0930\u0940 \u0939\u0941\u0908 \u091f\u094d\u0930\u093f\u092a - \u0905\u0902\u0924\u093f\u092e \u0938\u093e\u0930\u093e\u0902\u0936","Confirm & Create Booking":"\u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902 \u0914\u0930 \u092c\u0941\u0915\u093f\u0902\u0917 \u092c\u0928\u093e\u090f\u0901","Confirm & Re-Broadcast \u26a1":"\u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u0938\u093e\u0930\u093f\u0924 \u0915\u0930\u0947\u0902 \u26a1","Confirm Cancel (\u20b9500 Fee)":"\u0930\u0926\u094d\u0926 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902 (\u20b9500 \u0936\u0941\u0932\u094d\u0915)","Confirm New Password":"\u0928\u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u094b\u092c\u093e\u0930\u093e \u0932\u093f\u0916\u0947\u0902","Confirm Password":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902","Confirm tariff":"\u091f\u0948\u0930\u093f\u092b\u093c \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902",Confirmed:"\u092a\u0915\u094d\u0915\u093e","Connected ({0})":"\u091c\u0941\u0921\u093c\u093e \u0939\u0941\u0906 ({0})",Contact:"\u0938\u0902\u092a\u0930\u094d\u0915","Contact & Security":"\u0938\u0902\u092a\u0930\u094d\u0915 \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e","Contact Drop Cars Helpline Support for assistance with this booking.":"\u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0947 \u0932\u093f\u090f Drop Cars \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964",Contacts:"\u0938\u0902\u092a\u0930\u094d\u0915","Continue chat with Attachment team":"\u0905\u091f\u0948\u091a\u092e\u0947\u0902\u091f \u091f\u0940\u092e \u0915\u0947 \u0938\u093e\u0925 \u091a\u0948\u091f \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902",Copied:"\u0915\u0949\u092a\u0940 \u0939\u094b \u0917\u092f\u093e","Corporate Booking":"\u0915\u0949\u0930\u094d\u092a\u094b\u0930\u0947\u091f \u092c\u0941\u0915\u093f\u0902\u0917","Corporate contracted booking rates":"\u0915\u0949\u0930\u094d\u092a\u094b\u0930\u0947\u091f \u0905\u0928\u0941\u092c\u0902\u0927 \u092c\u0941\u0915\u093f\u0902\u0917 \u0926\u0930\u0947\u0902","Corporate Fare Booking":"\u0915\u0949\u0930\u094d\u092a\u094b\u0930\u0947\u091f \u0915\u093f\u0930\u093e\u092f\u093e \u092c\u0941\u0915\u093f\u0902\u0917","Could not apply referral code":"\u0930\u0947\u092b\u093c\u0930\u0932 \u0915\u094b\u0921 \u0932\u093e\u0917\u0942 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","could not be verified automatically against our records.":"\u0939\u092e\u093e\u0930\u0947 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0938\u0947 \u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964","Could not cancel booking.":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0930\u0926\u094d\u0926 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940\u0964","Could not cancel this booking. Please try again.":"\u092f\u0939 \u092c\u0941\u0915\u093f\u0902\u0917 \u0930\u0926\u094d\u0926 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Could not change":"\u092c\u0926\u0932\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e","Could not change duty status. Please try again.":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092c\u0926\u0932\u0940 \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0940\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Could not change password.":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932\u093e \u091c\u093e \u0938\u0915\u093e\u0964","Could not change password. Please try again.":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932\u093e \u091c\u093e \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Could not fetch complete user profile":"\u092a\u0942\u0930\u0940 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0940","Could not fetch drivers or cabs for assignment.":"\u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u0915\u0947 \u0932\u093f\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092f\u093e \u0915\u0948\u092c \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0947\u0964","Could not load the bill":"\u092c\u093f\u0932 \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","Could not load this trip right now.":"\u092f\u0939 \u091f\u094d\u0930\u093f\u092a \u0905\u092d\u0940 \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940\u0964","Could not open WhatsApp.":"WhatsApp \u0928\u0939\u0940\u0902 \u0916\u0941\u0932 \u0938\u0915\u093e\u0964","Could not save":"\u0938\u0947\u0935 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","Could not save payment details.":"\u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0935\u0930\u0923 \u0938\u0947\u0935 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0947\u0964","Could not save photo.":"\u092b\u094b\u091f\u094b \u0938\u0947\u0935 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940\u0964","Could Not Send Code":"\u0915\u094b\u0921 \u092d\u0947\u091c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e","Could not send the voice note. Please try again.":"\u0935\u0949\u092f\u0938 \u0928\u094b\u091f \u092d\u0947\u091c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Could not send verification code.":"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u094b\u0921 \u092d\u0947\u091c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e\u0964","Could not start recording.":"\u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0936\u0941\u0930\u0942 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940\u0964","Could not start the Monthly plan. Please try again.":"\u092e\u093e\u0938\u093f\u0915 \u092a\u094d\u0932\u093e\u0928 \u0936\u0941\u0930\u0942 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Could not start your duty session. Please try again.":"\u0906\u092a\u0915\u093e \u0921\u094d\u092f\u0942\u091f\u0940 \u0938\u0947\u0936\u0928 \u0936\u0941\u0930\u0942 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Could not submit business name request.":"\u0935\u094d\u092f\u0935\u0938\u093e\u092f \u0928\u093e\u092e \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u091c\u092e\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964","Could not submit mobile number update request.":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092c\u0926\u0932\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u091c\u092e\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964","Could not submit name update request.":"\u0928\u093e\u092e \u092c\u0926\u0932\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u091c\u092e\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964","Could not submit payment detail update. Please try again.":"\u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0935\u0930\u0923 \u092c\u0926\u0932\u093e\u0935 \u091c\u092e\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Could not submit secondary mobile request.":"\u0926\u0942\u0938\u0930\u0947 \u092e\u094b\u092c\u093e\u0907\u0932 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u091c\u092e\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964","Could not submit the payout request.":"\u092d\u0941\u0917\u0924\u093e\u0928 \u0928\u093f\u0915\u093e\u0938\u0940 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u091c\u092e\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964","Could not switch to driver mode.":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092e\u094b\u0921 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932 \u0938\u0915\u0947\u0964","Could not switch to Duty mode":"\u0921\u094d\u092f\u0942\u091f\u0940 \u092e\u094b\u0921 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932 \u0938\u0915\u0947","Could not switch to Duty mode.":"\u0921\u094d\u092f\u0942\u091f\u0940 \u092e\u094b\u0921 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932 \u0938\u0915\u0947\u0964","Could not update":"\u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","Could not update auto-renew. Please try again.":"\u0911\u091f\u094b-\u0930\u093f\u0928\u094d\u092f\u0942 \u092c\u0926\u0932\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Could not update mobile number":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","Could not upgrade to Yearly. Please try again.":"\u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u092a\u094d\u0932\u093e\u0928 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932 \u0938\u0915\u0947\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Could not verify code.":"\u0915\u094b\u0921 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964","Couldn't Load Reviews":"\u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0901 \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940\u0902","Couldn't Start Duty Session":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0938\u0947\u0936\u0928 \u0936\u0941\u0930\u0942 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","Create Password":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0928\u093e\u090f\u0901","Create password (min 6 chars)":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0928\u093e\u090f\u0901 (\u0915\u092e \u0938\u0947 \u0915\u092e 6 \u0905\u0915\u094d\u0937\u0930)","Create Password and Confirm Password do not match. Please enter matching passwords.":"\u092c\u0928\u093e\u092f\u093e \u0917\u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0914\u0930 \u092a\u0941\u0937\u094d\u091f\u093f \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u0947\u0964 \u090f\u0915 \u091c\u0948\u0938\u0947 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Create This Booking?":"\u0915\u094d\u092f\u093e \u092f\u0939 \u092c\u0941\u0915\u093f\u0902\u0917 \u092c\u0928\u093e\u0928\u0940 \u0939\u0948?","Critical alerts for urgent trips, Drop Bid driver requests, and expiring assignments":"\u0924\u0924\u094d\u0915\u093e\u0932 \u091f\u094d\u0930\u093f\u092a, Drop Bid \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0905\u0928\u0941\u0930\u094b\u0927 \u0914\u0930 \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0947 \u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u0915\u0947 \u0932\u093f\u090f \u091c\u093c\u0930\u0942\u0930\u0940 \u0905\u0932\u0930\u094d\u091f","CRITICAL UPLOAD NEEDED":"\u091c\u093c\u0930\u0942\u0930\u0940 \u0905\u092a\u0932\u094b\u0921 \u091a\u093e\u0939\u093f\u090f","Crop & Adjust Document":"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u094d\u0930\u0949\u092a \u0915\u0930\u0915\u0947 \u0920\u0940\u0915 \u0915\u0930\u0947\u0902","Crop & Upload":"\u0915\u094d\u0930\u0949\u092a \u0915\u0930\u0915\u0947 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902","Current Password":"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921","Current Total Fare":"\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0915\u0941\u0932 \u0915\u093f\u0930\u093e\u092f\u093e","Custom notification horn sound for high priority bookings":"\u0909\u091a\u094d\u091a \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0915\u0938\u094d\u091f\u092e \u0938\u0942\u091a\u0928\u093e \u0939\u0949\u0930\u094d\u0928 \u0927\u094d\u0935\u0928\u093f",Customer:"\u0917\u094d\u0930\u093e\u0939\u0915","Customer 4-Digit Start OTP:":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u093e 4 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0936\u0941\u0930\u0941\u0906\u0924\u0940 OTP:","Customer Advance Paid:":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0905\u0917\u094d\u0930\u093f\u092e:","Customer Countered Your Bid: \u20b9":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0928\u0947 \u0906\u092a\u0915\u0940 \u092c\u094b\u0932\u0940 \u0915\u093e \u091c\u0935\u093e\u092c\u0940 \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0926\u093f\u092f\u093e: \u20b9","Customer Feedback":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e","Customer Name":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u093e \u0928\u093e\u092e","Customer paid (trip total)":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0928\u0947 \u091a\u0941\u0915\u093e\u092f\u093e (\u091f\u094d\u0930\u093f\u092a \u0915\u0941\u0932)","Customer pays \u20b9":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0926\u0947\u0917\u093e \u20b9","Customer reviews will show up here after your trips.":"\u0906\u092a\u0915\u0940 \u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u092c\u093e\u0926 \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0901 \u092f\u0939\u093e\u0901 \u0926\u093f\u0916\u0947\u0902\u0917\u0940\u0964","Customer Special Notes & Instructions":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0947 \u0935\u093f\u0936\u0947\u0937 \u0928\u094b\u091f\u094d\u0938 \u0914\u0930 \u0928\u093f\u0930\u094d\u0926\u0947\u0936","Customize your app experience":"\u0905\u092a\u0928\u0947 \u0910\u092a \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926 \u0938\u0947 \u092c\u0926\u0932\u0947\u0902","Dark Mode":"\u0921\u093e\u0930\u094d\u0915 \u092e\u094b\u0921","Data Sharing":"\u0921\u0947\u091f\u093e \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u093e",Date:"\u0924\u093e\u0930\u0940\u0916\u093c","Day After":"\u0905\u0917\u0932\u093e \u0926\u093f\u0928","debited from your wallet.":"\u0906\u092a\u0915\u0947 \u0935\u0949\u0932\u0947\u091f \u0938\u0947 \u0915\u093e\u091f\u093e \u0917\u092f\u093e\u0964","Decline (":"\u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902 (","Decline (Need 7 Seater)":"\u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902 (7-\u0938\u0940\u091f\u0930 \u091a\u093e\u0939\u093f\u090f)","Decline is FREE during the 10s countdown. Post-assignment cancel fee: \u20b9500.":"10 \u0938\u0947\u0915\u0902\u0921 \u0915\u0940 \u0917\u093f\u0928\u0924\u0940 \u092e\u0947\u0902 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u093e \u092e\u0941\u092b\u093c\u094d\u0924 \u0939\u0948\u0964 \u0905\u0938\u093e\u0907\u0928 \u0915\u0947 \u092c\u093e\u0926 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u093e \u0936\u0941\u0932\u094d\u0915: \u20b9500\u0964","Decline within 10 seconds":"10 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902","Demo Mode Active":"\u0921\u0947\u092e\u094b \u092e\u094b\u0921 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948","Departure date":"\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0915\u0940 \u0924\u093e\u0930\u0940\u0916\u093c","Departure time":"\u092a\u094d\u0930\u0938\u094d\u0925\u093e\u0928 \u0915\u093e \u0938\u092e\u092f","Describe the name, address, or document changes needed...":"\u091c\u093c\u0930\u0942\u0930\u0940 \u0928\u093e\u092e, \u092a\u0924\u093e \u092f\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092c\u0926\u0932\u093e\u0935 \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u0932\u093f\u0916\u0947\u0902...","Describe your issue or enter your correct email address...":"\u0905\u092a\u0928\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u092c\u0924\u093e\u090f\u0901 \u092f\u093e \u0938\u0939\u0940 \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902...","Details to Update / Reason":"\u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0935\u093f\u0935\u0930\u0923 / \u0915\u093e\u0930\u0923","Didn't clearly match your licence photo ({0}%) - you can retake it in Settings.":"\u0906\u092a\u0915\u0940 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u092b\u094b\u091f\u094b \u0938\u0947 \u0938\u093e\u092b\u093c \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u092f\u093e ({0}%) - \u0906\u092a \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u0926\u094b\u092c\u093e\u0930\u093e \u0932\u0947 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Different Driver":"\u0926\u0942\u0938\u0930\u093e \u0921\u094d\u0930\u093e\u0907\u0935\u0930","Different Number":"\u0926\u0942\u0938\u0930\u093e \u0928\u0902\u092c\u0930","Direct dealings outside the Drop Cars platform will result in account suspension.":"Drop Cars \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0915\u0947 \u092c\u093e\u0939\u0930 \u0938\u0940\u0927\u093e \u0938\u094c\u0926\u093e \u0915\u0930\u0928\u0947 \u092a\u0930 \u0916\u093e\u0924\u093e \u0928\u093f\u0932\u0902\u092c\u093f\u0924 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964","Direct personal numbers & WhatsApp contacts are masked to protect trip security and platform privacy.":"\u091f\u094d\u0930\u093f\u092a \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0914\u0930 \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0915\u0940 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u091c\u0940 \u0928\u0902\u092c\u0930 \u0914\u0930 WhatsApp \u0938\u0902\u092a\u0930\u094d\u0915 \u091b\u093f\u092a\u093e\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964","directly from customer. Security deposit is held temporarily in wallet and settled after trip completion.":"\u0938\u0940\u0927\u0947 \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947\u0964 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091c\u092e\u093e \u0935\u0949\u0932\u0947\u091f \u092e\u0947\u0902 \u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0939\u094b\u0932\u094d\u0921 \u0930\u0939\u0924\u0940 \u0939\u0948 \u0914\u0930 \u091f\u094d\u0930\u093f\u092a \u092a\u0942\u0930\u0940 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0938\u0947\u091f\u0932 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964","Directly post and dispatch new trips from your driver panel to the Drop Cars network.":"\u0905\u092a\u0928\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u0948\u0928\u0932 \u0938\u0947 \u0938\u0940\u0927\u0947 Drop Cars \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u092a\u0930 \u0928\u0908 \u091f\u094d\u0930\u093f\u092a \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964",Dismiss:"\u092c\u0902\u0926 \u0915\u0930\u0947\u0902",Distance:"\u0926\u0942\u0930\u0940","Distance (km)":"\u0926\u0942\u0930\u0940 (\u0915\u093f\u092e\u0940)","Distance & Fare":"\u0926\u0942\u0930\u0940 \u0914\u0930 \u0915\u093f\u0930\u093e\u092f\u093e","Distance actually driven":"\u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u091a\u0932\u093e\u0908 \u0917\u0908 \u0926\u0942\u0930\u0940","Distance driven":"\u091a\u0932\u093e\u0908 \u0917\u0908 \u0926\u0942\u0930\u0940","Distance edited:":"\u0926\u0942\u0930\u0940 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0940 \u0917\u0908:","Distance is different":"\u0926\u0942\u0930\u0940 \u0905\u0932\u0917 \u0939\u0948","Distance planned":"\u0924\u092f \u0926\u0942\u0930\u0940","DL & Police Checked":"DL \u0914\u0930 \u092a\u0941\u0932\u093f\u0938 \u091c\u093e\u0901\u091a \u0939\u094b \u091a\u0941\u0915\u0940","Do you want to log in as a different driver?":"\u0915\u094d\u092f\u093e \u0906\u092a \u0926\u0942\u0938\u0930\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?","DOCUMENT EXPIRY DATE":"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0940 \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0924\u093f\u0925\u093f","Document Renewal Required":"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0928\u0935\u0940\u0928\u0940\u0915\u0930\u0923 \u091c\u093c\u0930\u0942\u0930\u0940",Done:"\u0939\u094b \u0917\u092f\u093e","Driver {0} and Vehicle {1} assigned successfully.":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 {0} \u0914\u0930 \u0917\u093e\u0921\u093c\u0940 {1} \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0905\u0938\u093e\u0907\u0928 \u0939\u0941\u090f\u0964","Driver & Fleet Partner Portal":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u092b\u094d\u0932\u0940\u091f \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u092a\u094b\u0930\u094d\u091f\u0932","Driver & Vehicle Profile":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0917\u093e\u0921\u093c\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932","Driver account status is {0}. Please contact support for assistance.":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0916\u093e\u0924\u0947 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f {0} \u0939\u0948\u0964 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0938\u092a\u094b\u0930\u094d\u091f \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964","Driver account status is {0}. Please contact support.":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0916\u093e\u0924\u0947 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f {0} \u0939\u0948\u0964 \u0938\u092a\u094b\u0930\u094d\u091f \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964","Driver Allowance":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092d\u0924\u094d\u0924\u093e","Driver assignment, arrival reminders, trip start and completion updates":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0
et Up Your Duty Driver Profile":"\u0905\u092a\u0928\u0940 \u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u0947\u091f \u0915\u0930\u0947\u0902","Set Up Your Duty Driver Profile First":"\u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0940 \u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u0947\u091f \u0915\u0930\u0947\u0902","Set Vacant Cities":"\u0916\u093e\u0932\u0940 \u0936\u0939\u0930 \u0938\u0947\u091f \u0915\u0930\u0947\u0902",Share:"\u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902","Share anonymous usage data":"\u0917\u0941\u092e\u0928\u093e\u092e \u0909\u092a\u092f\u094b\u0917 \u0921\u0947\u091f\u093e \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902","Share empty seats in your vehicle during return trips or intercity journeys to earn extra guaranteed income while providing passengers affordable travel.":"\u0935\u093e\u092a\u0938\u0940 \u092f\u093e \u0936\u0939\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e\u0913\u0902 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0917\u093e\u0921\u093c\u0940 \u0915\u0940 \u0916\u093e\u0932\u0940 \u0938\u0940\u091f\u0947\u0902 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902 \u0914\u0930 \u092f\u093e\u0924\u094d\u0930\u093f\u092f\u094b\u0902 \u0915\u094b \u0938\u0938\u094d\u0924\u093e \u0938\u092b\u093c\u0930 \u0926\u0947\u0924\u0947 \u0939\u0941\u090f \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092a\u0915\u094d\u0915\u0940 \u0915\u092e\u093e\u0908 \u0915\u0930\u0947\u0902\u0964","Share these codes with your customer - the driver will ask the customer for them to start and to end the trip.":"\u092f\u0947 \u0915\u094b\u0921 \u0905\u092a\u0928\u0947 \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094b \u0926\u0947\u0902 - \u091f\u094d\u0930\u093f\u092a \u0936\u0941\u0930\u0942 \u0914\u0930 \u0916\u0924\u094d\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947 \u092f\u0947 \u092e\u093e\u0901\u0917\u0947\u0917\u093e\u0964","Share your referral code with fellow vehicle owners and earn rewards when they join Drop Cars.":"\u0938\u093e\u0925\u0940 \u0935\u093e\u0939\u0928 \u092e\u093e\u0932\u093f\u0915\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0905\u092a\u0928\u093e \u0930\u0947\u092b\u093c\u0930\u0932 \u0915\u094b\u0921 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902; \u0935\u0947 Drop Cars \u0938\u0947 \u091c\u0941\u0921\u093c\u0947\u0902 \u0924\u094b \u0907\u0928\u093e\u092e \u092a\u093e\u090f\u0901\u0964","Short Password":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u091b\u094b\u091f\u093e \u0939\u0948","Shortfall in Wallet:":"\u0935\u0949\u0932\u0947\u091f \u092e\u0947\u0902 \u0915\u092e\u0940:","Show customer number to driver":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u093e \u0928\u0902\u092c\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u094b \u0926\u093f\u0916\u093e\u090f\u0901","Show this QR. They scan it, see the trip and your name, and give stars and feedback.":"\u092f\u0939 QR \u0926\u093f\u0916\u093e\u090f\u0901\u0964 \u0935\u0947 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0915\u0947 \u091f\u094d\u0930\u093f\u092a \u0914\u0930 \u0906\u092a\u0915\u093e \u0928\u093e\u092e \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u0914\u0930 \u0938\u094d\u091f\u093e\u0930 \u0935 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0926\u0947\u0902\u0917\u0947\u0964","Side View Photo":"\u0938\u093e\u0907\u0921 \u0935\u094d\u092f\u0942 \u092b\u094b\u091f\u094b","Sign-in failed: {0}":"\u0938\u093e\u0907\u0928-\u0907\u0928 \u0935\u093f\u092b\u0932: {0}","Signin failed":"\u0938\u093e\u0907\u0928 \u0907\u0928 \u0935\u093f\u092b\u0932","Signin failed: {0}":"\u0938\u093e\u0907\u0928 \u0907\u0928 \u0935\u093f\u092b\u0932: {0}","Signin successful":"\u0938\u093e\u0907\u0928 \u0907\u0928 \u0938\u092b\u0932","Signup did not complete successfully":"\u0938\u093e\u0907\u0928 \u0905\u092a \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092a\u0942\u0930\u093e \u0928\u0939\u0940\u0902 \u0939\u0941\u0906","Signup failed":"\u0938\u093e\u0907\u0928 \u0905\u092a \u0935\u093f\u092b\u0932","Signup failed: {0}":"\u0938\u093e\u0907\u0928 \u0905\u092a \u0935\u093f\u092b\u0932: {0}","Signup successful":"\u0938\u093e\u0907\u0928 \u0905\u092a \u0938\u092b\u0932","Something went wrong while signing you in for duty.":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0915\u0941\u091b \u0917\u0932\u0924 \u0939\u094b \u0917\u092f\u093e\u0964","Sound Tone Set":"\u0927\u094d\u0935\u0928\u093f \u091f\u094b\u0928 \u0938\u0947\u091f \u0939\u094b \u0917\u0908","Speak with Drop Cars Support":"Drop Cars \u0938\u092a\u094b\u0930\u094d\u091f \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0947\u0902",Speaker:"\u0938\u094d\u092a\u0940\u0915\u0930","Speaker On":"\u0938\u094d\u092a\u0940\u0915\u0930 \u091a\u093e\u0932\u0942","Special Instructions & Customer Requests (Optional)":"\u0935\u093f\u0936\u0947\u0937 \u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0914\u0930 \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0940 \u092e\u093e\u0901\u0917\u0947\u0902 (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)","Special Request":"\u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u0930\u094b\u0927","Speedometer image is required to start trip":"\u091f\u094d\u0930\u093f\u092a \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u092a\u0940\u0921\u094b\u092e\u0940\u091f\u0930 \u092b\u094b\u091f\u094b \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948","Standard Partner":"\u0938\u094d\u091f\u0948\u0902\u0921\u0930\u094d\u0921 \u092a\u093e\u0930\u094d\u091f\u0928\u0930","Standard per-KM tariff \u2022 Tolls, Parking & Driver Bata extra as actuals":"\u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u0924\u093f \u0915\u093f\u092e\u0940 \u0926\u0930 \u2022 \u091f\u094b\u0932, \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092c\u0924\u094d\u0924\u093e \u0905\u0938\u0932\u0940 \u0916\u0930\u094d\u091a \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0905\u0932\u0917","Standard Tariff":"\u092e\u093e\u0928\u0915 \u091f\u0948\u0930\u093f\u092b\u093c","Standard Tariff Booking":"\u092e\u093e\u0928\u0915 \u091f\u0948\u0930\u093f\u092b\u093c \u092c\u0941\u0915\u093f\u0902\u0917","Standard tariff per KM applies without extra charges.":"\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0936\u0941\u0932\u094d\u0915 \u0915\u0947 \u092c\u093f\u0928\u093e \u092e\u093e\u0928\u0915 \u092a\u094d\u0930\u0924\u093f \u0915\u093f\u092e\u0940 \u0926\u0930 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964","Standard Trip":"\u092e\u093e\u0928\u0915 \u091f\u094d\u0930\u093f\u092a","Start a chat":"\u091a\u0948\u091f \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902","Start Duty Verification":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902","Start KM must be provided and greater than 0":"\u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0915\u093f\u092e\u0940 \u0926\u0947\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948 \u0914\u0930 \u092f\u0939 0 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f","Start KM:":"\u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0915\u093f\u092e\u0940:","Start odometer photo":"\u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0913\u0921\u094b\u092e\u0940\u091f\u0930 \u092b\u094b\u091f\u094b","Start OTP:":"\u0936\u0941\u0930\u0941\u0906\u0924\u0940 OTP:","Start Ride":"\u091f\u094d\u0930\u093f\u092a \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902","State Permit / Tax":"\u0930\u093e\u091c\u094d\u092f \u092a\u0930\u092e\u093f\u091f / \u0915\u0930","State+RTO (TN25), Year (2018), Serial (0004862)":"\u0930\u093e\u091c\u094d\u092f+RTO (TN25), \u0935\u0930\u094d\u0937 (2018), \u0915\u094d\u0930\u092e \u0938\u0902\u0916\u094d\u092f\u093e (0004862)","State+RTO code, year of issue, serial number - as printed on the licence.":"\u0930\u093e\u091c\u094d\u092f+RTO \u0915\u094b\u0921, \u091c\u093e\u0930\u0940 \u0939\u094b\u0928\u0947 \u0915\u093e \u0935\u0930\u094d\u0937, \u0915\u094d\u0930\u092e \u0938\u0902\u0916\u094d\u092f\u093e - \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u092a\u0930 \u091b\u092a\u0947 \u0905\u0928\u0941\u0938\u093e\u0930\u0964","Status Update":"\u0938\u094d\u0925\u093f\u0924\u093f \u0905\u092a\u0921\u0947\u091f","Status: Pending Vendor Approval \u2022 Please wait":"\u0938\u094d\u0925\u093f\u0924\u093f: \u0935\u0947\u0902\u0921\u0930 \u0915\u0940 \u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u0932\u0902\u092c\u093f\u0924 \u2022 \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902",Stay:"\u0930\u0941\u0915\u0947\u0902","Stay updated with real-time alerts":"\u0930\u093f\u092f\u0932-\u091f\u093e\u0907\u092e \u0905\u0932\u0930\u094d\u091f \u0938\u0947 \u0905\u092a\u0921\u0947\u091f \u0930\u0939\u0947\u0902",Step:"\u0915\u0926\u092e","Step 1 of 2 \u2022 Verify Account":"\u0915\u0926\u092e 1/2 \u2022 \u0916\u093e\u0924\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902","Step 1: Submit Your Bid":"\u0915\u0926\u092e 1: \u0905\u092a\u0928\u0940 \u092c\u094b\u0932\u0940 \u091c\u092e\u093e \u0915\u0930\u0947\u0902","Step 1b of 2 \u2022 Verify {0}":"\u0915\u0926\u092e 1b/2 \u2022 {0} \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902","Step 2 of 2 \u2022 Reset Password":"\u0915\u0926\u092e 2/2 \u2022 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0947\u0902","Step 2: Customer Accept / Counter":"\u0915\u0926\u092e 2: \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0940 \u092e\u0902\u091c\u093c\u0942\u0930\u0940 / \u091c\u0935\u093e\u092c\u0940 \u0911\u092b\u093c\u0930","Step 3: Automated Booking Creation & Assignment":"\u0915\u0926\u092e 3: \u0905\u092a\u0928\u0947 \u0906\u092a \u092c\u0941\u0915\u093f\u0902\u0917 \u092c\u0928\u0928\u093e \u0914\u0930 \u0905\u0938\u093e\u0907\u0928 \u0939\u094b\u0928\u093e","Still Waiting":"\u0905\u092d\u0940 \u092d\u0940 \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u092e\u0947\u0902","Still waiting at":"\u0905\u092d\u0940 \u092d\u0940 \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u092e\u0947\u0902",Stop:"\u0930\u094b\u0915\u0947\u0902",Stops:"\u0938\u094d\u091f\u0949\u092a","Street Address (Optional)":"\u0917\u0932\u0940 \u0915\u093e \u092a\u0924\u093e (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)","SUBMIT DOCUMENT FOR APPROVAL":"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u091c\u092e\u093e \u0915\u0930\u0947\u0902","Submit Edit Request":"\u0938\u0902\u092a\u093e\u0926\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u091c\u092e\u093e \u0915\u0930\u0947\u0902","Submit for Admin Review":"\u090f\u0921\u092e\u093f\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u092e\u093e \u0915\u0930\u0947\u0902","Submit Payout Request":"\u0928\u093f\u0915\u093e\u0938\u0940 \u0905\u0928\u0941\u0930\u094b\u0927 \u091c\u092e\u093e \u0915\u0930\u0947\u0902","Submitted Offer: \u20b9":"\u091c\u092e\u093e \u0915\u093f\u092f\u093e \u0911\u092b\u093c\u0930: \u20b9","Submitted profile changes will be sent to Drop Cars Admin verification desk for security approval.":"\u091c\u092e\u093e \u0915\u093f\u090f \u0917\u090f \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092c\u0926\u0932\u093e\u0935 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f Drop Cars \u090f\u0921\u092e\u093f\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0921\u0947\u0938\u094d\u0915 \u0915\u094b \u092d\u0947\u091c\u0947 \u091c\u093e\u090f\u0901\u0917\u0947\u0964","Submitting request to vendor...":"\u0935\u0947\u0902\u0921\u0930 \u0915\u094b \u0905\u0928\u0941\u0930\u094b\u0927 \u091c\u092e\u093e \u0915\u0930 \u0930\u0939\u093e \u0939\u0948...","Submitting...":"\u091c\u092e\u093e \u0939\u094b \u0930\u0939\u093e \u0939\u0948...",Subscribe:"\u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0915\u0930\u0947\u0902","Subscribe - \u20b9199/month":"\u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c - \u20b9199/\u092e\u093e\u0939","Subscribe Monthly - \u20b9{0}/month":"\u092e\u093e\u0938\u093f\u0915 \u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928 - \u20b9{0}/\u092e\u093e\u0939","Subscribed drivers get full weekly earnings breakdown, best day tracking, and trip growth insights.":"\u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0915\u093f\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u094b \u0938\u093e\u092a\u094d\u0924\u093e\u0939\u093f\u0915 \u0915\u092e\u093e\u0908 \u0915\u093e \u092a\u0942\u0930\u093e \u092c\u094d\u092f\u094b\u0930\u093e, \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0947 \u0926\u093f\u0928 \u0915\u0940 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u0914\u0930 \u091f\u094d\u0930\u093f\u092a \u092c\u0922\u093c\u094b\u0924\u0930\u0940 \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964","Success \ud83c\udf89":"\u0938\u092b\u0932 \ud83c\udf89","Support & Assistance":"\u0938\u092a\u094b\u0930\u094d\u091f \u0914\u0930 \u0938\u0939\u093e\u092f\u0924\u093e","Support & Help":"\u0938\u092a\u094b\u0930\u094d\u091f \u0914\u0930 \u092e\u0926\u0926","SUV (Ertiga, Carens, Triber)":"SUV (Ertiga, Carens, Triber)","SWIPE TO START DUTY":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0935\u093e\u0907\u092a \u0915\u0930\u0947\u0902","Switch between light and dark themes":"\u0932\u093e\u0907\u091f \u0914\u0930 \u0921\u093e\u0930\u094d\u0915 \u0925\u0940\u092e \u0915\u0947 \u092c\u0940\u091a \u092c\u0926\u0932\u0947\u0902","Switch to dark theme":"\u0921\u093e\u0930\u094d\u0915 \u0925\u0940\u092e \u092a\u0930 \u091c\u093e\u090f\u0901","Switch to Duty Driver":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u0930 \u091c\u093e\u090f\u0901","Switch to Duty Driver Login":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0932\u0949\u0917\u093f\u0928 \u092a\u0930 \u091c\u093e\u090f\u0901","Switch to Duty Driver Mode":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092e\u094b\u0921 \u092a\u0930 \u091c\u093e\u090f\u0901","Switch to Fleet Owner Login":"\u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u0932\u0949\u0917\u093f\u0928 \u092a\u0930 \u091c\u093e\u090f\u0901","Take 4 Pre-Trip Photos & Start for Pickup.":"4 \u091f\u094d\u0930\u093f\u092a-\u092a\u0942\u0930\u094d\u0935 \u092b\u094b\u091f\u094b \u0932\u0947\u0902 \u0914\u0930 \u092a\u093f\u0915\u0905\u092a \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u0915\u0932\u0947\u0902\u0964","Take a fresh photo for your profile avatar.":"\u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092b\u094b\u091f\u094b \u0915\u0947 \u0932\u093f\u090f \u0928\u0908 \u092b\u094b\u091f\u094b \u0932\u0947\u0902\u0964","Take Back Photo":"\u092a\u0940\u091b\u0947 \u0915\u0940 \u092b\u094b\u091f\u094b \u0932\u0947\u0902","Take clear photo of starting & ending dashboard odometer.":"\u0936\u0941\u0930\u0942 \u0914\u0930 \u0905\u0902\u0924 \u0915\u0947 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0913\u0921\u094b\u092e\u0940\u091f\u0930 \u0915\u0940 \u0938\u093e\u092b\u093c \u092b\u094b\u091f\u094b \u0932\u0947\u0902\u0964","Take Photo Now":"\u0905\u092d\u0940 \u092b\u094b\u091f\u094b \u0932\u0947\u0902","Tap on any feature below to see how it works:":"\u0928\u0940\u091a\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0935\u0939 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0939\u0948:","Tap on any setting to see how it works:":"\u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0935\u0939 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0939\u0948:","Tap the + button to message the Vendor/Fleet Owner/Admin behind your current trips, call a customer, or reach Admin support.":"\u0905\u092a\u0928\u0940 \u092e\u094c\u091c\u0942\u0926\u093e \u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u0935\u0947\u0902\u0921\u0930/\u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915/\u090f\u0921\u092e\u093f\u0928 \u0915\u094b \u0938\u0902\u0926\u0947\u0936 \u092d\u0947\u091c\u0928\u0947, \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094b \u0915\u0949\u0932 \u0915\u0930\u0928\u0947 \u092f\u093e \u090f\u0921\u092e\u093f\u0928 \u0938\u092a\u094b\u0930\u094d\u091f \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f + \u092c\u091f\u0928 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964","Tap to add alternate mobile":"\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u091c\u094b\u0921\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902","Tap to add email address":"\u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u091c\u094b\u0921\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902","Tap to call Drop Cars support (7200217986)":"Drop Cars \u0938\u092a\u094b\u0930\u094d\u091f \u0915\u094b \u0915\u0949\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902 (7200217986)","Tap to change your mobile number":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092c\u0926\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902","Tap to edit":"\u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902","Tap to select":"\u091a\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902","Tap to take photo":"\u092b\u094b\u091f\u094b \u0932\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902","Tariff Breakdown & Inclusions":"\u091f\u0948\u0930\u093f\u092b\u093c \u0935\u093f\u0935\u0930\u0923 \u0914\u0930 \u0936\u093e\u092e\u093f\u0932 \u091a\u0940\u091c\u093c\u0947\u0902",Tariffs:"\u091f\u0948\u0930\u093f\u092b\u093c","Tariffs \u2022 Start OTP \u2022 Tolls \u2022 Documents \u2022 ask anything":"\u091f\u0948\u0930\u093f\u092b\u093c \u2022 \u0936\u0941\u0930\u0941\u0906\u0924\u0940 OTP \u2022 \u091f\u094b\u0932 \u2022 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u2022 \u0915\u0941\u091b \u092d\u0940 \u092a\u0942\u091b\u0947\u0902","Tax Identification":"\u0915\u0930 \u092a\u0939\u091a\u093e\u0928","Terms & Conditions":"\u0928\u093f\u092f\u092e \u0914\u0930 \u0936\u0930\u094d\u0924\u0947\u0902","Terms & Policies":"\u0928\u093f\u092f\u092e \u0914\u0930 \u0928\u0940\u0924\u093f\u092f\u093e\u0901","Test 10s Alert HUD":"10 \u0938\u0947\u0915\u0902\u0921 \u0905\u0932\u0930\u094d\u091f HUD \u091f\u0947\u0938\u094d\u091f","Test Notification":"\u091f\u0947\u0938\u094d\u091f \u0928\u094b\u091f\u093f\u092b\u093c\u093f\u0915\u0947\u0936\u0928","Test notification sent!":"\u091f\u0947\u0938\u094d\u091f \u0928\u094b\u091f\u093f\u092b\u093c\u093f\u0915\u0947\u0936\u0928 \u092d\u0947\u091c \u0926\u093f\u092f\u093e \u0917\u092f\u093e!","Thank you for reaching out! Drop Cars Attachment Desk has logged your message. An executive will assist you shortly.":"\u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0927\u0928\u094d\u092f\u0935\u093e\u0926! Drop Cars \u0905\u091f\u0948\u091a\u092e\u0947\u0902\u091f \u0921\u0947\u0938\u094d\u0915 \u0928\u0947 \u0906\u092a\u0915\u093e \u0938\u0902\u0926\u0947\u0936 \u0926\u0930\u094d\u091c \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948\u0964 \u090f\u0915 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u091c\u0932\u094d\u0926 \u0939\u0940 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902\u0917\u0947\u0964","The bill could not be loaded. You can still continue to the last step.":"\u092c\u093f\u0932 \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964 \u0906\u092a \u0906\u0916\u093f\u0930\u0940 \u0915\u0926\u092e \u092a\u0930 \u0906\u0917\u0947 \u092c\u0922\u093c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","The booking has been cancelled.":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0930\u0926\u094d\u0926 \u0915\u0930 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964","The code is invalid or expired. Please try again.":"\u0915\u094b\u0921 \u0917\u0932\u0924 \u0939\u0948 \u092f\u093e \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","The customer reviews competing offers or proposes a counter-offer. You can accept, decline, or counter back directly.":"\u0917\u094d\u0930\u093e\u0939\u0915 \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u092a\u0930\u094d\u0927\u0940 \u0911\u092b\u093c\u0930 \u0926\u0947\u0916\u0924\u093e \u0939\u0948 \u092f\u093e \u091c\u0935\u093e\u092c\u0940 \u0911\u092b\u093c\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u0938\u0940\u0927\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930, \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u092f\u093e \u091c\u0935\u093e\u092c\u0940 \u0911\u092b\u093c\u0930 \u0926\u0947 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","The full yearly fee will be charged now from your wallet, and your plan switches to Yearly. Continue?":"\u092a\u0942\u0930\u093e \u0938\u093e\u0932\u093e\u0928\u093e \u0936\u0941\u0932\u094d\u0915 \u0905\u092d\u0940 \u0906\u092a\u0915\u0947 \u0935\u0949\u0932\u0947\u091f \u0938\u0947 \u0915\u091f\u0947\u0917\u093e \u0914\u0930 \u0906\u092a\u0915\u093e \u092a\u094d\u0932\u093e\u0928 \u0938\u093e\u0932\u093e\u0928\u093e \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964 \u0906\u0917\u0947 \u092c\u0922\u093c\u0947\u0902?","The moment the customer accepts your bid, an advance payment is collected, an official Order ID is generated, and the trip is automatically assigned to your driver in My Bookings!":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0947 \u0906\u092a\u0915\u0940 \u092c\u094b\u0932\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0940 \u0905\u0917\u094d\u0930\u093f\u092e \u092d\u0941\u0917\u0924\u093e\u0928 \u0932\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0911\u0930\u094d\u0921\u0930 ID \u092c\u0928\u0924\u0940 \u0939\u0948 \u0914\u0930 \u091f\u094d\u0930\u093f\u092a \u0905\u092a\u0928\u0947 \u0906\u092a \u0906\u092a\u0915\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u094b \u092e\u0947\u0930\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u092e\u0947\u0902 \u0905\u0938\u093e\u0907\u0928 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948!","The trip shows this name as the driver. Tap the pencil to enter your own name instead of the fleet name.":"\u091f\u094d\u0930\u093f\u092a \u092e\u0947\u0902 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092f\u0939\u0940 \u0928\u093e\u092e \u0926\u093f\u0916\u0924\u093e \u0939\u0948\u0964 \u092b\u094d\u0932\u0940\u091f \u0915\u0947 \u0928\u093e\u092e \u0915\u0940 \u091c\u0917\u0939 \u0905\u092a\u0928\u093e \u0928\u093e\u092e \u0932\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0947\u0902\u0938\u093f\u0932 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964","These are already paid through the fare. Do not ask the customer for them again.":"\u092f\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0915\u093f\u0930\u093e\u092f\u0947 \u092e\u0947\u0902 \u091a\u0941\u0915\u093e\u090f \u091c\u093e \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964 \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947 \u0926\u094b\u092c\u093e\u0930\u093e \u0928 \u092e\u093e\u0901\u0917\u0947\u0902\u0964","These are charged on actuals, on top of the trip fare. Enter the amount you collected from the customer for each one. Keep 0 if nothing was collected.":"\u092f\u0947 \u0905\u0938\u0932\u0940 \u0916\u0930\u094d\u091a \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, \u091f\u094d\u0930\u093f\u092a \u0915\u093f\u0930\u093e\u092f\u0947 \u0915\u0947 \u090a\u092a\u0930 \u0935\u0938\u0942\u0932\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u0930 \u090f\u0915 \u0915\u0947 \u0932\u093f\u090f \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947 \u0935\u0938\u0942\u0932\u0940 \u0930\u093e\u0936\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964 \u0915\u0941\u091b \u0928 \u0932\u093f\u092f\u093e \u0939\u094b \u0924\u094b 0 \u0930\u0916\u0947\u0902\u0964","This account is blocked.":"\u092f\u0939 \u0916\u093e\u0924\u093e \u092c\u094d\u0932\u0949\u0915 \u0939\u0948\u0964","This booking is reserved for Trusted Partners for the next {0}. Upgrade to a Trusted Partner to accept bookings like this right now.":"\u092f\u0939 \u092c\u0941\u0915\u093f\u0902\u0917 \u0905\u0917\u0932\u0947 {0} \u0924\u0915 \u091f\u094d\u0930\u0938\u094d\u091f\u0947\u0921 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u0906\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0964 \u0910\u0938\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u0905\u092d\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u094d\u0930\u0938\u094d\u091f\u0947\u0921 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0947\u0902\u0964","This booking requires a verified":"\u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u091a\u093e\u0939\u093f\u090f","This booking requires at least {0} passenger seats for {1}. {2} has {3} seats. Would you like to send this exception request to the vendor for approval?":"\u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f {1} \u0915\u0947 \u0932\u093f\u090f \u0915\u092e \u0938\u0947 \u0915\u092e {0} \u092f\u093e\u0924\u094d\u0930\u0940 \u0938\u0940\u091f\u0947\u0902 \u091a\u093e\u0939\u093f\u090f\u0964 {2} \u092e\u0947\u0902 {3} \u0938\u0940\u091f\u0947\u0902 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u093e \u092f\u0939 \u0905\u092a\u0935\u093e\u0926 \u0905\u0928\u0941\u0930\u094b\u0927 \u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u0935\u0947\u0902\u0921\u0930 \u0915\u094b \u092d\u0947\u091c\u0947\u0902?","This booking was cancelled.":"\u092f\u0939 \u092c\u0941\u0915\u093f\u0902\u0917 \u0930\u0926\u094d\u0926 \u0939\u094b \u0917\u0908\u0964","This is a test notification":"\u092f\u0939 \u090f\u0915 \u091f\u0947\u0938\u094d\u091f \u0928\u094b\u091f\u093f\u092b\u093c\u093f\u0915\u0947\u0936\u0928 \u0939\u0948","This is different from the bill. It is saved as you entered it and Drop Cars may check it.":"\u092f\u0939 \u092c\u093f\u0932 \u0938\u0947 \u0905\u0932\u0917 \u0939\u0948\u0964 \u092f\u0939 \u0935\u0948\u0938\u0947 \u0939\u0940 \u0938\u0947\u0935 \u0939\u094b\u0917\u093e \u091c\u0948\u0938\u093e \u0906\u092a\u0928\u0947 \u0926\u0930\u094d\u091c \u0915\u093f\u092f\u093e, \u0914\u0930 Drop Cars \u0907\u0938\u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964","This is shown to the booking owner and the customer as the driver of the trip.":"\u092f\u0939 \u092c\u0941\u0915\u093f\u0902\u0917 \u092e\u093e\u0932\u093f\u0915 \u0914\u0930 \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094b \u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0926\u093f\u0916\u0947\u0917\u093e\u0964","This licence number is already registered. Please use a different licence number.":"\u092f\u0939 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0928\u0902\u092c\u0930 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0926\u0942\u0938\u0930\u093e \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0928\u0902\u092c\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902\u0964","This mobile number (+91 {0}) is registered as a Duty Driver account. Would you like to switch to Duty Driver login?":"\u092f\u0939 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 (+91 {0}) \u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0916\u093e\u0924\u0947 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0932\u0949\u0917\u093f\u0928 \u092a\u0930 \u091c\u093e\u090f\u0901?","This mobile number (+91 {0}) is registered as a Fleet Owner account. Would you like to switch to Fleet Owner login?":"\u092f\u0939 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 (+91 {0}) \u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u0916\u093e\u0924\u0947 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u0932\u0949\u0917\u093f\u0928 \u092a\u0930 \u091c\u093e\u090f\u0901?","This mobile number is already registered for a driver. Please use a different mobile number.":"\u092f\u0939 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0939\u0932\u0947 \u0938\u0947 \u090f\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0932\u093f\u090f \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0926\u0942\u0938\u0930\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902\u0964","This mobile number isn't registered as a duty driver yet. Ask your fleet owner to add you in their app.":"\u092f\u0939 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0905\u092d\u0940 \u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0905\u092a\u0928\u0947 \u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u0938\u0947 \u0909\u0928\u0915\u0947 \u0910\u092a \u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u091c\u094b\u0921\u093c\u0928\u0947 \u0915\u094b \u0915\u0939\u0947\u0902\u0964","This mobile number isn't registered yet as a fleet owner.":"\u092f\u0939 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0905\u092d\u0940 \u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964","This Month":"\u0907\u0938 \u092e\u0939\u0940\u0928\u0947","This screen doesn't exist.":"\u092f\u0939 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u094c\u091c\u0942\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964","This trip broadcasts to nearby drivers - whoever accepts earns the \u20b9":"\u092f\u0939 \u091f\u094d\u0930\u093f\u092a \u092a\u093e\u0938 \u0915\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u0938\u093e\u0930\u093f\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948 - \u091c\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0917\u093e \u0935\u0939 \u0915\u092e\u093e\u090f\u0917\u093e \u20b9","This trip is completed - chat is closed.":"\u092f\u0939 \u091f\u094d\u0930\u093f\u092a \u092a\u0942\u0930\u0940 \u0939\u094b \u0917\u0908 - \u091a\u0948\u091f \u092c\u0902\u0926 \u0939\u0948\u0964","This vehicle has no vacant cities set. Tap below to select where it's waiting for a trip.":"\u0907\u0938 \u0917\u093e\u0921\u093c\u0940 \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u0936\u0939\u0930 \u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u092f\u0939 \u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u093e\u0901 \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948, \u092f\u0939 \u091a\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0940\u091a\u0947 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964","THIS WEEK":"\u0907\u0938 \u0938\u092a\u094d\u0924\u093e\u0939","THIS WEEK DAILY BREAKDOWN":"\u0907\u0938 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u093e \u0926\u0948\u0928\u093f\u0915 \u092c\u094d\u092f\u094b\u0930\u093e",To:"\u0924\u0915","to accept":"\u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f","to link an email address for password reset.":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f \u0915\u0947 \u0932\u093f\u090f \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u091c\u094b\u0921\u093c\u0928\u0947 \u0939\u0947\u0924\u0941\u0964","to My Fleet":"\u092e\u0947\u0930\u0947 \u092b\u094d\u0932\u0940\u091f \u092e\u0947\u0902","to post this booking. It is only HELD (not charged) - returned when the trip completes or if you cancel the booking.":"\u092f\u0939 \u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u0939\u094b\u0932\u094d\u0921 \u0939\u0948 (\u0915\u091f\u0924\u093e \u0928\u0939\u0940\u0902) - \u091f\u094d\u0930\u093f\u092a \u092a\u0942\u0930\u0940 \u0939\u094b\u0928\u0947 \u092a\u0930 \u092f\u093e \u092c\u0941\u0915\u093f\u0902\u0917 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0932\u094c\u091f \u0906\u0924\u093e \u0939\u0948\u0964","to Wallet to Accept":"\u0935\u0949\u0932\u0947\u091f \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u0947\u0902 \u0914\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902","to your selected driver and car.":"\u0906\u092a\u0915\u0947 \u091a\u0941\u0928\u0947 \u0939\u0941\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0917\u093e\u0921\u093c\u0940 \u0915\u094b\u0964","to your vehicle.":"\u0906\u092a\u0915\u0940 \u0917\u093e\u0921\u093c\u0940 \u0915\u094b\u0964","Today Only":"\u0938\u093f\u0930\u094d\u092b\u093c \u0906\u091c","Token verified successfully":"\u091f\u094b\u0915\u0928 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0939\u0941\u0906","Toll & Parking":"\u091f\u094b\u0932 \u0914\u0930 \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917","Toll, parking or any charge collected outside the bill. 0 if none.":"\u092c\u093f\u0932 \u0915\u0947 \u092c\u093e\u0939\u0930 \u0935\u0938\u0942\u0932\u093e \u0917\u092f\u093e \u091f\u094b\u0932, \u092a\u093e\u0930\u094d\u0915\u093f\u0902\u0917 \u092f\u093e \u0915\u094b\u0908 \u092d\u0940 \u0936\u0941\u0932\u094d\u0915\u0964 \u0928 \u093
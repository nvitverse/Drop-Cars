e\u0c40\u0c15\u0c41 \u0c32\u0c47\u0c35\u0c41","You drove {0} km, but this route is about {1} km. Please tell us why. The trip is not stopped - the booking owner and Drop Cars will see your reason.":"\u0c2e\u0c40\u0c30\u0c41 {0} \u0c15\u0c3f.\u0c2e\u0c40. \u0c28\u0c21\u0c3f\u0c2a\u0c3e\u0c30\u0c41, \u0c15\u0c3e\u0c28\u0c40 \u0c08 \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c02 \u0c38\u0c41\u0c2e\u0c3e\u0c30\u0c41 {1} \u0c15\u0c3f.\u0c2e\u0c40. \u0c15\u0c3e\u0c30\u0c23\u0c02 \u0c1a\u0c46\u0c2a\u0c4d\u0c2a\u0c02\u0c21\u0c3f. \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c06\u0c17\u0c26\u0c41 - \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c2f\u0c1c\u0c2e\u0c3e\u0c28\u0c3f, Drop Cars \u0c2e\u0c40 \u0c15\u0c3e\u0c30\u0c23\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c1a\u0c42\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41.","You earned":"\u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c02\u0c2a\u0c3e\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28\u0c26\u0c3f","You have a car that fits this":"\u0c26\u0c40\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c2f\u0c47 \u0c15\u0c3e\u0c30\u0c41 \u0c2e\u0c40 \u0c35\u0c26\u0c4d\u0c26 \u0c09\u0c02\u0c26\u0c3f","You have already accepted {0} bookings. Please assign driver and car to your accepted bookings before accepting new ones.":"\u0c2e\u0c40\u0c30\u0c41 \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 {0} \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c30\u0c41. \u0c15\u0c4a\u0c24\u0c4d\u0c24\u0c35\u0c3f \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d & \u0c15\u0c3e\u0c30\u0c41 \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","You have an assigned trip active or scheduled within 1 hour. You must remain On Duty until the trip is completed.":"1 \u0c17\u0c02\u0c1f\u0c32\u0c4
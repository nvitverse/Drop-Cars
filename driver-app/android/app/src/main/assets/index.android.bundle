a6\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb0\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)","Fare Price Increased! \u26a1":"\u0ca6\u0cb0 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbe\u0c97\u0cbf\u0ca6\u0cc6! \u26a1","Final Agreed Fare":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0ca6 \u0ca6\u0cb0","Final amount: \u20b9":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0cae\u0cca\u0ca4\u0ccd\u0ca4: \u20b9","Final fare includes all trip charges. No extra km rate deductions.":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0ca6\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb5\u0cc6. \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0c95\u0cbf.\u0cae\u0cc0. \u0ca6\u0cb0 \u0c95\u0ca1\u0cbf\u0ca4 \u0c87\u0cb2\u0ccd\u0cb2.","Final trip amount (customer)":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cca\u0ca4\u0ccd\u0ca4 (\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95)","Fitness (FC)":"\u0cab\u0cbf\u0c9f\u0ccd\u200c\u0ca8\u0cc6\u0cb8\u0ccd (FC)","Fleet Car":"\u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0c95\u0cbe\u0cb0\u0cc1","Fleet Driver Account":"\u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c96\u0cbe\u0ca4\u0cc6","Fleet owner":"\u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0\u0cc1","Fleet owner on duty":"\u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0\u0cc1","Fleet Owner Portal":"\u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0 \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd","Fleet Partner:":"\u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd:","Fleet Status":"\u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf","Fleet Vacant Cities":"\u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0c96\u0cbe\u0cb2\u0cbf \u0ca8\u0c97\u0cb0\u0c97\u0cb3\u0cc1","For password reset - verified with a code":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cb0\u0cc1\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0c97\u0cc6 - \u0c95\u0ccb\u0ca1\u0ccd\u200c\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","For the ~{0} km route between {1} and {2}, the maximum seat contribution cap is \u20b9{3} to keep seat sharing fair and affordable.":"{1} \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 {2} \u0ca8\u0ca1\u0cc1\u0cb5\u0cbf\u0ca8 ~{0} \u0c95\u0cbf.\u0cae\u0cc0. \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0c95\u0ccd\u0c95\u0cc6, \u0cb8\u0cc0\u0c9f\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cc6 \u0ca8\u0ccd\u0caf\u0cbe\u0caf\u0caf\u0cc1\u0ca4 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c95\u0ca1\u0cbf\u0cae\u0cc6 \u0cb5\u0cc6\u0c9a\u0ccd\u0c9a\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cb2\u0cc1 \u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0 \u0cb8\u0cc0\u0c9f\u0cc1 \u0caa\u0cbe\u0cb2\u0cc1 \u20b9{3}.",From:"\u0c87\u0c82\u0ca6","Front Side":"\u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97","Front side of Aadhaar":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97","Front Side Photo":"\u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb","FRONT SIDE PHOTO":"\u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb","Front View Photo":"\u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0ca8\u0ccb\u0c9f \u0cab\u0ccb\u0c9f\u0ccb","full \u20b9{0}":"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u20b9{0}","Full Name":"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","Full Name (Per Govt ID)":"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 (\u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cc0\u0c9f\u0cbf\u0caf\u0c82\u0ca4\u0cc6)",Gallery:"\u0c97\u0ccd\u0caf\u0cbe\u0cb2\u0cb0\u0cbf","GENERATING...":"\u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Get help and support":"\u0cb8\u0cb9\u0cbe\u0caf & \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0caa\u0ca1\u0cc6\u0caf\u0cbf\u0cb0\u0cbf","Get notified about new trips":"\u0cb9\u0cca\u0cb8 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0caa\u0ca1\u0cc6\u0caf\u0cbf\u0cb0\u0cbf","Go Off Duty":"\u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0ca8\u0cbf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf","Go on duty & execute assigned rides":"\u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf\u0c97\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf\u0ca6 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cbf","Go On Duty for Live Bookings":"\u0cb2\u0cc8\u0cb5\u0ccd \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf\u0c97\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf","Go online to start receiving and accepting new duty bookings.":"\u0cb9\u0cca\u0cb8 \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb9\u0ccb\u0c97\u0cbf.","Go to Booking & Accept":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf","Go to home screen!":"\u0cae\u0cc1\u0c96\u0caa\u0cc1\u0c9f\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf!","Go to the duty-driver side of the app":"\u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0ca8 \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cad\u0cbe\u0c97\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf","Got It":"\u0c85\u0cb0\u0ccd\u0ca5\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1","Got It, Refresh List":"\u0c85\u0cb0\u0ccd\u0ca5\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1, \u0caa\u0c9f\u0ccd\u0c9f\u0cbf \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Got it!":"\u0c85\u0cb0\u0ccd\u0ca5\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1!","Got It!":"\u0c85\u0cb0\u0ccd\u0ca5\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1!","Govt Photo ID Verification":"\u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0cab\u0ccb\u0c9f\u0ccb \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6","Guest Rider":"\u0c85\u0ca4\u0cbf\u0ca5\u0cbf \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95",Hatchback:"\u0cb9\u0ccd\u0caf\u0cbe\u0c9a\u0ccd\u200c\u0cac\u0ccd\u0caf\u0cbe\u0c95\u0ccd","Hatchback (Swift, i10, WagonR)":"\u0cb9\u0ccd\u0caf\u0cbe\u0c9a\u0ccd\u200c\u0cac\u0ccd\u0caf\u0cbe\u0c95\u0ccd (Swift, i10, WagonR)","Have a referral code? Enter it here":"\u0cb0\u0cc6\u0cab\u0cb0\u0cb2\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0c87\u0ca6\u0cc6\u0caf\u0cc7? \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Have a referrer code?":"\u0cb0\u0cc6\u0cab\u0cb0\u0cb0\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0c87\u0ca6\u0cc6\u0caf\u0cc7?","Help Bot":"\u0cb9\u0cc6\u0cb2\u0ccd\u0caa\u0ccd \u0cac\u0cbe\u0c9f\u0ccd","HELP BOT":"\u0cb9\u0cc6\u0cb2\u0ccd\u0caa\u0ccd \u0cac\u0cbe\u0c9f\u0ccd","Help Bot for instant duty answers, plus a real chat with whoever posted each trip (a vendor, another fleet owner, or Drop Cars Admin) and quick ways to reach or call the customer.":"\u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb9\u0cc6\u0cb2\u0ccd\u0caa\u0ccd \u0cac\u0cbe\u0c9f\u0ccd, \u0c9c\u0cca\u0ca4\u0cc6\u0c97\u0cc6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0cb5\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 (\u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd, \u0c87\u0ca8\u0ccd\u0ca8\u0cca\u0cac\u0ccd\u0cac \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cae\u0cbe\u0cb2\u0cc0\u0c95 \u0c85\u0ca5\u0cb5\u0cbe Drop Cars \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd) \u0ca8\u0cc7\u0cb0 \u0c9a\u0cbe\u0c9f\u0ccd, \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0ca6\u0cbe\u0cb0\u0cbf\u0c97\u0cb3\u0cc1.","Help Bot is typing...":"\u0cb9\u0cc6\u0cb2\u0ccd\u0caa\u0ccd \u0cac\u0cbe\u0c9f\u0ccd \u0c9f\u0cc8\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Help Bot, trip contacts & support":"\u0cb9\u0cc6\u0cb2\u0ccd\u0caa\u0ccd \u0cac\u0cbe\u0c9f\u0ccd, \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0c97\u0cb3\u0cc1 & \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd","Help Center":"\u0cb8\u0cb9\u0cbe\u0caf \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0","Hi, I would like to request Booking #DC{0} with my {1} ({2}). Please approve if suitable.":"\u0cb9\u0cbe\u0caf\u0ccd, \u0ca8\u0ca8\u0ccd\u0ca8 {1} ({2}) \u0c9c\u0cca\u0ca4\u0cc6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd #DC{0} \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6. \u0cb8\u0cc2\u0c95\u0ccd\u0ca4\u0cb5\u0cbe\u0ca6\u0cb0\u0cc6 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.","Hidden until a few hours before pickup. Turn on to show it to the driver now.":"\u0caa\u0cbf\u0c95\u0caa\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0c97\u0c82\u0c9f\u0cc6 \u0cae\u0cca\u0ca6\u0cb2\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0cae\u0cb0\u0cc6\u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c88\u0c97\u0cb2\u0cc7 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cc6 \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Hide details":"\u0cb5\u0cbf\u0cb5\u0cb0 \u0cae\u0cb0\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","Hide fare details":"\u0ca6\u0cb0 \u0cb5\u0cbf\u0cb5\u0cb0 \u0cae\u0cb0\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","High Customer Rating":"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd","Hill Charges":"\u0cac\u0cc6\u0c9f\u0ccd\u0c9f\u0ca6 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95","Hills Charges":"\u0cac\u0cc6\u0c9f\u0ccd\u0c9f\u0ca6 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1","Holder Name:":"\u0c96\u0cbe\u0ca4\u0cc6\u0ca6\u0cbe\u0cb0:","Hourly / Local":"\u0c97\u0c82\u0c9f\u0cc6\u0caf / \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf","House/Door No, Street name":"\u0cae\u0ca8\u0cc6/\u0cac\u0cbe\u0c97\u0cbf\u0cb2\u0cc1 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6, \u0cb0\u0cb8\u0ccd\u0ca4\u0cc6 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","How do you want to add this photo?":"\u0c88 \u0cab\u0ccb\u0c9f\u0ccb\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf?","How it works:":"\u0c87\u0ca6\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0c95\u0cc6\u0cb2\u0cb8 \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6:","How was the customer?":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cc1 \u0cb9\u0cc7\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc1?","hrs)":"\u0c97\u0c82\u0c9f\u0cc6)","I agree to the Booking Terms & Cancellation Penalty Policy":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 & \u0cb0\u0ca6\u0ccd\u0ca6\u0ca4\u0cbf \u0ca6\u0c82\u0ca1 \u0ca8\u0cc0\u0ca4\u0cbf\u0c97\u0cc6 \u0c92\u0caa\u0ccd\u0caa\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6","I'll try to answer instantly first - type your question, or tap an option below. Only 'Talk to a person' goes to a human, and that's reviewed, not instant.":"\u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca4\u0c95\u0ccd\u0cb7\u0ca3 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6 - \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6 \u0c9f\u0cc8\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf. '\u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0caf\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cae\u0cbe\u0ca4\u0ca8\u0cbe\u0ca1\u0cbf' \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cae\u0ca8\u0cc1\u0cb7\u0ccd\u0caf\u0cb0\u0cbf\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0c85\u0ca6\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0ca4\u0c95\u0ccd\u0cb7\u0ca3\u0cb5\u0cb2\u0ccd\u0cb2.","Identity Verification Failed?":"\u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc7?","IFSC Code:":"IFSC \u0c95\u0ccb\u0ca1\u0ccd:",Ignore:"\u0ca8\u0cbf\u0cb0\u0ccd\u0cb2\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cbf","Image URLs not received from server":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb URL \u0c97\u0cb3\u0cc1 \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","In-App Chat":"\u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c9a\u0cbe\u0c9f\u0ccd",Included:"\u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0cc6","Included in the fare":"\u0ca6\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0cc6","Included in the trip fare":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca6\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0cc6","Incorrect password. Please try again.":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca4\u0caa\u0ccd\u0caa\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Increase Booking Fare":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca6\u0cb0 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0cb8\u0cbf","Increase Fare":"\u0ca6\u0cb0 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0cb8\u0cbf","Increases fare by":"\u0ca6\u0cb0 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","Innova / Crysta":"Innova / Crysta","Innova / Crysta / Hycross":"Innova / Crysta / Hycross","Instant dispatch lead with competitive driver counter-bidding enabled.":"\u0caa\u0cc8\u0caa\u0ccb\u0c9f\u0cbf\u0caf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0ca4\u0cbf-\u0cac\u0cbf\u0ca1\u0ccd\u0ca1\u0cbf\u0c82\u0c97\u0ccd\u200c\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd.","Instant Local Dispatch Mode":"\u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd \u0cae\u0ccb\u0ca1\u0ccd","Instant Release (\u0b89\u0b9f\u0ba9\u0b9f\u0bbf \u0bb5\u0bbf\u0b9f\u0bc1\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1)":"\u0ca4\u0c95\u0ccd\u0cb7\u0ca3 \u0cac\u0cbf\u0ca1\u0cc1\u0c97\u0ca1\u0cc6","Insufficient Redeemable Balance":"\u0cb8\u0cbe\u0c95\u0cb7\u0ccd\u0c9f\u0cc1 \u0cb0\u0cbf\u0ca1\u0cc0\u0cae\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6 \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0c87\u0cb2\u0ccd\u0cb2","Interior Photo Required":"\u0c92\u0cb3\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0cac\u0cc7\u0c95\u0cc1","Invalid car ID received from server":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0c95\u0cbe\u0cb0\u0cc1 ID \u0cac\u0c82\u0ca6\u0cbf\u0ca6\u0cc6","Invalid Mobile":"\u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd","Invalid mobile number or password":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0c
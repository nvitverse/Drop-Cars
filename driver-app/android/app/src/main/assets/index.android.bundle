24\u0947 \u0939\u0948\u0902\u0964 \u0935\u0949\u0932\u0947\u091f \u092e\u0947\u0902 \u0915\u092e \u0938\u0947 \u0915\u092e \u20b9{1} \u092c\u0948\u0932\u0947\u0902\u0938 \u0930\u0939\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964",Membership:"\u0938\u0926\u0938\u094d\u092f\u0924\u093e","MESSAGE ABOUT A TRIP":"\u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0938\u0902\u0926\u0947\u0936 \u092d\u0947\u091c\u0947\u0902","Microphone access needed":"\u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u091c\u093c\u0930\u0942\u0930\u0940","Minimum Year":"\u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0935\u0930\u094d\u0937","Missing Driver":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0928\u0939\u0940\u0902 \u091a\u0941\u0928\u093e","Missing Fields":"\u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u0927\u0942\u0930\u0940 \u0939\u0948","Missing required Razorpay parameters for verification":"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u0932\u093f\u090f \u091c\u093c\u0930\u0942\u0930\u0940 Razorpay \u092a\u0948\u0930\u093e\u092e\u0940\u091f\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0947","Missing Route":"\u0930\u0942\u091f \u0928\u0939\u0940\u0902 \u091a\u0941\u0928\u093e","Missing Vehicle":"\u0917\u093e\u0921\u093c\u0940 \u0928\u0939\u0940\u0902 \u091a\u0941\u0928\u0940","Mobile number":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930","Mobile number not found. Please check your mobile number or sign up first.":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964 \u0905\u092a\u0928\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u091c\u093e\u0901\u091a\u0947\u0902 \u092f\u093e \u092a\u0939\u0932\u0947 \u0938\u093e\u0907\u0928 \u0905\u092a \u0915\u0930\u0947\u0902\u0964","Mobile number updated. Use the new number next time you log in.":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0905\u092a\u0921\u0947\u091f \u0939\u094b \u0917\u092f\u093e\u0964 \u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u0928\u090f \u0928\u0902\u092c\u0930 \u0938\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902\u0964","Money you collected":"\u0906\u092a\u0915\u093e \u0935\u0938\u0942\u0932\u093e \u0939\u0941\u0906 \u092a\u0948\u0938\u093e","Monthly Plan - active":"\u092e\u093e\u0938\u093f\u0915 \u092a\u094d\u0932\u093e\u0928 - \u0938\u0915\u094d\u0930\u093f\u092f","Multi-City":"\u092e\u0932\u094d\u091f\u0940-\u0938\u093f\u091f\u0940","Multi-City (One Way)":"\u092e\u0932\u094d\u091f\u0940-\u0938\u093f\u091f\u0940 (\u0935\u0928 \u0935\u0947)","Must assign driver & vehicle within 15 mins to avoid cancellation penalty.":"\u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u093e \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 15 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0917\u093e\u0921\u093c\u0940 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964",Mute:"\u092e\u094d\u092f\u0942\u091f \u0915\u0930\u0947\u0902","Mute Notifications":"\u0938\u0942\u091a\u0928\u093e\u090f\u0901 \u092e\u094d\u092f\u0942\u091f \u0915\u0930\u0947\u0902",Muted:"\u092e\u094d\u092f\u0942\u091f \u0939\u0948","My Bookings - Bookings You Posted":"\u092e\u0947\u0930\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 - \u091c\u094b \u0906\u092a\u0928\u0947 \u092a\u094b\u0938\u094d\u091f \u0915\u0940\u0902","My Details":"\u092e\u0947\u0930\u0947 \u0935\u093f\u0935\u0930\u0923","My Documents & Verification":"\u092e\u0947\u0930\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0914\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u0928","My Performance":"\u092e\u0947\u0930\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928","My Profile":"\u092e\u0947\u0930\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932","My Rides - Drop Cars Trips":"\u092e\u0947\u0930\u0940 \u091f\u094d\u0930\u093f\u092a - Drop Cars \u091f\u094d\u0930\u093f\u092a","My Trips":"\u092e\u0947\u0930\u0940 \u091f\u094d\u0930\u093f\u092a","Name as per bank records":"\u092c\u0948\u0902\u0915 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0928\u093e\u092e","Name per bank record":"\u092c\u0948\u0902\u0915 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u092e\u0947\u0902 \u0928\u093e\u092e","Need assistance with this booking? You can contact Drop Cars Support Helpline directly.":"\u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u092e\u0947\u0902 \u092e\u0926\u0926 \u091a\u093e\u0939\u093f\u090f? \u0906\u092a Drop Cars \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0938\u0947 \u0938\u0940\u0927\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Need Help":"\u092e\u0926\u0926 \u091a\u093e\u0939\u093f\u090f","Need Help / Contact Support":"\u092e\u0926\u0926 \u091a\u093e\u0939\u093f\u090f / \u0938\u092a\u094b\u0930\u094d\u091f \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902","Need Help?":"\u092e\u0926\u0926 \u091a\u093e\u0939\u093f\u090f?",Needs:"\u091c\u093c\u0930\u0942\u0930\u0924","Needs {0} \u2022 View Options":"{0} \u091a\u093e\u0939\u093f\u090f \u2022 \u0935\u093f\u0915\u0932\u094d\u092a \u0926\u0947\u0916\u0947\u0902","Needs a {0} ({1} Seats)":"{0} ({1} \u0938\u0940\u091f) \u091a\u093e\u0939\u093f\u090f","Needs Review":"\u0938\u092e\u0940\u0915\u094d\u0937\u093e \u091c\u093c\u0930\u0942\u0930\u0940","Net Earning From Posting":"\u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0938\u0947 \u0936\u0941\u0926\u094d\u0927 \u0915\u092e\u093e\u0908","Network Error":"\u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0924\u094d\u0930\u0941\u091f\u093f","Network error while uploading. Please check your connection and try again.":"\u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0924\u094d\u0930\u0941\u091f\u093f\u0964 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0901\u091a\u0915\u0930 \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Network error. Please check your internet connection.":"\u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0924\u094d\u0930\u0941\u091f\u093f\u0964 \u0905\u092a\u0928\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0901\u091a\u0947\u0902\u0964","Never miss a booking":"\u0915\u094b\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u0928 \u091b\u094b\u0921\u093c\u0947\u0902","Never miss a booking again":"\u0905\u092c \u0915\u094b\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u0928 \u091b\u094b\u0921\u093c\u0947\u0902","New 10-Digit Primary Mobile Number":"\u0928\u092f\u093e 10 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930","New Booking Bubble":"\u0928\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u092c\u092c\u0932","New bookings in your city will automatically appear here in real-time":"\u0906\u092a\u0915\u0947 \u0936\u0939\u0930 \u0915\u0940 \u0928\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u0930\u093f\u092f\u0932-\u091f\u093e\u0907\u092e \u092e\u0947\u0902 \u092f\u0939\u093e\u0901 \u0905\u092a\u0928\u0947 \u0906\u092a \u0926\u093f\u0916\u0947\u0902\u0917\u0940","New Email Address":"\u0928\u092f\u093e \u0908\u092e\u0947\u0932 \u092a\u0924\u093e","New Fleet?":"\u0928\u090f \u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u0939\u0948\u0902?","New Mobile Number":"\u0928\u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930","New Password":"\u0928\u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921","Next 24 Hrs":"\u0905\u0917\u0932\u0947 24 \u0918\u0902\u091f\u0947","Next 3 Days":"\u0905\u0917\u0932\u0947 3 \u0926\u093f\u0928","Next 7 Days":"\u0905\u0917\u0932\u0947 7 \u0926\u093f\u0928","Night Allowance":"\u0930\u093e\u0924 \u0915\u093e \u092d\u0924\u094d\u0924\u093e","Night Charges":"\u0930\u093e\u0924 \u0915\u093e \u0936\u0941\u0932\u094d\u0915",No:"\u0928\u0939\u0940\u0902","No {0} Upcoming Rides":"{0} \u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u091f\u094d\u0930\u093f\u092a \u0928\u0939\u0940\u0902 \u0939\u0948\u0902","No access token received from server":"\u0938\u0930\u094d\u0935\u0930 \u0938\u0947 \u090f\u0915\u094d\u0938\u0947\u0938 \u091f\u094b\u0915\u0928 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No active assignment found for this booking.":"\u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f \u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964","No active trips right now - once you accept a booking, its Vendor/Owner chat and the customer's call option will appear here.":"\u0905\u092d\u0940 \u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f \u091f\u094d\u0930\u093f\u092a \u0928\u0939\u0940\u0902 \u0939\u0948 - \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0940 \u0909\u0938\u0915\u0947 \u0935\u0947\u0902\u0921\u0930/\u092e\u093e\u0932\u093f\u0915 \u0915\u0940 \u091a\u0948\u091f \u0914\u0930 \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094b \u0915\u0949\u0932 \u0915\u093e \u0935\u093f\u0915\u0932\u094d\u092a \u092f\u0939\u093e\u0901 \u0926\u093f\u0916\u0947\u0917\u093e\u0964","No address registered":"\u092a\u0924\u093e \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0939\u0948","No authentication token found":"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u091f\u094b\u0915\u0928 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No authentication token found. Please login first.":"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u091f\u094b\u0915\u0928 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964 \u092a\u0939\u0932\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902\u0964","No available drivers found. Add a driver first in My Drivers.":"\u0915\u094b\u0908 \u0909\u092a\u0932\u092c\u094d\u0927 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964 \u092a\u0939\u0932\u0947 \u092e\u0947\u0930\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092e\u0947\u0902 \u090f\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u091c\u094b\u0921\u093c\u0947\u0902\u0964","No available drivers found. Please complete verification or add a driver first.":"\u0915\u094b\u0908 \u0909\u092a\u0932\u092c\u094d\u0927 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902 \u092f\u093e \u092a\u0939\u0932\u0947 \u090f\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u091c\u094b\u0921\u093c\u0947\u0902\u0964","No available vehicles found. Add a car first in My Cabs.":"\u0915\u094b\u0908 \u0909\u092a\u0932\u092c\u094d\u0927 \u0917\u093e\u0921\u093c\u0940 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940\u0964 \u092a\u0939\u0932\u0947 \u092e\u0947\u0930\u0940 \u0915\u0948\u092c \u092e\u0947\u0902 \u090f\u0915 \u0917\u093e\u0921\u093c\u0940 \u091c\u094b\u0921\u093c\u0947\u0902\u0964","No cars available. Add vehicles in My Cars.":"\u0915\u094b\u0908 \u0917\u093e\u0921\u093c\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092e\u0947\u0930\u0940 \u0917\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0917\u093e\u0921\u093c\u093f\u092f\u093e\u0901 \u091c\u094b\u0921\u093c\u0947\u0902\u0964","No chats match your search.":"\u0906\u092a\u0915\u0940 \u0916\u094b\u091c \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0924\u0940 \u0915\u094b\u0908 \u091a\u0948\u091f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964","No chats yet":"\u0905\u092d\u0940 \u0915\u094b\u0908 \u091a\u0948\u091f \u0928\u0939\u0940\u0902","No Completed Rides Yet":"\u0905\u092d\u0940 \u0915\u094b\u0908 \u092a\u0942\u0930\u0940 \u0939\u0941\u0908 \u091f\u094d\u0930\u093f\u092a \u0928\u0939\u0940\u0902","No Confirmed Trips Yet":"\u0905\u092d\u0940 \u0915\u094b\u0908 \u092a\u0915\u094d\u0915\u0940 \u091f\u094d\u0930\u093f\u092a \u0928\u0939\u0940\u0902","No driver & vehicle assigned yet.":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0917\u093e\u0921\u093c\u0940 \u0905\u092d\u0940 \u0905\u0938\u093e\u0907\u0928 \u0928\u0939\u0940\u0902 \u0939\u0941\u090f\u0964","No driver logged in":"\u0915\u094b\u0908 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0932\u0949\u0917\u093f\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948","No drivers available.":"\u0915\u094b\u0908 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902\u0964","No drivers registered. Add a driver first in Drivers tab.":"\u0915\u094b\u0908 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092a\u0939\u0932\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u091f\u0948\u092c \u092e\u0947\u0902 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u091c\u094b\u0921\u093c\u0947\u0902\u0964","No exact cached match for \"":"\u0915\u0948\u0936 \u092e\u0947\u0902 \u0920\u0940\u0915 \u092e\u093f\u0932\u0924\u093e \u092a\u0930\u093f\u0923\u093e\u092e \u0928\u0939\u0940\u0902: \"","No expiry set":"\u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0924\u093f\u0925\u093f \u0924\u092f \u0928\u0939\u0940\u0902 \u0939\u0948","No External Dealing Policy:":"\u092c\u093e\u0939\u0930 \u0938\u0940\u0927\u093e \u0932\u0947\u0928-\u0926\u0947\u0928 \u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0928\u0940\u0924\u093f:","No Fleet Cars Found":"\u0915\u094b\u0908 \u092b\u094d\u0932\u0940\u091f \u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940","No number":"\u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948","No OTP was requested yet. Please request a code first.":"\u0905\u092d\u0940 \u0924\u0915 OTP \u0928\u0939\u0940\u0902 \u092e\u093e\u0901\u0917\u093e \u0917\u092f\u093e\u0964 \u092a\u0939\u0932\u0947 \u0915\u094b\u0921 \u092e\u093e\u0901\u0917\u0947\u0902\u0964","No pending bookings available":"\u0915\u094b\u0908 \u0932\u0902\u092c\u093f\u0924 \u092c\u0941\u0915\u093f\u0902\u0917 \u0928\u0939\u0940\u0902","No Pending Seat Requests":"\u0915\u094b\u0908 \u0932\u0902\u092c\u093f\u0924 \u0938\u0940\u091f \u0905\u0928\u0941\u0930\u094b\u0927 \u0928\u0939\u0940\u0902","No response data received from driver deletion":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0939\u091f\u093e\u0928\u0947 \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No response data received from driver fetch":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0932\u093e\u0928\u0947 \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No response data received from profile update":"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0905\u092a\u0921\u0947\u091f \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No response data received from Razorpay order creation":"Razorpay \u0911\u0930\u094d\u0921\u0930 \u092c\u0928\u093e\u0928\u0947 \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No response data received from Razorpay payment verification":"Razorpay \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No response data received from signin":"\u0938\u093e\u0907\u0928 \u0907\u0928 \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No response data received from signup":"\u0938\u093e\u0907\u0928 \u0905\u092a \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No response data received from trip payment":"\u091f\u094d\u0930\u093f\u092a \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No response data received from wallet addition":"\u0935\u0949\u0932\u0947\u091f \u092e\u0947\u0902 \u092a\u0948\u0938\u0947 \u091c\u094b\u0921\u093c\u0928\u0947 \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No response data received from wallet balance fetch":"\u0935\u0949\u0932\u0947\u091f \u092c\u0948\u0932\u0947\u0902\u0938 \u0932\u093e\u0928\u0947 \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No response data received from wallet deduction":"\u0935\u0949\u0932\u0947\u091f \u0915\u091f\u094c\u0924\u0940 \u0938\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","No Reviews Yet":"\u0905\u092d\u0940 \u0915\u094b\u0908 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0928\u0939\u0940\u0902","No Running Trips":"\u0915\u094b\u0908 \u091a\u0932 \u0930\u0939\u0940 \u091f\u094d\u0930\u093f\u092a \u0928\u0939\u0940\u0902","No Sent Bids":"\u0915\u094b\u0908 \u092d\u0947\u091c\u0940 \u0917\u0908 \u092c\u094b\u0932\u0940 \u0928\u0939\u0940\u0902","No Upcoming Duty Bookings":"\u0915\u094b\u0908 \u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u0921\u094d\u092f\u0942\u091f\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u0928\u0939\u0940\u0902","No user data found. Please login again.":"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964 \u092b\u093f\u0930 \u0938\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902\u0964","No Vehicles Currently Marked Vacant":"\u0905\u092d\u0940 \u0915\u094b\u0908 \u0917\u093e\u0921\u093c\u0940 \u0916\u093e\u0932\u0940 \u091a\u093f\u0939\u094d\u0928\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948","No, Keep It":"\u0928\u0939\u0940\u0902, \u0930\u0939\u0928\u0947 \u0926\u0947\u0902","Non CNG Vehicle Only":"\u0938\u093f\u0930\u094d\u092b\u093c \u0917\u0948\u0930-CNG \u0917\u093e\u0921\u093c\u0940","Not authenticated/authorized. Please login as Driver.":"\u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924/\u0905\u0927\u093f\u0915\u0943\u0924 \u0928\u0939\u0940\u0902\u0964 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902\u0964","Not configured":"\u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948","Not enough wallet balance available to accept this booking. Please top up your wallet.":"\u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u0949\u0932\u0947\u091f \u092e\u0947\u0902 \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u092c\u0948\u0932\u0947\u0902\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0935\u0949\u0932\u0947\u091f \u091f\u0949\u092a \u0905\u092a \u0915\u0930\u0947\u0902\u0964","Not in the fare - charged on actuals":"\u0915\u093f\u0930\u093e\u092f\u0947 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 - \u0905\u0938\u0932\u0940 \u0916\u0930\u094d\u091a \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0932\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e","Not in the fare - enter what you collected":"\u0915\u093f\u0930\u093e\u092f\u0947 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 - \u091c\u094b \u0906\u092a\u0928\u0947 \u0935\u0938\u0942\u0932\u093e \u0935\u0939 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Not needed for self-sourced bookings \u2014 you can complete the trip directly.":"\u0916\u0941\u0926 \u0932\u093e\u0908 \u0917\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u091c\u093c\u0930\u0942\u0930\u0940 \u0928\u0939\u0940\u0902 \u2014 \u0906\u092a \u0938\u0940\u0927\u0947 \u091f\u094d\u0930\u093f\u092a \u092a\u0942\u0930\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Not now":"\u0905\u092d\u0940 \u0928\u0939\u0940\u0902","Not Now":"\u0905\u092d\u0940 \u0928\u0939\u0940\u0902","Not provided":"\u0928\u0939\u0940\u0902 \u0926\u093f\u092f\u093e \u0917\u092f\u093e","Not Registered as a Driver":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902","Not selected":"\u091a\u0941\u0928\u093e \u0928\u0939\u0940\u0902 \u0917\u092f\u093e","Not set":"\u0924\u092f \u0928\u0939\u0940\u0902 \u0939\u0948","Not Set":"\u0924\u092f \u0928\u0939\u0940\u0902 \u0939\u0948","Not set - tap to choose":"\u0924\u092f \u0928\u0939\u0940\u0902 - \u091a\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902","Note:":"\u0928\u094b\u091f:","Notification Inbox":"\u0938\u0942\u091a\u0928\u093e \u0907\u0928\u092c\u0949\u0915\u094d\u0938","Notifications stay on by default so you never miss a booking. Pick a duration to go quiet for a while.":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0928 \u091b\u0942\u091f\u0947 \u0907\u0938\u0932\u093f\u090f \u0938\u0942\u091a\u0928\u093e\u090f\u0901 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u091a\u093e\u0932\u0942 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902\u0964 \u0915\u0941\u091b \u0926\u0947\u0930 \u0936\u093e\u0902\u0924 \u0930\u0939\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0935\u0927\u093f \u091a\u0941\u0928\u0947\u0902\u0964","Number Masked & Protected":"\u0928\u0902\u092c\u0930 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948","Odometer Reading Check:":"\u0913\u0921\u094b\u092e\u0940\u091f\u0930 \u0930\u0940\u0921\u093f\u0902\u0917 \u091c\u093e\u0901\u091a:","Odometer Required":"\u0913\u0921\u094b\u092e\u0940\u091f\u0930 \u091c\u093c\u0930\u0942\u0930\u0940","Odometer start \u2192 end":"\u0913\u0921\u094b\u092e\u0940\u091f\u0930 \u0936\u0941\u0930\u0942 \u2192 \u0905\u0902\u0924","of 2":"2 \u092e\u0947\u0902 \u0938\u0947","Off - pay manually via Razorpay/UPI each year when due":"\u092c\u0902\u0926 - \u0939\u0930 \u0938\u093e\u0932 Razorpay/UPI \u0938\u0947 \u0916\u0941\u0926 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947\u0902","OFF DUTY":"\u0921\u094d\u092f\u0942\u091f\u0940 \u092c\u0902\u0926","Off Duty / Offline Mode":"\u0921\u094d\u092f\u0942\u091f\u0940 \u092c\u0902\u0926 / \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u092e\u094b\u0921","Offer a vehicle from your fleet. Once requested, you can chat directly with the vendor and get instant approval.":"\u0905\u092a\u0928\u0947 \u092b\u094d\u0932\u0940\u091f \u0938\u0947 \u090f\u0915 \u0917\u093e\u0921\u093c\u0940 \u0911\u092b\u093c\u0930 \u0915\u0930\u0947\u0902\u0964 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0906\u092a \u0935\u0947\u0902\u0921\u0930 \u0938\u0947 \u0938\u0940\u0927\u0947 \u091a\u0948\u091f \u0915\u0930 \u0924\u0941\u0930\u0902\u0924 \u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u092a\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Offer Empty Seats":"\u0916\u093e\u0932\u0940 \u0938\u0940\u091f\u0947\u0902 \u0911\u092b\u093c\u0930 \u0915\u0930\u0947\u0902","Offer price (\u20b9{0}) cannot be less than 50% of customer target (Min allowed bid: \u20b9{1}).":"\u0911\u092b\u093c\u0930 \u0915\u0940\u092e\u0924 (\u20b9{0}) \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0947 \u0932\u0915\u094d\u0937\u094d\u092f \u0915\u0947 50% \u0938\u0947 \u0915\u092e \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u0940 (\u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092c\u094b\u0932\u0940: \u20b9{1})\u0964","Offer price (\u20b9{0}) cannot exceed 2.5x customer target price (Max allowed bid: \u20b9{1}). Please enter a realistic offer.":"\u0911\u092b\u093c\u0930 \u0915\u0940\u092e\u0924 (\u20b9{0}) \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0940 \u0932\u0915\u094d\u0937\u093f\u0924 \u0915\u0940\u092e\u0924 \u0915\u0947 2.5 \u0917\u0941\u0928\u093e \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u0940 (\u0905\u0927\u093f\u0915\u0924\u092e \u092c\u094b\u0932\u0940: \u20b9{1})\u0964 \u0915\u0943\u092a\u092f\u093e \u0935\u093e\u091c\u093f\u092c \u0911\u092b\u093c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Offer Too High":"\u0911\u092b\u093c\u0930 \u092c\u0939\u0941\u0924 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0939\u0948","Offer Too Low":"\u0911\u092b\u093c\u0930 \u092c\u0939\u0941\u0924 \u0915\u092e \u0939\u0948",Offers:"\u0911\u092b\u093c\u0930","Official Platform Agreement":"\u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0938\u092e\u091d\u094c\u0924\u093e","On - a floating bubble shows new bookings even outside the app":"\u091a\u093e\u0932\u0942 - \u0910\u092a \u0915\u0947 \u092c\u093e\u0939\u0930 \u092d\u0940 \u090f\u0915 \u0924\u0948\u0930\u0924\u093e \u092c\u092c\u0932 \u0928\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948","On - but \"Display over other apps\" permission is not granted yet":"\u091a\u093e\u0932\u0942 - \u0932\u0947\u0915\u093f\u0928 \"\u0926\u0942\u0938\u0930\u0947 \u0910\u092a \u0915\u0947 \u090a\u092a\u0930 \u0926\u093f\u0916\u093e\u090f\u0901\" \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0905\u092d\u0940 \u0928\u0939\u0940\u0902 \u0926\u0940 \u0917\u0908","On - the yearly fee is debited from your wallet automatically when due":"\u091a\u093e\u0932\u0942 - \u0938\u093e\u0932\u093e\u0928\u093e \u0936\u0941\u0932\u094d\u0915 \u0926\u0947\u092f \u0939\u094b\u0928\u0947 \u092a\u0930 \u0935\u0949\u0932\u0947\u091f \u0938\u0947 \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u091f \u091c\u093e\u0924\u093e \u0939\u0948","ON DUTY":"\u0921\u094d\u092f\u0942\u091f\u0940 \u092a\u0930","One last step":"\u0906\u0916\u093f\u0930\u0940 \u0915\u0926\u092e","ONE WAY":"\u0935\u0928 \u0935\u0947","One-Way":"\u0935\u0928-\u0935\u0947","ONLINE & READY FOR DISPATCH":"\u0911\u0928\u0932\u093e\u0907\u0928 \u0914\u0930 \u0921\u093f\u0938\u094d\u092a\u0948\u091a \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930","Online \u2022 Drop Cars Team":"\u0911\u0928\u0932\u093e\u0907\u0928 \u2022 Drop Cars \u091f\u0940\u092e","Only for Trusted Partners":"\u0938\u093f\u0930\u094d\u092b\u093c \u091f\u094d\u0930\u0938\u094d\u091f\u0947\u0921 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f","Only Trusted Partners can post bookings.":"\u0938\u093f\u0930\u094d\u092b\u093c \u091f\u094d\u0930\u0938\u094d\u091f\u0947\u0921 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0939\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u094b\u0938\u094d\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Oops!":"\u0905\u0930\u0947!","Open My Bookings":"\u092e\u0947\u0930\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u0916\u094b\u0932\u0947\u0902","Open My Fleet":"\u092e\u0947\u0930\u093e \u092b\u094d\u0932\u0940\u091f \u0916\u094b\u0932\u0947\u0902","Opening that booking's chat...":"\u0909\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0940 \u091a\u0948\u091f \u0916\u0941\u0932 \u0930\u0939\u0940 \u0939\u0948...","Operating City":"\u0938\u0902\u091a\u093e\u0932\u0928 \u0915\u093e \u0936\u0939\u0930","Optional for self-sourced bookings \u2014 you can start the trip directly.":"\u0916\u0941\u0926 \u0932\u093e\u0908 \u0917\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u2014 \u0906\u092a \u0938\u0940\u0927\u0947 \u091f\u094d\u0930\u093f\u092a \u0936\u0941\u0930\u0942 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","or newer":"\u092f\u093e \u0928\u092f\u093e","Or share the link":"\u092f\u093e \u0932\u093f\u0902\u0915 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902","Or type custom cancellation reason...":"\u092f\u093e \u0905\u092a\u0928\u093e \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u0923 \u0932\u093f\u0916\u0947\u0902...","Order #":"\u0911\u0930\u094d\u0921\u0930 #","Order Details in Bold Styling":"\u0911\u0930\u094d\u0921\u0930 \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u0917\u0939\u0930\u0947 \u0905\u0915\u094d\u0937\u0930\u094b\u0902 \u092e\u0947\u0902","Other (type your own reason)":"\u0905\u0928\u094d\u092f (\u0905\u092a\u0928\u093e \u0915\u093e\u0930\u0923 \u0932\u093f\u0916\u0947\u0902)","Other extras collected":"\u0935\u0938\u0942\u0932\u0947 \u0917\u090f \u0905\u0928\u094d\u092f \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0936\u0941\u0932\u094d\u0915","Outstation & drop bookings are managed in Open Bookings. This Live Radar is dedicated to high-frequency point-to-point local bookings.":"\u0906\u0909\u091f\u0938\u094d\u091f\u0947\u0936\u0928 \u0914\u0930 \u0921\u094d\u0930\u0949\u092a \u092c\u0941\u0915\u093f\u0902\u0917 Open Bookings \u092e\u0947\u0902 \u0938\u0902\u092d\u093e\u0932\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0932\u093e\u0907\u0935 \u0930\u0921\u093e\u0930 \u092c\u093e\u0930-\u092c\u093e\u0930 \u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u0932\u094b\u0915\u0932 \u092a\u0949\u0907\u0902\u091f-\u091f\u0942-\u092a\u0949\u0907\u0902\u091f \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964","Owner Profile \xb7 Email Address Missing":"\u092e\u093e\u0932\u093f\u0915 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \xb7 \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948","\ud83c\udd7f\ufe0f Fastag & Tolls":"\ud83c\udd7f\ufe0f \u092b\u093e\u0938\u094d\u091f\u0948\u0917 \u0914\u0930 \u091f\u094b\u0932","PAN Card (Tax Proof)":"PAN \u0915\u093e\u0930\u094d\u0921 (\u0915\u0930 \u092a\u094d\u0930\u092e\u093e\u0923)","PAN Card Verification":"PAN \u0915\u093e\u0930\u094d\u0921 \u0938\u0924\u094d\u092f\u093e\u092a\u0928","PAN Number":"PAN \u0928\u0902\u092c\u0930","PAN number is required":"PAN \u0928\u0902\u092c\u0930 \u091c\u093c\u0930\u0942\u0930\u0940",Partner:"\u092a\u093e\u0930\u094d\u091f\u0928\u0930","Partner Mobile":"\u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u092e\u094b\u092c\u093e\u0907\u0932","Passenger has visually confirmed the final closing meter reading":"\u092f\u093e\u0924\u094d\u0930\u0940 \u0928\u0947 \u0905\u0902\u0924\u093f\u092e \u092e\u0940\u091f\u0930 \u0930\u0940\u0921\u093f\u0902\u0917 \u0916\u0941\u0926 \u0926\u0947\u0916\u0915\u0930 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0940 \u0939\u0948","Passenger has visually confirmed the starting meter reading":"\u092f\u093e\u0924\u094d\u0930\u0940 \u0928\u0947 \u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u092e\u0940\u091f\u0930 \u0930\u0940\u0921\u093f\u0902\u0917 \u0916\u0941\u0926 \u0926\u0947\u0916\u0915\u0930 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0940 \u0939\u0948","passenger seats":"\u092f\u093e\u0924\u094d\u0930\u0940 \u0938\u0940\u091f\u0947\u0902","passenger seats.":"\u092f\u093e\u0924\u094d\u0930\u0940 \u0938\u0940\u091f\u0947\u0902\u0964","Password Mismatch":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u0947","Pay the full yearly fee once and stop the monthly auto-debit":"\u092a\u0942\u0930\u093e \u0938\u093e\u0932\u093e\u0928\u093e \u0936\u0941\u0932\u094d\u0915 \u090f\u0915 \u092c\u093e\u0930 \u091a\u0941\u0915\u093e\u090f\u0901 \u0914\u0930 \u092e\u093e\u0938\u093f\u0915 \u0911\u091f\u094b-\u0921\u0947\u092c\u093f\u091f \u092c\u0902\u0926 \u0915\u0930\u0947\u0902","Payment & Bank Details":"\u092d\u0941\u0917\u0924\u093e\u0928 \u0914\u0930 \u092c\u0948\u0902\u0915 \u0935\u093f\u0935\u0930\u0923","Payment could not be processed":"\u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","Payment Details":"\u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0935\u0930\u0923","Payment verification failed":"\u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0935\u093f\u092b\u0932","Payout Account":"\u092d\u0941\u0917\u0924\u093e\u0928 \u0928\u093f\u0915\u093e\u0938\u0940 \u0916\u093e\u0924\u093e","Payout Amount (\u0ba4\u0bca\u0b95\u0bc8)":"\u0928\u093f\u0915\u093e\u0938\u0940 \u0915\u0940 \u0930\u093e\u0936\u093f","Payout bank account & payment details saved successfully.":"\u0928\u093f\u0915\u093e\u0938\u0940 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0914\u0930 \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0935\u0930\u0923 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u0947\u0935 \u0939\u094b \u0917\u090f\u0964","Payout Method (\u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0bb1\u0bc8)":"\u0928\u093f\u0915\u093e\u0938\u0940 \u0915\u093e \u0924\u0930\u0940\u0915\u093e","Payout Requested":"\u0928\u093f\u0915\u093e\u0938\u0940 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0939\u0941\u0906","Payouts, account credits/debits, and wallet balance updates":"\u0928\u093f\u0915\u093e\u0938\u0940, \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u091c\u092e\u093e/\u0915\u091f\u094c\u0924\u0940 \u0914\u0930 \u0935\u0949\u0932\u0947\u091f \u092c\u0948\u0932\u0947\u0902\u0938 \u0905\u092a\u0921\u0947\u091f",Pending:"\u0932\u0902\u092c\u093f\u0924","Pending orders endpoint not found.":"\u0932\u0902\u092c\u093f\u0924 \u0911\u0930\u094d\u0921\u0930 \u090f\u0902\u0921\u092a\u0949\u0907\u0902\u091f \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964","Pending Passenger Requests (":"\u0932\u0902\u092c\u093f\u0924 \u092f\u093e\u0924\u094d\u0930\u0940 \u0905\u0928\u0941\u0930\u094b\u0927 (","PENDING SEAT REQUEST":"\u0932\u0902\u092c\u093f\u0924 \u0938\u0940\u091f \u0905\u0928\u0941\u0930\u094b\u0927","Pending Verification":"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0932\u0902\u092c\u093f\u0924","Per KM Rate":"\u092a\u094d\u0930\u0924\u093f \u0915\u093f\u092e\u0940 \u0926\u0930","Per-Km Booking (10% Commission):":"\u092a\u094d\u0930\u0924\u093f \u0915\u093f\u092e\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 (10% \u0915\u092e\u0940\u0936\u0928):","Permission Denied":"\u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940","Permission needed":"\u0905\u0928\u0941\u092e\u0924\u093f \u091c\u093c\u0930\u0942\u0930\u0940","Permit Charges":"\u092a\u0930\u092e\u093f\u091f \u0936\u0941\u0932\u094d\u0915","Personal & Business Info":"\u0928\u093f\u091c\u0940 \u0914\u0930 \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u091c\u093e\u0928\u0915\u093e\u0930\u0940","Personal, KYC & Account details":"\u0928\u093f\u091c\u0940, KYC \u0914\u0930 \u0916\u093e\u0924\u0947 \u0915\u093e \u0935\u093f\u0935\u0930\u0923","Pet Friendly Vehicle":"\u092a\u093e\u0932\u0924\u0942 \u091c\u093e\u0928\u0935\u0930\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0915\u0942\u0932 \u0917\u093e\u0921\u093c\u0940","Phone Number":"\u092b\u093c\u094b\u0928 \u0928\u0902\u092c\u0930","Phone sign-in isn\u2019t available on this build yet. Please use Mobile Number + Password.":"\u0907\u0938 \u0935\u0930\u094d\u091c\u093c\u0928 \u092e\u0947\u0902 \u092b\u093c\u094b\u0928 \u0938\u093e\u0907\u0928-\u0907\u0928 \u0905\u092d\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 + \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902\u0964","Photo Captured":"\u092b\u094b\u091f\u094b \u0932\u0940 \u0917\u0908","Photo doesn't clearly match the licence photo ({0}%).":"\u092b\u094b\u091f\u094b \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0915\u0940 \u092b\u094b\u091f\u094b \u0938\u0947 \u0938\u093e\u092b\u093c \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u0940 ({0}%)\u0964","Photo library permission is required to select photos.":"\u092b\u094b\u091f\u094b \u091a\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092b\u094b\u091f\u094b \u0932\u093e\u0907\u092c\u094d\u0930\u0947\u0930\u0940 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964","Photo Saved":"\u092b\u094b\u091f\u094b \u0938\u0947\u0935 \u0939\u094b \u0917\u0908",Pick:"\u091a\u0941\u0928\u0947\u0902","Pick up a Drop Cars booking from the open list and assign it to yourself to manage and execute the trip directly here.":"\u0916\u0941\u0932\u0940 \u0938\u0942\u091a\u0940 \u0938\u0947 Drop Cars \u092c\u0941\u0915\u093f\u0902\u0917 \u0909\u0920\u093e\u090f\u0901, \u0916\u0941\u0926 \u0915\u094b \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092f\u0939\u0940\u0902 \u0938\u0940\u0927\u0947 \u091f\u094d\u0930\u093f\u092a \u0938\u0902\u092d\u093e\u0932\u0947\u0902\u0964",Pickup:"\u092a\u093f\u0915\u0905\u092a","Pickup (From City)":"\u092a\u093f\u0915\u0905\u092a (\u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0936\u0939\u0930)","Pickup Address / Landmark (Optional)":"\u092a\u093f\u0915\u0905\u092a \u092a\u0924\u093e / \u0932\u0948\u0902\u0921\u092e\u093e\u0930\u094d\u0915 (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)","Pickup Date":"\u092a\u093f\u0915\u0905\u092a \u0915\u0940 \u0924\u093e\u0930\u0940\u0916\u093c","Pickup Date & Time:":"\u092a\u093f\u0915\u0905\u092a \u0924\u093e\u0930\u0940\u0916\u093c \u0914\u0930 \u0938\u092e\u092f:","Pickup Note / Instructions:":"\u092a\u093f\u0915\u0905\u092a \u0928\u094b\u091f / \u0928\u093f\u0930\u094d\u0926\u0947\u0936:","Pickup Notes / Driver Instructions:":"\u092a\u093f\u0915\u0905\u092a \u0928\u094b\u091f\u094d\u0938 / \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0928\u093f\u0930\u094d\u0926\u0947\u0936:","Pickup Schedule":"\u092a\u093f\u0915\u0905\u092a \u0915\u093e \u0938\u092e\u092f","Pickup:":"\u092a\u093f\u0915\u0905\u092a:","Place Offer / Bid (Target: \u20b9":"\u0911\u092b\u093c\u0930 / \u092c\u094b\u0932\u0940 \u0932\u0917\u093e\u090f\u0901 (\u0932\u0915\u094d\u0937\u094d\u092f: \u20b9","Platform Commission (Est. 10%):":"\u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0915\u092e\u0940\u0936\u0928 (\u0905\u0928\u0941\u092e\u093e\u0928\u093f\u0924 10%):","Platform fee":"\u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0936\u0941\u0932\u094d\u0915","Platform Fee":"\u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0936\u0941\u0932\u094d\u0915","Platform fee (":"\u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e \u0936\u0941\u0932\u094d\u0915 (","Please accept the booking terms and cancellation penalty policy to proceed.":"\u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0940 \u0936\u0930\u094d\u0924\u0947\u0902 \u0914\u0930 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u0947 \u0915\u0940 \u0928\u0940\u0924\u093f \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902\u0964","Please assign a driver for this request.":"\u0907\u0938 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902\u0964","Please capture Back Seat photo.":"\u092a\u093f\u091b\u0932\u0940 \u0938\u0940\u091f \u0915\u0940 \u092b\u094b\u091f\u094b \u0932\u0947\u0902\u0964","Please capture Car Front photo.":"\u0917\u093e\u0921\u093c\u0940 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0915\u0940 \u092b\u094b\u091f\u094b \u0932\u0947\u0902\u0964","Please capture Interior Cleanliness photo.":"\u0905\u0902\u0926\u0930 \u0915\u0940 \u0938\u092b\u093c\u093e\u0908 \u0915\u0940 \u092b\u094b\u091f\u094b \u0932\u0947\u0902\u0964","Please capture the back photo of the document.":"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u0940 \u092b\u094b\u091f\u094b \u0932\u0947\u0902\u0964","Please capture the front photo of the document.":"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0947 \u0906\u0917\u0947 \u0915\u0940 \u092b\u094b\u091f\u094b \u0932\u0947\u0902\u0964","Please check driver information: {0}":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u091c\u093e\u0901\u091a\u0947\u0902: {0}","Please check your connection and try again.":"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0901\u091a\u0915\u0930 \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Please check your internet connection and try again":"\u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0901\u091a\u0915\u0930 \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902","Please complete Driver Selfie Check before starting trip.":"\u091f\u094d\u0930\u093f\u092a \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0938\u0947\u0932\u094d\u092b\u093c\u0940 \u091c\u093e\u0901\u091a \u092a\u0942\u0930\u0940 \u0915\u0930\u0947\u0902\u0964","Please complete the driving licence number (State+RTO, Year, Serial).":"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0928\u0902\u092c\u0930 \u092a\u0942\u0930\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 (\u0930\u093e\u091c\u094d\u092f+RTO, \u0935\u0930\u094d\u0937, \u0915\u094d\u0930\u092e \u0938\u0902\u0916\u094d\u092f\u093e)\u0964","Please confirm your password.":"\u0905\u092a\u0928\u0947 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902\u0964","Please detail what information you need updated.":"\u092c\u0924\u093e\u090f\u0901 \u0915\u093f \u0915\u094c\u0928 \u0938\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0940 \u0939\u0948\u0964","Please enter a name with at least 2 characters.":"\u0915\u092e \u0938\u0947 \u0915\u092e 2 \u0905\u0915\u094d\u0937\u0930\u094b\u0902 \u0915\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter a valid 10-digit mobile number starting with 6, 7, 8, or 9.":"6, 7, 8 \u092f\u093e 9 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u093e \u0938\u0939\u0940 10 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter a valid 10-digit UPI Mobile Number":"\u0938\u0939\u0940 10 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e UPI \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Please enter a valid password (at least 6 characters).":"\u0938\u0939\u0940 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 (\u0915\u092e \u0938\u0947 \u0915\u092e 6 \u0905\u0915\u094d\u0937\u0930)\u0964","Please enter a valid payout amount.":"\u0938\u0939\u0940 \u0928\u093f\u0915\u093e\u0938\u0940 \u0930\u093e\u0936\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter a valid Travels / Business Name.":"\u0938\u0939\u0940 \u091f\u094d\u0930\u0948\u0935\u0932\u094d\u0938 / \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u0915\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter both mobile number and password.":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u094b\u0928\u094b\u0902 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter initial odometer reading.":"\u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0913\u0921\u094b\u092e\u0940\u091f\u0930 \u0930\u0940\u0921\u093f\u0902\u0917 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter the 12-digit Aadhaar number.":"12 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter the 6-digit verification code sent to your email.":"\u0906\u092a\u0915\u0947 \u0908\u092e\u0947\u0932 \u092a\u0930 \u092d\u0947\u091c\u093e \u0917\u092f\u093e 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter valid 4-digit Customer Start OTP.":"\u0938\u0939\u0940 4 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0917\u094d\u0930\u093e\u0939\u0915 \u0936\u0941\u0930\u0941\u0906\u0924\u0940 OTP \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter your valid full name as per Government ID.":"\u0938\u0930\u0915\u093e\u0930\u0940 ID \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0905\u092a\u0928\u093e \u0938\u0939\u0940 \u092a\u0942\u0930\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please explain the reason for requesting profile updates.":"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0905\u092a\u0921\u0947\u091f \u092e\u093e\u0901\u0917\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u0923 \u092c\u0924\u093e\u090f\u0901\u0964","Please give the customer a star rating before you finish.":"\u0916\u0924\u094d\u092e \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094b \u0938\u094d\u091f\u093e\u0930 \u0930\u0947\u091f\u093f\u0902\u0917 \u0926\u0947\u0902\u0964","Please place a regular phone call.":"\u0915\u0943\u092a\u092f\u093e \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092b\u093c\u094b\u0928 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902\u0964","Please rate the customer and confirm the amount collected to finish this trip.":"\u092f\u0939 \u091f\u094d\u0930\u093f\u092a \u092a\u0942\u0930\u0940 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094b \u0930\u0947\u091f\u093f\u0902\u0917 \u0926\u0947\u0902 \u0914\u0930 \u0935\u0938\u0942\u0932\u0940 \u0917\u0908 \u0930\u093e\u0936\u093f \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902\u0964","Please rate your Drop Cars trip: {0}":"\u0905\u092a\u0928\u0940 Drop Cars \u091f\u094d\u0930\u093f\u092a \u0915\u094b \u0930\u0947\u091f\u093f\u0902\u0917 \u0926\u0947\u0902: {0}","Please select a Drop (To City).":"\u0921\u094d\u0930\u0949\u092a (\u0917\u0902\u0924\u0935\u094d\u092f \u0936\u0939\u0930) \u091a\u0941\u0928\u0947\u0902\u0964","Please select a Pickup (From City).":"\u092a\u093f\u0915\u0905\u092a (\u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0936\u0939\u0930) \u091a\u0941\u0928\u0947\u0902\u0964","Please select a valid expiry date for this document.":"\u0907\u0938 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0940 \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0924\u093f\u0925\u093f \u091a\u0941\u0928\u0947\u0902\u0964","Please select a vehicle for this request.":"\u0907\u0938 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0917\u093e\u0921\u093c\u0940 \u091a\u0941\u0928\u0947\u0902\u0964","Please select or type a cancellation reason.":"\u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u0923 \u091a\u0941\u0928\u0947\u0902 \u092f\u093e \u0932\u093f\u0916\u0947\u0902\u0964","Please select or type a reason for cancelling this booking.":"\u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u094b \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u0923 \u091a\u0941\u0928\u0947\u0902 \u092f\u093e \u0932\u093f\u0916\u0947\u0902\u0964","Please take a live selfie before continuing.":"\u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0932\u093e\u0907\u0935 \u0938\u0947\u0932\u094d\u092b\u093c\u0940 \u0932\u0947\u0902\u0964","Please try again.":"\u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Please upload both the Aadhaar FRONT and BACK photos.":"\u0906\u0927\u093e\u0930 \u0915\u0940 \u0906\u0917\u0947 \u0914\u0930 \u092a\u0940\u091b\u0947 \u0926\u094b\u0928\u094b\u0902 \u0924\u0930\u092b\u093c \u0915\u0940 \u092b\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964","Please upload the Licence BACK side photo too - both sides are required.":"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u0940 \u092b\u094b\u091f\u094b \u092d\u0940 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 - \u0926\u094b\u0928\u094b\u0902 \u0924\u0930\u092b\u093c \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0902\u0964","Please verify your":"\u0915\u0943\u092a\u092f\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0905\u092a\u0928\u093e","Please verify your email address by tapping \"Verify Email\" before completing registration.":"\u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u092a\u0942\u0930\u093e \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \"\u0908\u092e\u0947\u0932 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902\" \u091f\u0948\u092a \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u093e \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902\u0964","Please wait for approval":"\u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930\u0947\u0902","plus \u20b9":"\u0938\u093e\u0925 \u092e\u0947\u0902 \u20b9","Pollution Certificate (PUC)":"\u092a\u094d\u0930\u0926\u0942\u0937\u0923 \u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 (PUC)","Post Booking & Dispatch":"\u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u0921\u093f\u0938\u094d\u092a\u0948\u091a \u0915\u0930\u0947\u0902","Posted by you":"\u0906\u092a\u0928\u0947 \u092a\u094b\u0938\u094d\u091f \u0915\u093f\u092f\u093e","Posting Earning (for sourcing this trip)":"\u092a\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0915\u092e\u093e\u0908 (\u092f\u0939 \u091f\u094d\u0930\u093f\u092a \u0932\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f)","Pre-book and guarantee priority dispatch for your available fleet! When a passenger books a trip on your requested route, our system auto-matches it with a 10-second alert window.":"\u0905\u092a\u0928\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u092b\u094d\u0932\u0940\u091f \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u0932\u0947 \u0938\u0947 \u092c\u0941\u0915 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u0935\u093e\u0932\u093e \u0921\u093f\u0938\u094d\u092a\u0948\u091a \u092a\u0915\u094d\u0915\u093e \u0915\u0930\u0947\u0902! \u091c\u092c \u0915\u094b\u0908 \u092f\u093e\u0924\u094d\u0930\u0940 \u0906\u092a\u0915\u0947 \u091a\u0941\u0928\u0947 \u0930\u0942\u091f \u092a\u0930 \u092c\u0941\u0915 \u0915\u0930\u0924\u093e \u0939\u0948, \u0939\u092e\u093e\u0930\u093e \u0938\u093f\u0938\u094d\u091f\u092e 10 \u0938\u0947\u0915\u0902\u0921 \u0915\u0947 \u0905\u0932\u0930\u094d\u091f \u0915\u0947 \u0938\u093e\u0925 \u0909\u0938\u0947 \u0905\u092a\u0928\u0947 \u0906\u092a \u092e\u0948\u091a \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",Preferences:"\u092a\u0938\u0902\u0926","Preview:":"\u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928:","Price per KM":"\u092a\u094d\u0930\u0924\u093f \u0915\u093f\u092e\u0940 \u0915\u0940\u092e\u0924","Primary Mobile":"\u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u092e\u094b\u092c\u093e\u0907\u0932","Primary Mobile Number":"\u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930","Priority trip dispatch & subscriber analytics":"\u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u091f\u094d\u0930\u093f\u092a \u0921\u093f\u0938\u094d\u092a\u0948\u091a \u0914\u0930 \u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c\u0930 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923","Privacy & Security":"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e",Profile:"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932","Profile & Account Details":"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0914\u0930 \u0916\u093e\u0924\u0947 \u0915\u093e \u0935\u093f\u0935\u0930\u0923","Profile Photo":"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092b\u094b\u091f\u094b","Profile Photo Required":"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092b\u094b\u091f\u094b \u091c\u093c\u0930\u0942\u0930\u0940","Profile update failed: {0}":"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0
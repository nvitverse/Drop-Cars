0c02\u0c26\u0c28 \u0c21\u0c47\u0c1f\u0c3e \u0c30\u0c3e\u0c32\u0c47\u0c26\u0c41","No Reviews Yet":"\u0c07\u0c02\u0c15\u0c3e \u0c30\u0c3f\u0c35\u0c4d\u0c2f\u0c42\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41","No Running Trips":"\u0c28\u0c21\u0c41\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28 \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u200c\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41","No Sent Bids":"\u0c2a\u0c02\u0c2a\u0c3f\u0c28 \u0c2c\u0c3f\u0c21\u0c4d\u200c\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41","No Upcoming Duty Bookings":"\u0c30\u0c3e\u0c2c\u0c4b\u0c2f\u0c47 \u0c21\u0c4d\u0c2f\u0c42\u0c1f\u0c40 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41","No user data found. Please login again.":"\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c21\u0c47\u0c1f\u0c3e \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41. \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c05\u0c35\u0c4d\u0c35\u0c02\u0c21\u0c3f.","No Vehicles Currently Marked Vacant":"\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 \u0c16\u0c3e\u0c33\u0c40\u0c17\u0c3e \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3e\u0c39\u0c28\u0c3e\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41","No, Keep It":"\u0c35\u0c26\u0c4d\u0c26\u0c41, \u0c09\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f","Non CNG Vehicle Only":"CNG \u0c15\u0c3e\u0c28\u0c3f \u0c35\u0c3e\u0c39\u0c28\u0c02 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47","Not authenticated/authorized. Please login as Driver.":"\u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41/\u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c02 \u0c32\u0c47\u0c26\u0c41. \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u200c\u0c17\u0c3e \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c05\u0c35\u0c4d\u0c35\u0c02\u0c21\u0c3f.","Not configured":"\u0c15\u0c3e\u0c28\u0c4d\u0c2b\u0c3f\u0c17\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c26\u0c41","Not enough wallet balance available to accept this booking. Please top up your wallet.":"\u0c08 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c24\u0c17\u0c3f\u0c28\u0c02\u0c24 \u0c2c\u0c4d\u0c2f\u0c3e\u0c32\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c32\u0c47\u0c26\u0c41. \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c1f\u0c3e\u0c2a\u0c4d \u0c05\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Not in the fare - charged on actuals":"\u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c41 - \u0c35\u0c3e\u0c38\u0c4d\u0c24\u0c35 \u0c16\u0c30\u0c4d\u0c1a\u0c41\u0c32 \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02 \u0c35\u0c38\u0c42\u0c32\u0c41","Not in the fare - enter what you collected":"\u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c41 - \u0c2e\u0c40\u0c30\u0c41 \u0c35\u0c38\u0c42\u0c32\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28\u0c26\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Not needed for self-sourced bookings \u2014 you can complete the trip directly.":"\u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c17\u0c3e \u0c24\u0c46\u0c1a\u0c4d\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c05\u0c35\u0c38\u0c30\u0c02 \u0c32\u0c47\u0c26\u0c41 \u2014 \u0c28\u0c47\u0c30\u0c41\u0c17\u0c3e \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","Not now":"\u0c07\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c35\u0c26\u0c4d\u0c26\u0c41","Not Now":"\u0c07\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c35\u0c26\u0c4d\u0c26\u0c41","Not provided":"\u0c07\u0c35\u0c4d\u0c35\u0c32\u0c47\u0c26\u0c41","Not Registered as a Driver":"\u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u200c\u0c17\u0c3e \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c15\u0c3e\u0c32\u0c47\u0c26\u0c41","Not selected":"\u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c32\u0c47\u0c26\u0c41","Not set":"\u0c38\u0c46\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c26\u0c41","Not Set":"\u0c38\u0c46\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c26\u0c41","Not set - tap to choose":"\u0c38\u0c46\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c26\u0c41 - \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c02\u0c21\u0c3f","Note:":"\u0c17\u0c2e\u0c28\u0c3f\u0c15:","Notification Inbox":"\u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c07\u0c28\u0c4d\u200c\u0c2c\u0c3e\u0c15\u0c4d\u0c38\u0c4d","Notifications stay on by default so you never miss a booking. Pick a duration to go quiet for a while.":"\u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c2e\u0c3f\u0c38\u0c4d \u0c15\u0c3e\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41 \u0c21\u0c3f\u0c2b\u0c3e\u0c32\u0c4d\u0c1f\u0c4d\u200c\u0c17\u0c3e \u0c06\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f. \u0c15\u0c4a\u0c02\u0c24\u0c38\u0c47\u0c2a\u0c41 \u0c28\u0c3f\u0c36\u0c4d\u0c36\u0c2c\u0c4d\u0c26\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c21\u0c1f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c4d\u0c2f\u0c35\u0c27\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.","Number Masked & Protected":"\u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c26\u0c3e\u0c1a\u0c2c\u0c21\u0c3f \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f","Odometer Reading Check:":"\u0c13\u0c21\u0c4b\u0c2e\u0c40\u0c1f\u0c30\u0c4d \u0c30\u0c40\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c24\u0c28\u0c3f\u0c16\u0c40:","Odometer Required":"\u0c13\u0c21\u0c4b\u0c2e\u0c40\u0c1f\u0c30\u0c4d \u0c05\u0c35\u0c38\u0c30\u0c02","Odometer start \u2192 end":"\u0c13\u0c21\u0c4b\u0c2e\u0c40\u0c1f\u0c30\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c02 \u2192 \u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41","of 2":"2 \u0c32\u0c4b","Off - pay manually via Razorpay/UPI each year when due":"\u0c06\u0c2b\u0c4d - \u0c2a\u0c4d\u0c30\u0c24\u0c3f \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02 Razorpay/UPI \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c40\u0c30\u0c47 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","OFF DUTY":"\u0c06\u0c2b\u0c4d \u0c21\u0c4d\u0c2f\u0c42\u0c1f\u0c40","Off Duty / Offline Mode":"\u0c06\u0c2b\u0c4d \u0c21\u0c4d\u0c2f\u0c42\u0c1f\u0c40 / \u0c06\u0c2b\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c2e\u0c4b\u0c21\u0c4d","Offer a vehicle from your fleet. Once requested, you can chat directly with the vendor and get instant approval.":"\u0c2e\u0c40 \u0c2b\u0c4d\u0c32\u0c40\u0c1f\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c12\u0c15 \u0c35\u0c3e\u0c39\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c06\u0c2b\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c3f\u0c02\u0c1a\u0c3e\u0c15, \u0c35\u0c46\u0c02\u0c21\u0c30\u0c4d\u200c\u0c24\u0c4b \u0c28\u0c47\u0c30\u0c41\u0c17\u0c3e \u0c1a\u0c3e\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c24\u0c15\u0c4d\u0c37\u0c23 \u0c06\u0c2e\u0c4b\u0c26\u0c02 \u0c2a\u0c4a\u0c02\u0c26\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","Offer Empty Seats":"\u0c16\u0c3e\u0c33\u0c40 \u0c38\u0c40\u0c1f\u0c4d\u0c32\u0c41 \u0c06\u0c2b\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Offer price (\u20b9{0}) cannot be less than 50% of customer target (Min allowed bid: \u20b9{1}).":"\u0c06\u0c2b\u0c30\u0c4d \u0c27\u0c30 (\u20b9{0}) \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2f\u0c02\u0c32\u0c4b 50% \u0c15\u0c02\u0c1f\u0c47 \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c09\u0c02\u0c21\u0c15\u0c42\u0c21\u0c26\u0c41 (\u0c15\u0c28\u0c40\u0c38 \u0c2c\u0c3f\u0c21\u0c4d: \u20b9{1}).","Offer price (\u20b9{0}) cannot exceed 2.5x customer target price (Max allowed bid: \u20b9{1}). Please enter a realistic offer.":"\u0c06\u0c2b\u0c30\u0c4d \u0c27\u0c30 (\u20b9{0}) \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2f \u0c27\u0c30\u0c15\u0c41 2.5 \u0c30\u0c46\u0c1f\u0c4d\u0c32\u0c41 \u0c2e\u0c3f\u0c02\u0c1a\u0c15\u0c42\u0c21\u0c26\u0c41 (\u0c17\u0c30\u0c3f\u0c37\u0c4d\u0c20 \u0c2c\u0c3f\u0c21\u0c4d: \u20b9{1}). \u0c35\u0c3e\u0c38\u0c4d\u0c24\u0c35\u0c3f\u0c15\u0c2e\u0c48\u0c28 \u0c06\u0c2b\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Offer Too High":"\u0c06\u0c2b\u0c30\u0c4d \u0c1a\u0c3e\u0c32\u0c3e \u0c0e\u0c15\u0c4d\u0c15\u0c41\u0c35","Offer Too Low":"\u0c06\u0c2b\u0c30\u0c4d \u0c1a\u0c3e\u0c32\u0c3e \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35",Offers:"\u0c06\u0c2b\u0c30\u0c4d\u200c\u0c32\u0c41","Official Platform Agreement":"\u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f\u0c15 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c02 \u0c12\u0c2a\u0c4d\u0c2a\u0c02\u0c26\u0c02","On - a floating bubble shows new bookings even outside the app":"\u0c06\u0c28\u0c4d - \u0c2f\u0c3e\u0c2a\u0c4d \u0c2c\u0c2f\u0c1f \u0c15\u0c42\u0c21\u0c3e \u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c2b\u0c4d\u0c32\u0c4b\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c2c\u0c2c\u0c41\u0c32\u0c4d \u0c1a\u0c42\u0c2a\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f","On - but \"Display over other apps\" permission is not granted yet":"\u0c06\u0c28\u0c4d - \u0c15\u0c3e\u0c28\u0c40 \"\u0c07\u0c24\u0c30 \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c32 \u0c2a\u0c48\u0c28 \u0c1a\u0c42\u0c2a\u0c41\" \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f \u0c07\u0c02\u0c15\u0c3e \u0c07\u0c35\u0c4d\u0c35\u0c32\u0c47\u0c26\u0c41","On - the yearly fee is debited from your wallet automatically when due":"\u0c06\u0c28\u0c4d - \u0c35\u0c3e\u0c30\u0c4d\u0c37\u0c3f\u0c15 \u0c30\u0c41\u0c38\u0c41\u0c2e\u0c41 \u0c17\u0c21\u0c41\u0c35\u0c41 \u0c35\u0c1a\u0c4d\u0c1a\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c06\u0c1f\u0c4b\u0c2e\u0c47\u0c1f\u0c3f\u0c15\u0c4d\u200c\u0c17\u0c3e \u0c21\u0c46\u0c2c\u0c3f\u0c1f\u0c4d \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f","ON DUTY":"\u0c21\u0c4d\u0c2f\u0c42\u0c1f\u0c40\u0c32\u0c4b","One last step":"\u0c1a\u0c3f\u0c35\u0c30\u0c3f \u0c26\u0c36","ONE WAY":"\u0c35\u0c28\u0c4d \u0c35\u0c47","One-Way":"\u0c35\u0c28\u0c4d-\u0c35\u0c47","ONLINE & READY FOR DISPATCH":"\u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d & \u0c21\u0c3f\u0c38\u0c4d\u0c2a\u0c3e\u0c1a\u0c4d\u200c\u0c15\u0c41 \u0c38\u0c3f\u0c26\u0c4d\u0c27\u0c02","Online \u2022 Drop Cars Team":"\u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u2022 Drop Cars \u0c1f\u0c40\u0c2e\u0c4d","Only for Trusted Partners":"\u0c1f\u0c4d\u0c30\u0c38\u0c4d\u0c1f\u0c46\u0c21\u0c4d \u0c2a\u0c3e\u0c30\u0c4d\u0c1f\u0c28\u0c30\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47","Only Trusted Partners can post bookings.":"\u0c1f\u0c4d\u0c30\u0c38\u0c4d\u0c1f\u0c46\u0c21\u0c4d \u0c2a\u0c3e\u0c30\u0c4d\u0c1f\u0c28\u0c30\u0c4d\u200c\u0c32\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41 \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c30\u0c41.","Oops!":"\u0c05\u0c2f\u0c4d\u0c2f\u0c4b!","Open My Bookings":"\u0c28\u0c3e \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41 \u0c24\u0c46\u0c30\u0c35\u0c02\u0c21\u0c3f","Open My Fleet":"\u0c28\u0c3e \u0c2b\u0c4d\u0c32\u0c40\u0c1f\u0c4d \u0c24\u0c46\u0c30\u0c35\u0c02\u0c21\u0c3f","Opening that booking's chat...":"\u0c06 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c1a\u0c3e\u0c1f\u0c4d \u0c24\u0c46\u0c30\u0c41\u0c38\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f...","Operating City":"\u0c06\u0c2a\u0c30\u0c47\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c28\u0c17\u0c30\u0c02","Optional for self-sourced bookings \u2014 you can start the trip directly.":"\u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c17\u0c3e \u0c24\u0c46\u0c1a\u0c4d\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c10\u0c1a\u0c4d\u0c1b\u0c3f\u0c15\u0c02 \u2014 \u0c28\u0c47\u0c30\u0c41\u0c17\u0c3e \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","or newer":"\u0c32\u0c47\u0c26\u0c3e \u0c15\u0c4a\u0c24\u0c4d\u0c24\u0c26\u0c3f","Or share the link":"\u0c32\u0c47\u0c26\u0c3e \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c37\u0c47\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Or type custom cancellation reason...":"\u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c40 \u0c38\u0c4a\u0c02\u0c24 \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c15\u0c3e\u0c30\u0c23\u0c02 \u0c1f\u0c48\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f...","Order #":"\u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d #","Order Details in Bold Styling":"\u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c2c\u0c4b\u0c32\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c4b","Other (type your own reason)":"\u0c07\u0c24\u0c30 (\u0c2e\u0c40 \u0c15\u0c3e\u0c30\u0c23\u0c02 \u0c1f\u0c48\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f)","Other extras collected":"\u0c35\u0c38\u0c42\u0c32\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c07\u0c24\u0c30 \u0c05\u0c26\u0c28\u0c2a\u0c41 \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c41","Outstation & drop bookings are managed in Open Bookings. This Live Radar is dedicated to high-frequency point-to-point local bookings.":"\u0c14\u0c1f\u0c4d\u200c\u0c38\u0c4d\u0c1f\u0c47\u0c37\u0c28\u0c4d & \u0c21\u0c4d\u0c30\u0c3e\u0c2a\u0c4d \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41 Open Bookings \u0c32\u0c4b \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f. \u0c08 \u0c32\u0c48\u0c35\u0c4d \u0c30\u0c3e\u0c21\u0c3e\u0c30\u0c4d \u0c24\u0c30\u0c1a\u0c41\u0c17\u0c3e \u0c35\u0c1a\u0c4d\u0c1a\u0c47 \u0c32\u0c4b\u0c15\u0c32\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d-\u0c1f\u0c41-\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32 \u0c15\u0c4b\u0c38\u0c02.","Owner Profile \xb7 Email Address Missing":"\u0c2f\u0c1c\u0c2e\u0c3e\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \xb7 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c32\u0c47\u0c26\u0c41","\ud83c\udd7f\ufe0f Fastag & Tolls":"\ud83c\udd7f\ufe0f \u0c2b\u0c3e\u0c38\u0c4d\u0c1f\u0c3e\u0c17\u0c4d & \u0c1f\u0c4b\u0c32\u0c4d\u0c38\u0c4d","PAN Card (Tax Proof)":"PAN \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d (\u0c2a\u0c28\u0c4d\u0c28\u0c41 \u0c30\u0c41\u0c1c\u0c41\u0c35\u0c41)","PAN Card Verification":"PAN \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23","PAN Number":"PAN \u0c28\u0c02\u0c2c\u0c30\u0c4d","PAN number is required":"PAN \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c05\u0c35\u0c38\u0c30\u0c02",Partner:"\u0c2a\u0c3e\u0c30\u0c4d\u0c1f\u0c28\u0c30\u0c4d","Partner Mobile":"\u0c2a\u0c3e\u0c30\u0c4d\u0c1f\u0c28\u0c30\u0c4d \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d","Passenger has visually confirmed the final closing meter reading":"\u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c40\u0c1f\u0c30\u0c4d \u0c30\u0c40\u0c21\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c3f\u0c15\u0c41\u0c21\u0c41 \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c17\u0c3e \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c30\u0c41","Passenger has visually confirmed the starting meter reading":"\u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d \u0c2e\u0c40\u0c1f\u0c30\u0c4d \u0c30\u0c40\u0c21\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c3f\u0c15\u0c41\u0c21\u0c41 \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c17\u0c3e \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c30\u0c41","passenger seats":"\u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c3f\u0c15\u0c41\u0c32 \u0c38\u0c40\u0c1f\u0c4d\u0c32\u0c41","passenger seats.":"\u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c3f\u0c15\u0c41\u0c32 \u0c38\u0c40\u0c1f\u0c4d\u0c32\u0c41.","Password Mismatch":"\u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c32\u0c47\u0c26\u0c41","Pay the full yearly fee once and stop the monthly auto-debit":"\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c35\u0c3e\u0c30\u0c4d\u0c37\u0c3f\u0c15 \u0c30\u0c41\u0c38\u0c41\u0c2e\u0c41\u0c28\u0c41 \u0c12\u0c15\u0c47\u0c38\u0c3e\u0c30\u0c3f \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c3f \u0c28\u0c46\u0c32\u0c35\u0c3e\u0c30\u0c40 \u0c06\u0c1f\u0c4b-\u0c21\u0c46\u0c2c\u0c3f\u0c1f\u0c4d \u0c06\u0c2a\u0c02\u0c21\u0c3f","Payment & Bank Details":"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 & \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41","Payment could not be processed":"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c2a\u0c4d\u0c30\u0c3e\u0c38\u0c46\u0c38\u0c4d \u0c15\u0c3e\u0c32\u0c47\u0c26\u0c41","Payment Details":"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41","Payment verification failed":"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c35\u0c3f\u0c2b\u0c32\u0c2e\u0c48\u0c02\u0c26\u0c3f","Payout Account":"\u0c2a\u0c47\u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c16\u0c3e\u0c24\u0c3e","Payout Amount (\u0ba4\u0bca\u0b95\u0bc8)":"\u0c2a\u0c47\u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02","Payout bank account & payment details saved successfully.":"\u0c2a\u0c47\u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c16\u0c3e\u0c24\u0c3e & \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c38\u0c47\u0c35\u0c4d \u0c05\u0c2f\u0c4d\u0c2f\u0c3e\u0c2f\u0c3f.","Payout Method (\u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0bb1\u0bc8)":"\u0c2a\u0c47\u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c2a\u0c26\u0c4d\u0c27\u0c24\u0c3f","Payout Requested":"\u0c2a\u0c47\u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f","Payouts, account credits/debits, and wallet balance updates":"\u0c2a\u0c47\u0c05\u0c35\u0c41\u0c1f\u0c4d\u200c\u0c32\u0c41, \u0c16\u0c3e\u0c24\u0c3e \u0c15\u0c4d\u0c30\u0c46\u0c21\u0c3f\u0c1f\u0c4d/\u0c21\u0c46\u0c2c\u0c3f\u0c1f\u0c4d\u200c\u0c32\u0c41, \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c32\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d\u200c\u0c32\u0c41",Pending:"\u0c2a\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c17\u0c4d","Pending orders endpoint not found.":"\u0c2a\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d\u200c\u0c32 \u0c0e\u0c02\u0c21\u0c4d\u200c\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41.","Pending Passenger Requests (":"\u0c2a\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c3f\u0c15\u0c41\u0c32 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32\u0c41 (","PENDING SEAT REQUEST":"\u0c2a\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c40\u0c1f\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28","Pending Verification":"\u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c2a\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c17\u0c4d","Per KM Rate":"\u0c15\u0c3f.\u0c2e\u0c40. \u0c30\u0c47\u0c1f\u0c41","Per-Km Booking (10% Commission):":"\u0c15\u0c3f.\u0c2e\u0c40. \u0c06\u0c27\u0c3e\u0c30\u0c3f\u0c24 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d (10% \u0c15\u0c2e\u0c3f\u0c37\u0c28\u0c4d):","Permission Denied":"\u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f \u0c28\u0c3f\u0c30\u0c3e\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f","Permission needed":"\u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c02","Permit Charges":"\u0c2a\u0c30\u0c4d\u0c2e\u0c3f\u0c1f\u0c4d \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c41","Personal & Business Info":"\u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 & \u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02","Personal, KYC & Account details":"\u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24, KYC & \u0c16\u0c3e\u0c24\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41","Pet Friendly Vehicle":"\u0c2a\u0c46\u0c02\u0c2a\u0c41\u0c21\u0c41 \u0c1c\u0c02\u0c24\u0c41\u0c35\u0c41\u0c32\u0c15\u0c41 \u0c05\u0c28\u0c41\u0c15\u0c42\u0c32 \u0c35\u0c3e\u0c39\u0c28\u0c02","Phone Number":"\u0c2b\u0c4b\u0c28\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d","Phone sign-in isn\u2019t available on this build yet. Please use Mobile Number + Password.":"\u0c08 \u0c35\u0c46\u0c30\u0c4d\u0c37\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c2b\u0c4b\u0c28\u0c4d \u0c38\u0c48\u0c28\u0c4d-\u0c07\u0c28\u0c4d \u0c07\u0c02\u0c15\u0c3e \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c41. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d + \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c35\u0c3e\u0c21\u0c02\u0c21\u0c3f.","Photo Captured":"\u0c2b\u0c4b\u0c1f\u0c4b \u0c24\u0c40\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f","Photo doesn't clearly match the licence photo ({0}%).":"\u0c2b\u0c4b\u0c1f\u0c4b \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c2b\u0c4b\u0c1f\u0c4b\u0c24\u0c4b \u0c38\u0c4d\u0c2a\u0c37\u0c4d\u0c1f\u0c02\u0c17\u0c3e \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c32\u0c47\u0c26\u0c41 ({0}%).","Photo library permission is required to select photos.":"\u0c2b\u0c4b\u0c1f\u0c4b\u0c32\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2b\u0c4b\u0c1f\u0c4b \u0c32\u0c48\u0c2c\u0c4d\u0c30\u0c30\u0c40 \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c02.","Photo Saved":"\u0c2b\u0c4b\u0c1f\u0c4b \u0c38\u0c47\u0c35\u0c4d \u0c05\u0c2f\u0c3f\u0c02\u0c26\u0c3f",Pick:"\u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f","Pick up a Drop Cars booking from the open list and assign it to yo
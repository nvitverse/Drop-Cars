47\u0902 \u0926\u0947\u0916\u0947\u0902","View Vehicle Options":"\u0917\u093e\u0921\u093c\u0940 \u0915\u0947 \u0935\u093f\u0915\u0932\u094d\u092a \u0926\u0947\u0916\u0947\u0902","vs last week":"\u092a\u093f\u091b\u0932\u0947 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0940 \u0924\u0941\u0932\u0928\u093e \u092e\u0947\u0902",Wait:"\u0930\u0941\u0915\u0947\u0902","Waiting > 12h":"\u0907\u0902\u0924\u091c\u093c\u093e\u0930 > 12 \u0918\u0902\u091f\u0947","Waiting Charge":"\u0935\u0947\u091f\u093f\u0902\u0917 \u0936\u0941\u0932\u094d\u0915","Waiting Charges":"\u0935\u0947\u091f\u093f\u0902\u0917 \u0936\u0941\u0932\u094d\u0915","Waiting for a driver to accept this booking.":"\u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0939\u0948\u0964","Waiting for Drop Cars admin to review your request to use a different car.":"\u0926\u0942\u0938\u0930\u0940 \u0917\u093e\u0921\u093c\u0940 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0906\u092a\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0940 Drop Cars \u090f\u0921\u092e\u093f\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0939\u0948\u0964","Waiting for your fleet owner to assign a cab & driver.":"\u0915\u0948\u092c \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0947 \u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0939\u0948\u0964","Wallet balance: \u20b9":"\u0935\u0949\u0932\u0947\u091f \u092c\u0948\u0932\u0947\u0902\u0938: \u20b9","Wallet balance: \u20b9{0}":"\u0935\u0949\u0932\u0947\u091f \u092c\u0948\u0932\u0947\u0902\u0938: \u20b9{0}","Wallet entry":"\u0935\u0949\u0932\u0947\u091f \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f\u093f","Wallet Security Hold":"\u0935\u0949\u0932\u0947\u091f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0939\u094b\u0932\u094d\u0921","We could not load the details of this entry right now. Please try again in a moment.":"\u0907\u0938 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f\u093f \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u0905\u092d\u0940 \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u0925\u094b\u0921\u093c\u0940 \u0926\u0947\u0930 \u092e\u0947\u0902 \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","We extracted: {0}. All fields are fully editable below. Please review and make any needed corrections.":"\u0939\u092e\u0928\u0947 \u092f\u0939 \u0928\u093f\u0915\u093e\u0932\u093e: {0}\u0964 \u0938\u092d\u0940 \u092b\u093c\u0940\u0932\u094d\u0921 \u0928\u0940\u091a\u0947 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0902\u092a\u093e\u0926\u0928 \u092f\u094b\u0917\u094d\u092f \u0939\u0948\u0902\u0964 \u0915\u0943\u092a\u092f\u093e \u091c\u093e\u0901\u091a\u0947\u0902 \u0914\u0930 \u091c\u093c\u0930\u0942\u0930\u0940 \u0938\u0941\u0927\u093e\u0930 \u0915\u0930\u0947\u0902\u0964","We will send a 6-digit code to the email saved on your account.":"\u0939\u092e \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u0938\u0947\u0935 \u0908\u092e\u0947\u0932 \u092a\u0930 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u092d\u0947\u091c\u0947\u0902\u0917\u0947\u0964","We will send a 6-digit code to this email to confirm it is yours.":"\u092f\u0939 \u0906\u092a\u0915\u093e \u0939\u0940 \u0939\u0948 \u0907\u0938\u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0947 \u0932\u093f\u090f \u0939\u092e \u0907\u0938 \u0908\u092e\u0947\u0932 \u092a\u0930 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u092d\u0947\u091c\u0947\u0902\u0917\u0947\u0964","We will send a 6-digit code to your registered email.":"\u0939\u092e \u0906\u092a\u0915\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0908\u092e\u0947\u0932 \u092a\u0930 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u092d\u0947\u091c\u0947\u0902\u0917\u0947\u0964","We will send a 6-digit verification code to the email address registered with this mobile number.":"\u0939\u092e \u0907\u0938 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0908\u092e\u0947\u0932 \u092a\u0924\u0947 \u092a\u0930 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u094b\u0921 \u092d\u0947\u091c\u0947\u0902\u0917\u0947\u0964","We will send a 6-digit verification code to your new email address to confirm ownership before submitting for Admin Review.":"\u090f\u0921\u092e\u093f\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u092e\u0947\u0902 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u094d\u0935\u093e\u092e\u093f\u0924\u094d\u0935 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0947 \u0932\u093f\u090f \u0939\u092e \u0906\u092a\u0915\u0947 \u0928\u090f \u0908\u092e\u0947\u0932 \u092a\u0924\u0947 \u092a\u0930 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u094b\u0921 \u092d\u0947\u091c\u0947\u0902\u0917\u0947\u0964",Website:"\u0935\u0947\u092c\u0938\u093e\u0907\u091f","Welcome back,":"\u0935\u093e\u092a\u0938\u0940 \u092a\u0930 \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948,","WhatsApp Fleet Help Desk":"WhatsApp \u092b\u094d\u0932\u0940\u091f \u0939\u0947\u0932\u094d\u092a \u0921\u0947\u0938\u094d\u0915","WhatsApp Not Installed":"WhatsApp \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948","When a customer accepts your bid offer, confirmed trip details & direct booking links will appear right here!":"\u091c\u092c \u0917\u094d\u0930\u093e\u0939\u0915 \u0906\u092a\u0915\u0940 \u092c\u094b\u0932\u0940 \u0915\u093e \u0911\u092b\u093c\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0917\u093e, \u0924\u094b \u092a\u0915\u094d\u0915\u0940 \u091f\u094d\u0930\u093f\u092a \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u0914\u0930 \u0938\u0940\u0927\u0947 \u092c\u0941\u0915\u093f\u0902\u0917 \u0932\u093f\u0902\u0915 \u092f\u0939\u0940\u0902 \u0926\u093f\u0916\u0947\u0902\u0917\u0947!","When passengers request seats on any of your active rides, they will appear here for instant 1-tap approval.":"\u091c\u092c \u092f\u093e\u0924\u094d\u0930\u0940 \u0906\u092a\u0915\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u091f\u094d\u0930\u093f\u092a \u092e\u0947\u0902 \u0938\u0940\u091f \u092e\u093e\u0901\u0917\u0947\u0902\u0917\u0947, \u0924\u094b \u090f\u0915 \u091f\u0948\u092a \u0915\u0940 \u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0901 \u0926\u093f\u0916\u0947\u0902\u0917\u0947\u0964","Which booking is this about? Pick one - it opens that trip's Vendor/Owner chat.":"\u092f\u0939 \u0915\u093f\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0939\u0948? \u090f\u0915 \u091a\u0941\u0928\u0947\u0902 - \u0909\u0938 \u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u0935\u0947\u0902\u0921\u0930/\u092e\u093e\u0932\u093f\u0915 \u0915\u0940 \u091a\u0948\u091f \u0916\u0941\u0932\u0947\u0917\u0940\u0964","will be forfeited as a cancellation penalty and will NOT be refunded.":"\u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u0947 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u092c\u094d\u0924 \u0939\u094b\u0917\u093e \u0914\u0930 \u0935\u093e\u092a\u0938 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964","will be held from my wallet to guarantee this booking until trip completion.":"\u091f\u094d\u0930\u093f\u092a \u092a\u0942\u0930\u0940 \u0939\u094b\u0928\u0947 \u0924\u0915 \u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0940 \u0917\u093e\u0930\u0902\u091f\u0940 \u0915\u0947 \u0932\u093f\u090f \u092e\u0947\u0930\u0947 \u0935\u0949\u0932\u0947\u091f \u0938\u0947 \u0939\u094b\u0932\u094d\u0921 \u0930\u0939\u0947\u0917\u093e\u0964","will be held in wallet as a security deposit until trip completion.":"\u091f\u094d\u0930\u093f\u092a \u092a\u0942\u0930\u0940 \u0939\u094b\u0928\u0947 \u0924\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091c\u092e\u093e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0935\u0949\u0932\u0947\u091f \u092e\u0947\u0902 \u0939\u094b\u0932\u094d\u0921 \u0930\u0939\u0947\u0917\u093e\u0964","will incur a mandatory":"\u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u0932\u0917\u0947\u0917\u093e","will notify you.":"\u0906\u092a\u0915\u094b \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0947\u0917\u093e\u0964","with at least":"\u0915\u092e \u0938\u0947 \u0915\u092e \u0915\u0947 \u0938\u093e\u0925","Withdraw wallet balance directly to Bank / UPI":"\u0935\u0949\u0932\u0947\u091f \u092c\u0948\u0932\u0947\u0902\u0938 \u0938\u0940\u0927\u0947 \u092c\u0948\u0902\u0915 / UPI \u092e\u0947\u0902 \u0928\u093f\u0915\u093e\u0932\u0947\u0902","Worked out from the kilometres and amounts recorded when the trip was closed.":"\u091f\u094d\u0930\u093f\u092a \u092c\u0902\u0926 \u0939\u094b\u0924\u0947 \u0938\u092e\u092f \u0926\u0930\u094d\u091c \u0915\u093f\u092e\u0940 \u0914\u0930 \u0930\u093e\u0936\u093f\u092f\u094b\u0902 \u0938\u0947 \u0928\u093f\u0915\u093e\u0932\u093e \u0917\u092f\u093e\u0964","Write the reason":"\u0915\u093e\u0930\u0923 \u0932\u093f\u0916\u0947\u0902","Yearly fee due in {0} days":"\u0938\u093e\u0932\u093e\u0928\u093e \u0936\u0941\u0932\u094d\u0915 {0} \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0926\u0947\u092f \u0939\u0948","Yearly fee OVERDUE by {0} days":"\u0938\u093e\u0932\u093e\u0928\u093e \u0936\u0941\u0932\u094d\u0915 {0} \u0926\u093f\u0928 \u0938\u0947 \u092c\u0915\u093e\u092f\u093e \u0939\u0948","Yes, Cancel":"\u0939\u093e\u0901, \u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902","Yes, Still Waiting":"\u0939\u093e\u0901, \u0905\u092d\u0940 \u092d\u0940 \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u092e\u0947\u0902 \u0939\u0942\u0901","You are currently active & available to execute duty rides.":"\u0906\u092a \u0905\u092d\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0902 \u0914\u0930 \u0921\u094d\u092f\u0942\u091f\u0940 \u091f\u094d\u0930\u093f\u092a \u091a\u0932\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902\u0964","You can now accept Booking #":"\u0905\u092c \u0906\u092a \u092c\u0941\u0915\u093f\u0902\u0917 # \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902","You can set vacant waiting cities for your vehicle.":"\u0906\u092a \u0905\u092a\u0928\u0940 \u0917\u093e\u0921\u093c\u0940 \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0935\u093e\u0932\u0947 \u0936\u0939\u0930 \u0938\u0947\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","You cancelled this accepted booking.":"\u0906\u092a\u0928\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0940 \u0939\u0941\u0908 \u092f\u0939 \u092c\u0941\u0915\u093f\u0902\u0917 \u0930\u0926\u094d\u0926 \u0915\u0940\u0964","You collect the full trip fare (\u20b9":"\u0906\u092a \u092a\u0942\u0930\u093e \u091f\u094d\u0930\u093f\u092a \u0915\u093f\u0930\u093e\u092f\u093e \u0935\u0938\u0942\u0932\u0924\u0947 \u0939\u0948\u0902 (\u20b9","You don't have an active booking right now - once you accept one, its Vendor/Owner chat opens automatically.":"\u0905\u092d\u0940 \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f \u092c\u0941\u0915\u093f\u0902\u0917 \u0928\u0939\u0940\u0902 \u0939\u0948 - \u090f\u0915 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0940 \u0909\u0938\u0915\u0947 \u0935\u0947\u0902\u0921\u0930/\u092e\u093e\u0932\u093f\u0915 \u0915\u0940 \u091a\u0948\u091f \u0905\u092a\u0928\u0947 \u0906\u092a \u0916\u0941\u0932\u0947\u0917\u0940\u0964","You don't have any":"\u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948","You drove {0} km, but this route is about {1} km. Please tell us why. The trip is not stopped - the booking owner and Drop Cars will see your reason.":"\u0906\u092a\u0928\u0947 {0} \u0915\u093f\u092e\u0940 \u091a\u0932\u093e\u090f, \u092a\u0930 \u092f\u0939 \u0930\u0942\u091f \u0932\u0917\u092d\u0917 {1} \u0915\u093f\u092e\u0940 \u0915\u093e \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0915\u093e\u0930\u0923 \u092c\u0924\u093e\u090f\u0901\u0964 \u091f\u094d\u0930\u093f\u092a \u0930\u0941\u0915\u0947\u0917\u0940 \u0928\u0939\u0940\u0902 - \u092c\u0941\u0915\u093f\u0902\u0917 \u092e\u093e\u0932\u093f\u0915 \u0914\u0930 Drop Cars \u0906\u092a\u0915\u093e \u0915\u093e\u0930\u0923 \u0926\u0947\u0916\u0947\u0902\u0917\u0947\u0964","You earned":"\u0906\u092a\u0928\u0947 \u0915\u092e\u093e\u092f\u093e","You have a car that fits this":"\u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u0917\u093e\u0921\u093c\u0940 \u0939\u0948","You have already accepted {0} bookings. Please assign driver and car to your accepted bookings before accepting new ones.":"\u0906\u092a \u092a\u0939\u0932\u0947 \u0939\u0940 {0} \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964 \u0928\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0940 \u0917\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u092e\u0947\u0902 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0917\u093e\u0921\u093c\u0940 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902\u0964","You have an assigned trip active or scheduled within 1 hour. You must remain On Duty until the trip is completed.":"1 \u0918\u0902\u091f\u0947 \u0915\u0947 \u092d\u0940\u0924\u0930 \u090f\u0915 \u0905\u0938\u093e\u0907\u0928 \u092f\u093e \u0924\u092f \u091f\u094d\u0930\u093f\u092a \u0939\u0948\u0964 \u091f\u094d\u0930\u093f\u092a \u092a\u0942\u0930\u0940 \u0939\u094b\u0928\u0947 \u0924\u0915 \u0906\u092a\u0915\u094b \u0921\u094d\u092f\u0942\u091f\u0940 \u092a\u0930 \u0930\u0939\u0928\u093e \u0939\u094b\u0917\u093e\u0964","You haven't submitted any bids yet. Switch to the Live tab to place bids on customer requests!":"\u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0915\u094b\u0908 \u092c\u094b\u0932\u0940 \u091c\u092e\u093e \u0928\u0939\u0940\u0902 \u0915\u0940 \u0939\u0948\u0964 \u0917\u094d\u0930\u093e\u0939\u0915 \u0905\u0928\u0941\u0930\u094b\u0927\u094b\u0902 \u092a\u0930 \u092c\u094b\u0932\u0940 \u0932\u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0932\u093e\u0907\u0935 \u091f\u0948\u092c \u092a\u0930 \u091c\u093e\u090f\u0901!","You keep":"\u0906\u092a \u0930\u0916\u0924\u0947 \u0939\u0948\u0902","You must add and verify an email address before resetting or changing your password.":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f \u092f\u093e \u092c\u0926\u0932\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u091c\u094b\u0921\u093c\u0915\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964",Your:"\u0906\u092a\u0915\u093e","Your account is ready. Start exploring the app!":"\u0906\u092a\u0915\u093e \u0916\u093e\u0924\u093e \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964 \u0910\u092a \u0926\u0947\u0916\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902!","Your alternate mobile number request (+91 {0}) has been submitted for Admin Review.":"\u0906\u092a\u0915\u093e \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0905\u0928\u0941\u0930\u094b\u0927 (+91 {0}) \u090f\u0921\u092e\u093f\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u092e\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964","Your bank account / IFSC change request has been submitted to the Admin Review Queue and is pending approval.":"\u0906\u092a\u0915\u093e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e / IFSC \u092c\u0926\u0932\u093e\u0935 \u0905\u0928\u0941\u0930\u094b\u0927 \u090f\u0921\u092e\u093f\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0924\u093e\u0930 \u092e\u0947\u0902 \u092d\u0947\u091c\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u0932\u0902\u092c\u093f\u0924 \u0939\u0948\u0964","Your Bid: \u20b9":"\u0906\u092a\u0915\u0940 \u092c\u094b\u0932\u0940: \u20b9","Your city (e.g. Chennai)":"\u0906\u092a\u0915\u093e \u0936\u0939\u0930 (\u091c\u0948\u0938\u0947 \u091a\u0947\u0928\u094d\u0928\u0908)","Your current password":"\u0906\u092a\u0915\u093e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921","Your Earning":"\u0906\u092a\u0915\u0940 \u0915\u092e\u093e\u0908","Your Email Address":"\u0906\u092a\u0915\u093e \u0908\u092e\u0947\u0932 \u092a\u0924\u093e","Your email address has been successfully verified.":"\u0906\u092a\u0915\u093e \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0939\u094b \u0917\u092f\u093e\u0964","Your email is verified and saved. You can now reset your password with it.":"\u0906\u092a\u0915\u093e \u0908\u092e\u0947\u0932 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0939\u094b\u0915\u0930 \u0938\u0947\u0935 \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0905\u092c \u0906\u092a \u0907\u0938\u0938\u0947 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Your empty trips carry":"\u0906\u092a\u0915\u0940 \u0916\u093e\u0932\u0940 \u091f\u094d\u0930\u093f\u092a \u092e\u0947\u0902 \u092e\u093f\u0932\u0924\u093e \u0939\u0948","Your fare:":"\u0906\u092a\u0915\u093e \u0915\u093f\u0930\u093e\u092f\u093e:","Your Fleet Partner account has been upgraded to {0} Trusted Partner status!":"\u0906\u092a\u0915\u093e \u092b\u094d\u0932\u0940\u091f \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0916\u093e\u0924\u093e {0} \u091f\u094d\u0930\u0938\u094d\u091f\u0947\u0921 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0938\u094d\u0924\u0930 \u092a\u0930 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0939\u094b \u0917\u092f\u093e \u0939\u0948!","Your KYC (Aadhar + PAN) must be verified before you can accept bookings. Check Settings > Profile.":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0906\u092a\u0915\u093e KYC (\u0906\u0927\u093e\u0930 + PAN) \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 > \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0926\u0947\u0916\u0947\u0902\u0964","Your message has been created as a Chat thread in Drop Cars Admin App. Our support team will review your account (+91":"\u0906\u092a\u0915\u093e \u0938\u0902\u0926\u0947\u0936 Drop Cars \u090f\u0921\u092e\u093f\u0928 \u0910\u092a \u092e\u0947\u0902 \u091a\u0948\u091f \u0925\u094d\u0930\u0947\u0921 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092c\u0928 \u0917\u092f\u093e \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0940 \u0938\u092a\u094b\u0930\u094d\u091f \u091f\u0940\u092e \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0917\u0940 (+91","Your mobile number change request (+91 {0}) has been submitted to Drop Cars Admin for review & approval.":"\u0906\u092a\u0915\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092c\u0926\u0932\u093e\u0935 \u0905\u0928\u0941\u0930\u094b\u0927 (+91 {0}) \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0914\u0930 \u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f Drop Cars \u090f\u0921\u092e\u093f\u0928 \u0915\u094b \u091c\u092e\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964","Your name as driver":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0928\u093e\u092e","Your name is updated. It now shows on your trips and reviews.":"\u0906\u092a\u0915\u093e \u0928\u093e\u092e \u0905\u092a\u0921\u0947\u091f \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0905\u092c \u092f\u0939 \u0906\u092a\u0915\u0940 \u091f\u094d\u0930\u093f\u092a \u0914\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u0913\u0902 \u092e\u0947\u0902 \u0926\u093f\u0916\u0947\u0917\u093e\u0964","Your offer of \u20b9{0}{1} has been sent to {2}.":"\u20b9{0}{1} \u0915\u093e \u0911\u092b\u093c\u0930 {2} \u0915\u094b \u092d\u0947\u091c \u0926\u093f\u092f\u093e \u0917\u092f\u093e\u0964","Your ownership of '{0}' was verified! The request has been submitted for final Admin Review.":"'{0}' \u092a\u0930 \u0906\u092a\u0915\u093e \u0938\u094d\u0935\u093e\u092e\u093f\u0924\u094d\u0935 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0939\u094b \u0917\u092f\u093e! \u0905\u0928\u0941\u0930\u094b\u0927 \u0905\u0902\u0924\u093f\u092e \u090f\u0921\u092e\u093f\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u092e\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964","Your password has been changed successfully.":"\u0906\u092a\u0915\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092c\u0926\u0932 \u0917\u092f\u093e\u0964","Your password has been changed.":"\u0906\u092a\u0915\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0926\u0932 \u0917\u092f\u093e\u0964","Your payment details have been saved.":"\u0906\u092a\u0915\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0935\u0930\u0923 \u0938\u0947\u0935 \u0939\u094b \u0917\u090f\u0964","Your profile update request has been submitted to Drop Cars Admin. Our verification team will review and update your profile shortly.":"\u0906\u092a\u0915\u093e \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0905\u092a\u0921\u0947\u091f \u0905\u0928\u0941\u0930\u094b\u0927 Drop Cars \u090f\u0921\u092e\u093f\u0928 \u0915\u094b \u091c\u092e\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u091f\u0940\u092e \u091c\u0932\u094d\u0926 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0917\u0940\u0964","Your referral code":"\u0906\u092a\u0915\u093e \u0930\u0947\u092b\u093c\u0930\u0932 \u0915\u094b\u0921","YOUR REFERRAL CODE":"\u0906\u092a\u0915\u093e \u0930\u0947\u092b\u093c\u0930\u0932 \u0915\u094b\u0921","YOUR REGISTERED FLEET (":"\u0906\u092a\u0915\u093e \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092b\u094d\u0932\u0940\u091f (","Your request has been registered. You can chat directly with the vendor right now to get this booking approved!":"\u0906\u092a\u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0926\u0930\u094d\u091c \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0940 \u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a \u0905\u092d\u0940 \u0935\u0947\u0902\u0921\u0930 \u0938\u0947 \u0938\u0940\u0927\u0947 \u091a\u0948\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902!","Your request has been submitted to Drop Cars Admin. Our support team will review and update your profile shortly.":"\u0906\u092a\u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 Drop Cars \u090f\u0921\u092e\u093f\u0928 \u0915\u094b \u091c\u092e\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0940 \u0938\u092a\u094b\u0930\u094d\u091f \u091f\u0940\u092e \u091c\u0932\u094d\u0926 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0917\u0940\u0964","Your request to update Full Name to '{0}' has been submitted for Admin Review.":"\u092a\u0942\u0930\u093e \u0928\u093e\u092e '{0}' \u0915\u0930\u0928\u0947 \u0915\u093e \u0906\u092a\u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u090f\u0921\u092e\u093f\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u092e\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964","Your request to update Travels / Business Name to '{0}' has been submitted for Admin Review.":"\u091f\u094d\u0930\u0948\u0935\u0932\u094d\u0938 / \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u0915\u093e \u0928\u093e\u092e '{0}' \u0915\u0930\u0928\u0947 \u0915\u093e \u0906\u092a\u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u090f\u0921\u092e\u093f\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u092e\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964","Your scheduled trip starts in 30 minutes. Please be ready!":"\u0906\u092a\u0915\u0940 \u0924\u092f \u091f\u094d\u0930\u093f\u092a 30 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0936\u0941\u0930\u0942 \u0939\u094b\u0917\u0940\u0964 \u0924\u0948\u092f\u093e\u0930 \u0930\u0939\u0947\u0902!","Your share (poster)":"\u0906\u092a\u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e (\u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e)","Your vacant location update was logged over 12 hours ago. Are you still available for trips in":"\u0906\u092a\u0915\u093e \u0916\u093e\u0932\u0940 \u0932\u094b\u0915\u0947\u0936\u0928 \u0905\u092a\u0921\u0947\u091f 12 \u0918\u0902\u091f\u0947 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092a\u0939\u0932\u0947 \u0926\u0930\u094d\u091c \u0939\u0941\u0906 \u0925\u093e\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u0905\u092d\u0940 \u092d\u0940 \u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902:","Your vehicle or driver documents are expired or pending verification.":"\u0906\u092a\u0915\u0940 \u0917\u093e\u0921\u093c\u0940 \u092f\u093e \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b \u0917\u090f \u0939\u0948\u0902 \u092f\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0932\u0902\u092c\u093f\u0924 \u0939\u0948\u0964","Your wallet holds this amount (not charged) and returns it when the trip completes or you cancel.":"\u0906\u092a\u0915\u093e \u0935\u0949\u0932\u0947\u091f \u092f\u0939 \u0930\u093e\u0936\u093f \u0939\u094b\u0932\u094d\u0921 \u0915\u0930\u0924\u093e \u0939\u0948 (\u0915\u093e\u091f\u0924\u093e \u0928\u0939\u0940\u0902) \u0914\u0930 \u091f\u094d\u0930\u093f\u092a \u092a\u0942\u0930\u0940 \u0939\u094b\u0928\u0947 \u092f\u093e \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0932\u094c\u091f\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964","Your wallet must have \u20b9":"\u0906\u092a\u0915\u0947 \u0935\u0949\u0932\u0947\u091f \u092e\u0947\u0902 \u0915\u092e \u0938\u0947 \u0915\u092e \u20b9 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f","Your wallet needs to cover the advance you marked as received (held, not charged).":"\u0906\u092a\u0928\u0947 \u091c\u094b \u0905\u0917\u094d\u0930\u093f\u092e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u091a\u093f\u0939\u094d\u0928\u093f\u0924 \u0915\u093f\u092f\u093e \u0909\u0938\u0947 \u092a\u0942\u0930\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u0949\u0932\u0947\u091f \u092e\u0947\u0902 \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0930\u093e\u0936\u093f \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f (\u0939\u094b\u0932\u094d\u0921, \u0915\u091f\u094c\u0924\u0940 \u0928\u0939\u0940\u0902)\u0964","yourname@upi":"yourname@upi","zero penalty":"\u0936\u0942\u0928\u094d\u092f \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e","ZERO-COST IN-APP MASKED CALLING":"\u092e\u0941\u092b\u093c\u094d\u0924 \u0907\u0928-\u0910\u092a \u091b\u093f\u092a\u0940 \u0939\u0941\u0908 \u0915\u0949\u0932\u093f\u0902\u0917","Zoom -":"\u091c\u093c\u0942\u092e -","Zoom +":"\u091c\u093c\u0942\u092e +","\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bcb\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8 \u0baa\u0bc6\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bc1\u0b9f\u0ba9\u0bcd \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0bbe\u0b95\u0bbf (Admin) \u0ba8\u0bc7\u0bb0\u0b9f\u0bbf\u0baf\u0bbe\u0b95 \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd.":"\u0906\u092a\u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u092e\u093f\u0932\u0924\u0947 \u0939\u0940 \u090f\u0921\u092e\u093f\u0928 \u0938\u0940\u0927\u0947 \u091c\u093e\u0901\u091a\u0915\u0930 \u0906\u092a\u0915\u0947 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u092d\u0947\u091c \u0926\u0947\u0902\u0917\u0947\u0964","\u0b9a\u0bb5\u0bbe\u0bb0\u0bbf \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bbe\u0bb3\u0bb0\u0bbf\u0b9f\u0bae\u0bcd End OTP \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0bc1 \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4 \u0b85\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0bb5\u0bbf\u0ba9\u0bbe\u0b9f\u0bbf\u0baf\u0bc7, \u0bb9\u0bcb\u0bb2\u0bcd\u0b9f\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u20b9500 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd Available Balance-\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0ba9\u0b9f\u0bbf\u0baf\u0bbe\u0b95 \u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bbf\u0bb5\u0bbf\u0b9f\u0bc1\u0bae\u0bcd.":"\u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u0905\u0902\u0924 \u092e\u0947\u0902 \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947 End OTP \u0932\u0947\u0915\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0940, \u0939\u094b\u0932\u094d\u0921 \u0915\u093f\u090f \u20b9500 \u0924\u0941\u0930\u0902\u0924 \u0906\u092a\u0915\u0947 Available Balance \u092e\u0947\u0902 \u0932\u094c\u091f \u0906\u0924\u0947 \u0939\u0948\u0902\u0964","\u0b9a\u0bb5\u0bbe\u0bb0\u0bbf\u0baf\u0bc8 \u0b89\u0bb1\u0bc1\u0ba4\u0bbf\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bc1 \u0b95\u0bbe\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9f\u0bbf\u0bb0\u0bc8\u0bb5\u0bb0\u0bcd Assign \u0b86\u0ba9 \u0baa\u0bbf\u0bb1\u0b95\u0bc1 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb0\u0ba4\u0bcd\u0ba4\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd, \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0bb5\u0bbe\u0b95\u0ba9\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u0b9f\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0baf \u20b9500 \u0b95\u0b9f\u0bcd\u0b9f\u0ba3\u0bae\u0bcd \u0baa\u0bbf\u0b9f\u0bbf\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd.":"\u091f\u094d\u0930\u093f\u092a \u092a\u0915\u094d\u0915\u0940 \u0939\u094b\u0915\u0930 \u0917\u093e\u0921\u093c\u0940 \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 Assign \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0906\u0
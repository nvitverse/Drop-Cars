1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6.","Assignment Deadline":"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0ca8\u0cc6 \u0c97\u0ca1\u0cc1\u0cb5\u0cc1","You must assign a driver & car to this booking soon after accepting \u2014 you'll have {duration} (until {time}), or the held amount will be deducted as a penalty.":"\u0c92\u0caa\u0ccd\u0caa\u0cbf\u0ca6 \u0c95\u0cc2\u0ca1\u0cb2\u0cc7 \u0c88 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cc6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c95\u0cbe\u0cb0\u0cc1 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1 \u2014 \u0ca8\u0cbf\u0cae\u0c97\u0cc6 {duration} \u0cb8\u0cae\u0caf \u0c87\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 ({time} \u0cb5\u0cb0\u0cc6\u0c97\u0cc6), \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0cb9\u0ccb\u0cb2\u0ccd\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0ca6\u0c82\u0ca1\u0cb5\u0cbe\u0c97\u0cbf \u0c95\u0ca1\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Driver Tariff":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0ca6\u0cb0","Customer Tariff":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0ca6\u0cb0","Final Closed Amount":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0cae\u0cc1\u0c9a\u0ccd\u0c9a\u0cbf\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4","Close the trip within 10% of the booked distance (up to {max} km).":"\u0cac\u0cc1\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca6\u0cc2\u0cb0\u0ca6 10% \u0c92\u0cb3\u0c97\u0cc6 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cbf ({max} \u0c95\u0cbf.\u0cae\u0cc0. \u0cb5\u0cb0\u0cc6\u0c97\u0cc6).",Menu:"\u0cae\u0cc6\u0ca8\u0cc1","My Cars":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c95\u0cbe\u0cb0\u0cc1\u0c97\u0cb3\u0cc1","My Drivers":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1","Start Driving":"\u0c9a\u0cbe\u0cb2\u0ca8\u0cc6 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf","Trip History":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8",Transactions:"\u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1\u0c97\u0cb3\u0cc1",Settings:"\u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1",Logout:"\u0cb2\u0cbe\u0c97\u0ccd \u0c94\u0c9f\u0ccd",Language:"\u0cad\u0cbe\u0cb7\u0cc6","Choose your preferred app language":"\u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cad\u0cbe\u0cb7\u0cc6 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","Log in as {name} to manage this trip":"\u0c88 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 {name} \u0c86\u0c97\u0cbf \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Log In":"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd","You're logged in as {name} \u2014 switch to manage this trip":"\u0ca8\u0cc0\u0cb5\u0cc1 {name} \u0c86\u0c97\u0cbf \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0c86\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf \u2014 \u0c88 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf",Switch:"\u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf","Trip completed! Tap Owner above to switch back and accept new bookings or trips.":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6! \u0cb9\u0cca\u0cb8 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cb2\u0cc1 \u0cae\u0cc7\u0cb2\u0cbf\u0ca8 \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0 \u0cae\u0cc7\u0cb2\u0cc6 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf \u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cbf.","Trip completed! Log in to your fleet owner account to accept new bookings or trips.":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6! \u0cb9\u0cca\u0cb8 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Driver Partner":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd","Driver (Fleet)":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd (\u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd)","Duty Driver":"\u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd","Mobile Number:":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:","Password:":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd:","Enter a Valid Number,Must Contain 10 Digits":"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf, 10 \u0c85\u0c82\u0c95\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Signing In...":"\u0cb8\u0cc8\u0ca8\u0ccd \u0c87\u0ca8\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Sign In":"\u0cb8\u0cc8\u0ca8\u0ccd \u0c87\u0ca8\u0ccd",Login:"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd","Forgot Password?":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0cb0\u0cbe?","New Fleet? ":"\u0cb9\u0cca\u0cb8 \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0\u0cc7?","Create Account":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf",Wallet:"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd","Welcome back, {name}!":"\u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb8\u0ccd\u0cb5\u0cbe\u0c97\u0ca4, {name}!","Available Balance":"\u0cb2\u0cad\u0ccd\u0caf \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd","Balance below \u20b91000. Add money to receive bookings.":"\u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u20b91000 \u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0c95\u0ca1\u0cbf\u0cae\u0cc6. \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cb9\u0ca3 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf.","Add money via UPI":"UPI \u0cae\u0cc2\u0cb2\u0c95 \u0cb9\u0ca3 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Request Payout":"\u0caa\u0cc7\u0c94\u0c9f\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cbf","Payout Requests":"\u0caa\u0cc7\u0c94\u0c9f\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cc1","Invalid Amount":"\u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cae\u0cca\u0ca4\u0ccd\u0ca4","Please enter a valid amount":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Current balance: \u20b9{balance}. Admin will transfer this amount to you outside the app and mark it paid here.":"\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd: \u20b9{balance}. \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0c88 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cb9\u0cca\u0cb0\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cbf \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6.","Balance: \u20b9{balance} \xb7 You can redeem up to \u20b9{max} (\u20b9500 must stay in your wallet)":"\u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd: \u20b9{balance} \xb7 \u0ca8\u0cc0\u0cb5\u0cc1 \u20b9{max} \u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0cb0\u0cbf\u0ca1\u0cc0\u0cae\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 (\u20b9500 \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c89\u0cb3\u0cbf\u0caf\u0cac\u0cc7\u0c95\u0cc1)","Enter amount":"\u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Submit Request":"\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf",Requested:"\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Your payout request has been submitted for admin approval.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cc7\u0c94\u0c9f\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0c97\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Scan QR Code to Pay":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cc1 QR \u0c95\u0ccb\u0ca1\u0ccd \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Copy UPI ID":"UPI ID \u0ca8\u0c95\u0cb2\u0cbf\u0cb8\u0cbf","Copied!":"\u0ca8\u0c95\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","UPI ID copied to clipboard":"UPI ID \u0c95\u0ccd\u0cb2\u0cbf\u0caa\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cc6 \u0ca8\u0c95\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Enter amount to add to your wallet":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","\u20b9{amount} will be added to your wallet":"\u20b9{amount} \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0cc7\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","Fee \u20b9{fee} + GST \u20b9{gst}":"\u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u20b9{fee} + GST \u20b9{gst}","Payable now: \u20b9{amount}":"\u0c88\u0c97 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0ca6\u0ca6\u0ccd\u0ca6\u0cc1: \u20b9{amount}","Processing...":"\u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0ca8\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Proceed to Pay":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cc6 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf","Transaction History":"\u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8",All:"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe","Redeems & Payouts":"\u0cb0\u0cbf\u0ca1\u0cc0\u0cae\u0ccd & \u0caa\u0cc7\u0c94\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1","Loading transactions...":"\u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1\u0c97\u0cb3\u0cc1 \u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb5\u0cc6...","No redeems or payouts yet":"\u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0cb0\u0cbf\u0ca1\u0cc0\u0cae\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0cc7\u0c94\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","No transactions yet":"\u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","Session Expired":"\u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6","Your session has expired. Please login again.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",Back:"\u0cb9\u0cbf\u0c82\u0ca6\u0cc6","Forgot Password":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbe","We'll email you a 6-digit code to set a new password. No email linked? Contact the admin.":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0cb5\u0cc6. \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0c86\u0c97\u0cbf\u0cb2\u0ccd\u0cb2\u0cb5\u0cc7? \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf.","Registered mobile number":"\u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","We will send a 6-digit code to the email linked to this account.":"\u0c88 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0c86\u0c97\u0cbf\u0cb0\u0cc1\u0cb5 \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0cb5\u0cc6.","Sending...":"\u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Send Code to Email":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf","6-digit Code:":"6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd:","Code from the email":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0c82\u0ca6 \u0c95\u0ccb\u0ca1\u0ccd","Resend code":"\u0c95\u0ccb\u0ca1\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf","New Password:":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd:","At least 6 characters":"\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 6 \u0c85\u0c95\u0ccd\u0cb7\u0cb0","Confirm New Password:":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf:","Type the same password again":"\u0c85\u0ca6\u0cc7 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0c9f\u0cc8\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Passwords do not match":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb2\u0ccd\u0cb2","Changing Password...":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Change Password":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf",Error:"\u0ca6\u0ccb\u0cb7","Please fill in all the fields":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc1\u0c82\u0cac\u0cbf","Please enter a valid 10-digit mobile number":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","New password must be at least 6 characters":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 6 \u0c85\u0c95\u0ccd\u0cb7\u0cb0 \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Passwords do not match.":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb2\u0ccd\u0cb2.","Code sent. Check the email inbox (and spam).":"\u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c87\u0ca8\u0ccd\u200c\u0cac\u0cbe\u0c95\u0ccd\u0cb8\u0ccd (\u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0cae\u0ccd) \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","Could not send the code. Please try again.":"\u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Could not reset password. Please try again.":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cb0\u0cc1\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Password Changed":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0ca4\u0cc1","Your password has been changed. Please log in with your new password.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0ca6\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Login with your driver credentials":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Please enter both phone number and password":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cab\u0ccb\u0ca8\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c8e\u0cb0\u0ca1\u0ca8\u0ccd\u0ca8\u0cc2 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter a 10-digit number or +91 followed by 10 digits":"10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe +91 \u0ca8\u0c82\u0ca4\u0cb0 10 \u0c85\u0c82\u0c95\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Please enter a valid password (minimum 6 characters)":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 6 \u0c85\u0c95\u0ccd\u0cb7\u0cb0)","Login Failed":"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1","Please check your credentials and try again.":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0cb5\u0cb0 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Starting trip...":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Start Trip":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf","Record Trip Start":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad \u0ca6\u0cbe\u0c96\u0cb2\u0cbf\u0cb8\u0cbf","Upload odometer photo and enter current reading":"\u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Odometer Photo":"\u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cab\u0ccb\u0c9f\u0ccb","Retake Photo":"\u0cab\u0ccb\u0c9f\u0ccb \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf","Take Odometer Photo":"\u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf","Starting Kilometer":"\u0c86\u0cb0\u0c82\u0cad\u0cbf\u0c95 \u0c95\u0cbf\u0cb2\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd","Enter current KM reading (e.g., 10230)":"\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0c95\u0cbf.\u0cae\u0cc0. \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0c89\u0ca6\u0cbe. 10230)","Shown Odometer to the Customer":"\u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6","Starting Trip...":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Failed to take photo":"\u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Please enter start KM and upload odometer photo":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0c95 \u0c95\u0cbf.\u0cae\u0cc0. \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Failed to start trip":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Completing trip...":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","End Trip":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cbf","Complete Your Trip":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf","Upload final odometer photo and reading":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cab\u0ccb\u0c9f\u0ccb \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","End Odometer Photo":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cab\u0ccb\u0c9f\u0ccb","Ending Kilometer":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c95\u0cbf\u0cb2\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd","Enter end KM reading (e.g., 10380)":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c95\u0cbf.\u0cae\u0cc0. \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0c89\u0ca6\u0cbe. 10380)","Toll Charges":"\u0c9f\u0ccb\u0cb2\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95","Enter toll charges (\u20b9)":"\u0c9f\u0ccb\u0cb2\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u20b9)","Enter the toll charges incurred during the trip":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c86\u0ca6 \u0c9f\u0ccb\u0cb2\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Waiting Time (minutes)":"\u0c95\u0cbe\u0caf\u0cc1\u0cb5 \u0cb8\u0cae\u0caf (\u0ca8\u0cbf\u0cae\u0cbf\u0cb7)","Enter waiting time in minutes (e.g., 450)":"\u0c95\u0cbe\u0caf\u0cc1\u0cb5 \u0cb8\u0cae\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cae\u0cbf\u0cb7\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0c89\u0ca6\u0cbe. 450)","Enter the total waiting time in minutes for this multicity trip":"\u0c88 \u0cac\u0cb9\u0cc1 \u0ca8\u0c97\u0cb0 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0ca8 \u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0c95\u0cbe\u0caf\u0cc1\u0cb5 \u0cb8\u0cae\u0caf\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cae\u0cbf\u0cb7\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Cash Collected (Optional)":"\u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c97\u0ca6\u0cc1 (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)","Amount collected from the customer in cash":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c82\u0ca6 \u0ca8\u0c97\u0ca6\u0cbe\u0c97\u0cbf \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4","Only fill this in if an advance was collected upfront for this trip - the difference settles to your wallet automatically.":"\u0c88 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cc6 \u0cae\u0cc1\u0c82\u0c97\u0ca1 \u0caa\u0ca1\u0cc6\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc1\u0c82\u0cac\u0cbf - \u0cb5\u0ccd\u0caf\u0ca4\u0ccd\u0caf\u0cbe\u0cb8 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0ca4\u0cbe\u0ca8\u0cbe\u0c97\u0cbf \u0c87\u0ca4\u0ccd\u0caf\u0cb0\u0ccd\u0ca5\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Shown Ending km Odometer":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c95\u0cbf.\u0cae\u0cc0. \u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6","Completing Trip...":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Complete Trip":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf","Please complete all required fields and ensure the Ending Km is shown.":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c85\u0c97\u0ca4\u0ccd\u0caf \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c95\u0cbf.\u0cae\u0cc0. \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf \u0c8e\u0c82\u0ca6\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf.","Please enter a valid toll charge amount.":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c9f\u0ccb\u0cb2\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Please enter a valid waiting time in minutes for multicity bookings.":"\u0cac\u0cb9\u0cc1 \u0ca8\u0c97\u0cb0 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c95\u0cbe\u0caf\u0cc1\u0cb5 \u0cb8\u0cae\u0caf (\u0ca8\u0cbf\u0cae\u0cbf\u0cb7) \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Invalid KM Reading":"\u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0c95\u0cbf.\u0cae\u0cc0. \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd","The end kilometer reading cannot be less than the start kilometer reading. Please check your odometer reading and try again.":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c95\u0cbf.\u0cae\u0cc0. \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0c95 \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cbf\u0c82\u0ca4 \u0c95\u0ca1\u0cbf\u0cae\u0cc6 \u0c87\u0cb0\u0cac\u0cbe\u0cb0\u0ca6\u0cc1. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Please enter a valid end kilometer reading that is greater than the start reading.":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0c95 \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cbf\u0c82\u0ca4 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c95\u0cbf.\u0cae\u0cc0. \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Invalid Toll Charge":"\u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0c9f\u0ccb\u0cb2\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95","Insufficient Balance":"\u0cb8\u0cbe\u0c95\u0cb7\u0ccd\u0c9f\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0c87\u0cb2\u0ccd\u0cb2","Contact your Fleet to Top up the account":"\u0c96\u0cbe\u0ca4\u0cc6 \u0c9f\u0cbe\u0caa\u0ccd \u0c85\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf","Validation Error":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0ca6\u0ccb\u0cb7","Please check your input and try again.":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0cae\u0cc2\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Authentication Error":"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0ca6\u0ccb\u0cb7","Trip Not Found":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","This trip could not be found. Please try again or contact support.":"\u0c88 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf.","Server Error":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0ca6\u0ccb\u0cb7","There was a problem with our servers. Please try again later.":"\u0ca8\u0cae\u0ccd\u0cae \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6 \u0c87\u0ca4\u0ccd\u0ca4\u0cc1. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0c82\u0ca4\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Failed to end trip. Please try again.":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Loading trip report...":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb5\u0cb0\u0ca6\u0cbf \u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Trip Report":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb5\u0cb0\u0ca6\u0cbf","No report data available":"\u0cb5\u0cb0\u0ca6\u0cbf \u0ca1\u0cc7\u0c9f\u0cbe \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2","No trip report data found":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb5\u0cb0\u0ca6\u0cbf \u0ca1\u0cc7\u0c9f\u0cbe \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Failed to fetch trip report":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb5\u0cb0\u0ca6\u0cbf \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2",Retry:"\u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf","Trip Completed Successfully!":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6!","Order {id}":"\u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd {id}","Vendor Details":"\u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1",Primary:"\u0caa\u0ccd\u0cb0\u0cbe\u0ca5\u0cae\u0cbf\u0c95",Secondary:"\u0c8e\u0cb0\u0ca1\u0ca8\u0cc7","Trip Route":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cbe\u0cb0\u0ccd\u0c97","Trip Details":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","Distance: {km} km":"\u0ca6\u0cc2\u0cb0: {km} \u0c95\u0cbf.\u0cae\u0cc0.","Duration: {time}":"\u0c85\u0cb5\u0ca7\u0cbf: {time}","Waiting Charge: \u20b9{amount}":"\u0c95\u0cbe\u0caf\u0cc1\u0cb5 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95: \u20b9{amount}","Fare Breakdown":"\u0ca6\u0cb0 \u0cb5\u0cbf\u0cb5\u0cb0","Customer Price:":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cac\u0cc6\u0cb2\u0cc6:","Updated Toll:":"\u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0c9f\u0ccb\u0cb2\u0ccd:","Toll Charges:":"\u0c9f\u0ccb\u0cb2\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95:","Driver Beta:":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cac\u0c9f\u0ccd\u0c9f\u0cbe:","Waiting Charge:":"\u0c95\u0cbe\u0caf\u0cc1\u0cb5 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95:","Permit Charges:":"\u0caa\u0cb0\u0ccd\u0cae\u0cbf\u0c9f\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95:","Hill Charges:":"\u0cac\u0cc6\u0c9f\u0ccd\u0c9f\u0ca6 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95:","Night Charges:":"\u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95:","Pickup Notes":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0c9f\u0cbf\u0caa\u0ccd\u0caa\u0ca3\u0cbf\u0c97\u0cb3\u0cc1","Exit to Dashboard":"\u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf",Unknown:"\u0c97\u0cca\u0ca4\u0ccd\u0ca4\u0cbf\u0cb2\u0ccd\u0cb2","Hourly Rental booking does not have a drop location":"\u0c97\u0c82\u0c9f\u0cc6\u0caf \u0cac\u0cbe\u0ca1\u0cbf\u0c97\u0cc6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cc6 \u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0cb8\u0ccd\u0ca5\u0cb3 \u0c87\u0cb0\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","Hourly Rental":"\u0c97\u0c82\u0c9f\u0cc6\u0caf \u0cac\u0cbe\u0ca1\u0cbf\u0c97\u0cc6","Add your email":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Required to continue. We use it for password reset, payout updates, and trip receipts.":"\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cb2\u0cc1 \u0c87\u0ca6\u0cc1 \u0cac\u0cc7\u0c95\u0cc1. \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cb0\u0cc1\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6, \u0caa\u0cc7\u0c94\u0c9f\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb0\u0cb8\u0cc0\u0ca6\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0cb5\u0cc6.","Email address":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8","6-digit code":"6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd","Verify & Continue":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf","Send Code":"\u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf","Change email address":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf","Please enter a valid email address":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Code Sent":"\u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Check the email inbox (and spam folder).":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c87\u0ca8\u0ccd\u200c\u0cac\u0cbe\u0c95\u0ccd\u0cb8\u0ccd (\u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0cae\u0ccd \u0cab\u0ccb\u0cb2\u0ccd\u0ca1\u0cb0\u0ccd) \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","Could not send the code.":"\u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Enter the 6-digit code from the email":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0c82\u0ca6 6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Could not verify the code.":"\u0c95\u0ccb\u0ca1\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Account Verification":"\u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6","Account Under Verification":"\u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6","Our team is reviewing your documents":"\u0ca8\u0cae\u0ccd\u0cae \u0ca4\u0c82\u0ca1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6","Thank you for submitting your documents. Our verification team is currently reviewing your information. This process usually takes 8-48 hours. You will be notified once verification is complete.":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0c95\u0ccd\u0c95\u0cc6 \u0ca7\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0ca6\u0c97\u0cb3\u0cc1. \u0ca8\u0cae\u0ccd\u0cae \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cbe \u0ca4\u0c82\u0ca1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6. \u0c87\u0ca6\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf 8-48 \u0c97\u0c82\u0c9f\u0cc6 \u0cac\u0cc7\u0c95\u0cc1. \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cae\u0cc1\u0c97\u0cbf\u0ca6 \u0c95\u0cc2\u0ca1\u0cb2\u0cc7 \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Refresh Status":"\u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Account Verified!":"\u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","Your account has been verified":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Welcome to Drop Cars! You can now access all features.":"Drop Cars \u0c97\u0cc6 \u0cb8\u0ccd\u0cb5\u0cbe\u0c97\u0ca4! \u0c88\u0c97 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",Continue:"\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf","You can refresh to check if your status has been updated":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6\u0caf\u0cc7 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca8\u0ccb\u0ca1\u0cb2\u0cc1 \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1","Kindly pay the Registration fees & Wait Our team will Contact You And Refresh The app to see the updated status":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf \u0c95\u0cbe\u0caf\u0cbf\u0cb0\u0cbf. \u0ca8\u0cae\u0ccd\u0cae \u0ca4\u0c82\u0ca1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca8\u0cb5\u0cc0\u0c95\u0cc3\u0ca4 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0ca8\u0ccb\u0ca1\u0cb2\u0cc1 \u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","\u2713 Registration Fee Paid":"\u2713 \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Opening payment\u2026":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6\u2026","Pay Registration Fee \u20b9{amount}":"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u20b9{amount} \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf","UPI \u2022 Cards \u2022 Netbanking (Razorpay)":"UPI \u2022 \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u2022 \u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cbf\u0c82\u0c97\u0ccd (Razorpay)","\u2014 or pay manually \u2014":"\u2014 \u0c85\u0ca5\u0cb5\u0cbe \u0c95\u0cc8\u0caf\u0cbe\u0cb0\u0cc6 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf \u2014","Pay to UPI ID (Tap to view QR):":"UPI ID \u0c97\u0cc6 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf (QR \u0ca8\u0ccb\u0ca1\u0cb2\u0cc1 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf):","Checking Status...":"\u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","What happens next?":"\u0cae\u0cc1\u0c82\u0ca6\u0cc6 \u0c8f\u0ca8\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6?","Our team reviews your submitted documents":"\u0ca8\u0cae\u0ccd\u0cae \u0ca4\u0c82\u0ca1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","Verification typically takes 24-48 hours":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cc6 \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf 24-48 \u0c97\u0c82\u0c9f\u0cc6 \u0cac\u0cc7\u0c95\u0cc1","You'll receive a notification once approved":"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0caf\u0cbe\u0ca6 \u0c95\u0cc2\u0ca1\u0cb2\u0cc7 \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","After approval, you can access all features":"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0caf \u0ca8\u0c82\u0ca4\u0cb0 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1","Scan QR Code to Pay Rs.1000":"Rs.1000 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cc1 QR \u0c95\u0ccb\u0ca1\u0ccd \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Failed to copy UPI ID":"UPI ID \u0ca8\u0c95\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Not available":"\u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2","Razorpay checkout is not available here. Please pay using the UPI ID below.":"\u0c87\u0cb2\u0ccd\u0cb2\u0cbf Razorpay \u0c9a\u0cc6\u0c95\u0ccd\u200c\u0c94\u0c9f\u0ccd \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 UPI ID \u0cac\u0cb3\u0cb8\u0cbf \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf.","Payment Successful":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf","Your registration fee has been received. Our team will verify your account shortly - use \"Refresh Status\" to check.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca8\u0cae\u0ccd\u0cae \u0ca4\u0c82\u0ca1 \u0cb6\u0cc0\u0c98\u0ccd\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 - \u0ca8\u0ccb\u0ca1\u0cb2\u0cc1 \"\u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\" \u0cac\u0cb3\u0cb8\u0cbf.","Payment Failed":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1","Payment could not be completed. Please try again or pay via the UPI ID below.":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 UPI ID \u0cae\u0cc2\u0cb2\u0c95 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf.","Could not create the payment order. Please try again.":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Please login again to refresh your account status.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Refresh Failed":"\u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1","Could not refresh account status. Please try again.":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Driver Account Verification":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6","Your driver account has been verified":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Welcome to Drop Cars Driver App! You can now access all features.":"Drop Cars \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0ccd\u0cb5\u0cbe\u0c97\u0ca4! \u0c88\u0c97 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Go to Dashboard":"\u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf","After approval, you can start driving":"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0caf \u0ca8\u0c82\u0ca4\u0cb0 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c9a\u0cbe\u0cb2\u0ca8\u0cc6 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1","Add Car":"\u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add Your First Car":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0ca6\u0cb2 \u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Loading your cars...":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cbe\u0cb0\u0cc1\u0c97\u0cb3\u0cc1 \u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb5\u0cc6...","Error: {message}":"\u0ca6\u0ccb\u0cb7: {message}","No Cars Added Yet":"\u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2","Add your first car to start earning with Drop Cars":"Drop Cars \u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0c97\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0ca6\u0cb2 \u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Unnamed Car":"\u0cb9\u0cc6\u0cb8\u0cb0\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6 \u0c95\u0cbe\u0cb0\u0cc1","Registration:":"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf:","Type:":"\u0cb5\u0cb0\u0ccd\u0c97:","Year:":"\u0cb5\u0cb0\u0ccd\u0cb7:","Status:":"\u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf:","RC Front":"RC \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97","RC Back":"RC \u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97",Insurance:"\u0cb5\u0cbf\u0cae\u0cc6",Permit:"\u0caa\u0cb0\u0ccd\u0cae\u0cbf\u0c9f\u0ccd",Car:"\u0c95\u0cbe\u0cb0\u0cc1",OK:"\u0cb8\u0cb0\u0cbf","Add Driver":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf",Verified:"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0ca4","Loading your drivers...":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6...","{count} drivers available":"{count} \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb2\u0cad\u0ccd\u0caf",Verifying:"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf",Online:"\u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd","On Duty":"\u0ca1\u0ccd\u0caf\u0cc
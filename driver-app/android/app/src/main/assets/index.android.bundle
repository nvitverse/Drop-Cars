e}! \u0ca8\u0cc0\u0cb5\u0cc1 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0c95 \u0cb8\u0cc6\u0c9f\u0caa\u0ccd \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf.",whatWeCompleted:"\u0ca8\u0cbe\u0cb5\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1",accountCreatedTitle:"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",accountCreatedDesc:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",carAddedTitle:"\u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",carAddedDesc:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0ca6\u0cb2 \u0c95\u0cbe\u0cb0\u0cc1 \u0cb5\u0ccd\u0caf\u0cb5\u0cb8\u0ccd\u0ca5\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",driverProfileTitle:"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",driverProfileDesc:"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",documentsUnderReview:"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb5\u0cc6",reviewInProgress:"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0ca8\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6",reviewDescription:"\u0ca8\u0cae\u0ccd\u0cae \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cbe \u0ca4
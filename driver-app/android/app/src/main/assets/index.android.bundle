\u0cbe\u0ca4\u0cc6 \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0ca8\u0ca6\u0cc1","Account is Fleet Owner":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0\u0ca6\u0cc1","Account Name":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","Account Not Found":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Account not found. Please check your mobile number or sign up first.":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb8\u0cc8\u0ca8\u0ccd \u0c85\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","ACTION COMPLETED":"\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0cc6","ACTION REQUIRED":"\u0c95\u0ccd\u0cb0\u0cae \u0cac\u0cc7\u0c95\u0cc1","Activate Booking Request":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf",Active:"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf","Active & Ready for Trips":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf & \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0cbf\u0ca6\u0ccd\u0ca7","Active Fleet":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd","Active Rides":"\u0ca8\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb0\u0cc8\u0ca1\u0ccd\u0cb8\u0ccd","Active Route Monitoring":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0cae\u0cbe\u0cb0\u0ccd\u0c97 \u0cae\u0cc7\u0cb2\u0ccd\u0cb5\u0cbf\u0c9a\u0cbe\u0cb0\u0ca3\u0cc6","Active Vacant":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0c96\u0cbe\u0cb2\u0cbf",Add:"\u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add \"":"\u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf \"","Add \u20b9":"\u20b9 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add \u20b9{0} to Accept the Booking":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u20b9{0} \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add custom location: \"":"\u0c95\u0cb8\u0ccd\u0c9f\u0cae\u0ccd \u0cb8\u0ccd\u0ca5\u0cb3 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf: \"","Add Custom Town or Station":"\u0c95\u0cb8\u0ccd\u0c9f\u0cae\u0ccd \u0c8a\u0cb0\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cbf\u0cb2\u0ccd\u0ca6\u0cbe\u0ca3 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add Details":"\u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add Email":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add Email Address":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add Email Now":"\u0c88\u0c97 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add money to post this booking":"\u0c88 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cb9\u0ca3 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add New Driver":"\u0cb9\u0cca\u0cb8 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add or update an alternate contact number for emergency contact and dispatch alerts.":"\u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0caa\u0cb0\u0ccd\u0caf\u0cbe\u0caf \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf.","Add your bank account or UPI ID so payouts can be sent to you. Either one is enough.":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe UPI ID \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf. \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cbe\u0ca6\u0cb0\u0cc2 \u0c92\u0c82\u0ca6\u0cc1 \u0cb8\u0cbe\u0c95\u0cc1.","Add your bank account or UPI ID to receive payouts":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe UPI ID \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add your first driver to assign trips and manage duties.":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0ca6\u0cb2 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf.","Add Your Profile Photo":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cab\u0ccb\u0c9f\u0ccb \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add yourself as a duty driver (using your own Aadhaar/licence) first.":"\u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c86\u0c97\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf (\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd/\u0cb2\u0cc8\u0cb8\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd\u200c\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6).","Add yourself as a duty driver first (using your own Aadhaar/licence) so you can accept and run bookings yourself.":"\u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c86\u0c97\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf (\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd/\u0cb2\u0cc8\u0cb8\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd\u200c\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6), \u0c86\u0c97 \u0ca8\u0cc0\u0cb5\u0cc7 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cbf \u0c93\u0ca1\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Add yourself as a duty driver first (using your own Aadhaar/licence), then Duty will open your own bookings.":"\u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c86\u0c97\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf (\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd/\u0cb2\u0cc8\u0cb8\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd\u200c\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6), \u0ca8\u0c82\u0ca4\u0cb0 \u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0cb5\u0c82\u0ca4 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.","Added at trip end":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0caf\u0cc1\u0cb5\u0cbe\u0c97 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Additional Details / Message (Optional):":"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0cb5\u0cbf\u0cb5\u0cb0 / \u0cb8\u0c82\u0ca6\u0cc7\u0cb6 (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95):",Address:"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8","Admin rejected your request to use a different car.":"\u0cac\u0cc7\u0cb0\u0cc6 \u0c95\u0cbe\u0cb0\u0cc1 \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0ca4\u0cbf\u0cb0\u0cb8\u0ccd\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6.","Advance already paid":"\u0cae\u0cc1\u0c82\u0c97\u0ca1 \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Advance Paid by Customer:":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cc1 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cc1\u0c82\u0c97\u0ca1:","Advance received":"\u0cae\u0cc1\u0c82\u0c97\u0ca1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Advance Received":"\u0cae\u0cc1\u0c82\u0c97\u0ca1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Advance Received: \u20b9":"\u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cc1\u0c82\u0c97\u0ca1: \u20b9","Advance updated.":"\u0cae\u0cc1\u0c82\u0c97\u0ca1 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Alerts for standard new trip offers and bids":"\u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cb9\u0cca\u0cb8 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cab\u0cb0\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0cbf\u0ca1\u0ccd\u200c\u0c97\u0cb3 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cc1","Align final odometer reading inside camera viewfinder":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0ccd\u0caf\u0cbe\u0cae\u0cc6\u0cb0\u0cbe \u0cb5\u0ccd\u0caf\u0cc2\u0cab\u0cc8\u0c82\u0ca1\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf","Align odometer reading inside camera viewfinder":"\u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cb0\u0cc0\u0ca1\u0cbf\u0c82\u0c97\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0ccd\u0caf\u0cbe\u0cae\u0cc6\u0cb0\u0cbe \u0cb5\u0ccd\u0caf\u0cc2\u0cab\u0cc8\u0c82\u0ca1\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf","All Booking Types":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb5\u0cbf\u0ca7\u0c97\u0cb3\u0cc1","All Categories":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb5\u0cb0\u0ccd\u0c97\u0c97\u0cb3\u0cc1","All Cities":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0ca8\u0c97\u0cb0\u0c97\u0cb3\u0cc1","ALL CITIES & TOWNS (":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0ca8\u0c97\u0cb0\u0c97\u0cb3\u0cc1 & \u0caa\u0c9f\u0ccd\u0c9f\u0ca3\u0c97\u0cb3\u0cc1 (","All Dates":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0c97\u0cb3\u0cc1","All Inclusive Fare":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cb5\u0cc2 \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6 \u0ca6\u0cb0","All Inclusive Fare Booking":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cb5\u0cc2 \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6 \u0ca6\u0cb0\u0ca6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd","All Services":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cc1","All Time":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb8\u0cae\u0caf","All-inclusive booking - you see only what you earn. The exact amount to collect from the customer is shown once you accept.":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cb5\u0cc2 \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd - \u0ca8\u0cc0\u0cb5\u0cc1 \u0c97\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c95\u0cbe\u0ca3\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c82\u0ca6 \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0ca8\u0cbf\u0c96\u0cb0 \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","All-Inclusive Package:":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cb5\u0cc2 \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6 \u0caa\u0ccd\u0caf\u0cbe\u0c95\u0cc7\u0c9c\u0ccd:",Allow:"\u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0cb8\u0cbf","Allow \"Display over other apps\" so a new booking pops up as a floating bubble even while you are using another app. You can change this any time in Settings.":"\"\u0c87\u0ca4\u0cb0 \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0c97\u0cb3 \u0cae\u0cc7\u0cb2\u0cc6 \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cc1\" \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf, \u0cac\u0cc7\u0cb0\u0cc6 \u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cac\u0cb3\u0cb8\u0cc1\u0cb5\u0cbe\u0c97\u0cb2\u0cc2 \u0cb9\u0cca\u0cb8 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca4\u0cc7\u0cb2\u0cc1\u0cb5 \u0cac\u0cac\u0cb2\u0ccd \u0c86\u0c97\u0cbf \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0caf\u0cbe\u0cb5\u0cbe\u0c97 \u0cac\u0cc7\u0c95\u0cbe\u0ca6\u0cb0\u0cc2 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Allow app to access your location":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0c97\u0cc6 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf","Allow microphone access to send a voice note.":"\u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0cb8\u0c82\u0ca6\u0cc7\u0cb6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0cc8\u0c95\u0ccd\u0cb0\u0cca\u0cab\u0ccb\u0ca8\u0ccd \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0cb8\u0cbf.","Alternative mobile number":"\u0caa\u0cb0\u0ccd\u0caf\u0cbe\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Amount held at accept":"\u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cbe\u0c97 \u0cb9\u0ccb\u0cb2\u0ccd\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4","Analyzing fleet tariffs & operational protocols":"\u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0c9f\u0ccd\u0caf\u0cbe\u0cb0\u0cbf\u0cab\u0ccd & \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0cbe\u0c9a\u0cb0\u0ca3\u0cc6 \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb2\u0cc7\u0cb7\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6","Another vendor has accepted this trip just a moment ago. We are automatically refreshing your available bookings list.":"\u0c87\u0ca8\u0ccd\u0ca8\u0cca\u0cac\u0ccd\u0cac \u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd \u0c88\u0c97\u0cb7\u0ccd\u0c9f\u0cc7 \u0c88 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6. \u0cb2\u0cad\u0ccd\u0caf \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbe\u0ca8\u0cbe\u0c97\u0cbf \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0cb5\u0cc6.","Anything else you want to tell us? (optional)":"\u0ca8\u0cae\u0c97\u0cc6 \u0c87\u0ca8\u0ccd\u0ca8\u0cc7\u0ca8\u0cbe\u0ca6\u0cb0\u0cc2 \u0cb9\u0cc7\u0cb3\u0cac\u0cc7\u0c95\u0cc7? (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)","App & notification preferences":"\u0c86\u0ccd\u0caf\u0caa\u0ccd & \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0c97\u0cb3\u0cc1","App Information":"\u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf","App information and support":"\u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf","App language preference":"\u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cad\u0cbe\u0cb7\u0cc6 \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6","App version and info":"\u0c86\u0ccd\u0caf\u0caa\u0ccd \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf",Appearance:"\u0cb0\u0cc2\u0caa",Applied:"\u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",Apply:"\u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cbf","Apply Date Range":"\u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cb6\u0ccd\u0cb0\u0cc7\u0ca3\u0cbf \u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cbf","Apply Filters (":"\u0cab\u0cbf\u0cb2\u0ccd\u0c9f\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cbf (","Applying...":"\u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Approve (":"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cbf (","Approve & Lock Seats":"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cbf \u0cb8\u0cc0\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Approve Vehicle Request":"\u0cb5\u0cbe\u0cb9\u0ca8 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cbf","Approved \u2705":"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 \u2705","Are you sure you want to cancel this booking? If the trip has already started, a cancellation penalty will apply.":"\u0c88 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc7? \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0cb6\u0cc1\u0cb0\u0cc1\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0cb0\u0ca6\u0ccd\u0ca6\u0ca4\u0cbf \u0ca6\u0c82\u0ca1 \u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Are you sure you want to clear your entered details and chat history?":"\u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c9a\u0cbe\u0c9f\u0ccd \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8 \u0c85\u0cb3\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc7?","Are you sure you want to remove vacant status for {0}? Vendors will no longer see this car waiting.":"{0} \u0c97\u0cbe\u0c97\u0cbf \u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cac\u0cc7\u0c95\u0cc7? \u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c87\u0ca8\u0ccd\u0ca8\u0cc1 \u0c88 \u0c95\u0cbe\u0cb0\u0cc1 \u0c95\u0cbe\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0c95\u0cbe\u0ca3\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.","Area Pincode (Optional)":"\u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6 \u0caa\u0cbf\u0ca8\u0ccd\u200c\u0c95\u0ccb\u0ca1\u0ccd (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)","Ask customer for 4-digit OTP":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c82\u0ca6 4 \u0c85\u0c82\u0c95\u0cbf\u0caf OTP \u0c95\u0cc7\u0cb3\u0cbf","Ask for boot space photos":"\u0cac\u0cc2\u0c9f\u0ccd \u0cb8\u0ccd\u0caa\u0cc7\u0cb8\u0ccd \u0cab\u0ccb\u0c9f\u0ccb\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc7\u0cb3\u0cbf","Ask Help Bot anything in Tamil / English (or type 1\u20139)...":"Help Bot \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0ca8\u0ccd\u0ca8\u0ca1 / \u0c87\u0c82\u0c97\u0ccd\u0cb2\u0cbf\u0cb7\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c8f\u0ca8\u0cbe\u0ca6\u0cb0\u0cc2 \u0c95\u0cc7\u0cb3\u0cbf (\u0c85\u0ca5\u0cb5\u0cbe 1\u20139 \u0c9f\u0cc8\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cbf)...","Ask OTP & Enter Start Odometer (KM).":"OTP \u0c95\u0cc7\u0cb3\u0cbf \u0c86\u0cb0\u0c82\u0cad\u0ca6 \u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd (\u0c95\u0cbf.\u0cae\u0cc0.) \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Ask the customer for the 4-digit code shown on their booking confirmation.":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 4 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cc7\u0cb3\u0cbf.","Ask the customer for the 4-digit completion code from their SMS or booking page.":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 SMS \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0cc1\u0c9f\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 4 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5 \u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cc7\u0cb3\u0cbf.","Ask the customer for the trip end code from their confirmation email.":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c85\u0c82\u0ca4\u0ccd\u0caf\u0ca6 \u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cc7\u0cb3\u0cbf.","Ask the customer for the trip start code from their confirmation email.":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0ca6 \u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cc7\u0cb3\u0cbf.","Assign Driver":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf","Assign Driver & Cab":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd & \u0c95\u0ccd\u0caf\u0cbe\u0cac\u0ccd \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf","Assign driver & car in {0}":"{0} \u0c92\u0cb3\u0c97\u0cc6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd & \u0c95\u0cbe\u0cb0\u0cc1 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf","Assign Vehicle":"\u0cb5\u0cbe\u0cb9\u0ca8 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf","Assigned ({0})":"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf\u0ca6\u0cb5\u0cc1 ({0})","Assigned Cab & Driver":"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4 \u0c95\u0ccd\u0caf\u0cbe\u0cac\u0ccd & \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd","Assigned Driver & Cab":"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd & \u0c95\u0ccd\u0caf\u0cbe\u0cac\u0ccd","Assigned Vehicle":"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4 \u0cb5\u0cbe\u0cb9\u0ca8","Assigned Vehicle (":"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4 \u0cb5\u0cbe\u0cb9\u0ca8 (","Assigned:":"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4:","Assignment Error":"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0ca8\u0cc6 \u0ca6\u0ccb\u0cb7","Assignment Rules":"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0ca8\u0cc6 \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1","Attachment Support Desk":"\u0c85\u0c9f\u0ccd\u0caf\u0cbe\u0c9a\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0ca1\u0cc6\u0cb8\u0ccd\u0c95\u0ccd","Authentication failed - please login again to get a valid token.":"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0cab\u0cb2 - \u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0c9f\u0ccb\u0c95\u0ca8\u0ccd \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Authentication failed. Please login again and try adding the driver.":"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0cab\u0cb2. \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Authentication failed. Please login again.":"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0cb5\u0cbf\u0cab\u0cb2. \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Auto-assigning in":"\u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0ca8\u0cc6:","Auto-Assignment Rules & \u20b9500 Penalty":"\u0cb8\u0ccd\u0cb5\u0caf\u0c82-\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0ca8\u0cc6 \u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 & \u20b9500 \u0ca6\u0c82\u0ca1","Auto-cancelled: no driver & car were assigned in time.":"\u0cb8\u0ccd\u0cb5\u0caf\u0c82-\u0cb0\u0ca6\u0ccd\u0ca6\u0cc1: \u0cb8\u0cae\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd & \u0c95\u0cbe\u0cb0\u0cc1 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf\u0cb2\u0ccd\u0cb2.","Auto-renew from wallet":"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0cb8\u0ccd\u0cb5\u0caf\u0c82-\u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3","Auto-verification checks document photo, number & name":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0cab\u0ccb\u0c9f\u0ccb, \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 & \u0cb9\u0cc6\u0cb8\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","Auto-verified against name on document photo.":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0cab\u0ccb\u0c9f\u0ccb\u0ca6 \u0cb9\u0cc6\u0cb8\u0cb0\u0cbf\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Auto-verify checks driving licence photo, number & name match.":"\u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cab\u0ccb\u0c9f\u0ccb, \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 & \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6\u0caf\u0cc7 \u0c8e\u0c82\u0ca6\u0cc1 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Auto-verify checks driving licence, Aadhaar ID, photo & name match.":"\u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf, \u0c86\u0ca7\u0cbe\u0cb0\u0ccd ID, \u0cab\u0ccb\u0c9f\u0ccb & \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6\u0caf\u0cc7 \u0c8e\u0c82\u0ca6\u0cc1 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","AUTOMATED ANSWERS \u2022 AVAILABLE 24/7":"\u0cb8\u0ccd\u0cb5\u0caf\u0c82\u0c9a\u0cbe\u0cb2\u0cbf\u0ca4 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0c97\u0cb3\u0cc1 \u2022 24/7 \u0cb2\u0cad\u0ccd\u0caf","automatically assigned":"\u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","AUTOMATICALLY ASSIGNED":"\u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","automatically debited from your fleet wallet.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Available Wallet Balance: \u20b9":"\u0cb2\u0cad\u0ccd\u0caf \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd: \u20b9","Back Seat Photo Required":"\u0cb9\u0cbf\u0c82\u0ca6\u0cbf\u0ca8 \u0cb8\u0cc0\u0c9f\u0ccd \u0cab\u0ccb\u0c9f\u0ccb \u0cac\u0cc7\u0c95\u0cc1","Back Side":"\u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97","Back side of Aadhaar":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd\u200c\u0ca8 \u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97","Back Side Photo":"\u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb","BACK SIDE PHOTO":"\u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb","Backend failed - cannot process trip payment":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0cb5\u0cbf\u0cab\u0cb2 - \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2","Backend failed - cannot process wallet addition":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0cb5\u0cbf\u0cab\u0cb2 - \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ca3 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2","Backend failed - cannot process wallet deduction":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0cb5\u0cbf\u0cab\u0cb2 - \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0cb9\u0ca3 \u0c95\u0ca1\u0cbf\u0ca4 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2","Backend returned non-success status: {0}":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0ca6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0ca8\u0cc0\u0ca1\u0cbf\u0ca6\u0cc6: {0}","Backend unavailable - cannot process trip payment":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2 - \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2","Backend unavailable - cannot process wallet addition":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2 - \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ca3 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2","Backend unavailable - cannot process wallet deduction":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2 - \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0cb9\u0ca3 \u0c95\u0ca1\u0cbf\u0ca4 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2","Backend validation failed: {0}":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cb5\u0cbf\u0cab\u0cb2: {0}","Bad request: {0}":"\u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf: {0}","badges in the Customer App. 15% platform commission + GST applies.":"\u0cac\u0ccd\u0caf\u0cbe\u0ca1\u0ccd\u0c9c\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cbe\u0ca3\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6. 15% \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0c95\u0cae\u0cbf\u0cb7\u0ca8\u0ccd + GST \u0c85\u0ca8\u0ccd\u0cb5\u0caf.","Balance Due on Trip":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0cac\u0cbe\u0c95\u0cbf","Bank account / UPI saved - tap to update":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 / UPI \u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 - \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf","Bank Account & Payout Details":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 & \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","Bank Account Holder Name":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","Bank Account Number":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Bank account or UPI ID where trip earnings and balance payouts are credited.":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c97\u0cb3\u0cbf\u0c95\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0c9c\u0cae\u0cc6\u0caf\u0cbe\u0c97\u0cc1\u0cb5 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe UPI ID.","Bank Account:":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6:","Bank IFSC":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd IFSC","Bank IFSC Code":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd IFSC \u0c95\u0ccb\u0ca1\u0ccd","Bank Name, A/C No, IFSC Code":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6, IFSC \u0c95\u0ccb\u0ca1\u0ccd","Bank Transfer":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0cb5\u0ca3\u0cc6","Base Fare (":"\u0cae\u0cc2\u0cb2 \u0ca6\u0cb0 (","Base Rate per km":"\u0c95\u0cbf.\u0cae\u0cc0.\u0c97\u0cc6 \u0cae\u0cc2\u0cb2 \u0ca6\u0cb0",Bata:"\u0cac\u0c9f\u0ccd\u0c9f\u0cbe","Become a Trusted Partner":"\u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cbe\u0cb8\u0cbe\u0cb0\u0ccd\u0cb9 \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd \u0c86\u0c97\u0cbf","Become a Trusted Partner instantly. Auto-debited every month - cannot be cancelled, only upgraded to Yearly.":"\u0ca4\u0c95\u0ccd\u0cb7\u0ca3 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cbe\u0cb8\u0cbe\u0cb0\u0ccd\u0cb9 \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd \u0c86\u0c97\u0cbf. \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0ca4\u0cbf\u0c82\u0c97\u0cb3\u0cc1 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 - \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0ca6\u0cc1, \u0cb5\u0cbe\u0cb0\u0ccd\u0cb7\u0cbf\u0c95\u0c95\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Best Day:":"\u0c85\u0ca4\u0ccd\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cae \u0ca6\u0cbf\u0ca8:","Bill says \u20b9{0} was due. Change it only if the customer paid a different amount.":"\u0cac\u0cbf\u0cb2\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u20b9{0} \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc6\u0c82\u0ca6\u0cbf\u0ca6\u0cc6. \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cc1 \u0cac\u0cc7\u0cb0\u0cc6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf.","Binding Offer & Cancellation Policy Notice":"\u0cac\u0ca6\u0ccd\u0ca7 \u0c86\u0cab\u0cb0\u0ccd & \u0cb0\u0ca6\u0ccd\u0ca6\u0ca4\u0cbf \u0ca8\u0cc0\u0ca4\u0cbf \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6","Boarding:":"\u0cb9\u0ca4\u0ccd\u0ca4\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cb3:",Booking:"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd","Booking #":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd #","Booking #{0} has been cancelled.":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd #{0} \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Booking #{0} has been cancelled. A mandatory \u20b9500 cancellation penalty fee has been debited from your fleet wallet.":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd #{0} \u0cb0\
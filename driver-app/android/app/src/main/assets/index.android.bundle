0cbf\u0c82\u0c97\u0ccd","Toll, parking or any charge collected outside the bill. 0 if none.":"\u0cac\u0cbf\u0cb2\u0ccd \u0cb9\u0cca\u0cb0\u0c97\u0cc6 \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0c9f\u0ccb\u0cb2\u0ccd, \u0caa\u0cbe\u0cb0\u0ccd\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95. \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 0.","Toll, parking, permit and waiting are charged on actuals unless the booking says they are included.":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0cb9\u0cc7\u0cb3\u0ca6 \u0cb9\u0cca\u0cb0\u0ca4\u0cc1 \u0c9f\u0ccb\u0cb2\u0ccd, \u0caa\u0cbe\u0cb0\u0ccd\u0c95\u0cbf\u0c82\u0c97\u0ccd, \u0caa\u0cb0\u0ccd\u0cae\u0cbf\u0c9f\u0ccd, \u0c95\u0cbe\u0caf\u0cc1\u0cb5\u0cbf\u0c95\u0cc6 \u0ca8\u0cbf\u0c9c\u0cb5\u0cbe\u0ca6 \u0c96\u0cb0\u0ccd\u0c9a\u0cbf\u0ca8\u0c82\u0ca4\u0cc6 \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",Tolls:"\u0c9f\u0ccb\u0cb2\u0ccd\u200c\u0c97\u0cb3\u0cc1","Tolls, Permits & Driver Bata are included in total vendor price":"\u0c9f\u0ccb\u0cb2\u0ccd, \u0caa\u0cb0\u0ccd\u0cae\u0cbf\u0c9f\u0ccd & \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cac\u0c9f\u0ccd\u0c9f\u0cbe \u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd \u0cac\u0cc6\u0cb2\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb5\u0cc6",Tomorrow:"\u0ca8\u0cbe\u0cb3\u0cc6","Top Partner":"\u0c9f\u0cbe\u0caa\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd",Total:"\u0c92\u0c9f\u0ccd\u0c9f\u0cc1","Total amount paid by the customer":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cc1 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf\u0ca6 \u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cca\u0ca4\u0ccd\u0ca4","Total Booking Amount":"\u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cac\u0cc1\u0
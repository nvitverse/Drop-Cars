u0ca4\u0cc6 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.",accountCreatedTitle:"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",goToLogin:"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf",signupFailedGeneric:"\u0cb8\u0cc8\u0ca8\u0ccd \u0c85\u0caa\u0ccd \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.",requestTimeout:"\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0cae\u0caf \u0cae\u0cc0\u0cb0\u0cbf\u0ca6\u0cc6 - \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca4\u0cc1\u0c82\u0cac\u0cbe \u0cb8\u0cae\u0caf \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.",networkError:"\u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0ca6\u0ccb\u0cb7 - \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0c82\u0c9f\u0cb0\u0ccd\u0ca8\u0cc6\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.",serverNotFound:"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2 - \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0c95\u0cc6\u0c82\u0ca1\u0ccd \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0c9a\u0cbe\u0cb2\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6\u0caf\u0cc7 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.",serverError:"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0ca6\u0ccb\u0cb7 \u2014 \u0ca8\u0c82\u0ca4\u0cb0 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf.",signupFailedTitle:"\u0cb8\u0cc8\u0ca8\u0ccd \u0c85\u0caa\u0ccd \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1",uploaded:"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cbf\u0ca6\u0cc6",required:"\u0cac\u0cc7\u0c95\u0cc1",title:"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6",subtitle:"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",back:"\u0cb9\u0cbf\u0c82\u0ca6\u0cc6",creatingAccount:"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...",createAccount:"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf"},personalDetailsStep:{title:"\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1",subtitle:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cc2\u0cb2 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0ccb\u0ca3",aadharNumberLabel:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:",next:"\u0cae\u0cc1\u0c82\u0ca6\u0cc6"},signupSinglePage:{errorTitle:"\u0ca6\u0ccb\u0cb7",pickImageFailed:"\u0cab\u0ccb\u0c9f\u0ccb \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2",uploadFailedRetry:"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1. \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cb2\u0cc1 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf.",enterFullName:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",enterPrimaryNumber:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0cbe\u0ca5\u0cae\u0cbf\u0c95 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",mobileMustBe10Digits:"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0c97\u0cbf 10 \u0c85\u0c82\u0c95\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1",mobileMustStartWith:"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 6, 7, 8 \u0c85\u0ca5\u0cb5\u0cbe 9 \u0cb0\u0cbf\u0c82\u0ca6 \u0c86\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cac\u0cc7\u0c95\u0cc1",secondaryMobileMustBe10Digits:"\u0c8e\u0cb0\u0ca1\u0ca8\u0cc7 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0c97\u0cbf 10 \u0c85\u0c82\u0c95\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1",secondaryMobileMustStartWith:"\u0c8e\u0cb0\u0ca1\u0ca8\u0cc7 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 6, 7, 8 \u0c85\u0ca5\u0cb5\u0cbe 9 \u0cb0\u0cbf\u0c82\u0ca6 \u0c86\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cac\u0cc7\u0c95\u0cc1",enterPassword:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",passwordTooShort:"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 6 \u0c85\u0c95\u0ccd\u0cb7\u0cb0 \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1",enterAddress:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",enterCity:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0c97\u0cb0 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0c
u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","You don't have any assigned bookings at the moment.":"\u0cb8\u0ca6\u0ccd\u0caf \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0caf\u0cbe\u0cb5 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c95\u0cc2\u0ca1 \u0c87\u0cb2\u0ccd\u0cb2.","Booking {id}":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd {id}","Vendor: {name}":"\u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd: {name}",Vendor:"\u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd","Vendor Alt":"\u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd \u0caa\u0cb0\u0ccd\u0caf\u0cbe\u0caf","Waiting charge: \u20b9{amount}":"\u0c95\u0cbe\u0caf\u0cc1\u0cb5 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95: \u20b9{amount}","Night charges: \u20b9{amount}":"\u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95: \u20b9{amount}","\ud83d\udcb0 Toll charges can be updated":"\ud83d\udcb0 \u0c9f\u0ccb\u0cb2\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1","Pickup Notes: {notes}":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0c9f\u0cbf\u0caa\u0ccd\u0caa\u0ca3\u0cbf\u0c97\u0cb3\u0cc1: {notes}","Price per km:":"\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0c95\u0cbf.\u0cae\u0cc0. \u0cac\u0cc6\u0cb2\u0cc6:","Trip Active":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf",History:"\u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8","Completed Trips":"\u0cae\u0cc1\u0c97\u0cbf\u0ca6 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1",Close:"\u0cae\u0cc1\u0c9a\u0ccd\u0c9a\u0cbf","No completed trips found.":"\u0cae\u0cc1\u0c97\u0cbf\u0ca6 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Vendor:":"\u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd:","Number:":"\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:","From:":"\u0c87\u0c82\u0ca6:","To:":"\u0c97\u0cc6:","Stops:":"\u0ca8\u0cbf\u0cb2\u0cc1\u0c97\u0ca1\u0cc6\u0c97\u0cb3\u0cc1:","Trip: {tripType} \u2022 {carType}":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd: {tripType} \u2022 {carType}",Yes:"\u0cb9\u0ccc\u0ca6\u0cc1","No toll":"\u0c9f\u0ccb\u0cb2\u0ccd \u0c87\u0cb2\u0ccd\u0cb2","Toll: {value}":"\u0c9f\u0ccb\u0cb2\u0ccd: {value}","Night Charges: \u20b9{amount}":"\u0cb0\u0cbe\u0ca4\u0ccd\u0cb0\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95: \u20b9{amount}","Cash Collected: \u20b9{amount}":"\u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c97\u0ca6\u0cc1: \u20b9{amount}",Hide:"\u0cae\u0cb0\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","See More":"\u0c87\u0ca8\u0ccd\u0ca8\u0cb7\u0ccd\u0c9f\u0cc1 \u0ca8\u0ccb\u0ca1\u0cbf","Driver Beta: \u20b9{amount}":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cac\u0c9f\u0ccd\u0c9f\u0cbe: \u20b9{amount}","Created At: {date}":"\u0cb0\u0c9a\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb8\u0cae\u0caf: {date}","Cannot Go Online":"\u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb9\u0ccb\u0c97\u0cb2\u0cc1 \u0c86\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","You are currently driving. Please end your current trip first before going online.":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0ca6\u0ccd\u0caf \u0c9a\u0cbe\u0cb2\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf. \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb9\u0ccb\u0c97\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cbf.","Unable to update driver status. Please try again.":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Driver token is invalid or expired. Please login again.":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c9f\u0ccb\u0c95\u0ca8\u0ccd \u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0c85\u0ca5\u0cb5\u0cbe \u0c85\u0cb5\u0ca7\u0cbf \u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Connection Error":"\u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0ca6\u0ccb\u0cb7","Unable to connect to server. Please check your internet connection.":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0c82\u0c9f\u0cb0\u0ccd\u0ca8\u0cc6\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","Failed to load orders: {detail}":"\u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2: {detail}","Are you sure you want to logout?":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0cb2\u0cbe\u0c97\u0ccd \u0c94\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc7?","Active Trip":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd","You already have an active trip. Please end the current trip first.":"\u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c87\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cbf.","Cannot Start Trip":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","You cannot start a trip while your status is {status}. Please go online first to start trips.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf {status} \u0c86\u0c97\u0cbf\u0cb0\u0cc1\u0cb5\u0cbe\u0c97 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb9\u0ccb\u0c97\u0cbf.","Status Conflict":"\u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cb8\u0c82\u0c98\u0cb0\u0ccd\u0cb7","Failed to end trip":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Failed to load history":"\u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8 \u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Are you sure you want to leave registration? The details you entered may be lost.":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cac\u0cbf\u0ca1\u0cac\u0cc7\u0c95\u0cc7? \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0 \u0c95\u0cb3\u0cc6\u0ca6\u0cc1\u0cb9\u0ccb\u0c97\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Your account has been created successfully! Now let's set up your vehicle and driver details.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6! \u0c88\u0c97 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb9\u0ca8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0ccb\u0ca3.","Session expired":"\u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6","Please login again.":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",Unread:"\u0c93\u0ca6\u0ca6\u0cb5\u0cc1","Action Required":"\u0c95\u0ccd\u0cb0\u0cae \u0cac\u0cc7\u0c95\u0cc1","Delete Notifications":"\u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cb3\u0cbf\u0cb8\u0cbf","Delete {count} selected notification(s)?":"\u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 {count} \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6(\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1) \u0c85\u0cb3\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc7?",Delete:"\u0c85\u0cb3\u0cbf\u0cb8\u0cbf",Notifications:"\u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cc1","{count} selected":"{count} \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Delete Selected":"\u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cb3\u0cbf\u0cb8\u0cbf","No notifications here yet":"\u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","Failed to load pending orders":"\u0cac\u0cbe\u0c95\u0cbf \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Pending Bookings":"\u0cac\u0cbe\u0c95\u0cbf \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1","Type: {tripType} \u2022 Car: {carType}":"\u0cb5\u0cbf\u0ca7: {tripType} \u2022 \u0c95\u0cbe\u0cb0\u0cc1: {carType}","Distance: {distance} km \u2022 Time: {time}":"\u0ca6\u0cc2\u0cb0: {distance} \u0c95\u0cbf.\u0cae\u0cc0. \u2022 \u0cb8\u0cae\u0caf: {time}","Total: \u20b9{amount}":"\u0c92\u0c9f\u0ccd\u0c9f\u0cc1: \u20b9{amount}","Per km: {value}":"\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0c95\u0cbf.\u0cae\u0cc0.: {value}","No pending bookings":"\u0cac\u0cbe\u0c95\u0cbf \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","Setup Complete!":"\u0cb8\u0cc6\u0c9f\u0caa\u0ccd \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0cc6!","Great job, {name}! You've successfully completed your initial setup.":"\u0ca4\u0cc1\u0c82\u0cac\u0cbe \u0c92\u0cb3\u0ccd\u0cb3\u0cc6\u0caf\u0ca6\u0cc1, {name}! \u0ca8\u0cc0\u0cb5\u0cc1 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0c95 \u0cb8\u0cc6\u0c9f\u0caa\u0ccd \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf.","What We've Completed":"\u0ca8\u0cbe\u0cb5\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1","Account Created":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Your account owner profile has been successfully created":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Car Added":"\u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Your first car has been registered in the system":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0ca6\u0cb2 \u0c95\u0cbe\u0cb0\u0cc1 \u0cb5\u0ccd\u0caf\u0cb5\u0cb8\u0ccd\u0ca5\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Driver Profile Created":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Driver profile and documents have been submitted":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Documents Under Review":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb5\u0cc6","Review in Progress":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0ca8\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6","Our verification team is currently reviewing your submitted documents. This process typically takes 24-48 hours.":"\u0ca8\u0cae\u0ccd\u0cae \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cbe \u0ca4\u0c82\u0ca1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6. \u0c87\u0ca6\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf 24-48 \u0c97\u0c82\u0c9f\u0cc6 \u0cac\u0cc7\u0c95\u0cc1.","Account Owner Documents":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1","Under Review":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf","Driver Documents":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1","Car Registration":"\u0c95\u0cbe\u0cb0\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf","What Happens Next?":"\u0cae\u0cc1\u0c82\u0ca6\u0cc6 \u0c8f\u0ca8\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6?","Document Verification":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6","Our team will verify all submitted documents and information":"\u0ca8\u0cae\u0ccd\u0cae \u0ca4\u0c82\u0ca1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","Account Activation":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cbf\u0c95\u0cc6","Once verified, your account will be activated for full access":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbe\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","Start Your Journey":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf","You'll receive a notification when you can start using Drop Cars":"Drop Cars \u0cac\u0cb3\u0cb8\u0cb2\u0cc1 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6\u0cbe\u0c97 \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","Contact Support":"\u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf","You'll receive email and SMS notifications about your verification status. Please check your email regularly.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 SMS \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c86\u0c97\u0cbe\u0c97\u0ccd\u0c97\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","Aadhar Front Image":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb","Please upload Aadhar front image":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Please select an Aadhar front image":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","Invalid image format. Please select the image again.":"\u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cab\u0ccb\u0c9f\u0ccb \u0cb8\u0ccd\u0cb5\u0cb0\u0cc2\u0caa. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cab\u0ccb\u0c9f\u0ccb \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.","Go to Login":"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf","Signup failed. Please try again.":"\u0cb8\u0cc8\u0ca8\u0ccd \u0c85\u0caa\u0ccd \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Request timeout - server is taking too long to respond. Please try again.":"\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0cae\u0caf \u0cae\u0cc0\u0cb0\u0cbf\u0ca6\u0cc6 - \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca4\u0cc1\u0c82\u0cac\u0cbe \u0cb8\u0cae\u0caf \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Network error - please check your internet connection and try again.":"\u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0ca6\u0ccb\u0cb7 - \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0c82\u0c9f\u0cb0\u0ccd\u0ca8\u0cc6\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Server not found - please check if the backend server is running.":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2 - \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0c95\u0cc6\u0c82\u0ca1\u0ccd \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0c9a\u0cbe\u0cb2\u0ca8\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca6\u0cc6\u0caf\u0cc7 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","Server error - please try again later or contact support.":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0ca6\u0ccb\u0cb7 \u2014 \u0ca8\u0c82\u0ca4\u0cb0 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf.",Uploaded:"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cbf\u0ca6\u0cc6",Required:"\u0cac\u0cc7\u0c95\u0cc1","Upload your Aadhar front image for verification":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Creating Account...":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Personal Details":"\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","Let's start with your basic information":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cc2\u0cb2 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0ccb\u0ca3","Aadhar Number:":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:","Upload failed. Tap to try again.":"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1. \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cb2\u0cc1 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf.","Mobile number must be exactly 10 digits":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0c97\u0cbf 10 \u0c85\u0c82\u0c95\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Mobile number must start with 6, 7, 8, or 9":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 6, 7, 8 \u0c85\u0ca5\u0cb5\u0cbe 9 \u0cb0\u0cbf\u0c82\u0ca6 \u0c86\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cac\u0cc7\u0c95\u0cc1","Secondary mobile number must be exactly 10 digits":"\u0c8e\u0cb0\u0ca1\u0ca8\u0cc7 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0c97\u0cbf 10 \u0c85\u0c82\u0c95\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Secondary mobile number must start with 6, 7, 8, or 9":"\u0c8e\u0cb0\u0ca1\u0ca8\u0cc7 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 6, 7, 8 \u0c85\u0ca5\u0cb5\u0cbe 9 \u0cb0\u0cbf\u0c82\u0ca6 \u0c86\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cac\u0cc7\u0c95\u0cc1","Please enter your city":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0c97\u0cb0 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Aadhar number must be exactly 12 digits":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0c97\u0cbf 12 \u0c85\u0c82\u0c95\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Please enter your PAN number":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae PAN \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","PAN number must be in the format ABCDE1234F (5 letters, 4 digits, 1 letter)":"PAN \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 ABCDE1234F \u0cb8\u0ccd\u0cb5\u0cb0\u0cc2\u0caa\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1 (5 \u0c85\u0c95\u0ccd\u0cb7\u0cb0, 4 \u0c85\u0c82\u0c95\u0cbf, 1 \u0c85\u0c95\u0ccd\u0cb7\u0cb0)","Please wait":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c95\u0cbe\u0caf\u0cbf\u0cb0\u0cbf","Please wait for the document uploads to finish before creating your account.":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0caf\u0cc1\u0cb5\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0c95\u0cbe\u0caf\u0cbf\u0cb0\u0cbf.","Please upload Aadhar back image":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Please upload PAN card image":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 PAN \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Request timeout. Please try again.":"\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0cae\u0caf \u0cae\u0cc0\u0cb0\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Network error. Check your connection and try again.":"\u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0ca6\u0ccb\u0cb7. \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Server not found. Please try again later.":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0c82\u0ca4\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Server error. Please try again later.":"\u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0ca6\u0ccb\u0cb7. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0c82\u0ca4\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Tap to upload":"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf","Uploading...":"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Upload failed. Tap to retry.":"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1. \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cb2\u0cc1 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf.","Enter your details for partner verification":"\u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0cb5\u0cb0 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Full name":"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","Primary Mobile *":"\u0caa\u0ccd\u0cb0\u0cbe\u0ca5\u0cae\u0cbf\u0c95 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd *","10-digit mobile":"10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd","Secondary Mobile (Optional)":"\u0c8e\u0cb0\u0ca1\u0ca8\u0cc7 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)","Email *":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd *","Min 6 characters":"\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 6 \u0c85\u0c95\u0ccd\u0cb7\u0cb0","Address (Optional)":"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)","Street address":"\u0cb0\u0cb8\u0ccd\u0ca4\u0cc6 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8","City *":"\u0ca8\u0c97\u0cb0 *",City:"\u0ca8\u0c97\u0cb0",Pincode:"\u0caa\u0cbf\u0ca8\u0ccd\u200c\u0c95\u0ccb\u0ca1\u0ccd","6-digit pincode":"6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0caa\u0cbf\u0ca8\u0ccd\u200c\u0c95\u0ccb\u0ca1\u0ccd","12-digit Aadhar":"12 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c86\u0ca7\u0cbe\u0cb0\u0ccd","PAN Number *":"PAN \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 *",Document:"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6","Aadhar Front":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97","Aadhar Back":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97","PAN Card":"PAN \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd","Uploading documents...":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb5\u0cc6...","Got it ({count} more)":"\u0c85\u0cb0\u0ccd\u0ca5\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1 (\u0c87\u0ca8\u0ccd\u0ca8\u0cc2 {count})","Got it":"\u0c85\u0cb0\u0ccd\u0ca5\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1","Your wallet balance (\u20b9{balance}) is insufficient for this deduction (\u20b9{amount}). Please add money to your wallet.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd (\u20b9{balance}) \u0c88 \u0c95\u0ca1\u0cbf\u0ca4\u0c95\u0ccd\u0c95\u0cc6 (\u20b9{amount}) \u0cb8\u0cbe\u0c95\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ca3 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf.","Deduction Successful":"\u0c95\u0ca1\u0cbf\u0ca4 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf","\u20b9{amount} has been deducted from your wallet.\n\nNew Balance: \u20b9{newBalance}":"\u20b9{amount} \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0c95\u0ca1\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.\n\n\u0cb9\u0cca\u0cb8 \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd: \u20b9{newBalance}","Deduction Failed":"\u0c95\u0ca1\u0cbf\u0ca4 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1","Failed to process deduction. Please try again.":"\u0c95\u0ca1\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Wallet Deduction":"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0c95\u0ca1\u0cbf\u0ca4","Confirm the following deduction from your wallet":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0c88 \u0c95\u0ca1\u0cbf\u0ca4 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf",Type:"\u0cb5\u0cbf\u0ca7",Description:"\u0cb5\u0cbf\u0cb5\u0cb0\u0ca3\u0cc6",Details:"\u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1",Amount:"\u0cae\u0cca\u0ca4\u0ccd\u0ca4","Current Balance: \u20b9{balance} | After Deduction: \u20b9{after}":"\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd: \u20b9{balance} | \u0c95\u0ca1\u0cbf\u0ca4\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0: \u20b9{after}",Confirm:"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf","e.g. Swift Dzire":"\u0c89\u0ca6\u0cbe. Swift Dzire","No match - you can still type a custom car name":"\u0cb9\u0cca\u0c82\u0ca6\u0cbe\u0ca3\u0cbf\u0c95\u0cc6 \u0c87\u0cb2\u0ccd\u0cb2 - \u0ca8\u0cc0\u0cb5\u0cc1 \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0c95\u0cb8\u0ccd\u0c9f\u0cae\u0ccd \u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0c9f\u0cc8\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1","Others (Enter manually)":"\u0c87\u0ca4\u0cb0\u0cc6 (\u0c95\u0cc8\u0caf\u0cbe\u0cb0\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf)","Number: {plate}":"\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6: {plate}","State \xb7 RTO \xb7 Series \xb7 Number  (e.g. TN 25 CC 8246)":"\u0cb0\u0cbe\u0c9c\u0ccd\u0caf \xb7 RTO \xb7 \u0cb8\u0cb0\u0ca3\u0cbf \xb7 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6  (\u0c89\u0ca6\u0cbe. TN 25 CC 8246)",Approved:"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0ca4",Invalid:"\u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf",Processing:"\u0caa\u0ccd\u0cb0\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf","Permission Required":"\u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0cac\u0cc7\u0c95\u0cc1","Camera permission is required to take photos.":"\u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cb2\u0cc1 \u0c95\u0ccd\u0caf\u0cbe\u0cae\u0cc6\u0cb0\u0cbe \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0cac\u0cc7\u0c95\u0cc1.","Failed to take photo. Please try again.":"\u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Failed to pick image. Please try again.":"\u0cab\u0ccb\u0c9f\u0ccb \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","No Image":"\u0cab\u0ccb\u0c9f\u0ccb \u0c87\u0cb2\u0ccd\u0cb2","Please select an image first.":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cab\u0ccb\u0c9f\u0ccb \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.","Document updated successfully!":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","Failed to update document. Please try again.":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Update {name}":"{name} \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf","Take a new photo or select from gallery":"\u0cb9\u0cca\u0cb8 \u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0c97\u0ccd\u0caf\u0cbe\u0cb2\u0cb0\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","Image selected":"\u0cab\u0ccb\u0c9f\u0ccb \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Upload Document":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Take Photo":"\u0cab\u0ccb\u0c9f\u0ccb \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf","Choose from Gallery":"\u0c97\u0ccd\u0caf\u0cbe\u0cb2\u0cb0\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0c86\u0cb0\u0cbf\u0cb8\u0cbf","Could not save your Local Bookings city. Please try again.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0c97\u0cb0 \u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Local Bookings City":"\u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca8\u0c97\u0cb0","Pick the one city where you want to receive Local bookings.":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5 \u0c92\u0c82\u0ca6\u0cc1 \u0ca8\u0c97\u0cb0 \u0c86\u0cb0\u0cbf\u0cb8\u0cbf.","Search city":"\u0ca8\u0c97\u0cb0 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf","No serviceable cities found":"\u0cb8\u0cc7\u0cb5\u0cc6 \u0cb2\u0cad\u0ccd\u0caf \u0ca8\u0c97\u0cb0\u0c97\u0cb3\u0cc1 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Saving...":"\u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...",Save:"\u0c89\u0cb3\u0cbf\u0cb8\u0cbf","Account Created Successfully!":"\u0c96\u0cbe\u0ca4\u0cc6 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","Limit reached":"\u0cae\u0cbf\u0ca4\u0cbf \u0ca4\u0cb2\u0cc1\u0caa\u0cbf\u0ca6\u0cc6","You can select up to {max} vacant cities":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0 {max} \u0c96\u0cbe\u0cb2\u0cbf \u0ca8\u0c97\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1","Could not save vacant cities. Please try again.":"\u0c96\u0cbe\u0cb2\u0cbf \u0ca8\u0c97\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Vacant City ({count}/{max})":"\u0c96\u0cbe\u0cb2\u0cbf \u0ca8\u0c97\u0cb0 ({count}/{max})","Searching online for this city\u2026":"\u0c88 \u0ca8\u0c97\u0cb0\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6\u2026","Search Online":"\u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf","No matches for \"{query}\"":"\"{query}\" \u0c97\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2","Update Vacant City":"\u0c96\u0cbe\u0cb2\u0cbf \u0ca8\u0c97\u0cb0 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf","Pick up to {max} cities where you are waiting for a trip. Vendors can see these.":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cbe\u0c97\u0cbf \u0c95\u0cbe\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5 \u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0 {max} \u0ca8\u0c97\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0cb0\u0cbf\u0cb8\u0cbf. \u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c87\u0cb5\u0cc1 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.","Selected: {cities}":"\u0c86\u0caf\u0ccd\u0c95\u0cc6: {cities}","Search city...":"\u0ca8\u0c97\u0cb0 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf...",Clear:"\u0c85\u0cb3\u0cbf\u0cb8\u0cbf","+ Add \"{name}\"":"+ \"{name}\" \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Select Mfd Year":"\u0ca4\u0caf\u0cbe\u0cb0\u0cbf\u0c95\u0cbe \u0cb5\u0cb0\u0ccd\u0cb7 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","Cannot place call":"\u0c95\u0cb0\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","This device cannot make phone calls.":"\u0c88 \u0cb8\u0cbe\u0ca7\u0ca8\u0ca6\u0cbf\u0c82\u0ca6 \u0cab\u0ccb\u0ca8\u0ccd \u0c95\u0cb0\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.","Something went wrong while trying to dial.":"\u0ca1\u0caf\u0cb2\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cbe\u0c97 \u0c8f\u0ca8\u0ccb \u0ca4\u0caa\u0ccd\u0caa\u0cbe\u0caf\u0cbf\u0ca4\u0cc1.",Call:"\u0c95\u0cb0\u0cc6","Customer Feedbacks & Incentives":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0c85\u0cad\u0cbf\u0caa\u0ccd\u0cb0\u0cbe\u0caf & \u0caa\u0ccd\u0cb0\u0ccb\u0ca4\u0ccd\u0cb8\u0cbe\u0cb9\u0ca7\u0ca8","Star Performance Bonuses & Ratings (>3\u2605 = +\u20b910/star)":"\u0cb8\u0ccd\u0c9f\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c95\u0ccd\u0cb7\u0cae\u0ca4\u0cc6 \u0cac\u0ccb\u0ca8\u0cb8\u0ccd & \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd (>3\u2605 = \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cb8\u0ccd\u0c9f\u0cbe\u0cb0\u0ccd\u200c\u0c97\u0cc6 +\u20b910)","TOTAL STAR PERFORMANCE INCENTIVES":"\u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0ccd\u0c9f\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c95\u0ccd\u0cb7\u0cae\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0ccb\u0ca4\u0ccd\u0cb8\u0cbe\u0cb9\u0ca7\u0ca8","credited to your wallet":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0c9c\u0cae\u0cbe \u0c86\u0c97\u0cbf\u0ca6\u0cc6","Earn +\u20b910 per star for ratings >3 Stars! (5\u2605 = +\u20b950 / 4\u2605 = +\u20b940). This incentive belongs directly to the driver!":"3 \u0cb8\u0ccd\u0c9f\u0cbe\u0cb0\u0ccd\u200c\u0c97\u0cbf\u0c82\u0ca4 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0cb0\u0cc7\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cc6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cb8\u0ccd\u0c9f\u0cbe\u0cb0\u0ccd\u200c\u0c97\u0cc6 +\u20b910 \u0c97\u0cb3\u0cbf\u0cb8\u0cbf! (5\u2605 = +\u20b950 / 4\u2605 = +\u20b940). \u0c88 \u0caa\u0ccd\u0cb0\u0ccb\u0ca4\u0ccd\u0cb8\u0cbe\u0cb9\u0ca7\u0ca8 \u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0cc7\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6!","Recent Customer Reviews":"\u0c87\u0ca4\u0ccd\u0ca4\u0cc0\u0c9a\u0cbf\u0ca8 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cb5\u0cbf\u0cae\u0cb0\u0ccd\u0cb6\u0cc6\u0c97\u0cb3\u0cc1","Booking #{bookingId} \xb7 {date}":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd #{bookingId} \xb7 {date}","\ud83c\udf81 +\u20b9{amount} Star Performance Incentive Credited ({rating}\u2605 \xd7 \u20b910/star)":"\ud83c\udf81 +\u20b9{amount} \u0cb8\u0ccd\u0c9f\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c95\u0ccd\u0cb7\u0cae\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0ccb\u0ca4\u0ccd\u0cb8\u0cbe\u0cb9\u0ca7\u0ca8 \u0c9c\u0cae\u0cbe \u0c86\u0c97\u0cbf\u0ca6\u0cc6 ({rating}\u2605 \xd7 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cb8\u0ccd\u0c9f\u0cbe\u0cb0\u0ccd\u200c\u0c97\u0cc6 \u20b910)","\ud83d\ude96 Going Empty (Seat Sharing)":"\ud83d\ude96 \u0c96\u0cbe\u0cb2\u0cbf \u0cb9\u0ccb\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6 (\u0cb8\u0cc0\u0c9f\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cc6)","Offer empty seats on return trips \xb7 Seat Sharing":"\u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cbf \xb7 \u0cb8\u0cc0\u0c9f\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cc6","Post Empty Seats":"\u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Active Offers":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0c86\u0cab\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1","Open Seats":"\u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1\u0c97\u0cb3\u0cc1","Est. Earnings":"\u0c85\u0c82\u0ca6\u0cbe\u0c9c\u0cc1 \u0c97\u0cb3\u0cbf\u0c95\u0cc6","Post Empty Return / Route Trip":"\u0c96\u0cbe\u0cb2\u0cbf \u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5 / \u0cae\u0cbe\u0cb0\u0ccd\u0c97 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","From City *":"\u0cb9\u0cca\u0cb0\u0ca1\u0cc1\u0cb5 \u0ca8\u0c97\u0cb0 *","e.g. Chennai":"\u0c89\u0ca6\u0cbe. \u0c9a\u0cc6\u0ca8\u0ccd\u0ca8\u0cc8","To Destination *":"\u0ca4\u0cb2\u0cc1\u0caa\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cb3 *","e.g. Madurai":"\u0c89\u0ca6\u0cbe. \u0cae\u0ca7\u0cc1\u0cb0\u0cc8","Add Intermediate Route Stops (BlaBlaCar-style)":"\u0cae\u0ca7\u0ccd\u0caf\u0ca6 \u0cae\u0cbe\u0cb0\u0ccd\u0c97 \u0ca8\u0cbf\u0cb2\u0cc1\u0c97\u0ca1\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf (BlaBlaCar \u0cb6\u0cc8\u0cb2\u0cbf)","e.g. Villupuram / Trichy":"\u0c89\u0ca6\u0cbe. \u0cb5\u0cbf\u0cb2\u0ccd\u0cb2\u0cc1\u0caa\u0cc1\u0cb0\u0c82 / \u0ca4\u0cbf\u0cb0\u0cc1\u0c9a\u0ccd\u0c9a\u0cbf","Add Stop":"\u0ca8\u0cbf\u0cb2\u0cc1\u0c97\u0ca1\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Available Empty Seats":"\u0cb2\u0cad\u0ccd\u0caf \u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1\u0c97\u0cb3\u0cc1","Price Per Seat (\u20b9)":"\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cb8\u0cc0\u0c9f\u0cbf\u0c97\u0cc6 \u0cac\u0cc6\u0cb2\u0cc6 (\u20b9)","\u26a1 Instant Auto-Accept Seats?":"\u26a1 \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c97\u0cc6 \u0cb8\u0cc0\u0c9f\u0cc1\u0c97\u0cb3\u0cc7?","Instant seat confirmation upon payment":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0caf\u0cbe\u0ca6 \u0ca4\u0c95\u0ccd\u0cb7\u0ca3 \u0cb8\u0cc0\u0c9f\u0cc1 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3","Driver must manually approve each passenger request":"\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c95\u0cc8\u0caf\u0cbe\u0cb0\u0cc6 \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1","Publish Empty Trip Offer":"\u0c96\u0cbe\u0cb2\u0cbf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0cab\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0c95\u0c9f\u0cbf\u0cb8\u0cbf","Your Active Going Empty Offers":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0c96\u0cbe\u0cb2\u0cbf \u0cb9\u0ccb\u0c97\u0cc1\u0cb5 \u0c86\u0cab\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1","No Active Empty Seat Offers":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1 \u0c86\u0cab\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0cb2\u0ccd\u0cb2","Tap \"+ Post Empty Seats\" above to publish your return trip empty seats and earn extra income!":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0ca8 \u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0c95\u0c9f\u0cbf\u0cb8\u0cbf \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0c86\u0ca6\u0cbe\u0caf \u0c97\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0cae\u0cc7\u0cb2\u0cbf\u0ca8 \"+ \u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1 \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd\" \u0c92\u0ca4\u0ccd\u0ca4\u0cbf!","Departure:":"\u0cb9\u0cca\u0cb0\u0ca1\u0cc1\u0cb5 \u0cb8\u0cae\u0caf:","\ud83d\ude96 Commercial Cab":"\ud83d\ude96 \u0c95\u0cae\u0cb0\u0ccd\u0cb7\u0cbf\u0caf\u0cb2\u0ccd \u0c95\u0ccd\u0caf\u0cbe\u0cac\u0ccd","{count} Seats Left":"{count} \u0cb8\u0cc0\u0c9f\u0cc1\u0c97\u0cb3\u0cc1 \u0c89\u0cb3\u0cbf\u0ca6\u0cbf\u0cb5\u0cc6","/ seat":"/ \u0cb8\u0cc0\u0c9f\u0cbf\u0c97\u0cc6","\u26a1 Auto Accept ON":"\u26a1 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c97\u0cc6 \u0c86\u0ca8\u0ccd","\ud83d\udce9 Manual Request":"\ud83d\udce9 \u0c95\u0cc8\u0caf\u0cbe\u0cb0\u0cc6 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf","Passenger Seat Requests:":"\u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0 \u0cb8\u0cc0\u0c9f\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cc1:","Route: {pickup} \u2794 {drop} ({seats} seat)":"\u0cae\u0cbe\u0cb0\u0ccd\u0c97: {pickup} \u2794 {drop} ({seats} \u0cb8\u0cc0\u0c9f\u0cc1)",CONFIRMED:"\u0ca6\u0cc3\u0ca2\u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6\u0cc6",Approve:"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cbf","Please enter departure and destination cities.":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb9\u0cca\u0cb0\u0ca1\u0cc1\u0cb5 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca4\u0cb2\u0cc1\u0caa\u0cc1\u0cb5 \u0ca8\u0c97\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","\ud83c\udf89 \"Going Empty\" Seat Offer Published!":"\ud83c\udf89 \"\u0c96\u0cbe\u0cb2\u0cbf \u0cb9\u0ccb\u0c97\u0cc1\u0cb5\" \u0cb8\u0cc0\u0c9f\u0cc1 \u0c86\u0cab\u0cb0\u0ccd \u0caa\u0ccd\u0cb0\u0c95\u0c9f\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","Your seat offer ({from} \u2794 {to}) is now live in the Customer App under \"\ud83d\ude96 Drop Connect\". Net earnings will include 15% platform commission deduction.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cc0\u0c9f\u0cc1 \u0c86\u0cab\u0cb0\u0ccd ({from} \u2794 {to}) \u0c88\u0c97 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0ca8 \"\ud83d\ude96 Drop Connect\" \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cc8\u0cb5\u0ccd \u0c87\u0ca6\u0cc6. \u0ca8\u0cbf\u0cb5\u0ccd\u0cb5\u0cb3 \u0c97\u0cb3\u0cbf\u0c95\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf 15% \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0c95\u0cae\u0cbf\u0cb7\u0ca8\u0ccd \u0c95\u0ca1\u0cbf\u0ca4 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Approved!":"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","Passenger booking confirmed. Push notification sent to customer.":"\u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca6\u0cc3\u0ca2\u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6\u0cc6. \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0caa\u0cc1\u0cb6\u0ccd \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Driver Subscription":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cbf\u0c95\u0cc6","Priority Trips & High Earnings Tier":"\u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1 & \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0c97\u0cb3\u0cbf\u0c95\u0cc6 \u0cb9\u0c82\u0ca4","Standard Driver Tier":"\u0cb8\u0ccd\u0c9f\u0ccd\u0caf\u0cbe\u0c82\u0ca1\u0cb0\u0ccd\u0ca1\u0ccd \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb9\u0c82\u0ca4","PRO Driver ({tier})":"PRO \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd ({tier})","Standard trip dispatch":"\u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd","Priority dispatch & analytics active":"\u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd & \u0cb5\u0cbf\u0cb6\u0ccd\u0cb2\u0cc7\u0cb7\u0ca3\u0cc6 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf",ACTIVE:"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf",FREE:"\u0c89\u0c9a\u0cbf\u0ca4","Driver Wallet:":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd:","Select Subscription Plan":"\u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cbf\u0c95\u0cc6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","PRO MONTHLY":"PRO \u0cae\u0cbe\u0cb8\u0cbf\u0c95","Boost trip access":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0cb8\u0cbf","PRO ANNUAL":"PRO \u0cb5\u0cbe\u0cb0\u0ccd\u0cb7\u0cbf\u0c95","SAVE 16%":"16% \u0c89\u0cb3\u0cbf\u0ca4\u0cbe\u0caf","Maximum annual savings":"\u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0 \u0cb5\u0cbe\u0cb0\u0ccd\u0cb7\u0cbf\u0c95 \u0c89\u0cb3\u0cbf\u0ca4\u0cbe\u0caf","Extend Subscription":"\u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cbf\u0c95\u0cc6 \u0cb5\u0cbf\u0cb8\u0ccd\u0ca4\u0cb0\u0cbf\u0cb8\u0cbf","Subscribe {plan} \u2022 \u20b9{amount}":"{plan} \u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cb0\u0cbe\u0c97\u0cbf \u2022 \u20b9{amount}","PRO Driver Privileges":"PRO \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0ccc\u0cb2\u0cad\u0ccd\u0caf\u0c97\u0cb3\u0cc1","\ud83d\ude80 Driver Tier Upgraded!":"\ud83d\ude80 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb9\u0c82\u0ca4 \u0c85\u0caa\u0ccd\u200c\u0c97\u0ccd\u0cb0\u0cc7\u0ca1\u0ccd \u0c86\u0c97\u0cbf\u0ca6\u0cc6!","Your {plan} Driver Subscription is now ACTIVE!":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae {plan} \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cbf\u0c95\u0cc6 \u0c88\u0c97 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","Insufficient Driver Wallet":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cbe\u0c95\u0cb7\u0ccd\u0c9f\u0cc1 \u0cb9\u0ca3 \u0c87\u0cb2\u0ccd\u0cb2","Recharge Wallet":"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cb0\u0cc0\u0c9a\u0cbe\u0cb0\u0ccd\u0c9c\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Subscription Error":"\u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cbf\u0c95\u0cc6 \u0ca6\u0ccb\u0cb7","Subscription activation failed. Please try again.":"\u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cbf\u0c95\u0cc6 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","High-Value Outstation Trip Priority":"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cae\u0ccc\u0cb2\u0ccd\u0caf\u0ca6 \u0c94\u0c9f\u0ccd\u200c\u0cb8\u0ccd\u0c9f\u0cc7\u0cb7\u0ca8\u0ccd \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6","Get priority visibility & instant notifications on high-fare trips":"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0ca6\u0cb0\u0ca6 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0c97\u0ccb\u0c9a\u0cb0\u0ca4\u0cc6 & \u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0caa\u0ca1\u0cc6\u0caf\u0cbf\u0cb0\u0cbf","Subscriber Deep Analytics & Insights":"\u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cb0 \u0c86\u0cb3\u0cb5\u0cbe\u0ca6 \u0cb5\u0cbf\u0cb6\u0ccd\u0cb2\u0cc7\u0cb7\u0ca3\u0cc6 & \u0c92\u0cb3\u0ca8\u0ccb\u0c9f","Unlock weekly earnings breakdown, best earning hours & trip trends":"\u0cb5\u0cbe\u0cb0\u0ca6 \u0c97\u0cb3\u0cbf\u0c95\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0, \u0c89\u0ca4\u0ccd\u0ca4\u0cae \u0c97\u0cb3\u0cbf\u0c95\u0cc6 \u0cb8\u0cae\u0caf & \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0ccd\u0cb0\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Empty-Return Route Priority Matching":"\u0c96\u0cbe\u0cb2\u0cbf \u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5 \u0cae\u0cbe\u0cb0\u0ccd\u0c97 \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0cb9\u0cca\u0c82\u0ca6\u0cbe\u0ca3\u0cbf\u0c95\u0cc6","Subscribed drivers matched first for return trip passengers":"\u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","Customizable Alert Notification Toggles":"\u0c95\u0cb8\u0ccd\u0c9f\u0cae\u0cc8\u0cb8\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6 \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cb8\u0ccd\u0cb5\u0cbf\u0c9a\u0ccd\u200c\u0c97\u0cb3\u0cc1","Granular control over trip alert categories and floating bubble":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6 \u0cb5\u0cb0\u0ccd\u0c97\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca4\u0cc7\u0cb2\u0cc1\u0cb5 \u0cac\u0cac\u0cb2\u0ccd \u0cae\u0cc7\u0cb2\u0cc6 \u0cb8\u0cc2\u0c95\u0ccd\u0cb7\u0ccd\u0cae \u0ca8\u0cbf\u0caf\u0c82\u0ca4\u0ccd\u0cb0\u0ca3","Driver Cancelled":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc1",Running:"\u0ca8\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6","Driver Assigned":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4",Accepted:"\u0c92\u0caa\u0ccd\u0caa\u0cbf\u0ca6\u0cc6","Not Accepted":"\u0c92\u0caa\u0ccd\u0caa\u0cbf\u0cb2\u0ccd\u0cb2","Booking ID: #{id}":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd ID: #{id}","Without CC":"CC \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6","From: ":"\u0c87\u0c82\u0ca6:","To: ":"\u0c97\u0cc6:","Tap card for full details":"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb5\u0cbf\u0cb5\u0cb0\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0c92\u0ca4\u0ccd\u0ca4\u0cbf","My Bookings":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1","Create Booking":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf","Active ({count})":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf ({count})","Executed ({count})":"\u0ca8\u0ca1\u0cc6\u0cb8\u0cbf\u0ca6\u0cb5\u0cc1 ({count})","All ({count})":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe ({count})","Upcoming ({count})":"\u0cae\u0cc1\u0c82\u0cac\u0cb0\u0cc1\u0cb5 ({count})","Running ({count})":"\u0ca8\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5 ({count})","Completed ({count})":"\u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cb5\u0cc1 ({count})","Cancelled ({count})":"\u0cb0\u0ca6\u0ccd\u0ca6\u0cbe\u0ca6\u0cb5\u0cc1 ({count})","Driver Cancelled ({count})":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6\u0cb5\u0cc1 ({count})","No Bookings Found":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","No upcoming bookings found.":"\u0cae\u0cc1\u0c82\u0cac\u0cb0\u0cc1\u0cb5 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","No running trips found.":"\u0ca8\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","No completed bookings found.":"\u0cae\u0cc1\u0c97\u0cbf\u0ca6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","No creator-cancelled bookings found.":"\u0cb0\u0c9a\u0cbf\u0cb8\u0cbf\u0ca6\u0cb5\u0cb0\u0cc1 \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","No driver-cancelled bookings found.":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb8\u0cbf\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Bookings created or posted by you will show up here.":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf\u0ca6 \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.","Assigned: {driver} {car}":"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4: {driver} {car}","Setting up your driver session\u2026":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0caa\u0ca1\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6\u2026","Select Trip Type":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb5\u0cbf\u0ca7 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","Select Vehicle Type":"\u0cb5\u0cbe\u0cb9\u0ca8 \u0cb5\u0cb0\u0ccd\u0c97 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","Tap to change trip type":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb5\u0cbf\u0ca7 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf","Tap to change vehicle type":"\u0cb5\u0cbe\u0cb9\u0ca8 \u0cb5\u0cb0\u0ccd\u0c97 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf",Change:"\u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf","Trip Type":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb5\u0cbf\u0ca7","Vehicle Type":"\u0cb5\u0cbe\u0cb9\u0ca8 \u0cb5\u0cb0\u0ccd\u0c97","Customer Name *":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 *","Enter customer name":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Customer Mobile Number *":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 *","Enter 10-digit number":"10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter 8-15 digit number":"8-15 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Pickup Date & Time":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0caf","Return/Drop Date & Time":"\u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5/\u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0caf","Pickup & Drop Location":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0cb8\u0ccd\u0ca5\u0cb3","Pickup Location *":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cb8\u0ccd\u0ca5\u0cb3 *","Enter pickup address or city":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0c97\u0cb0 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Drop Location *":"\u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0cb8\u0ccd\u0ca5\u0cb3 *","Enter drop address or city":"\u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0c97\u0cb0 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Fare Type":"\u0ca6\u0cb0\u0ca6 \u0cb5\u0cbf\u0ca7","All Inclusive":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6","Pricing Details ({type})":"\u0ca6\u0cb0 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 ({type})","Total Booking Amount (\u20b9) *":"\u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0cca\u0ca4\u0ccd\u0ca4 (\u20b9) *","Total bundled price e.g. 10000":"\u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cac\u0c82\u0ca1\u0cb2\u0ccd \u0cac\u0cc6\u0cb2\u0cc6 \u0c89\u0ca6\u0cbe. 10000","Extra Amount (Optional)":"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0cae\u0cca\u0ca4\u0ccd\u0ca4 (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)","Bundled Charge Items":"\u0cac\u0c82\u0ca1\u0cb2\u0ccd \u0c86\u0ca6 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0cb5\u0cb8\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0cc1","Waiting Hours Included":"\u0c95\u0cbe\u0caf\u0cc1\u0cb5 \u0c97\u0c82\u0c9f\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0cc6","Cost Per KM (\u20b9)":"\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0c95\u0cbf.\u0cae\u0cc0. \u0cb5\u0cc6\u0c9a\u0ccd\u0c9a (\u20b9)","Driver Allowance (\u20b9)":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cad\u0ca4\u0ccd\u0caf\u0cc6 (\u20b9)","Toll Charges (\u20b9)":"\u0c9f\u0ccb\u0cb2\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 (\u20b9)","Toll charges may be updated during trip":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c9f\u0ccb\u0cb2\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1","Advance Received (Optional)":"\u0caa\u0ca1\u0cc6\u0ca6 \u0cae\u0cc1\u0c82\u0c97\u0ca1 (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)","Amount already collected from the customer":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c82\u0ca6 \u0c88\u0c97\u0cbe\u0c97\u0cb2\u0cc7 \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4","Special Requirements":"\u0cb5\u0cbf\u0cb6\u0cc7\u0cb7 \u0c85\u0cb5\u0cb6\u0ccd\u0caf\u0c95\u0ca4\u0cc6\u0c97\u0cb3\u0cc1","Car Make Year Requirement":"\u0c95\u0cbe\u0cb0\u0cc1 \u0ca4\u0caf\u0cbe\u0cb0\u0cbf\u0c95\u0cbe \u0cb5\u0cb0\u0ccd\u0cb7 \u0c85\u0cb5\u0cb6\u0ccd\u0caf\u0c95\u0ca4\u0cc6","Luggage Carrier Required":"\u0cb2\u0c97\u0cc7\u0c9c\u0ccd \u0c95\u0ccd\u0caf\u0cbe\u0cb0\u0cbf\u0caf\u0cb0\u0ccd \u0cac\u0cc7\u0c95\u0cc1","One Way":"\u0c92\u0ca8\u0ccd \u0cb5\u0cc7","Round Trip":"\u0cb0\u0ccc\u0c82\u0ca1\u0ccd \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd","Multi City":"\u0cac\u0cb9\u0cc1 \u0ca8\u0c97\u0cb0",Toll:"\u0c9f\u0ccb\u0cb2\u0ccd","State Permit":"\u0cb0\u0cbe\u0c9c\u0ccd\u0caf \u0caa\u0cb0\u0ccd\u0cae\u0cbf\u0c9f\u0ccd",Parking:"\u0caa\u0cbe\u0cb0\u0ccd\u0c95\u0cbf\u0c82\u0c97\u0ccd",Waiting:"\u0c95\u0cbe\u0caf\u0cc1\u0cb5\u0cbf\u0c95\u0cc6","Please enter customer name":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Please enter customer mobile number":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Please enter pickup and drop locations":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0cb8\u0ccd\u0ca5\u0cb3\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Please enter a valid Total Booking Amount for All-Inclusive fare":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6 \u0ca6\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Not Available Yet":"\u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2","Hourly Rental bookings from Driver App are coming soon - please use Oneway, Round Trip or Multi City for now.":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0c97\u0c82\u0c9f\u0cc6\u0caf \u0cac\u0cbe\u0ca1\u0cbf\u0c97\u0cc6 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb6\u0cc0\u0c98\u0ccd\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0cb0\u0cb2\u0cbf\u0ca6\u0cc6 - \u0cb8\u0ca6\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c92\u0ca8\u0ccd \u0cb5\u0cc7, \u0cb0\u0ccc\u0c82\u0ca1\u0ccd \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0cb9\u0cc1 \u0ca8\u0c97\u0cb0 \u0cac\u0cb3\u0cb8\u0cbf.","Return/drop date & time must be after the pickup date & time":"\u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5/\u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0caf \u0caa\u0cbf\u0c95\u0caa\u0ccd \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0caf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Could not create booking.":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Could Not Start Session":"\u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Indian mobile numbers (+91) must be exactly 10 digits":"\u0cad\u0cbe\u0cb0\u0ca4\u0cc0\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 (+91) \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0c97\u0cbf 10 \u0c85\u0c82\u0c95\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Mobile number must be {min}-{max} digits for country code {code}":"\u0ca6\u0cc7\u0cb6 \u0c95\u0ccb\u0ca1\u0ccd {code} \u0c97\u0cc6 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 {min}-{max} \u0c85\u0c82\u0c95\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Booking Created":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","View Active Rides":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccb\u0ca1\u0cbf","This trip is now live for nearby drivers to accept. You'll earn the posting bonus, and can accept it yourself too if you like.":"\u0c88 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c88\u0c97 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c92\u0caa\u0ccd\u0caa\u0cb2\u0cc1 \u0cb2\u0cc8\u0cb5\u0ccd \u0c87\u0ca6\u0cc6. \u0ca8\u0cc0\u0cb5\u0cc1 \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd \u0cac\u0ccb\u0ca8\u0cb8\u0ccd \u0c97\u0cb3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf, \u0cac\u0cc7\u0c95\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0ca8\u0cc0\u0cb5\u0cc7 \u0c95\u0cc2\u0ca1 \u0c92\u0caa\u0ccd\u0caa\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","View New Bookings":"\u0cb9\u0cca\u0cb8 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccb\u0ca1\u0cbf","Setting Up":"\u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0caa\u0ca1\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6","Still setting up your driver session - try again in a moment.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6 - \u0cb8\u0ccd\u0cb5\u0cb2\u0ccd\u0caa \u0cb9\u0cca\u0ca4\u0ccd\u0ca4\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Could not publish this listing.":"\u0c88 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf \u0caa\u0ccd\u0cb0\u0c95\u0c9f\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Could not approve this request.":"\u0c88 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Could not decline this request.":"\u0c88 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Share Empty Seats & Offer Seats":"\u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cc0\u0c9f\u0cc1 \u0ca8\u0cc0\u0ca1\u0cbf","\ud83d\udccb Requests ({count})":"\ud83d\udccb \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cc1 ({count})","\ud83d\udcba Offer Seats":"\ud83d\udcba \u0cb8\u0cc0
c8\u0b95\u0bb3\u0bcd",step1RouteTitle:"1. \u0baa\u0bbe\u0ba4\u0bc8 & \u0b87\u0b9f\u0bc8\u0baf\u0bbf\u0b9f\u0bc8 \u0ba8\u0bbf\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd",step2ScheduleTitle:"2. \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0bc8, \u0bb5\u0bbe\u0b95\u0ba9\u0bae\u0bcd & \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bcd",step3ReviewTitle:"3. \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0baf\u0bcd\u0bb5\u0bc1 & \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc8 \u0b9a\u0bb2\u0bc1\u0b95\u0bc8\u0baf\u0bc8 \u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u0bc1"},languageSelect:{title:"\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bca\u0bb4\u0bbf\u0baf\u0bc8\u0ba4\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd",subtitle:"\u0b87\u0ba4\u0bc8 \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0b85\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b8e\u0baa\u0bcd\u0baa\u0bcb\u0ba4\u0bc1 \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bbe\u0ba9\u0bbe\u0bb2\u0bc1\u0bae\u0bcd \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bb2\u0bbe\u0bae\u0bcd",continue:"\u0ba4\u0bca\u0b9f\u0bb0\u0bb5\u0bc1\u0bae\u0bcd",skip:"\u0ba4\u0bb1\u0bcd\u0baa\u0bcb\u0ba4\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0bb5\u0bbf\u0bb0\u0bcd"}}},2625,[]);
__d(function(e,t,a,i,r,o,l){r.exports={common:{brand:"Drop Cars"},tabBar:{home:"\u0c39\u0c4b\u0c2e\u0c4d",myRides:"\u0c28\u0c3e \u0c30\u0c48\u0c21\u0c4d\u200c\u0c32\u0c41",dropMarket:"\u0c21\u0c4d\u0c30\u0c3e\u0c2a\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c15\u0c46\u0c1f\u0c4d",chats:"\u0c1a\u0c3e\u0c1f\u0c4d",duty:"\u0c21\u0c4d\u0c2f\u0c42\u0c1f\u0c40"},languageNames:{en:"English",ta:"\u0ba4\u0bae\u0bbf\u0bb4\u0bcd",te:"\u0c24\u0c46\u0c32\u0c41\u0c17\u0c41",hi:"\u0939\u093f\u0928\u094d\u0926\u0940"},terms:{modalTitle:"\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 & \u0c37\u0c30\u0c24\u0c41\u0c32\u0c41",body:"\u0c21\u0c4d\u0c30\u0c3e\u0c2a\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c38\u0c4d \u2013 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d & \u0c2b\u0c4d\u0c32\u0c40\u0c1f\u0c4d \u0c2a\u0c3e\u0c30\u0c4d\u0c1f\u0c4d\u0c28\u0c30\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\n\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 & \u0c37\u0c30\u0c24\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c30\u0c2e\u0c4d \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c02\n\nDrop Cars \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c2a\u0c3e\u0c30\u0c4d\u0c1f\u0c4d\u0c28\u0c30\u0c4d \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c32\u0c4b \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e, \u0c2f\u0c42\u0c1c\u0c30\u0c4d (\u0c2b\u0c4d\u0c32\u0c40\u0c1f\u0c4d \u0c2f\u0c1c\u0c2e\u0c3e\u0c28\u0c3f, \u0c35\u0c3e\u0c39\u0c28 \u0c2f\u0c1c\u0c2e\u0c3e\u0c28\u0c3f, \u0c32\u0c47\u0c26\u0c3e \u0c16\u0c3e\u0c24\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c21\u0c41) \u0c15\u0c3f\u0c02\u0c26\u0c3f \u0c1a\u0c1f\u0c4d\u0c1f\u0c2c\u0c26\u0c4d\u0c27\u0c2e\u0c48\u0c28 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c15\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c41.\n\n1. \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c30\u0c2e\u0c4d \u0c24\u0c1f\u0c38\u0c4d\u0c25\u0c24 & \u0c1c\u0c40\u0c30\u0c4b \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24 (Zero Liability)\nDrop Cars \u0c05\u0c28\u0c47\u0c26\u0c3f \u0c38\u0c4d\u0c35\u0c24\u0c02\u0c24\u0c4d\u0c30 \u0c2b\u0c4d\u0c32\u0c40\u0c1f\u0c4d \u0c2f\u0c1c\u0c2e\u0c3e\u0c28\u0c41\u0c32\u0c28\u0c41/\u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u0c32\u0c28\u0c41 \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c35\u0c3e\u0c21\u0c15\u0c02\u0c24\u0c4b \u0c15\u0c32\u0c3f\u0c2a\u0c47 \u0c21\u0c3f\u0c1c\u0c3f\u0c1f\u0c32\u0c4d \u0c38\u0c3e\u0c02\u0c15\u0c47\u0c24\u0c3f\u0c15 \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c30\u0c2e\u0c4d \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47. Drop Cars \u0c30\u0c35\u0c3e\u0c23\u0c3e \u0c38\u0c02\u0c38\u0c4d\u0c25 \u0c32\u0c47\u0c26\u0c3e \u0c2f\u0c1c\u0c2e\u0c3e\u0c28\u0c3f \u0c15\u0c3e\u0c26\u0c41. \u0c35\u0c3e\u0c39\u0c28\u0c02 \u0c2a\u0c30\u0c3f\u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f, \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c2a\u0c4d\u0c30\u0c35\u0c30\u0c4d\u0c24\u0c28, \u0c30\u0c4b\u0c21\u0c4d\u0c21\u0c41 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c26\u0c3e\u0c32\u0c41, \u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c40\u0c15\u0c41\u0c32 \u0c17\u0c3e\u0c2f\u0c3e\u0c32\u0c41, \u0c06\u0c38\u0c4d\u0c24\u0c3f \u0c28\u0c37\u0c4d\u0c1f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c1a\u0c1f\u0c4d\u0c1f\u0c2a\u0c30\u0c2e\u0c48\u0c28 \u0c35\u0c3f\u0c35\u0c3e\u0c26\u0c3e\u0c32\u0c15\u0c41 Drop Cars \u0c0e\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24 \u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c26\u0c41 (ZERO Liability).\n\n2. \u0c16\u0c3e\u0c24\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c21\u0c3f \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24 (Absolute Account Holder Liability)\nDrop Cars \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u200c\u0c32\u0c4b \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c28\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c28\u0c2e\u0c4b\u0c26\u0c3f\u0c24 \u0c16\u0c3e\u0c24\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c21\u0c41, \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c15\u0c4d\u0c37\u0c23\u0c02 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c2f\u0c4d\u0c2f\u0c47 \u0c35\u0c30\u0c15\u0c41 100% \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c1f\u0c4d\u0c1f\u0c2a\u0c30\u0c2e\u0c48\u0c28, \u0c06\u0c30\u0c4d\u0c25\u0c3f\u0c15 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c47\u0c30\u0c2a\u0c42\u0c30\u0c3f\u0c24 \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24\u0c28\u0c41 \u0c35\u0c39\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41. \u0c16\u0c3e\u0c24\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c21\u0c41 \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c17\u0c3e \u0c28\u0c21\u0c3f\u0c2a\u0c3f\u0c28\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c07\u0c1a\u0c4d\u0c1a\u0c3f\u0c28\u0c3e \u0c08 \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24 \u0c35\u0c3e\u0c30\u0c3f\u0c2a\u0c48\u0c28\u0c47 \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f.\n\n3. \u0c05\u0c28\u0c27\u0c3f\u0c15\u0c3e\u0c30 \u0c35\u0c3e\u0c39\u0c28\u0c02 & \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41 (\u0c15\u0c20\u0c3f\u0c28\u0c2e\u0c48\u0c28 \u0c28\u0c3f\u0c37\u0c47\u0c27\u0c02)\n3.1. \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2a\u0c4d\u0c30\u0c24\u0c3f \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c2f\u0c3e\u0c2a\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f\u0c15\u0c02\u0c17\u0c3e \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c35\u0c3e\u0c39\u0c28\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c28\u0c21\u0c2a\u0c2c\u0c21\u0c3e\u0c32\u0c3f.\n3.2. \u0c05\u0c28\u0c27\u0c3f\u0c15\u0c3e\u0c30 \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41/\u0c05\u0c2a\u0c4d\u0c2a\u0c17\u0c3f\u0c02\u0c24: \u0c16\u0c3e\u0c24\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c21\u0c41 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c28\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f, \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c32\u0c4b \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c28\u0c3f \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c35\u0c3e\u0c39\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c47, \u0c26\u0c3e\u0c28\u0c3f\u0c35\u0c32\u0c4d\u0c32 \u0c1c\u0c30\u0c3f\u0c17\u0c47 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c26\u0c02, \u0c2e\u0c30\u0c23\u0c02, \u0c17\u0c3e\u0c2f\u0c02, \u0c26\u0c4a\u0c02\u0c17\u0c24\u0c28\u0c02, \u0c35\u0c3e\u0c39\u0c28 \u0c28\u0c37\u0c4d\u0c1f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c1a\u0c1f\u0c4d\u0c1f\u0c2a\u0c30\u0c2e\u0c48\u0c28 \u0c1c\u0c30\u0c3f\u0c2e\u0c3e\u0c28\u0c3e\u0c32\u0c15\u0c41 100% \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c38\u0c3f\u0c35\u0c3f\u0c32\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c4d\u0c30\u0c3f\u0c2e\u0c3f\u0c28\u0c32\u0c4d \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c16\u0c3e\u0c24\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c21\u0c3f\u0c26\u0c47. Drop Cars \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c15\u0c4d\u0c32\u0c46\u0c2f\u0c3f\u0c2e\u0c4d\u200c\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c35\u0c3f\u0c2e\u0c41\u0c15\u0c4d\u0c24\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.\n3.3. \u0c09\u0c32\u0c4d\u0c32\u0c02\u0c18\u0c28\u0c32\u0c15\u0c41 \u0c24\u0c15\u0c4d\u0c37\u0c23 \u0c1c\u0c30\u0c3f\u0c2e\u0c3e\u0c28\u0c3e \u20b910,000 \u0c35\u0c30\u0c15\u0c41, \u0c16\u0c3e\u0c24\u0c3e \u0c36\u0c3e\u0c36\u0c4d\u0c35\u0c24 \u0c2c\u0c4d\u0c32\u0c3e\u0c15\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c1f\u0c4d\u0c1f\u0c2a\u0c30\u0c2e\u0c48\u0c28 \u0c1a\u0c30\u0c4d\u0c2f\u0c32\u0c41 \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f.\n\n4. \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u0c32 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 & \u0c35\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41\n4.1. \u0c16\u0c3e\u0c24\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c3f\u0c02\u0c17\u0c4d \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d, RC, \u0c15\u0c2e\u0c30\u0c4d\u0c37\u0c3f\u0c2f\u0c32\u0c4d \u0c07\u0c28\u0c4d\u0c38\u0c42\u0c30\u0c46\u0c28\u0c4d\u0c38\u0c4d, \u0c2b\u0c3f\u0c1f\u0c4d\u200c\u0c28\u0c46\u0c38\u0c4d \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c46\u0c1f\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c30\u0c4d\u0c2e\u0c3f\u0c1f\u0c4d \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u0c32\u0c28\u0c41 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c1a\u0c3e\u0c32\u0c3f.\n4.2. \u0c17\u0c21\u0c41\u0c35\u0c41 \u0c2e\u0c41\u0c17\u0c3f\u0c38\u0c3f\u0c28 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c15\u0c3f\u0c32\u0c40 \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u0c32\u0c41: \u0c17\u0c21\u0c41\u0c35\u0c41 \u0c2e\u0c41\u0c17\u0c3f\u0c38\u0c3f\u0c28 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c15\u0c3f\u0c32\u0c40 \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u0c32\u0c24\u0c4b \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c28\u0c21\u0c3f\u0c2a\u0c3f\u0c24\u0c47, \u0c35\u0c1a\u0c4d\u0c1a\u0c47 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c1f\u0c4d\u0c30\u0c3e\u0c2b\u0c3f\u0c15\u0c4d \u0c1c\u0c30\u0c3f\u0c2e\u0c3e\u0c28\u0c3e\u0c32\u0c41, \u0c1a\u0c1f\u0c4d\u0c1f\u0c2a\u0c30\u0c2e\u0c48\u0c28 \u0c28\u0c37\u0c4d\u0c1f\u0c2a\u0c30\u0c3f\u0c39\u0c3e\u0c30\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c07\u0c28\u0c4d\u0c38\u0c42\u0c30\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c23\u0c32\u0c15\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c16\u0c3e\u0c24\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c21\u0c47 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c2c\u0c3e\u0c27\u0c4d\u0c2f\u0c24 \u0c35\u0c39\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41.\n\n5. \u0c28\u0c37\u0c4d\u0c1f\u0c2a\u0c30\u0c3f\u0c39\u0c3e\u0c30 \u0c30\u0c15\u0c4d\u0c37\u0c23 \u0c12\u0c2a\u0c4d\u0c2a\u0c02\u0c26\u0c02 (Indemnification)\n\u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c38\u0c2e\u0c2f\u0c02\u0c32\u0c4b \u0c1c\u0c30\u0c3f\u0c17\u0c47 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c26\u0c3e\u0c32\u0c41, \u0c05\u0c28\u0c27\u0c3f\u0c15\u0c3e\u0c30 \u0c35\u0c3e\u0c39\u0c28/\u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c32\u0c41, \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c28\u0c3f \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u0c32\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c24\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c2a\u0c4d\u0c30\u0c35\u0c30\u0c4d\u0c24\u0c28 \u0c35\u0c32\u0c4d\u0c32 \u0c15\u0c32\u0c3f\u0c17\u0c47 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c37\u0c4d\u0c1f\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c1f\u0c4d\u0c1f\u0c2a\u0c30\u0c2e\u0c48\u0c28 \u0c16\u0c30\u0c4d\u0c1a\u0c41\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f Drop Cars \u0c28\u0c41 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f\u0c17\u0c3e \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c28\u0c3f \u0c2f\u0c42\u0c1c\u0c30\u0c4d \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c41.\n\n6. \u0c2b\u0c40\u0c1c\u0c41\u0c32\u0c41 & \u0c1c\u0c30\u0c3f\u0c2e\u0c3e\u0c28\u0c3e\u0c32\u0c41\n\u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c2a\u0c41 \u0c38\u0c2c\u0c4d\u200c\u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u0c37\u0c28\u0c4d \u0c2b\u0c40\u0c1c\u0c41, \u0c15\u0c2e\u0c40\u0c37\u0c28\u0c4d (10%) \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1c\u0c30\u0c3f\u0c2e\u0c3e\u0c28\u0c3e\u0c32\u0c41 \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c35\u0c41.\n- \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c48\u0c2b\u0c32\u0c4d\u0c2f\u0c02 \u0c1c\u0c30\u0c3f\u0c2e\u0c3e\u0c28\u0c3e: \u20b92,000 \u0c35\u0c30\u0c15\u0c41\n- \u0c05\u0c28\u0c27\u0c3f\u0c15\u0c3e\u0c30 \u0c35\u0c3e\u0c39\u0c28/\u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41 \u0c1c\u0c30\u0c3f\u0c2e\u0c3e\u0c28\u0c3e: \u20b910,000 \u0c35\u0c30\u0c15\u0c41 & \u0c36\u0c3e\u0c36\u0c4d\u0c35\u0c24 \u0c2c\u0c4d\u0c32\u0c3e\u0c15\u0c4d\n\n7. \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41 & \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41\u0c32\u0c41\n\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d: support@dropcars.com | \u0c2b\u0c4b\u0c28\u0c4d: +917200217986\n"},welcome:{steps:[{title:"Drop Cars \u0c15\u0c3f \u0c38\u0c4d\u0c35\u0c3e\u0c17\u0c24\u0c02!",subtitle:"\u0c2a\u0c4d\u0c30\u0c2e\u0c41\u0c16 \u0c2b\u0c4d\u0c32\u0c40\u0c1f\u0c4d & \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c2a\u0c3e\u0c30\u0c4d\u0c1f\u0c4d\u0c28\u0c30\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c30\u0c2e\u0c4d",description:"\u0c2d\u0c3e\u0c30\u0c24\u0c26\u0c47\u0c36\u0c02 \u0c05\u0c02\u0c24\u0c1f\u0c3e \u0c09\u0c28\u0c4d\u0c28 \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c24\u0c4b \u0c2e\u0c40 \u0c35\u0c3e\u0c39\u0c28\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c38\u0c02\u0c27\u0c3e\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f. \u0c38\u0c41\u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c30\u0c35\u0c3e\u0c23\u0c3e \u0c38\u0c47\u0c35\u0c32\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c42 \u0c28\u0c2e\u0c4d\u0c2e\u0c15\u0c02\u0c17\u0c3e \u0c38\u0c02\u0c2a\u0c3e\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."},{title:"\u0c26\u0c36 1: \u0c2b\u0c4d\u0c32\u0c40\u0c1f\u0c4d & \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u0c32\u0c28\u0c41 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",subtitle:"\u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u0c32\u0c28\u0c41 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c1a\u0c02\u0c21\u0c3f",description:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41 \u0c05\u0c2f\u0c4d\u0c2f\u0c47 RC, \u0c07\u0c28\u0c4d\u0c38\u0c42\u0c30\u0c46\u0c28\u0c4d\u0c38\u0c4d, \u0c2a\u0c30\u0c4d\u0c2e\u0c3f\u0c1f\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2b\u0c3f\u0c1f\u0c4d\u200c\u0c28\u0c46\u0c38\u0c4d\u200c\u0c24\u0c4b \u0c35\u0c3e\u0c39\u0c28\u0c3e\u0c32\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c09\u0c28\u0c4d\u0c28 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u0c32\u0c28\u0c41 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."},{title:"\u0c26\u0c36 2: \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",subtitle:"\u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c35\u0c3e\u0c39\u0c28\u0c02 & \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c24\u0c2a\u0c4d\u0c2a\u0c28\u0c3f\u0c38\u0c30\u0c3f",description:"\u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c2f\u0c3e\u0c2a\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c35\u0c3e\u0c39\u0c28\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f. \u0c05\u0c28\u0c27\u0c3f\u0c15\u0c3e\u0c30 \u0c35\u0c3e\u0c39\u0c28\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41 \u0c24\u0c40\u0c35\u0c4d\u0c30\u0c2e\u0c
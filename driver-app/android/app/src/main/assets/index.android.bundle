0bcd\u0b95\u0bc8",passengerRequestsLabel:"\u0baa\u0baf\u0ba3\u0bbf \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc8 \u0b95\u0bcb\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bcd:",routeLine:"\u0baa\u0bbe\u0ba4\u0bc8: {pickup} \u2794 {drop} ({seats} \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc8)",confirmed:"\u0b89\u0bb1\u0bc1\u0ba4\u0bbf \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1",approve:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bb0\u0bbf",requiredAlertTitle:"\u0ba4\u0bc7\u0bb5\u0bc8",requiredAlertBody:"\u0baa\u0bc1\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc6\u0bb2\u0bcd\u0bb2\u0bc1\u0bae\u0bcd \u0ba8\u0b95\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0b89\u0bb3\u0bcd\u0bb3\u0bbf\u0b9f\u0bb5\u0bc1\u0bae\u0bcd.",publishedAlertTitle:"\ud83c\udf89 \"\u0b95\u0bbe\u0bb2\u0bbf \u0bb5\u0ba3\u0bcd\u0b9f\u0bbf\" \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc8 \u0b9a\u0bb2\u0bc1\u0b95\u0bc8 \u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1!",publishedAlertBody:"\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc8 \u0b9a\u0bb2\u0bc1\u0b95\u0bc8 ({from} \u2794 {to}) \u0b87\u0baa\u0bcd\u0baa\u0bcb\u0ba4\u0bc1 Customer App-\u0bb2\u0bcd \"\ud83d\ude96 Drop Connect\"-\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0ba8\u0bc7\u0bb0\u0b9f\u0bbf\u0baf\u0bbe\u0b95 \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0ba8\u0bbf\u0b95\u0bb0 \u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 15% \u0ba4\u0bb3 \u0b95\u0bae\u0bbf\u0bb7\u0ba9\u0bcd \u0b95\u0bb4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd.",approvedAlertTitle:"\u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1!",approvedAlertBody:"\u0baa\u0baf\u0ba3\u0bbf \u0bae\u0bc1\u0ba9\u0bcd\u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b89\u0bb1\u0bc1\u0ba4\u0bbf \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc
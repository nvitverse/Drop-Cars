0cb8\u0cc8\u0c9f\u0ccd","Welcome back,":"\u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb8\u0ccd\u0cb5\u0cbe\u0c97\u0ca4,","WhatsApp Fleet Help Desk":"WhatsApp \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cb9\u0cc6\u0cb2\u0ccd\u0caa\u0ccd \u0ca1\u0cc6\u0cb8\u0ccd\u0c95\u0ccd","WhatsApp Not Installed":"WhatsApp \u0c87\u0ca8\u0ccd\u200c\u0cb8\u0ccd\u0c9f\u0cbe\u0cb2\u0ccd \u0c86\u0c97\u0cbf\u0cb2\u0ccd\u0cb2","When a customer accepts your bid offer, confirmed trip details & direct booking links will appear right here!":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0cbf\u0ca1\u0ccd \u0c86\u0cab\u0cb0\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0ca6\u0cbe\u0c97, \u0ca6\u0cc3\u0ca2\u0caa\u0c9f\u0ccd\u0c9f \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 & \u0ca8\u0cc7\u0cb0 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cb2\u0cbf\u0c82\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf\u0caf\u0cc7 \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6!","When passengers request seats on any of your active rides, they will appear here for instant 1-tap approval.":"\u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc0\u0c9f\u0cc1 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0cb8\u0cbf\u0ca6\u0cbe\u0c97, \u0c92\u0c82\u0ca6\u0cc7 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf\u0ca8 \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cbe\u0ca3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.","Which booking is this about? Pick one - it opens that trip's Vendor/Owner chat.":"\u0c87\u0ca6\u0cc1 \u0caf\u0cbe\u0cb5 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cac\u0c97\u0ccd\u0c97\u0cc6? \u0c92\u0c82\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0cb0\u0cbf\u0cb8\u0cbf - \u0c86 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u
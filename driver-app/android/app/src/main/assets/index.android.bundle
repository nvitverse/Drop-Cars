0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c38\u0c30\u0c3f\u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f: {0}","Please check your connection and try again.":"\u0c15\u0c28\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c1a\u0c42\u0c38\u0c3f \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Please check your internet connection and try again":"\u0c07\u0c02\u0c1f\u0c30\u0c4d\u0c28\u0c46\u0c1f\u0c4d \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c1a\u0c42\u0c38\u0c3f \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Please complete Driver Selfie Check before starting trip.":"\u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d \u0c38\u0c46\u0c32\u0c4d\u0c2b\u0c40 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please complete the driving licence number (State+RTO, Year, Serial).":"\u0c21\u0c4d\u0c30\u0c48\u0c35\u0c3f\u0c02\u0c17\u0c4d \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f\u0c17\u0c3e \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f (\u0c30\u0c3e\u0c37\u0c4d\u0c1f\u0c4d\u0c30\u0c02+RTO, \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c02, \u0c38\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d).","Please confirm your password.":"\u0c2e\u0c40 \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Please detail what information you need updated.":"\u0c0f \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c4b \u0c35\u0c3f\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Please enter a name with at least 2 characters.":"\u0c15\u0c28\u0c40\u0c38\u0c02 2 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32 \u0c2a\u0c47\u0c30\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please enter a valid 10-digit mobile number starting with 6, 7, 8, or 9.":"6, 7, 8 \u0c32\u0c47\u0c26\u0c3e 9 \u0c24\u0c4b \u0c2e\u0c4a\u0c26\u0c32\u0c2f\u0c4d\u0c2f\u0c47 \u0c38\u0c30\u0c48\u0c28 10 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please enter a valid 10-digit UPI Mobile Number":"\u0c38\u0c30\u0c48\u0c28 10 \u0c05\u0c02\u0c15\u0c46\u0c32 UPI \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Please enter a valid password (at least 6 characters).":"\u0c38\u0c30\u0c48\u0c28 \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f (\u0c15\u0c28\u0c40\u0c38\u0c02 6 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32\u0c41).","Please enter a valid payout amount.":"\u0c38\u0c30\u0c48\u0c28 \u0c2a\u0c47\u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please enter a valid Travels / Business Name.":"\u0c38\u0c30\u0c48\u0c28 \u0c1f\u0c4d\u0c30\u0c3e\u0c35\u0c46\u0c32\u0c4d\u0c38\u0c4d / \u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30 \u0c2a\u0c47\u0c30\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please enter both mobile number and password.":"\u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d, \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c30\u0c46\u0c02\u0c21\u0c42 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please enter initial odometer reading.":"\u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d \u0c13\u0c21\u0c4b\u0c2e\u0c40\u0c1f\u0c30\u0c4d \u0c30\u0c40\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please enter the 12-digit Aadhaar number.":"12 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please enter the 6-digit verification code sent to your email.":"\u0c2e\u0c40 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d\u200c\u0c15\u0c41 \u0c2a\u0c02\u0c2a\u0c3f\u0c28 6 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c15\u0c4b\u0c21\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please enter valid 4-digit Customer Start OTP.":"\u0c38\u0c30\u0c48\u0c28 4 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d OTP \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please enter your valid full name as per Government ID.":"\u0c2a\u0c4d\u0c30\u0c2d\u0c41\u0c24\u0c4d\u0c35 ID \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02 \u0c2e\u0c40 \u0c38\u0c30\u0c48\u0c28 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c2a\u0c47\u0c30\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please explain the reason for requesting profile updates.":"\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c15\u0c4b\u0c30\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c3e\u0c30\u0c23\u0c02 \u0c35\u0c3f\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Please give the customer a star rating before you finish.":"\u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c1a\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c38\u0c4d\u0c1f\u0c3e\u0c30\u0c4d \u0c30\u0c47\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c07\u0c35\u0c4d\u0c35\u0c02\u0c21\u0c3f.","Please place a regular phone call.":"\u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23 \u0c2b\u0c4b\u0c28\u0c4d \u0c15\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please rate the customer and confirm the amount collected to finish this trip.":"\u0c08 \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c30\u0c47\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c07\u0c1a\u0c4d\u0c1a\u0c3f \u0c35\u0c38\u0c42\u0c32\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Please rate your Drop Cars trip: {0}":"\u0c2e\u0c40 Drop Cars \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u200c\u0c15\u0c41 \u0c30\u0c47\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c07\u0c35\u0c4d\u0c35\u0c02\u0c21\u0c3f: {0}","Please select a Drop (To City).":"\u0c21\u0c4d\u0c30\u0c3e\u0c2a\u0c4d (\u0c17\u0c2e\u0c4d\u0c2f \u0c28\u0c17\u0c30\u0c02) \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.","Please select a Pickup (From City).":"\u0c2a\u0c3f\u0c15\u0c2a\u0c4d (\u0c2c\u0c2f\u0c32\u0c41\u0c26\u0c47\u0c30\u0c47 \u0c28\u0c17\u0c30\u0c02) \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.","Please select a valid expiry date for this document.":"\u0c08 \u0c2a\u0c24\u0c4d\u0c30\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c30\u0c48\u0c28 \u0c17\u0c21\u0c41\u0c35\u0c41 \u0c24\u0c47\u0c26\u0c40 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.","Please select a vehicle for this request.":"\u0c08 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c15\u0c41 \u0c12\u0c15 \u0c35\u0c3e\u0c39\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.","Please select or type a cancellation reason.":"\u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c15\u0c3e\u0c30\u0c23\u0c02 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c1f\u0c48\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please select or type a reason for cancelling this booking.":"\u0c08 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c3e\u0c30\u0c23\u0c02 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c1f\u0c48\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please take a live selfie before continuing.":"\u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c32\u0c48\u0c35\u0c4d \u0c38\u0c46\u0c32\u0c4d\u0c2b\u0c40 \u0c24\u0c40\u0c2f\u0c02\u0c21\u0c3f.","Please try again.":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Please upload both the Aadhaar FRONT and BACK photos.":"\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c2e\u0c41\u0c02\u0c26\u0c41 & \u0c35\u0c46\u0c28\u0c41\u0c15 \u0c30\u0c46\u0c02\u0c21\u0c41 \u0c35\u0c48\u0c2a\u0c41\u0c32 \u0c2b\u0c4b\u0c1f\u0c4b\u0c32\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Please upload the Licence BACK side photo too - both sides are required.":"\u0c21\u0c4d\u0c30\u0c48\u0c35\u0c3f\u0c02\u0c17\u0c4d \u0c32\u0c48\u0c38\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c35\u0c46\u0c28\u0c41\u0c15 \u0c35\u0c48\u0c2a\u0c41 \u0c2b\u0c4b\u0c1f\u0c4b \u0c15\u0c42\u0c21\u0c3e \u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f - \u0c30\u0c46\u0c02\u0c21\u0c41 \u0c35\u0c48\u0c2a\u0c41\u0c32\u0c3e \u0c05\u0c35\u0c38\u0c30\u0c02.","Please verify your":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f \u0c2e\u0c40","Please verify your email address by tapping \"Verify Email\" before completing registration.":"\u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c38\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \"\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f\" \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c3f \u0c2e\u0c40 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Please wait for approval":"\u0c06\u0c2e\u0c4b\u0c26\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c35\u0c47\u0c1a\u0c3f \u0c09\u0c02\u0c21\u0c02\u0c21\u0c3f","plus \u20b9":"\u0c2a\u0c4d\u0c32\u0c38\u0c4d \u20b9","Pollution Certificate (PUC)":"\u0c15\u0c3e\u0c32\u0c41\u0c37\u0c4d\u0c2f \u0c27\u0c43\u0c35\u0c2a\u0c24\u0c4d\u0c30\u0c02 (PUC)","Post Booking & Dispatch":"\u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c21\u0c3f\u0c38\u0c4d\u0c2a\u0c3e\u0c1a\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Posted by you":"\u0c2e\u0c40\u0c30\u0c41 \u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28\u0c26\u0c3f","Posting Earning (for sourcing this trip)":"\u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c02\u0c2a\u0c3e\u0c26\u0c28 (\u0c08 \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c24\u0c46\u0c1a\u0c4d\u0c1a\u0c3f\u0c28\u0c02\u0c26\u0c41\u0c15\u0c41)","Pre-book and guarantee priority dispatch for your available fleet! When a passenger books a trip on your requested route, our system auto-matches it with a 10-second alert window.":"\u0c2e\u0c40 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28 \u0c2b\u0c4d\u0c32\u0c40\u0c1f\u0c4d\u200c\u0c15\u0c41 \u0c2e\u0c41\u0c02\u0c26\u0c47 \u0c2c\u0c41\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f\u0c24 \u0c21\u0c3f\u0c38\u0c4d\u0c2a\u0c3e\u0c1a\u0c4d \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f! \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c02\u0c32\u0c4b \u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c3f\u0c15\u0c41\u0c21\u0c41 \u0c2c\
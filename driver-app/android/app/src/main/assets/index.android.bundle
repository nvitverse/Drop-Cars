ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0c95\u0cae\u0cbf\u0cb7\u0ca8\u0ccd \u0c95\u0ca1\u0cbf\u0ca4 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",approvedAlertTitle:"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!",approvedAlertBody:"\u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0c95\u0cb0 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca6\u0cc3\u0ca2\u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6\u0cc6. \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0caa\u0cc1\u0cb6\u0ccd \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6."},subscription:{headerTitle:"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cbf\u0c95\u0cc6",headerSub:"\u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1 & \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0c97\u0cb3\u0cbf\u0c95\u0cc6 \u0cb9\u0c82\u0ca4",standardTier:"\u0cb8\u0ccd\u0c9f\u0ccd\u0caf\u0cbe\u0c82\u0ca1\u0cb0\u0ccd\u0ca1\u0ccd \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb9\u0c82\u0ca4",proTier:"PRO \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd ({tier})",standardDispatch:"\u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd",priorityDispatch:"\u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd & \u0cb5\u0cbf\u0cb6\u0ccd\u0cb2\u0cc7\u0cb7\u0ca3\u0cc6 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf",active:"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf",free:"\u0c89\u0c9a\u0cbf\u0ca4",driverWallet:"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd:",selectPlan:"\u0c9a\u0c82\u0ca6\u0cbe\u0ca6\u0cbe\u0cb0\u0cbf\u0c95\u0cc6 \u0caf\u0ccb\u0c9c\u0ca8\u0cc6 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",proMonthly:"PRO \u0cae\u0cbe\u0cb8\u0cbf\u0c95",boostAcc
r Name":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cbf","Edit Full Name (Per Govt ID)":"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cbf (\u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cc0\u0c9f\u0cbf\u0caf\u0c82\u0ca4\u0cc6)","Edit Name":"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cbf","Edit Travels / Business Name":"\u0c9f\u0ccd\u0cb0\u0cbe\u0cb5\u0cc6\u0cb2\u0ccd\u0cb8\u0ccd / \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cbf",Email:"\u0c87\u0cae\u0cc7\u0cb2\u0ccd","Email Address":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8","Email Address (Password Reset & OTP)":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 (\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cb0\u0cc1\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6 & OTP)","Email Address Required \ud83d\udce7":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cac\u0cc7\u0c95\u0cc1 \ud83d\udce7","Email Address Verification":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6","Email Code Verified \ud83c\udf89 Submitted for Admin Approval \u23f3":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 \ud83c\udf89 \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 \u23f3","Email Support":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd","Email Verification Required \ud83d\udce7":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cac\u0cc7\u0c95\u0cc1 \ud83d\udce7","Email Verified! \u2713":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6! \u2713",Enable:"\u0c86\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","End KM must be provided and greater than 0":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c95\u0cbf.\u0cae\u0cc0. \u0ca8\u0cc0\u0ca1\u0cac\u0cc7\u0c95\u0cc1, \u0c85\u0ca6\u0cc1 0 \u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1","End KM:":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c95\u0cbf.\u0cae\u0cc0.:","End odometer photo":"\u0c85\u0c82\u0ca4\u0cbf\u0cae \u0c93\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cab\u0ccb\u0c9f\u0ccb","End OTP:":"\u0c85\u0c82\u0ca4\u0cbf\u0cae OTP:","End speedometer image is required to end trip":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0c82\u0ca4\u0cbf\u0cae \u0cb8\u0ccd\u0caa\u0cc0\u0ca1\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cab\u0ccb\u0c9f\u0ccb \u0cac\u0cc7\u0c95\u0cc1","Enter 10-digit mobile number (e.g. 9876543210)":"10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0c89\u0ca6\u0cbe. 9876543210)","Enter 6-digit code":"6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter 6-Digit Email Code":"6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter a positive number of kilometers":"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c95\u0cbf\u0cb2\u0ccb\u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter a referral code":"\u0cb0\u0cc6\u0cab\u0cb0\u0cb2\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter a valid 10-digit alternate mobile number starting with 6-9":"6-9 \u0cb0\u0cbf\u0c82\u0ca6 \u0c86\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cc1\u0cb5 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0caa\u0cb0\u0ccd\u0caf\u0cbe\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter a valid 10-digit mobile number starting with 6-9":"6-9 \u0cb0\u0cbf\u0c82\u0ca6 \u0c86\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cc1\u0cb5 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter a valid 10-digit mobile number.":"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Enter Aadhaar Number":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter account number":"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter amount (e.g. 1000)":"\u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0c89\u0ca6\u0cbe. 1000)","Enter at least a bank account or UPI ID before saving":"\u0c89\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe UPI ID \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter at least a bank account, UPI Number, or UPI ID before saving":"\u0c89\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6, UPI \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe UPI ID \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter bank account details or UPI ID for instant payout settlements.":"\u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0 \u0c85\u0ca5\u0cb5\u0cbe UPI ID \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Enter bank account number":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter driver password":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter Driving Licence Number":"\u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter full name":"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter full name as on licence":"\u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter mobile number":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter New Total Fare (\u20b9)":"\u0cb9\u0cca\u0cb8 \u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca6\u0cb0 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u20b9)","Enter OTP":"OTP \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter password":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter referral code":"\u0cb0\u0cc6\u0cab\u0cb0\u0cb2\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter the 6-digit code sent to your email":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6 6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter the 6-digit code sent to your email and set your new password.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6 6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf \u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf.","Enter the 6-digit code sent to your saved email, and set your new password.":"\u0c89\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6 6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf \u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf.","Enter the 6-digit code sent to your saved email, and your new password.":"\u0c89\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6 6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0ccb\u0ca1\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Enter the exact full name as printed on the driving licence to ensure auto-verification succeeds.":"\u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cb2\u0cc1 \u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Enter UPI ID (e.g. driver@upi / 9876543210@ybl)":"UPI ID \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0c89\u0ca6\u0cbe. driver@upi / 9876543210@ybl)","Enter your current password to confirm":"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter your new 10-digit mobile number. Drop Cars Admin will review & verify your request.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cca\u0cb8 10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf. Drop Cars \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6.","Enter your new number and current password to confirm.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cca\u0cb8 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf.","Enter your official name as printed on your Aadhaar or PAN card. Name updates require Admin Review.":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca5\u0cb5\u0cbe PAN \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cc1\u0ca6\u0ccd\u0cb0\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cc1\u0cb5\u0c82\u0ca4\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c85\u0ca7\u0cbf\u0c95\u0cc3\u0ca4 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf. \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0c97\u0cc6 \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cac\u0cc7\u0c95\u0cc1.","Enter your registered fleet, agency, or business name. Updates require Admin Review.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd, \u0c8f\u0c9c\u0cc6\u0ca8\u0ccd\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf. \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0c97\u0cc6 \u0c85\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cac\u0cc7\u0c95\u0cc1.","Enter your registered mobile number to receive a 6-digit reset code via Email.":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf 6 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cae\u0cb0\u0cc1\u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6 \u0c95\u0ccb\u0ca1\u0ccd \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf.","Error:":"\u0ca6\u0ccb\u0cb7:","Error: {0}":"\u0ca6\u0ccb\u0cb7: {0}","Estimated Time":"\u0c85\u0c82\u0ca6\u0cbe\u0c9c\u0cc1 \u0cb8\u0cae\u0caf","Estimated Time (optional)":"\u0c85\u0c82\u0ca6\u0cbe\u0c9c\u0cc1 \u0cb8\u0cae\u0caf (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)","Every trip you accepted from the Drop Cars booking market, from acceptance to completion, in one place.":"Drop Cars \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0cae\u0cbe\u0cb0\u0ccd\u0c95\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0c82\u0ca1 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd, \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c97\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0cae\u0cc1\u0c97\u0cbf\u0caf\u0cc1\u0cb5\u0cb5\u0cb0\u0cc6\u0c97\u0cc6, \u0c92\u0c82\u0ca6\u0cc7 \u0c95\u0ca1\u0cc6.","Exact Door No, Destination Landmark or Maps link":"\u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0cac\u0cbe\u0c97\u0cbf\u0cb2\u0cc1 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6, \u0ca4\u0cb2\u0cc1\u0caa\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cb3\u0ca6 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe Maps \u0cb2\u0cbf\u0c82\u0c95\u0ccd","Exact Door No, Street, Landmark or Maps link":"\u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0cac\u0cbe\u0c97\u0cbf\u0cb2\u0cc1 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6, \u0cb0\u0cb8\u0ccd\u0ca4\u0cc6, \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe Maps \u0cb2\u0cbf\u0c82\u0c95\u0ccd",Exclusive:"\u0cb5\u0cbf\u0cb6\u0cc7\u0cb7","Exclusive for Trusted Partners \u2022 Auto-matches incoming trips":"\u0c9f\u0ccd\u0cb0\u0cb8\u0ccd\u0c9f\u0cc6\u0ca1\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u2022 \u0cac\u0cb0\u0cc1\u0cb5 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0ca4\u0cbe\u0ca8\u0cbe\u0c97\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6","Exclusive Partner":"\u0cb5\u0cbf\u0cb6\u0cc7\u0cb7 \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd",Executed:"\u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c97\u0ca4\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0cc6","Expected: \u20b9":"\u0ca8\u0cbf\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4: \u20b9",Expired:"\u0c85\u0cb5\u0ca7\u0cbf \u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6","Expires {0}":"{0} \u0cb0\u0c82\u0ca6\u0cc1 \u0c85\u0cb5\u0ca7\u0cbf \u0cae\u0cc1\u0c97\u0cbf\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","Expiry Date Required":"\u0c85\u0cb5\u0ca7\u0cbf \u0cae\u0cc1\u0c97\u0cbf\u0caf\u0cc1\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cac\u0cc7\u0c95\u0cc1","Explain the reason for correction. Drop Cars verification team will review your request.":"\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0c97\u0cc6 \u0c95\u0cbe\u0cb0\u0ca3 \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf. Drop Cars \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cbe \u0ca4\u0c82\u0ca1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Explain why you are requesting this change (e.g. business name update, new mobile number)":"\u0c88 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8f\u0c95\u0cc6 \u0c95\u0ccb\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf (\u0c89\u0ca6\u0cbe. \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6, \u0cb9\u0cca\u0cb8 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6)","Explore App Configuration":"\u0c86\u0ccd\u0caf\u0caa\u0ccd \u0c95\u0cbe\u0ca8\u0ccd\u0cab\u0cbf\u0c97\u0cb0\u0cc7\u0cb6\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0cb5\u0cc7\u0cb7\u0cbf\u0cb8\u0cbf","Explore App Features":"\u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0cc7\u0cb7\u0cbf\u0cb8\u0cbf","extra charges listed above":"\u0cae\u0cc7\u0cb2\u0cc6 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1","Extra charges paid directly (not part of the trip total)":"\u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cc1\u0cb5 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1 (\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c92\u0c9f\u0ccd\u0c9f\u0cbf\u0ca8 \u0cad\u0cbe\u0c97\u0cb5\u0cb2\u0ccd\u0cb2)","Extra Driver Allowance (Vendor)":"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cad\u0ca4\u0ccd\u0caf\u0cc6 (\u0cb5\u0cc6\u0c82\u0ca1\u0cb0\u0ccd)","Face Match Check":"\u0cae\u0cc1\u0c96 \u0cb9\u0cca\u0c82\u0ca6\u0cbe\u0ca3\u0cbf\u0c95\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6","Failed to accept booking. Please try again.":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Failed to add money":"\u0cb9\u0ca3 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Failed to assign cab and driver.":"\u0c95\u0ccd\u0caf\u0cbe\u0cac\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Failed to create Razorpay order":"Razorpay \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Failed to deduct money":"\u0cb9\u0ca3 \u0c95\u0ca1\u0cbf\u0ca4 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Failed to delete car driver":"\u0c95\u0cbe\u0cb0\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c85\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Failed to fetch car driver":"\u0c95\u0cbe\u0cb0\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Failed to fetch car driver by mobile":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0c95\u0cbe\u0cb0\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Failed to fetch cars: {0}":"\u0c95\u0cbe\u0cb0\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2: {0}","Failed to fetch completed orders":"\u0cae\u0cc1\u0c97\u0cbf\u0ca6 \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa
HappensNext:"\u0cae\u0cc1\u0c82\u0ca6\u0cc6 \u0c8f\u0ca8\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6?",step1:"\u0ca8\u0cae\u0ccd\u0cae \u0ca4\u0c82\u0ca1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6",step2:"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cc6 \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf 24-48 \u0c97\u0c82\u0c9f\u0cc6 \u0cac\u0cc7\u0c95\u0cc1",step3:"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0caf\u0cbe\u0ca6 \u0c95\u0cc2\u0ca1\u0cb2\u0cc7 \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6",step4:"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0caf \u0ca8\u0c82\u0ca4\u0cb0 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1",scanQrToPay:"Rs.1000 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cc1 QR \u0c95\u0ccb\u0ca1\u0ccd \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",upiIdLabel:"UPI ID:",copyUpiId:"UPI ID \u0ca8\u0c95\u0cb2\u0cbf\u0cb8\u0cbf",copiedTitle:"\u0ca8\u0c95\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!",copiedBody:"UPI ID \u0c95\u0ccd\u0cb2\u0cbf\u0caa\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cc6 \u0ca8\u0c95\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",errorTitle:"\u0ca6\u0ccb\u0cb7",copyFailedBody:"UPI ID \u0ca8\u0c95\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2",notAvailableTitle:"\u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2",razorpayUnavailableBody:"\u0c87\u0cb2\u0ccd\u0cb2\u0cbf Razorpay \u0c9a\u0cc6\u0c95\u0ccd\u200c\u0c94\u0c9f\u0ccd \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 UPI ID \u0cac\u0cb3\u0cb8\u0cbf \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf.",paymentSuccessTitle:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf",paymentSuccessBody:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca8\u0cae\u0ccd\u0cae \u0ca4\u0c82\u0ca1 \u0cb6\u0cc0\u0c98\u0ccd\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 - \u0ca8\u0ccb\u0ca1\u0cb2\u0cc1 \"\u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\" \u0cac\u0cb3\u0cb8\u0cbf.",paymentFailedTitle:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1",paymentFailedGeneric:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 UPI ID \u0cae\u0cc2\u0cb2\u0c95 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf.",orderFailedBody:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0c86\u0cb0\u0ccd\u0ca1\u0cb0\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.",sessionExpiredTitle:"\u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6",sessionExpiredBody:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",refreshFailedTitle:"\u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1",refreshFailedBody:"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf."},driverVerification:{headerSubtitle:"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6",verifiedSubtitle:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",verifiedMessage:"Drop Cars \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0c97\u0cc6 \u0cb8\u0ccd\u0cb5\u0cbe\u0c97\u0ca4! \u0c88\u0c97 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",goToDashboard:"\u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf",step4:"\u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0caf \u0ca8\u0c82\u0ca4\u0cb0 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c9a\u0cbe\u0cb2\u0ca8\u0cc6 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1"},myCars:{headerTitle:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c95\u0cbe\u0cb0\u0cc1\u0c97\u0cb3\u0cc1",addCar:"\u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf",addFirstCar:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0ca6\u0cb2 \u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u
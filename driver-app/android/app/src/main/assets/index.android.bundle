f\u093f\u0902\u0917","6-digit Code":"6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921","6-digit Verification Code":"6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u094b\u0921","6/6 Fleet Documents Active":"6/6 \u092b\u094d\u0932\u0940\u091f \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0938\u0915\u094d\u0930\u093f\u092f","8 hours":"8 \u0918\u0902\u091f\u0947","A 6-digit code has been sent to {0}. Please check your inbox (and spam folder). It expires in 10 minutes.":"{0} \u092a\u0930 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u092d\u0947\u091c\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0905\u092a\u0928\u093e \u0907\u0928\u092c\u0949\u0915\u094d\u0938 (\u0914\u0930 \u0938\u094d\u092a\u0948\u092e \u092b\u093c\u094b\u0932\u094d\u0921\u0930) \u0926\u0947\u0916\u0947\u0902\u0964 \u092f\u0939 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964","A driver has accepted this booking - waiting for them to assign a cab & driver.":"\u090f\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0928\u0947 \u092f\u0939 \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0932\u0940 \u0939\u0948 - \u0915\u0948\u092c \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0905\u0938\u093e\u0907\u0928 \u0939\u094b\u0928\u0947 \u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0939\u0948\u0964","A driver has already accepted booking #{0}. Cancelling removes it from them and refunds their held amount. There is no fee for you.":"\u092c\u0941\u0915\u093f\u0902\u0917 #{0} \u0915\u094b \u090f\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u091a\u0941\u0915\u093e \u0939\u0948\u0964 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0935\u0939 \u0909\u0938\u0938\u0947 \u0939\u091f \u091c\u093e\u090f\u0917\u0940 \u0914\u0930 \u0909\u0938\u0915\u0940 \u0939\u094b\u0932\u094d\u0921 \u0930\u093e\u0936\u093f \u0932\u094c\u091f\u093e \u0926\u0940 \u091c\u093e\u090f\u0917\u0940\u0964 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0936\u0941\u0932\u094d\u0915 \u0928\u0939\u0940\u0902\u0964","A minimum wallet security hold of \u20b9{0} is required to accept this booking. Available: \u20b9{1} (\u20b9{2} total - \u20b9{3} reserved). Add \u20b9{4} to accept this booking.":"\u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092e \u0938\u0947 \u0915\u092e \u20b9{0} \u0935\u0949\u0932\u0947\u091f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0939\u094b\u0932\u094d\u0921 \u091a\u093e\u0939\u093f\u090f\u0964 \u0909\u092a\u0932\u092c\u094d\u0927: \u20b9{1} (\u0915\u0941\u0932 \u20b9{2} - \u20b9{3} \u0906\u0930\u0915\u094d\u0937\u093f\u0924)\u0964 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u20b9{4} \u091c\u094b\u0921\u093c\u0947\u0902\u0964","A new trip request is waiting for you. Tap to view details.":"\u090f\u0915 \u0928\u092f\u093e \u091f\u094d\u0930\u093f\u092a \u0905\u0928\u0941\u0930\u094b\u0927 \u0906\u092a\u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u0935\u093f\u0935\u0930\u0923 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964","A new version of Drop Cars has been downloaded with fixes and improvements. Restart now to use it?":"\u0938\u0941\u0927\u093e\u0930\u094b\u0902 \u0914\u0930 \u092c\u0947\u0939\u0924\u0930\u0940 \u0915\u0947 \u0938\u093e\u0925 Drop Cars \u0915\u093e \u0928\u092f\u093e \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0905\u092d\u0940 \u0930\u0940\u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0915\u0930\u0915\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902?","A refundable security deposit of \u20b9":"\u0935\u093e\u092a\u0938\u0940 \u092f\u094b\u0917\u094d\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091c\u092e\u093e \u20b9","A valid email address is required":"\u090f\u0915 \u092e\u093e\u0928\u094d\u092f \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u091a\u093e\u0939\u093f\u090f","Aadhaar Back":"\u0906\u0927\u093e\u0930 \u092a\u0940\u091b\u0947 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e","Aadhaar Back Side":"\u0906\u0927\u093e\u0930 \u092a\u0940\u091b\u0947 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e","Aadhaar Card":"\u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921","Aadhaar Card (ID Proof)":"\u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 (\u092a\u0939\u091a\u093e\u0928 \u092a\u094d\u0930\u092e\u093e\u0923)","Aadhaar Front":"\u0906\u0927\u093e\u0930 \u0938\u093e\u092e\u0928\u0947 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e","Aadhaar Front Side":"\u0906\u0927\u093e\u0930 \u0938\u093e\u092e\u0928\u0947 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e","Aadhaar Number":"\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930","AADHAAR NUMBER":"\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930","Aadhaar Number Required":"\u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948","Aadhar Card (Front & Back)":"\u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 (\u0906\u0917\u0947 \u0914\u0930 \u092a\u0940\u091b\u0947)",About:"\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902","About App":"\u0910\u092a \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902",Accept:"\u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0947\u0902","Accept \u20b9":"\u20b9 \u092e\u0947\u0902 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0947\u0902","Accept Booking":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0947\u0902","Accept Booking for \u20b9":"\u20b9 \u092e\u0947\u0902 \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0947\u0902","Accept Driver & Vehicle":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0917\u093e\u0921\u093c\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0947\u0902","Accept for \u20b9":"\u20b9 \u092e\u0947\u0902 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0947\u0902","Accept Now":"\u0905\u092d\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0947\u0902","Accepted bookings requiring driver & cab assignment will appear here":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0915\u0948\u092c \u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u0935\u093e\u0932\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0940 \u0917\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u092f\u0939\u093e\u0901 \u0926\u093f\u0916\u0947\u0902\u0917\u0940","Accepting...":"\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...","Access denied - insufficient permissions":"\u092a\u0939\u0941\u0901\u091a \u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924 - \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902","Access denied - insufficient permissions for this operation.":"\u092a\u0939\u0941\u0901\u091a \u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924 - \u0907\u0938 \u0915\u093e\u0930\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902\u0964",Account:"\u0916\u093e\u0924\u093e","Account Holder Name":"\u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915 \u0915\u093e \u0928\u093e\u092e","Account is Duty Driver":"\u0916\u093e\u0924\u093e \u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u093e \u0939\u0948","Account is Fleet Owner":"\u0916\u093e\u0924\u093e \u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u0915\u093e \u0939\u0948","Account Name":"\u0916\u093e\u0924\u0947 \u0915\u093e \u0928\u093e\u092e","Account Not Found":"\u0916\u093e\u0924\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","Account not found. Please check your mobile number or sign up first.":"\u0916\u093e\u0924\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964 \u0905\u092a\u0928\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u091c\u093e\u0901\u091a\u0947\u0902 \u092f\u093e \u092a\u0939\u0932\u0947 \u0938\u093e\u0907\u0928 \u0905\u092a \u0915\u0930\u0947\u0902\u0964","ACTION COMPLETED":"\u0915\u093e\u0930\u094d\u092f \u092a\u0942\u0930\u093e \u0939\u0941\u0906","ACTION REQUIRED":"\u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u091c\u093c\u0930\u0942\u0930\u0940","Activate Booking Request":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0905\u0928\u0941\u0930\u094b\u0927 \u0938\u0915\u094d\u0930\u093f\u092f \u0915\u0930\u0947\u0902",Active:"\u0938\u0915\u094d\u0930\u093f\u092f","Active & Ready for Trips":"\u0938\u0915\u094d\u0930\u093f\u092f \u0914\u0930 \u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930","Active Fleet":"\u0938\u0915\u094d\u0930\u093f\u092f \u092b\u094d\u0932\u0940\u091f","Active Rides":"\u091a\u0932 \u0930\u0939\u0940 \u0930\u093e\u0907\u0921\u094d\u0938","Active Route Monitoring":"\u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0942\u091f \u0928\u093f\u0917\u0930\u093e\u0928\u0940","Active Vacant":"\u0938\u0915\u094d\u0930\u093f\u092f \u0916\u093e\u0932\u0940",Add:"\u091c\u094b\u0921\u093c\u0947\u0902","Add \"":"\u091c\u094b\u0921\u093c\u0947\u0902 \"","Add \u20b9":"\u20b9 \u091c\u094b\u0921\u093c\u0947\u0902","Add \u20b9{0} to Accept the Booking":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u20b9{0} \u091c\u094b\u0921\u093c\u0947\u0902","Add custom location: \"":"\u0915\u0938\u094d\u091f\u092e \u0938\u094d\u0925\u093e\u0928 \u091c\u094b\u0921\u093c\u0947\u0902: \"","Add Custom Town or Station":"\u0915\u0938\u094d\u091f\u092e \u0936\u0939\u0930 \u092f\u093e \u0938\u094d\u091f\u0947\u0936\u0928 \u091c\u094b\u0921\u093c\u0947\u0902","Add Details":"\u0935\u093f\u0935\u0930\u0923 \u091c\u094b\u0921\u093c\u0947\u0902","Add Email":"\u0908\u092e\u0947\u0932 \u091c\u094b\u0921\u093c\u0947\u0902","Add Email Address":"\u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u091c\u094b\u0921\u093c\u0947\u0902","Add Email Now":"\u0905\u092d\u0940 \u0908\u092e\u0947\u0932 \u091c\u094b\u0921\u093c\u0947\u0902","Add money to post this booking":"\u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u094b \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0948\u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902","Add New Driver":"\u0928\u092f\u093e \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u091c\u094b\u0921\u093c\u0947\u0902","Add or update an alternate contact number for emergency contact and dispatch alerts.":"\u0906\u092a\u093e\u0924 \u0938\u0902\u092a\u0930\u094d\u0915 \u0914\u0930 \u0921\u093f\u0938\u094d\u092a\u0948\u091a \u0905\u0932\u0930\u094d\u091f \u0915\u0947 \u0932\u093f\u090f \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0938\u0902\u092a\u0930\u094d\u0915 \u0928\u0902\u092c\u0930 \u091c\u094b\u0921\u093c\u0947\u0902 \u092f\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902\u0964","Add your bank account or UPI ID so payouts can be sent to you. Either one is enough.":"\u092d\u0941\u0917\u0924\u093e\u0928 \u092d\u0947\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u092f\u093e UPI ID \u091c\u094b\u0921\u093c\u0947\u0902\u0964 \u0926\u094b\u0928\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0915\u093e\u092b\u093c\u0940 \u0939\u0948\u0964","Add your bank account or UPI ID to receive payouts":"\u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u092f\u093e UPI ID \u091c\u094b\u0921\u093c\u0947\u0902","Add your first driver to assign trips and manage duties.":"\u091f\u094d\u0930\u093f\u092a \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0921\u094d\u092f\u0942\u091f\u0940 \u0938\u0901\u092d\u093e\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u092a\u0939\u0932\u093e \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u091c\u094b\u0921\u093c\u0947\u0902\u0964","Add Your Profile Photo":"\u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092b\u094b\u091f\u094b \u091c\u094b\u0921\u093c\u0947\u0902","Add yourself as a duty driver (using your own Aadhaar/licence) first.":"\u092a\u0939\u0932\u0947 \u0916\u0941\u0926 \u0915\u094b \u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u0947\u0902 (\u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930/\u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0938\u0947)\u0964","Add yourself as a duty driver first (using your own Aadhaar/licence) so you can accept and run bookings yourself.":"\u092a\u0939\u0932\u0947 \u0916\u0941\u0926 \u0915\u094b \u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u0947\u0902 (\u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930/\u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0938\u0947), \u092b\u093f\u0930 \u0906\u092a \u0916\u0941\u0926 \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0915\u0947 \u091a\u0932\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Add yourself as a duty driver first (using your own Aadhaar/licence), then Duty will open your own bookings.":"\u092a\u0939\u0932\u0947 \u0916\u0941\u0926 \u0915\u094b \u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u0947\u0902 (\u0905\u092a\u0928\u0947 \u0906\u0927\u093e\u0930/\u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0938\u0947), \u092b\u093f\u0930 \u0921\u094d\u092f\u0942\u091f\u0940 \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u0905\u092a\u0928\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u0916\u0941\u0932\u0947\u0902\u0917\u0940\u0964","Added at trip end":"\u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u0905\u0902\u0924 \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u093e \u0917\u092f\u093e","Additional Details / Message (Optional):":"\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0935\u093f\u0935\u0930\u0923 / \u0938\u0902\u0926\u0947\u0936 (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915):",Address:"\u092a\u0924\u093e","Admin rejected your request to use a different car.":"\u090f\u0921\u092e\u093f\u0928 \u0928\u0947 \u0926\u0942\u0938\u0930\u0940 \u0917\u093e\u0921\u093c\u0940 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u0947 \u0915\u093e \u0906\u092a\u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e\u0964","Advance already paid":"\u0905\u0917\u094d\u0930\u093f\u092e \u092a\u0939\u0932\u0947 \u0939\u0940 \u091a\u0941\u0915\u093e\u092f\u093e \u0917\u092f\u093e","Advance Paid by Customer:":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0905\u0917\u094d\u0930\u093f\u092e:","Advance received":"\u0905\u0917\u094d\u0930\u093f\u092e \u092a\u094d\u0930\u093e\u092a\u094d\u0924","Advance Received":"\u0905\u0917\u094d\u0930\u093f\u092e \u092a\u094d\u0930\u093e\u092a\u094d\u0924","Advance Received: \u20b9":"\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0905\u0917\u094d\u0930\u093f\u092e: \u20b9","Advance updated.":"\u0905\u0917\u094d\u0930\u093f\u092e \u0905\u092a\u0921\u0947\u091f \u0939\u094b \u0917\u092f\u093e\u0964","Alerts for standard new trip offers and bids":"\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0928\u0908 \u091f\u094d\u0930\u093f\u092a \u0911\u092b\u093c\u0930 \u0914\u0930 \u092c\u094b\u0932\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0930\u094d\u091f","Align final odometer reading inside camera viewfinder":"\u0905\u0902\u0924\u093f\u092e \u0913\u0921\u094b\u092e\u0940\u091f\u0930 \u0930\u0940\u0921\u093f\u0902\u0917 \u0915\u094b \u0915\u0948\u092e\u0930\u093e \u0935\u094d\u092f\u0942\u092b\u093c\u093e\u0907\u0902\u0921\u0930 \u092e\u0947\u0902 \u0938\u0939\u0940 \u0930\u0916\u0947\u0902","Align odometer reading inside camera viewfinder":"\u0913\u0921\u094b\u092e\u0940\u091f\u0930 \u0930\u0940\u0921\u093f\u0902\u0917 \u0915\u094b \u0915\u0948\u092e\u0930\u093e \u0935\u094d\u092f\u0942\u092b\u093c\u093e\u0907\u0902\u0921\u0930 \u092e\u0947\u0902 \u0938\u0939\u0940 \u0930\u0916\u0947\u0902","All Booking Types":"\u0938\u092d\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u094d\u0930\u0915\u093e\u0930","All Categories":"\u0938\u092d\u0940 \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u093e\u0901","All Cities":"\u0938\u092d\u0940 \u0936\u0939\u0930","ALL CITIES & TOWNS (":"\u0938\u092d\u0940 \u0936\u0939\u0930 \u0914\u0930 \u0915\u0938\u094d\u092c\u0947 (","All Dates":"\u0938\u092d\u0940 \u0924\u093e\u0930\u0940\u0916\u0947\u0902","All Inclusive Fare":"\u0938\u092c \u0915\u0941\u091b \u0936\u093e\u092e\u093f\u0932 \u0915\u093f\u0930\u093e\u092f\u093e","All Inclusive Fare Booking":"\u0938\u092c \u0915\u0941\u091b \u0936\u093e\u092e\u093f\u0932 \u0915\u093f\u0930\u093e\u092f\u0947 \u0915\u0940 \u092c\u0941\u0915\u093f\u0902\u0917","All Services":"\u0938\u092d\u0940 \u0938\u0947\u0935\u093e\u090f\u0901","All Time":"\u0938\u092d\u0940 \u0938\u092e\u092f","All-inclusive booking - you see only what you earn. The exact amount to collect from the customer is shown once you accept.":"\u0938\u092c \u0915\u0941\u091b \u0936\u093e\u092e\u093f\u0932 \u092c\u0941\u0915\u093f\u0902\u0917 - \u0906\u092a\u0915\u094b \u0915\u0947\u0935\u0932 \u0905\u092a\u0928\u0940 \u0915\u092e\u093e\u0908 \u0926\u093f\u0916\u0924\u0940 \u0939\u0948\u0964 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947 \u0935\u0938\u0942\u0932\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u091f\u0940\u0915 \u0930\u093e\u0936\u093f \u0926\u093f\u0916\u093e\u0908 \u091c\u093e\u090f\u0917\u0940\u0964","All-Inclusive Package:":"\u0938\u092c \u0915\u0941\u091b \u0936\u093e\u092e\u093f\u0932 \u092a\u0948\u0915\u0947\u091c:",Allow:"\u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902","Allow \"Display over other apps\" so a new booking pops up as a floating bubble even while you are using another app. You can change this any time in Settings.":"\"\u0905\u0928\u094d\u092f \u0910\u092a\u094d\u0938 \u0915\u0947 \u090a\u092a\u0930 \u0926\u093f\u0916\u093e\u090f\u0901\" \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902 \u0924\u093e\u0915\u093f \u0926\u0942\u0938\u0930\u093e \u0910\u092a \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u092d\u0940 \u0928\u0908 \u092c\u0941\u0915\u093f\u0902\u0917 \u0924\u0948\u0930\u0924\u0947 \u092c\u092c\u0932 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0906\u090f\u0964 \u0907\u0938\u0947 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u0915\u092d\u0940 \u092d\u0940 \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Allow app to access your location":"\u0910\u092a \u0915\u094b \u0905\u092a\u0928\u093e \u0932\u094b\u0915\u0947\u0936\u0928 \u0926\u0947\u0916\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902","Allow microphone access to send a voice note.":"\u0935\u0949\u092f\u0938 \u0928\u094b\u091f \u092d\u0947\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902\u0964","Alternative mobile number":"\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930","Amount held at accept":"\u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0924\u0947 \u0938\u092e\u092f \u0939\u094b\u0932\u094d\u0921 \u0915\u0940 \u0917\u0908 \u0930\u093e\u0936\u093f","Analyzing fleet tariffs & operational protocols":"\u092b\u094d\u0932\u0940\u091f \u091f\u0948\u0930\u093f\u092b\u093c \u0914\u0930 \u0938\u0902\u091a\u093e\u0932\u0928 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0939\u094b \u0930\u0939\u093e \u0939\u0948","Another vendor has accepted this trip just a moment ago. We are automatically refreshing your available bookings list.":"\u090f\u0915 \u0914\u0930 \u0935\u0947\u0902\u0921\u0930 \u0928\u0947 \u0905\u092d\u0940 \u092f\u0939 \u091f\u094d\u0930\u093f\u092a \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0932\u0940\u0964 \u0939\u092e \u0909\u092a\u0932\u092c\u094d\u0927 \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u0942\u091a\u0940 \u0905\u092a\u0928\u0947 \u0906\u092a \u0930\u0940\u092b\u093c\u094d\u0930\u0947\u0936 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964","Anything else you want to tell us? (optional)":"\u0939\u092e\u0947\u0902 \u0914\u0930 \u0915\u0941\u091b \u092c\u0924\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902? (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)","App & notification preferences":"\u0910\u092a \u0914\u0930 \u0938\u0942\u091a\u0928\u093e \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u090f\u0901","App Information":"\u0910\u092a \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940","App information and support":"\u0910\u092a \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0914\u0930 \u0938\u0939\u093e\u092f\u0924\u093e","App language preference":"\u0910\u092a \u092d\u093e\u0937\u093e \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e","App version and info":"\u0910\u092a \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0914\u0930 \u091c\u093e\u0928\u0915\u093e\u0930\u0940",Appearance:"\u0926\u093f\u0916\u093e\u0935\u091f",Applied:"\u0932\u093e\u0917\u0942 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",Apply:"\u0932\u093e\u0917\u0942 \u0915\u0930\u0947\u0902","Apply Date Range":"\u0924\u093e\u0930\u0940\u0916\u093c \u0938\u0940\u092e\u093e \u0932\u093e\u0917\u0942 \u0915\u0930\u0947\u0902","Apply Filters (":"\u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0932\u093e\u0917\u0942 \u0915\u0930\u0947\u0902 (","Applying...":"\u0932\u093e\u0917\u0942 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...","Approve (":"\u092e\u0902\u091c\u093c\u0942\u0930 \u0915\u0930\u0947\u0902 (","Approve & Lock Seats":"\u092e\u0902\u091c\u093c\u0942\u0930 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u0940\u091f\u0947\u0902 \u0932\u0949\u0915 \u0915\u0930\u0947\u0902","Approve Vehicle Request":"\u0917\u093e\u0921\u093c\u0940 \u0905\u0928\u0941\u0930\u094b\u0927 \u092e\u0902\u091c\u093c\u0942\u0930 \u0915\u0930\u0947\u0902","Approved \u2705":"\u092e\u0902\u091c\u093c\u0942\u0930 \u2705","Are you sure you want to cancel this booking? If the trip has already started, a cancellation penalty will apply.":"\u0915\u094d\u092f\u093e \u0906\u092a \u0907\u0938 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u094b \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902? \u092f\u0926\u093f \u091f\u094d\u0930\u093f\u092a \u0936\u0941\u0930\u0942 \u0939\u094b \u091a\u0941\u0915\u0940 \u0939\u0948 \u0924\u094b \u0930\u0926\u094d\u0926\u0940\u0915\u0930\u0923 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e \u0932\u0917\u0947\u0917\u093e\u0964","Are you sure you want to clear your entered details and chat history?":"\u0915\u094d\u092f\u093e \u0906\u092a \u0926\u0930\u094d\u091c \u0915\u093f\u090f \u0935\u093f\u0935\u0930\u0923 \u0914\u0930 \u091a\u0948\u091f \u0907\u0924\u093f\u0939\u093e\u0938 \u092e\u093f\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?","Are you sure you want to remove vacant status for {0}? Vendors will no longer see this car waiting.":"\u0915\u094d\u092f\u093e \u0906\u092a {0} \u0915\u0940 \u0916\u093e\u0932\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902? \u0935\u0947\u0902\u0921\u0930 \u0905\u092c \u0907\u0938 \u0917\u093e\u0921\u093c\u0940 \u0915\u094b \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u0947\u0902\u0917\u0947\u0964","Area Pincode (Optional)":"\u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092a\u093f\u0928\u0915\u094b\u0921 (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)","Ask customer for 4-digit OTP":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947 4 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e OTP \u092e\u093e\u0901\u0917\u0947\u0902","Ask for boot space photos":"\u092c\u0942\u091f \u0938\u094d\u092a\u0947\u0938 \u0915\u0940 \u092b\u094b\u091f\u094b \u092e\u093e\u0901\u0917\u0947\u0902","Ask Help Bot anything in Tamil / English (or type 1\u20139)...":"Help Bot \u0938\u0947 \u0939\u093f\u0902\u0926\u0940 / \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u093c\u0940 \u092e\u0947\u0902 \u0915\u0941\u091b \u092d\u0940 \u092a\u0942\u091b\u0947\u0902 (\u092f\u093e 1\u20139 \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902)...","Ask OTP & Enter Start Odometer (KM).":"OTP \u092e\u093e\u0901\u0917\u0947\u0902 \u0914\u0930 \u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0913\u0921\u094b\u092e\u0940\u091f\u0930 (\u0915\u093f\u092e\u0940) \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Ask the customer for the 4-digit code shown on their booking confirmation.":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u0941\u0937\u094d\u091f\u093f \u092e\u0947\u0902 \u0926\u093f\u0916\u0947 4 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u092e\u093e\u0901\u0917\u0947\u0902\u0964","Ask the customer for the 4-digit completion code from their SMS or booking page.":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0947 SMS \u092f\u093e \u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u0947\u091c \u0938\u0947 4 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0915\u094b\u0921 \u092e\u093e\u0901\u0917\u0947\u0902\u0964","Ask the customer for the trip end code from their confirmation email.":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0947 \u092a\u0941\u0937\u094d\u091f\u093f \u0908\u092e\u0947\u0932 \u0938\u0947 \u091f\u094d\u0930\u093f\u092a \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0915\u094b\u0921 \u092e\u093e\u0901\u0917\u0947\u0902\u0964","Ask the customer for the trip start code from their confirmation email.":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0947 \u092a\u0941\u0937\u094d\u091f\u093f \u0908\u092e\u0947\u0932 \u0938\u0947 \u091f\u094d\u0930\u093f\u092a \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u093e \u0915\u094b\u0921 \u092e\u093e\u0901\u0917\u0947\u0902\u0964","Assign Driver":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902","Assign Driver & Cab":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0915\u0948\u092c \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902","Assign driver & car in {0}":"{0} \u0915\u0947 \u092d\u0940\u0924\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0917\u093e\u0921\u093c\u0940 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902","Assign Vehicle":"\u0917\u093e\u0921\u093c\u0940 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902","Assigned ({0})":"\u0905\u0938\u093e\u0907\u0928 \u0915\u093f\u090f \u0917\u090f ({0})","Assigned Cab & Driver":"\u0905\u0938\u093e\u0907\u0928 \u0915\u0940 \u0917\u0908 \u0915\u0948\u092c \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930","Assigned Driver & Cab":"\u0905\u0938\u093e\u0907\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0915\u0948\u092c","Assigned Vehicle":"\u0905\u0938\u093e\u0907\u0928 \u0915\u0940 \u0917\u0908 \u0917\u093e\u0921\u093c\u0940","Assigned Vehicle (":"\u0905\u0938\u093e\u0907\u0928 \u0915\u0940 \u0917\u0908 \u0917\u093e\u0921\u093c\u0940 (","Assigned:":"\u0905\u0938\u093e\u0907\u0928:","Assignment Error":"\u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u0924\u094d\u0930\u0941\u091f\u093f","Assignment Rules":"\u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u0928\u093f\u092f\u092e","Attachment Support Desk":"\u0905\u091f\u0948\u091a\u092e\u0947\u0902\u091f \u0938\u092a\u094b\u0930\u094d\u091f \u0921\u0947\u0938\u094d\u0915","Authentication failed - please login again to get a valid token.":"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0935\u093f\u092b\u0932 - \u092e\u093e\u0928\u094d\u092f \u091f\u094b\u0915\u0928 \u0915\u0947 \u0932\u093f\u090f \u092b\u093f\u0930 \u0938\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902\u0964","Authentication failed. Please login again and try adding the driver.":"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0935\u093f\u092b\u0932\u0964 \u092b\u093f\u0930 \u0938\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0915\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u091c\u094b\u0921\u093c\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964","Authentication failed. Please login again.":"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0935\u093f\u092b\u0932\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0947\u0902\u0964","Auto-assigning in":"\u0911\u091f\u094b-\u0905\u0938\u093e\u0907\u0928 \u0939\u094b\u0917\u093e:","Auto-Assignment Rules & \u20b9500 Penalty":"\u0911\u091f\u094b-\u0905\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u0928\u093f\u092f\u092e \u0914\u0930 \u20b9500 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u093e","Auto-cancelled: no driver & car were assigned in time.":"\u0911\u091f\u094b-\u0930\u0926\u094d\u0926: \u0938\u092e\u092f \u092a\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0917\u093e\u0921\u093c\u0940 \u0905\u0938\u093e\u0907\u0928 \u0928\u0939\u0940\u0902 \u0939\u0941\u0908\u0964","Auto-renew from wallet":"\u0935\u0949\u0932\u0947\u091f \u0938\u0947 \u0911\u091f\u094b-\u0930\u093f\u0928\u094d\u092f\u0942","Auto-verification checks document photo, number & name":"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0940 \u092b\u094b\u091f\u094b, \u0928\u0902\u092c\u0930 \u0914\u0930 \u0928\u093e\u092e \u0915\u0940 \u0905\u092a\u0928\u0947 \u0906\u092a \u091c\u093e\u0901\u091a \u0915\u0930\u0924\u093e \u0939\u0948","Auto-verified against name on document photo.":"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0915\u0940 \u092b\u094b\u091f\u094b \u092a\u0930 \u0932\u093f\u0916\u0947 \u0928\u093e\u092e \u0938\u0947 \u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924\u0964","Auto-verify checks driving licence photo, number & name match.":"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0915\u0940 \u092b\u094b\u091f\u094b, \u0928\u0902\u092c\u0930 \u0914\u0930 \u0928\u093e\u092e \u092e\u0947\u0932 \u0916\u093e\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0928\u0939\u0940\u0902, \u0905\u092a\u0928\u0947 \u0906\u092a \u091c\u093e\u0901\u091a\u0924\u093e \u0939\u0948\u0964","Auto-verify checks driving licence, Aadhaar ID, photo & name match.":"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938, \u0906\u0927\u093e\u0930 ID, \u092b\u094b\u091f\u094b \u0914\u0930 \u0928\u093e\u092e \u092e\u0947\u0932 \u0916\u093e\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0928\u0939\u0940\u0902, \u0905\u092a\u0928\u0947 \u0906\u092a \u091c\u093e\u0901\u091a\u0924\u093e \u0939\u0948\u0964","AUTOMATED ANSWERS \u2022 AVAILABLE 24/7":"\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u091c\u0935\u093e\u092c \u2022 24/7 \u0909\u092a\u0932\u092c\u094d\u0927","automatically assigned":"\u0905\u092a\u0928\u0947 \u0906\u092a \u0905\u0938\u093e\u0907\u0928 \u0939\u0941\u0906","AUTOMATICALLY ASSIGNED":"\u0905\u092a\u0928\u0947 \u0906\u092a \u0905\u0938\u093e\u0907\u0928 \u0939\u0941\u0906","automatically debited from your fleet wallet.":"\u0906\u092a\u0915\u0947 \u092b\u094d\u0932\u0940\u091f \u0935\u0949\u0932\u0947\u091f \u0938\u0947 \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u091f\u0947\u0917\u093e\u0964","Available Wallet Balance: \u20b9":"\u0909\u092a\u0932\u092c\u094d\u0927 \u0935\u0949\u0932\u0947\u091f \u0936\u0947\u0937: \u20b9","Back Seat Photo Required":"\u092a\u093f\u091b\u0932\u0940 \u0938\u0940\u091f \u0915\u0940 \u092b\u094b\u091f\u094b \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948","Back Side":"\u092a\u0940\u091b\u0947 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e","Back side of Aadhaar":"\u0906\u0927\u093e\u0930 \u0915\u093e \u092a\u093f\u091b\u0932\u093e \u0939\u093f\u0938\u094d\u0938\u093e","Back Side Photo":"\u092a\u0940\u091b\u0947 \u0915\u0940 \u0924\u0930\u092b\u093c \u0915\u0940 \u092b\u094b\u091f\u094b","BACK SIDE PHOTO":"\u092a\u0940\u091b\u0947 \u0915\u0940 \u0924\u0930\u092b\u093c \u0915\u0940 \u092b\u094b\u091f\u094b","Backend failed - cannot process trip payment":"\u0938\u0930\u094d\u0935\u0930 \u0935\u093f\u092b\u0932 - \u091f\u094d\u0930\u093f\u092a \u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\
nter a valid year (1900\u2013{maxYear}).":"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0cb5\u0cb0\u0ccd\u0cb7 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (1900\u2013{maxYear}).","{fields} still {verb} an upload.":"{fields} \u0c97\u0cc6 \u0c87\u0ca8\u0ccd\u0ca8\u0cc2 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd {verb}.",need:"\u0cac\u0cc7\u0c95\u0cc1",needs:"\u0cac\u0cc7\u0c95\u0cc1","Failed to pick image":"\u0cab\u0ccb\u0c9f\u0ccb \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2",Success:"\u0caf\u0cb6\u0cb8\u0ccd\u0cb8\u0cc1","Car details added successfully!":"\u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","Please check the highlighted fields":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb9\u0cc8\u0cb2\u0cc8\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf","Could not add car":"\u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Failed to add car details. Please try again.":"\u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Step {current}/3":"\u0cb9\u0c82\u0ca4 {current}/3","Hi {name}, let's get you started by adding your first car and driver.":"\u0ca8\u0cae\u0cb8\u0ccd\u0c95\u0cbe\u0cb0 {name}, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0ca6\u0cb2 \u0c95\u0cbe\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0ccb\u0ca3.","Check the vehicle details":"\u0cb5\u0cbe\u0cb9\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf","Car Details":"\u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","Car Name:":"\u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1:","Car Type:":"\u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb5\u0cb0\u0ccd\u0c97:","Select Car Type":"\u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb5\u0cb0\u0ccd\u0c97 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","Registration Number:":"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:","Enter your car number exactly as on the RC (e.g. TN 25 CC 8246)":"RC \u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cc1\u0cb5\u0c82\u0ca4\u0cc6\u0caf\u0cc7 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0c89\u0ca6\u0cbe. TN 25 CC 8246)","Mfd Year:":"\u0ca4\u0caf\u0cbe\u0cb0\u0cbf\u0c95\u0cbe \u0cb5\u0cb0\u0ccd\u0cb7:","Required Documents":"\u0c85\u0c97\u0ca4\u0ccd\u0caf \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1","Please upload clear images of all required documents":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c85\u0c97\u0ca4\u0ccd\u0caf \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3 \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Complete the vehicle documents":"\u0cb5\u0cbe\u0cb9\u0ca8 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf","Registration Certificate front side":"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ca4\u0ccd\u0cb0\u0ca6 \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97","Registration Certificate back side":"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ca4\u0ccd\u0cb0\u0ca6 \u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97","Valid insurance certificate":"\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cb5\u0cbf\u0cae\u0cc6 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ca4\u0ccd\u0cb0","Fitness Certificate":"\u0cab\u0cbf\u0c9f\u0ccd\u200c\u0ca8\u0cc6\u0cb8\u0ccd \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0caa\u0ca4\u0ccd\u0cb0","Vehicle Permit":"\u0cb5\u0cbe\u0cb9\u0ca8 \u0caa\u0cb0\u0ccd\u0cae\u0cbf\u0c9f\u0ccd","Clear photo of your car":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f \u0cab\u0ccb\u0c9f\u0ccb","Review Before Submitting":"\u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf","Check everything looks right, then submit for approval.":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cb5\u0cc2 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6\u0caf\u0cc7 \u0ca8\u0ccb\u0ca1\u0cbf, \u0ca8\u0c82\u0ca4\u0cb0 \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0ca8\u0cc6\u0c97\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cbf.","Car Name":"\u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","Car Type":"\u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb5\u0cb0\u0ccd\u0c97","Registration Number":"\u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Mfd Year":"\u0ca4\u0caf\u0cbe\u0cb0\u0cbf\u0c95\u0cbe \u0cb5\u0cb0\u0ccd\u0cb7","Uploading\u2026 {percent}%":"\u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6\u2026 {percent}%","Saving Car...":"\u0c95\u0cbe\u0cb0\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Save Car & Continue":"\u0c95\u0cbe\u0cb0\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cbf \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf","Add New Car":"\u0cb9\u0cca\u0cb8 \u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add Another Car":"\u0c87\u0ca8\u0ccd\u0ca8\u0cca\u0c82\u0ca6\u0cc1 \u0c95\u0cbe\u0cb0\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add details for your new vehicle to expand your fleet.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cb5\u0cbf\u0cb8\u0ccd\u0ca4\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb9\u0cca\u0cb8 \u0cb5\u0cbe\u0cb9\u0ca8\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf.","Save Car":"\u0c95\u0cbe\u0cb0\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cbf","Failed to add car details":"\u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Are you sure you want to go back? The driver details you entered may be lost.":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0cb9\u0cbf\u0c82\u0ca6\u0cc6 \u0cb9\u0ccb\u0c97\u0cac\u0cc7\u0c95\u0cc7? \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0 \u0c95\u0cb3\u0cc6\u0ca6\u0cc1\u0cb9\u0ccb\u0c97\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Full name is required":"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0cac\u0cc7\u0c95\u0cc1","Primary phone number is required":"\u0caa\u0ccd\u0cb0\u0cbe\u0ca5\u0cae\u0cbf\u0c95 \u0cab\u0ccb\u0ca8\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cac\u0cc7\u0c95\u0cc1","Password is required":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0cc7\u0c95\u0cc1","Driving licence number is required":"\u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cac\u0cc7\u0c95\u0cc1","Address is required":"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cac\u0cc7\u0c95\u0cc1","Please fill all required fields":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c85\u0c97\u0ca4\u0ccd\u0caf \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc1\u0c82\u0cac\u0cbf","Please upload Licence Front image":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf\u0caf \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97\u0ca6 \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Authentication Required":"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3 \u0cac\u0cc7\u0c95\u0cc1","Please log in again to continue.":"\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Session expired or invalid. Please log in again.":"\u0cb8\u0cc6\u0cb7\u0ca8\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Enter valid 10-digit Indian mobile number":"\u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0cad\u0cbe\u0cb0\u0ca4\u0cc0\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Secondary number invalid":"\u0c8e\u0cb0\u0ca1\u0ca8\u0cc7 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf","Address must be at least 5 characters":"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 5 \u0c85\u0c95\u0ccd\u0cb7\u0cb0 \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","City is required":"\u0ca8\u0c97\u0cb0 \u0cac\u0cc7\u0c95\u0cc1","Pincode must be 6 digits":"\u0caa\u0cbf\u0ca8\u0ccd\u200c\u0c95\u0ccb\u0ca1\u0ccd 6 \u0c85\u0c82\u0c95\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Pincode must be exactly 6 digits":"\u0caa\u0cbf\u0ca8\u0ccd\u200c\u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0c97\u0cbf 6 \u0c85\u0c82\u0c95\u0cbf \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Password must be at least 6 characters":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 6 \u0c85\u0c95\u0ccd\u0cb7\u0cb0 \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Driver details added successfully!":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","Could not add driver":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Failed to add driver details. Please try again.":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Add Your First Driver":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0ca6\u0cb2 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Driver Registration":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf","Hi {name}, let's add your first driver to complete the setup.":"\u0ca8\u0cae\u0cb8\u0ccd\u0c95\u0cbe\u0cb0 {name}, \u0cb8\u0cc6\u0c9f\u0caa\u0ccd \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0ca6\u0cb2 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0ccb\u0ca3.","Driver Details":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","Who is driving?":"\u0caf\u0cbe\u0cb0\u0cc1 \u0c93\u0ca1\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0cb0\u0cc6?","Own cum Driver":"\u0cae\u0cbe\u0cb2\u0cc0\u0c95\u0cb0\u0cc7 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd","Your name, mobile and address are filled in automatically. Just add your licence details below - no separate driver password needed, you'll switch into this using your own login.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca4\u0cbe\u0ca8\u0cbe\u0c97\u0cbf \u0ca4\u0cc1\u0c82\u0cac\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cb5\u0cbf\u0cb5\u0cb0 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf - \u0caa\u0ccd\u0cb0\u0ca4\u0ccd\u0caf\u0cc7\u0c95 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0cc7\u0c95\u0cbf\u0cb2\u0ccd\u0cb2, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0cb5\u0c82\u0ca4 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cac\u0cb3\u0cb8\u0cbf \u0c87\u0ca6\u0c95\u0ccd\u0c95\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf.","Full Name:":"\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1:","Primary Mobile Number:":"\u0caa\u0ccd\u0cb0\u0cbe\u0ca5\u0cae\u0cbf\u0c95 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:","Enter your mobile number exactly as you want it stored":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5\u0c82\u0ca4\u0cc6\u0caf\u0cc7 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Secondary Mobile Number (Optional):":"\u0c8e\u0cb0\u0ca1\u0ca8\u0cc7 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95):","Driving Licence Number:":"\u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:","Enter your driving licence number exactly as it appears on your licence":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0cb0\u0cc1\u0cb5\u0c82\u0ca4\u0cc6\u0caf\u0cc7 \u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Street Address:":"\u0cb0\u0cb8\u0ccd\u0ca4\u0cc6 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8:","City:":"\u0ca8\u0c97\u0cb0:","Pincode:":"\u0caa\u0cbf\u0ca8\u0ccd\u200c\u0c95\u0ccb\u0ca1\u0ccd:","Required Document":"\u0c85\u0c97\u0ca4\u0ccd\u0caf \u0ca6\u0cbe\u0c96\u0cb2\u0cc6","Please upload a clear image of your driving license":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf\u0caf \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f \u0cab\u0ccb\u0c9f\u0ccb \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Licence Front":"\u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97","Front side of driving licence":"\u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf\u0caf \u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97","Licence Back":"\u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97","Back side of driving licence":"\u0c9a\u0cbe\u0cb2\u0ca8\u0cbe \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf\u0caf \u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97","Saving Driver...":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...","Save Driver & Continue":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c89\u0cb3\u0cbf\u0cb8\u0cbf \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf","Add Your Driver":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Hi {name}, let's add you driver to complete the setup.":"\u0ca8\u0cae\u0cb8\u0ccd\u0c95\u0cbe\u0cb0 {name}, \u0cb8\u0cc6\u0c9f\u0caa\u0ccd \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0ccb\u0ca3.","Validation Failed":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0caf\u0cbf\u0ca4\u0cc1","Failed to add driver details info ":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2","Data Sync Issue":"\u0ca1\u0cc7\u0c9f\u0cbe \u0cb8\u0cbf\u0c82\u0c95\u0ccd \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6","Some bookings have outdated car type information. Please contact support to update the database, or try refreshing later.":"\u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb9\u0cb3\u0cc6\u0caf \u0c95\u0cbe\u0cb0\u0cc1 \u0cb5\u0cb0\u0ccd\u0c97\u0ca6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0c87\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca1\u0cc7\u0c9f\u0cbe\u0cac\u0cc7\u0cb8\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf, \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0c82\u0ca4\u0cb0 \u0cb0\u0cbf\u0cab\u0ccd\u0cb0\u0cc6\u0cb6\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0ca8\u0ccb\u0ca1\u0cbf.","Failed to fetch rides data":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca1\u0cc7\u0c9f\u0cbe \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2",Assigned:"\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4",Completed:"\u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6",Cancelled:"\u0cb0\u0ca6\u0ccd\u0ca6\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",Rides:"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1","Booking ID: {id}":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd ID: {id}","From: {city}":"\u0c87\u0c82\u0ca6: {city}","Pickup Location":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cb8\u0ccd\u0ca5\u0cb3","To: {
re":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e","Driver with this mobile number already exists":"\u0907\u0938 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948","Driver:":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930:","Driving License Number (Savaari Format)":"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0928\u0902\u092c\u0930 (Savaari \u092a\u094d\u0930\u093e\u0930\u0942\u092a)","driving portion. You keep the posting earning above either way, and can accept it yourself from the New Bookings feed to earn both.":"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0935\u093e\u0932\u093e \u0939\u093f\u0938\u094d\u0938\u093e\u0964 \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u092e\u093e\u0908 \u0906\u092a\u0915\u094b \u0926\u094b\u0928\u094b\u0902 \u0924\u0930\u0939 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948; New Bookings \u0938\u0947 \u0916\u0941\u0926 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0947\u0902 \u0924\u094b \u0926\u094b\u0928\u094b\u0902 \u0915\u092e\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Drop (To City)":"\u0921\u094d\u0930\u0949\u092a (\u0917\u0902\u0924\u0935\u094d\u092f \u0936\u0939\u0930)","Drop Address / Landmark (Optional)":"\u0921\u094d\u0930\u0949\u092a \u092a\u0924\u093e / \u0932\u0948\u0902\u0921\u092e\u093e\u0930\u094d\u0915 (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)","Drop Bid Bidding Lead:":"Drop Bid \u092c\u094b\u0932\u0940 \u092e\u0947\u0902 \u0906\u0917\u0947:","Drop Bid Booking Pipeline":"Drop Bid \u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e","Drop Bid Fare Booking":"Drop Bid \u0915\u093f\u0930\u093e\u092f\u093e \u092c\u0941\u0915\u093f\u0902\u0917","Drop Bid Marketplace":"Drop Bid \u092e\u093e\u0930\u094d\u0915\u0947\u091f\u092a\u094d\u0932\u0947\u0938","Drop Cars Admin / Support":"Drop Cars \u090f\u0921\u092e\u093f\u0928 / \u0938\u092a\u094b\u0930\u094d\u091f","Drop Cars admin removed this booking from you.":"Drop Cars \u090f\u0921\u092e\u093f\u0928 \u0928\u0947 \u092f\u0939 \u092c\u0941\u0915\u093f\u0902\u0917 \u0906\u092a\u0938\u0947 \u0939\u091f\u093e \u0926\u0940\u0964","Drop Cars Chats":"Drop Cars \u091a\u0948\u091f","Drop Cars Duty & Fare Guidelines":"Drop Cars \u0921\u094d\u092f\u0942\u091f\u0940 \u0914\u0930 \u0915\u093f\u0930\u093e\u092f\u093e \u0926\u093f\u0936\u093e\u0928\u093f\u0930\u094d\u0926\u0947\u0936","Drop Cars fee":"Drop Cars \u0936\u0941\u0932\u094d\u0915","Drop Cars Help Bot":"Drop Cars \u0939\u0947\u0932\u094d\u092a \u092c\u0949\u091f","DROP CARS HELP BOT":"DROP CARS \u0939\u0947\u0932\u094d\u092a \u092c\u0949\u091f","Drop Cars is now monitoring trips from {0} to {1} starting {2} till {3}. When a matching trip is posted, a 10-second HUD Alert will notify you to accept or decline.":"Drop Cars \u0905\u092c {2} \u0938\u0947 {3} \u0924\u0915 {0} \u0938\u0947 {1} \u0915\u0940 \u091f\u094d\u0930\u093f\u092a \u092a\u0930 \u0928\u091c\u093c\u0930 \u0930\u0916 \u0930\u0939\u093e \u0939\u0948\u0964 \u092e\u093f\u0932\u0924\u0940-\u091c\u0941\u0932\u0924\u0940 \u091f\u094d\u0930\u093f\u092a \u092a\u094b\u0938\u094d\u091f \u0939\u094b\u0928\u0947 \u092a\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u092f\u093e \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 10 \u0938\u0947\u0915\u0902\u0921 \u0915\u093e HUD \u0905\u0932\u0930\u094d\u091f \u0906\u090f\u0917\u093e\u0964","Drop Cars Partner Platform":"Drop Cars \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e","Drop Cars support":"Drop Cars \u0938\u092a\u094b\u0930\u094d\u091f","DROP CONNECT":"DROP CONNECT","Drop Connect - Empty Seat Sharing":"Drop Connect - \u0916\u093e\u0932\u0940 \u0938\u0940\u091f \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u093e","Drop Date & Time":"\u0921\u094d\u0930\u0949\u092a \u0924\u093e\u0930\u0940\u0916\u093c \u0914\u0930 \u0938\u092e\u092f","Duplicate Offer":"\u0921\u0941\u092a\u094d\u0932\u093f\u0915\u0947\u091f \u0911\u092b\u093c\u0930",Duration:"\u0905\u0935\u0927\u093f","Duty & route help desk":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0914\u0930 \u0930\u0942\u091f \u0939\u0947\u0932\u094d\u092a \u0921\u0947\u0938\u094d\u0915","Duty Driver Account":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0916\u093e\u0924\u093e","Duty driver mobile number":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930","Duty Driver Portal":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u094b\u0930\u094d\u091f\u0932","Duty Mode":"\u0921\u094d\u092f\u0942\u091f\u0940 \u092e\u094b\u0921","Duty rides you finish and synced passenger ratings will automatically appear here.":"\u0906\u092a\u0915\u0940 \u092a\u0942\u0930\u0940 \u0915\u0940 \u0917\u0908 \u0921\u094d\u092f\u0942\u091f\u0940 \u091f\u094d\u0930\u093f\u092a \u0914\u0930 \u0938\u093f\u0902\u0915 \u0939\u0941\u0908 \u092f\u093e\u0924\u094d\u0930\u0940 \u0930\u0947\u091f\u093f\u0902\u0917 \u0905\u092a\u0928\u0947 \u0906\u092a \u092f\u0939\u093e\u0901 \u0926\u093f\u0916\u0947\u0902\u0917\u0940\u0964","Duty Trip History":"\u0921\u094d\u092f\u0942\u091f\u0940 \u091f\u094d\u0930\u093f\u092a \u0907\u0924\u093f\u0939\u093e\u0938","e.g. 3 hours 10 min":"\u091c\u0948\u0938\u0947 3 \u0918\u0902\u091f\u0947 10 \u092e\u093f\u0928\u091f","e.g. Heavy luggage, baby onboard, pet travelling, elderly passenger, AC preference...":"\u091c\u0948\u0938\u0947 \u092d\u093e\u0930\u0940 \u0938\u093e\u092e\u093e\u0928, \u092c\u091a\u094d\u091a\u093e, \u092a\u093e\u0932\u0924\u0942 \u091c\u093e\u0928\u0935\u0930, \u092c\u094
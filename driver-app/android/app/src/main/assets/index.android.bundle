it:":"\u0915\u093f\u092e\u0940 \u0914\u0930 \u0918\u0902\u091f\u0947 \u0915\u0940 \u0938\u0940\u092e\u093e:","KM & Hours Package":"\u0915\u093f\u092e\u0940 \u0914\u0930 \u0918\u0902\u091f\u0947 \u0915\u093e \u092a\u0948\u0915\u0947\u091c","km \xd7 \u20b9":"\u0915\u093f\u092e\u0940 \xd7 \u20b9","km billed.":"\u0915\u093f\u092e\u0940 \u0915\u093e \u092c\u093f\u0932 \u092c\u0928\u093e\u0964","km calculated \u2192":"\u0915\u093f\u092e\u0940 \u0915\u0940 \u0917\u0923\u0928\u093e \u2192","KM Limit Included":"\u0915\u093f\u092e\u0940 \u0938\u0940\u092e\u093e \u0936\u093e\u092e\u093f\u0932","km):":"\u0915\u093f\u092e\u0940):","KYC status, document expiry reminders, and admin announcements":"KYC \u0938\u094d\u0925\u093f\u0924\u093f, \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u0914\u0930 \u090f\u0921\u092e\u093f\u0928 \u0918\u094b\u0937\u0923\u093e\u090f\u0901","KYC Updated":"KYC \u0905\u092a\u0921\u0947\u091f \u0939\u0941\u0906","KYC Verification Required":"KYC \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u091c\u093c\u0930\u0942\u0930\u0940","Language / \u0bae\u0bca\u0bb4\u0bbf":"Language / \u092d\u093e\u0937\u093e","LAST WEEK":"\u092a\u093f\u091b\u0932\u093e \u0938\u092a\u094d\u0924\u093e\u0939",Later:"\u092c\u093e\u0926 \u092e\u0947\u0902","LAUNCH OFFER":"\u0932\u0949\u0928\u094d\u091a \u0911\u092b\u093c\u0930",Leave:"\u091b\u094b\u0921\u093c\u0947\u0902","Leave this page?":"\u092f\u0939 \u092a\u0947\u091c \u091b\u094b\u0921\u093c\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?","Legal Agreement & Security Policy":"\u0915\u093e\u0928\u0942\u0928\u0940 \u0938\u092e\u091d\u094c\u0924\u093e \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u0940\u0924\u093f","Licence (Back)":"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 (\u092a\u0940\u091b\u0947)","Licence (Front)":"\u0921\u094d\u0930\u093e\u09
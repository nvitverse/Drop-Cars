0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bca\u0b95\u0bc8 \u20b9","A valid email address is required":"\u0b9a\u0bb0\u0bbf\u0baf\u0bbe\u0ba9 \u0bae\u0bbf\u0ba9\u0bcd\u0ba9\u0b9e\u0bcd\u0b9a\u0bb2\u0bcd \u0bae\u0bc1\u0b95\u0bb5\u0bb0\u0bbf \u0ba4\u0bc7\u0bb5\u0bc8","Aadhaar Back":"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0baa\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bcd\u0b95\u0bae\u0bcd","Aadhaar Back Side":"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0baa\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bcd\u0b95\u0bae\u0bcd","Aadhaar Card":"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b95\u0bbe\u0bb0\u0bcd\u0b9f\u0bc1","Aadhaar Card (ID Proof)":"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b95\u0bbe\u0bb0\u0bcd\u0b9f\u0bc1 (\u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3\u0b9a\u0bcd \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1)","Aadhaar Front":"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0bae\u0bc1\u0ba9\u0bcd \u0baa\u0b95\u0bcd\u0b95\u0bae\u0bcd","Aadhaar Front Side":"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0bae\u0bc1\u0ba9\u0bcd \u0baa\u0b95\u0bcd\u0b95\u0bae\u0bcd","Aadhaar Number":"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd","AADHAAR NUMBER":"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd","Aadhaar Number Required":"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd \u0ba4\u0bc7\u0bb5\u0bc8","Aadhar Card (Front & Back)":"\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b95\u0bbe\u0bb0\u0bcd\u0b9f\u0bc1 (\u0bae\u0bc1\u0ba9\u0bcd & \u0baa\u0bbf\u0ba9\u0bcd)",About:"\u0baa\u0bb1\u0bcd\u0bb1\u0bbf","About App":"\u0b86\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf",Accept:"\u0b8f\u0bb1\u0bcd\u0bb1\u0bc1","Accept \u20b9":"\u20b9 \u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1","Accept Booking":"\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0b99\u0bcd\u0b95\u0bc8 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1","Accept Booking for \u20b9":"\u20b9 \u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0b99\u0bcd\u0b95\u0bc8 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1","Accept Driver & Vehicle":"\u0b9f\u0bbf\u0bb0\u0bc8\u0bb5\u0bb0\u0bcd & \u0bb5\u0bbe\u0b95\u0ba9\u0ba4\u0bcd\u0ba4\u0bc8 \u0b8f\u0b
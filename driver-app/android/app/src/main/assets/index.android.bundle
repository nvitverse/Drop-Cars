caa\u0ccd \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cb8\u0ccd\u0c9f\u0cae\u0cc8\u0cb8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Dark Mode":"\u0ca1\u0cbe\u0cb0\u0ccd\u0c95\u0ccd \u0cae\u0ccb\u0ca1\u0ccd","Data Sharing":"\u0ca1\u0cc7\u0c9f\u0cbe \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cc6",Date:"\u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95","Day After":"\u0cae\u0cb0\u0cc1\u0ca6\u0cbf\u0ca8","debited from your wallet.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0c86\u0c97\u0cbf\u0ca6\u0cc6.","Decline (":"\u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cbf (","Decline (Need 7 Seater)":"\u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cbf (7 \u0cb8\u0cc0\u0c9f\u0cb0\u0ccd \u0cac\u0cc7\u0c95\u0cc1)","Decline is FREE during the 10s countdown. Post-assignment cancel fee: \u20b9500.":"10 \u0cb8\u0cc6\u0c95\u0cc6\u0c82\u0ca1\u0ccd \u0c95\u0ccc\u0c82\u0c9f\u0ccd\u200c\u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c89\u0c9a\u0cbf\u0ca4. \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0ca8\u0c82\u0ca4\u0cb0 \u0cb0\u0ca6\u0ccd\u0ca6\u0ca4\u0cbf \u0cb6\u0cc1\u0cb2\u0ccd\u0c95: \u20b9500.","Decline within 10 seconds":"10 \u0cb8\u0cc6\u0c95\u0cc6\u0c82\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cbf","Demo Mode Active":"\u0ca1\u0cc6\u0cae\u0cca \u0cae\u0ccb\u0ca1\u0ccd \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Departure date":"\u0cb9\u0cca\u0cb0\u0ca1\u0cc1\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95","Departure time":"\u0cb9\u0cca\u0cb0\u0ca1\u0cc1\u0cb5 \u0cb8\u0cae\u0caf","Describe the name, address, or document changes needed...":"\u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c85\u0ca5\u0cb5\u0cbe \u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf...","Describe your issue or enter your correct email address...":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf...","Details to Update / Reason":"\u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0 / \u0c95\u0cbe\u0cb0\u0ca3","Didn't clearly match your licence photo ({0}%) - you can retake it in Settings.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb2\u0cc8\u0cb8\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0cab\u0ccb\u0c9f\u0ccb\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f\u0cb5\u0cbe\u0c97\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2 ({0}%) - \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Different Driver":"\u0cac\u0cc7\u0cb0\u0cc6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd","Different Number":"\u0cac\u0cc7\u0cb0\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Direct dealings outside the Drop Cars platform will result in account suspension.":"Drop Cars \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0cb9\u0cca\u0cb0\u0c97\u0cc6 \u0ca8\u0cc7\u0cb0 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0c96\u0cbe\u0ca4\u0cc6 \u0c85\u0cae\u0cbe\u0ca8\u0ca4\u0cbf\u0c97\u0cc6 \u0c95\u0cbe\u0cb0\u0ca3\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Direct personal numbers & WhatsApp contacts are masked to protect trip security and platform privacy.":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6\u0c97\u0cbe\u0c97\u0cbf \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 & WhatsApp \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc6\u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","directly from customer. Security deposit is held temporarily in wallet and settled after trip completion.":"\u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c82\u0ca6. \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0ca0\u0cc7\u0cb5\u0ca3\u0cbf \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca4\u0cbe\u0ca4\u0ccd\u0c95\u0cbe\u0cb2\u0cbf\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0cb9\u0ccb\u0cb2\u0ccd\u0ca1\u0ccd \u0c86\u0c97\u0cbf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cae\u0cc1\u0c97\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0 \u0cb8\u0cc6\u0c9f\u0cb2\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Directly post and dispatch new trips from your driver panel to the Drop Cars network.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0ccd\u0caf\u0cbe\u0ca8\u0cc6\u0cb2\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf Drop Cars \u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd\u200c\u0c97\u0cc6 \u0cb9\u0cca\u0cb8 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0caa\u0ccb\u0cb8\u0ccd\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",Dismiss:"\u0cb5\u0c9c\u0cbe\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf",Distance:"\u0ca6\u0cc2\u0cb0","Distance (km)":"\u0ca6\u0cc2\u0cb0 (\u0c95\u0cbf.\u0cae\u0cc0.)","Distance & Fare":"\u0ca6\u0cc2\u0cb0 & \u0ca6\u0cb0","Distance actually driven":"\u0ca8\u0cbf\u0c9c\u0cb5\u0cbe\u0c97\u0cbf \u0c93\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca6\u0cc2\u0cb0","Distance driven":"\u0c93\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca6\u0cc2\u0cb0","Distance edited:":"\u0ca6\u0cc2\u0cb0 \u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6:","Distance is different":"\u0ca6\u0cc2\u0cb0 \u0cac\u0cc7\u0cb0\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Distance planned":"\u0caf\u0ccb\u0c9c\u0cbf\u0ca4 \u0ca6\u0cc2\u0cb0","DL & Police Checked":"DL & \u0caa\u0cca\u0cb2\u0cc0\u0cb8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0c86\u0c97\u0cbf\u0ca6\u0cc6","Do you want to log in as a different driver?":"\u0cac\u0cc7\u0cb0\u0cc6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c86\u0c97\u0cbf \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc7?","DOCUMENT EXPIRY DATE":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0c85\u0cb5\u0ca7\u0cbf \u0cae\u0cc1\u0c97\u0cbf\u0caf\u0cc1\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95","Document Renewal Required":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1",Done:"\u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6","Driver {0} and Vehicle {1} assigned successfully.":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd {0} \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbe\u0cb9\u0ca8 {1} \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Driver & Fleet Partner Portal":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd & \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd \u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0cb2\u0ccd","Driver & Vehicle Profile":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd & \u0cb5\u0cbe\u0cb9\u0ca8 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd","Driver account status is {0}. Please contact support for assistance.":"\u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf {0}. \u0cb8\u0cb9\u0cbe\u0caf\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf."
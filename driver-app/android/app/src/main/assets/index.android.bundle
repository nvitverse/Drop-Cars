__d(function(e,t,a,i,r,o,n){r.exports={common:{brand:"Drop Cars"},tabBar:{home:"Home",myRides:"My Rides",dropMarket:"Drop Market",chats:"Chat",duty:"Duty"},languageNames:{en:"English",ta:"\u0ba4\u0bae\u0bbf\u0bb4\u0bcd",te:"\u0c24\u0c46\u0c32\u0c41\u0c17\u0c41",hi:"\u0939\u093f\u0928\u094d\u0926\u0940"},terms:{modalTitle:"Terms and Conditions",body:"DROP CARS \u2013 DRIVER & FLEET PARTNER PLATFORM\nTERMS & CONDITIONS & PLATFORM PROTECTION POLICY\n\nBy registering, accessing, or using the Drop Cars Driver Partner App, the user (fleet owner, vehicle owner, or driver account holder) agrees to the following legally binding terms.\n\n1. Platform Neutrality & Zero Liability Status\nDrop Cars operates strictly as a digital technology intermediary platform connecting independent fleet operators/drivers with customer/vendor rental requests. Drop Cars is NOT a motor carrier, transportation provider, employer, or bailee. Drop Cars assumes ZERO liability for vehicle condition, driver conduct, road accidents, passenger injury, property damage, loss of goods, or legal disputes occurring during any trip.\n\n2. Absolute Account Holder Liability & Responsibility (Crucial)\nThe registered user / account holder who accepts a booking on the Drop Cars platform assumes FULL, EXCLUSIVE, AND UNLIMITED LEGAL, FINANCIAL, AND CRIMINAL RESPONSIBILITY for that booking from acceptance to trip completion. This accountability applies regardless of whether the account holder executes the trip personally or delegates it to an assigned driver.\n\n3. Unauthorized Vehicle & Driver Swap (Strict Prohibition)\n3.1. Every accepted trip must be executed ONLY by the exact vehicle and driver officially assigned through the app for that specific booking ID.\n3.2. UNAUTHORIZED HANDOFF / SWAP: If an account holder accepts a booking and allows an unassigned driver, unauthorized vehicle, or third party to execute the trip without official app assignment, the accepting account holder bears 100% FULL CIVIL AND CRIMINAL LIABILITY for any resulting accident, death, injury, theft, vehicle damage, customer loss, or regulatory fine. Drop Cars is fully indemnified and released from all claims.\n3.3. Violations carry an immediate penalty up to \u20b910,000, instant account termination, permanent block, and potential criminal/civil prosecution.\n\n4. Vehicle & Driver Document Validity Compliance\n4.1. Account holders must upload authentic, valid, and unexpired documents: Driving Licence, Registration Certificate (RC), Commercial Insurance, Fitness Certificate, and Vehicle Permit.\n4.2. EXPIRED OR FAKE DOCUMENTS: If a trip is conducted with expired, forged, suspended, or invalid documents, the accepting account holder assumes TOTAL AND EXCLUSIVE FINANCIAL AND LEGAL LIABILITY for all traffic violations, legal penalties, insurance claim rejections, and third-party damages. Drop Cars accepts no responsibility for verifying physical document authenticity on-site.\n\n5. Indemnification & Hold Harmless Agreement\nThe account holder agrees to defend, indemnify, release, and hold harmless Drop Cars, its parent company, directors, employees, affiliates, and technology partners from and against ANY and ALL claims, demands, losses, damages, liabilities, lawsuits, judgments, fines, penalties, costs, and attorney fees arising directly or indirectly out of:\n- Any trip executed or failed to be executed under the user's account.\n- Any road accident, collision, passenger injury, death, or property damage.\n- Unauthorized cab or driver swaps / handoffs.\n- Expired, fraudulent, or missing vehicle/driver documentation.\n- Driver misconduct, negligence, traffic violations, or unlawful acts.\n- Collecting extra unauthorized cash from customers outside app fares.\n\n6. Registration, Subscription & Non-Refundable Fees\n6.1. Drivers/Fleet owners must pay a yearly attachment fee (non-refundable) to access the platform.\n6.2. Platform fees, commissions (10% on KM fare), extras, and penalties deducted from the in-app wallet are strictly NON-REFUNDABLE under any circumstances once processed.\n\n7. Debit Logic & Wallet Rules\n7.1. Drivers must maintain a positive wallet balance to accept and execute trips.\n7.2. Held amounts during trip acceptance will be forfeited as a penalty if the driver fails to assign resources on time or fails to complete the trip.\n\n8. Penalties & Account Enforcement\nPenalties will be automatically deducted from the wallet or recovered legally for platform breaches:\n- Unallocation / No-Show Penalty: Up to \u20b92,000\n- Late Assignment Penalty: Up to \u20b9500\n- Unauthorized Vehicle/Driver Swap Penalty: Up to \u20b910,000 & Permanent Block\n- Fraudulent / Expired Document Penalty: Up to \u20b95,000 & Permanent Block\n\n9. Right of Termination & Legal Action\nDrop Cars reserves the unconditional right to suspend, lock, or permanently delete any user account, freeze wallet funds, and initiate legal action under Indian law for violations of safety, fraudulent behavior, document misrepresentation, or unauthorized trip transfers.\n\n10. Support & Dispute Resolution\nFor queries, contact support@dropcars.com or +917200217986. All penalty decisions are subject to Drop Cars Admin final approval.\n"},welcome:{steps:[{title:"Welcome to Drop Cars!",subtitle:"Premier Fleet & Driver Partner Platform",description:"Connect your vehicles with customer bookings across India. Earn reliably while providing safe, professional transportation services."},{title:"Step 1: Add Fleet & Drivers",subtitle:"Keep All Documents Valid & Active",description:"Register vehicles with valid RC, Insurance, Permit, and Fitness. Add licensed drivers. You must keep all documents unexpired before taking trips."},{title:"Step 2: Accept & Assign Trips",subtitle:"Exact Vehicle & Driver Required",description:"Accept available bookings matching your route. You MUST assign the exact registered vehicle and driver in the app. Unauthorized cab or driver swaps are strictly prohibited."},{title:"Step 3: Account Holder Liability",subtitle:"100% Full Responsibility on Accepting User",description:"The user accepting a booking holds 100% full legal, financial, and criminal responsibility for trip execution, document validity, driver conduct, and any loss/accident. Drop Cars bears zero liability."},{title:"Terms & Platform Policies",subtitle:"Legal Protection & Safety Compliance",description:"Please read and accept our comprehensive Terms & Conditions to protect all partners and activate your account."}],next:"Next",previous:"Previous",getStarted:"Get Started",stepIndicator:"{current} of {total}",swipeHint:"\u2190 Swipe left/right to navigate \u2192",agreePrefix:"I have read and agree to the",termsLink:"Terms and Conditions",modalTitle:"Terms and Conditions"},dashboard:{brand:"Drop Cars",totalBookingsDone:"Total Bookings Done",tierPreferred:"Trusted",tierStandard:"Standard",kycVerified:"KYC Verified",kycPending:"KYC Pending",carsBadge:"Cars",driversBadge:"Drivers",walletBalance:"Wallet Balance",driver:"Driver",addMoney:"Add Money",vacant:"Vacant",filterByCity:"Filter by City",filter:"Filter",availableBookings:"Available Bookings"},booking:{noLongerAvailable:"No longer available",expiresIn:"Expires in {time}",availableToAll:"Available to All",onlyForPreferredPartnersUntil:"Only for Trusted Partners \xb7 until {time}",vendorPrice:"Vendor Price",acceptFor:"Accept for \u20b9{amount}",recharge:"Recharge",toAccept:"to Accept",viewMoreDetails:"View More Details",hideMoreDetails:"Hide More Details",acceptTermsCheckbox:"I accept the Drop Cars Terms and Conditions.",termsLink:"Terms and Conditions",assignDeadlineTitle:"Assignment Deadline",assignDeadlineWarning:"You must assign a driver & car to this booking soon after accepting \u2014 you'll have {duration} (until {time}), or the held amount will be deducted as a penalty.",driverTariff:"Driver Tariff",customerTariff:"Customer Tariff",closedAmount:"Final Closed Amount",kmLimitNote:"Close the trip within 10% of the booked d
s('fare')||t.includes('rate')||t.includes('km rate')||t.includes('evlo')||t.includes('kattanam')||t.includes('per km')||t.includes('charges')||t.includes('rate card')||t.includes('pricing'))?{category:'TARIFF CALCULATION',text:"\ud83d\udcb0 Drop Cars Partner Standard Tariffs:\n\n\u2022 \ud83d\ude97 Sedan (Etios / Dzire / Aura): \u20b914/km (Outstation min 250 km/day)\n\u2022 \ud83d\ude99 SUV (Ertiga / Marazzo / Carens): \u20b919/km\n\u2022 \ud83d\ude98 Prime SUV (Innova / Crysta): \u20b921/km\n\u2022 \ud83d\ude96 Hatchback (Swift / WagonR): \u20b913/km\n\n\u2022 \ud83d\udc68\u200d\u2708\ufe0f Driver Bata (Allowance):\n  - Day: \u20b9300 (06:00 AM - 10:00 PM)\n  - Night: \u20b9400 (10:00 PM - 06:00 AM)\n\u2022 \ud83c\udd7f\ufe0f Fastag Tolls & Parking: 100% paid by customer on actual receipts.\n\n\ud83d\udccd Popular Intercity Quick Lookups:\n\u2022 Chennai \u2794 Bangalore (~345 km): Sedan ~\u20b94,830 | SUV ~\u20b96,555\n\u2022 Chennai \u2794 Madurai (~460 km): Sedan ~\u20b96,440 | SUV ~\u20b98,740\n\u2022 Chennai \u2794 Coimbatore (~505 km): Sedan ~\u20b97,070 | SUV ~\u20b99,595\n\u2022 Chennai \u2794 Trichy (~330 km): Sedan ~\u20b94,620 | SUV ~\u20b96,270\n\u2022 Chennai \u2794 Pondicherry (~155 km): Sedan ~\u20b92,170 | SUV ~\u20b92,945\n\n\ud83d\udca1 Type any route (e.g. \"Chennai to Madurai\") for instant calculated quotes!",action_chips:['\ud83d\ude97 Chennai to Madurai','\ud83d\ude97 Chennai to Bangalore','\ud83d\ude97 Chennai to Coimbatore','\ud83d\udd11 2. Start Trip OTP','\ud83c\udd7f\ufe0f 3. Toll Rules']}:n||t.includes('otp')||t.includes('start code')||t.includes('end code')||t.includes('start trip')||t.includes('start ride')||t.includes('verification')?{category:'OTP PROTOCOL',text:"\ud83d\udd11 Start Trip & End OTP Verification Protocol:\n\n1. \ud83d\udcf2 Start Trip OTP (4 Digits):\n\u2022 Visible on the passenger's app home screen and sent to their registered mobile via SMS.\n\u2022 Ask the passenger for the code when you meet at the pickup location.\n\u2022 Enter the 4 digits in Duty Dashboard before starting navigation.\n\n2. \ud83c\udfc1 End Trip OTP:\n\u2022 At destination, enter any actual Fastag toll receipts and extra km in the app.\n\u2022 Verify the End OTP with passenger to close the duty sheet and unlock payments.\n\n3. \u26a0\ufe0f Troubleshooting OTP:\n\u2022 If passenger did not get SMS: Tap 'Resend OTP' on driver duty screen.\n\u2022 Check if passenger mobile has signal.\n\u2022 In extreme network outage: Contact Dispatch Desk for verified instant override.",action_chips:['\ud83c\udd7f\ufe0f 3. Toll & Parking Rules','\u23f3 4. Waiting Time Policy','\ud83c\udfa7 Contact Dispatch Desk']}:o||t.includes('toll')||t.includes('fastag')||t.includes('parking')||t.includes('permit')||t.includes('sunga')||t.includes('sungam')?{category:'TOLLS & FASTAG',text:"\ud83c\udd7f\ufe0f Fastag Toll, Parking & Permit Collection Rules:\n\n\u2022 \ud83d\udee3\ufe0f Fastag Toll Plazas: All National and State Highway tolls are 100% payable by the customer as per actual receipts.\n\u2022 \ud83d\ude97 Parking Charges: Airport entry, railway station parking, or commercial parking tickets are reimbursed by customer.\n\u2022 \ud83c\udfdb\ufe0f Inter-State Road Permits: State entrance tax (e.g. Tamil Nadu \u2794 Karnataka / Kerala / AP) is billed directly to the customer.\n\n\ud83d\udccb How to Log Tolls at Trip End:\n1. Keep Fastag SMS or plaza slips handy.\n2. In the 'Close Duty' screen, enter the exact total toll amount.\n3. The amount is automatically added to customer final bill and credited to you.",action_chips:['\ud83d\udcb0 1. Calculate Fare','\ud83d\udd11 2. Start Trip OTP','\ud83d\udcb3 5. Wallet Security Hold']}:l||t.includes('wait')||t.includes('delay')||t.includes('late')||t.includes('not reachable')||t.includes('unresponsive')||t.includes('waiting charge')?{category:'WAITING & DELAY',text:"\u23f3 Passenger Delay & Waiting Time Policy:\n\n\u2022 \u23f1\ufe0f Free Waiting Period: 15 minutes from the scheduled trip start time.\n\u2022 \ud83d\udcb5 Waiting Charges (after 15 mins):\n  - Sedan: \u20b92.00 / minute (\u20b9120 / hour)\n  - SUV / Innova: \u20b92.50 / minute (\u20b9150 / hour)\n\n\ud83d\udccd Unreachable Customer Protocol:\n1. Send an in-app message (\"I have reached the pickup location\").\n2. Call passenger via the masked in-app line.\n3. If passenger does not arrive after 15 minutes, tap 'Report Issue \u2794 Waiting Delay'.\n4. Platform logs GPS timestamp and adds verified waiting fee to customer invoice.",action_chips:['\ud83d\udccd Reached Pickup Point','\u26a0\ufe0f 6. Cancellation Rules','\ud83c\udfa7 Contact Dispatch Desk']}:s||t.includes('wallet')||t.includes('hold')||t.includes('security')||t.includes('payout')||t.includes('settlement')||t.includes('panam')||t.includes('balance')?{category:'FINANCIAL CORE',text:"\ud83d\udcb3 Wallet Security Hold, Payouts & Balance Policy:\n\n\u2022 \ud83d\udd12 Refundable Security Hold (\u20b9500):\n  - Reserved temporarily when an active booking is accepted to guarantee dispatch reliability.\n  - Automatically and instantly released back to your Available Balance the second the trip is completed via End OTP.\n\n\u2022 \ud83c\udfe6 Partner Settlements:\n  - Weekly automated bank settlements disbursed every Monday directly to your registered bank account.\n  - Instant on-demand payouts available via Wallet \u2794 Withdraw.\n\n\u2022 \ud83d\udca1 Pro Tip: Maintain at least \u20b91,000 wallet balance so high-demand outstation rides are instantly assigned to you without delay.",action_chips:['\u2795 Recharge Wallet','\u26a0\ufe0f 6. Cancellation Fine','\ud83d\udcb0 1. Tariff Rates']}:d||t.includes('cancel')||t.includes('penalty')||t.includes('500')||t.includes('fine')||t.includes('decline')||t.includes('abaraatham')?{category:'CANCELLATION & PENALTY',text:"\u26a0\ufe0f Cancellation Rules & \u20b9500 Operational Penalty:\n\n1. \u23f1\ufe0f 10-Second HUD Alert Decline:\n\u2022 Declining an incoming ride during the 10-second HUD broadcast is 100% FREE (\u20b90 penalty, zero impact on partner score).\n\n2. \ud83d\udeab Post-Assignment Partner Cancellation:\n\u2022 Once a ride is accepted and assigned to a driver/car, partner cancellations incur a \u20b9500 operational penalty deducted from wallet to cover emergency passenger reassignment.\n\n3. \ud83d\udcb5 Customer Cancellation:\n\u2022 If the passenger cancels after you arrive at pickup, the platform charges the customer and credits the cancellation fee directly to your driver wallet.",action_chips:['\ud83d\udcb3 5. Wallet Balance','\u23f3 4. Waiting Policy','\ud83c\udfa7 Contact Dispatch Desk']}:c||t.includes('bata')||t.includes('allowance')||t.includes('night')||t.includes('stay')||t.includes('halt')||t.includes('beta')?{category:'DRIVER ALLOWANCE',text:"\ud83c\udf19 Driver Bata & Night Halt Allowances:\n\n\u2022 \u2600\ufe0f Day Driver Bata: \u20b9300 per day (06:00 AM - 10:00 PM).\n\u2022 \ud83c\udf19 Night Driver Bata: \u20b9400 per night (for duty running between 10:00 PM and 06:00 AM).\n\u2022 \ud83c\udfe8 Outstation Multi-Day Halt: \u20b9500/night halt allowance when passenger requires the vehicle overnight on outstation trips.\n\n\u2022 Digital Trip Sheet: All allowances are computed automatically based on trip start and completion timestamps.",action_chips:['\ud83d\udcb0 1. Standard Tariffs','\ud83c\udd7f\ufe0f 3. Toll Rules','\ud83c\udfa7 Contact Dispatch Desk']}:u||t.includes('hud')||t.includes('sound')||t.includes('alert')||t.includes('audio')||t.includes('broadcast')||t.includes('10 second')?{category:'HUD DISPATCH',text:"\ud83d\udce1 Drop Cars Urgent HUD Dispatch & Sound Alerts:\n\n\u2022 \ud83d\udd0a Urgent Audio Broadcast: When a ride matching your car segment and route appears, your app sounds a high-priority 10-second alert.\n\u2022 \u26a1 10-Second Acceptance Window: You have 10 seconds to review the route, estimated payout, and tap 'ACCEPT'.\n\u2022 \ud83d\udd14 Ensure Sound is Active: Turn phone media volume up and keep Drop Cars notifications enabled in phone settings.\n\u2022 \ud83d\ude97 Route Requests vs Direct HUD: Route Requests give advance confirmed bookings; Direct HUD is for instant broadcasts.",action_chips:['\u26a1 View Route Requests','\ud83d\udcb0 1. Tariff Rates','\ud83c\udfa7 Contact Dispatch Desk']}:h||t.includes('sos')||t.includes('emergency')||t.includes('accident')||t.includes('breakdown')||t.includes('police')||t.includes('ambulance')||t.includes('dispatch')||t.includes('agent')||t.includes('support')?{category:'EMERGENCY SOS',text:"\ud83d\udea8 24/7 Emergency SOS & Central Operations Desk:\n\n\u2022 \ud83d\ude97 Vehicle Breakdown: Tap 'Emergency SOS' in Duty dashboard. Drop Cars Dispatch will coordinate a replacement cab within 30-45 minutes.\n\u2022 \ud83c\udfe5 Accident / Medical Help: Dial 108 (Ambulance) / 112 (Police) immediately.\n\u2022 \ud83c\udfa7 For anything else, open Drop Cars Admin / Support and tap 'Talk to a person now' to reach whoever is on duty.",action_chips:['\ud83c\udfa7 Open Admin / Support','\ud83d\udccd Share GPS Coordinates']}:{category:'GREETING',text:"\ud83d\udc4b Drop Cars Help Bot\nInstant answers for drivers, 24/7\n\nType a number (1\u20139) or tap an option below:\n\n1. \ud83d\udcb0 Tariff & Distance Rates\n2. \ud83d\udd11 Start Trip & End OTP\n3. \ud83c\udd7f\ufe0f Fastag & Toll Rules\n4. \u23f3 Delay & Waiting Time\n5. \ud83d\udcb3 Wallet Hold & Settlements\n6. \u26a0\ufe0f Cancellation & \u20b9500 Penalty\n7. \ud83c\udf19 Driver Bata (Day \u20b9300 / Night \u20b9400)\n8. \ud83d\udce1 HUD Auto-Matching\n9. \ud83d\udea8 Emergency SOS & Dispatch\n\n\ud83d\udca1 You can also type a route like \"Chennai to Madurai\", or ask in Tamil.",action_chips:['\ud83d\udcb0 1. Calculate Fare','\ud83d\udd11 2. How to get Start OTP?','\ud83c\udd7f\ufe0f 3. Toll Rules','\u23f3 4. Waiting Policy','\u26a0\ufe0f 6. \u20b9500 Penalty Policy']}}function B(e){var t,r=e.uri,a=e.mine,i=e.tint,n=(0,S.useAudioPlayer)(r),l=(0,S.useAudioPlayerStatus)(n)
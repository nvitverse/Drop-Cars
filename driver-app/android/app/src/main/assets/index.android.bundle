30 \u0916\u094b\u091c \u0930\u0939\u093e \u0939\u0948","Live reverse-bidding system where customers post trip requests with their expected fare, and drivers/fleet owners place custom price bids.":"\u0932\u093e\u0907\u0935 \u0930\u093f\u0935\u0930\u094d\u0938-\u092c\u093f\u0921\u093f\u0902\u0917 \u0938\u093f\u0938\u094d\u091f\u092e \u091c\u0939\u093e\u0901 \u0917\u094d\u0930\u093e\u0939\u0915 \u0905\u092a\u0928\u0947 \u0905\u092a\u0947\u0915\u094d\u0937\u093f\u0924 \u0915\u093f\u0930\u093e\u092f\u0947 \u0915\u0947 \u0938\u093e\u0925 \u091f\u094d\u0930\u093f\u092a \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930/\u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u0905\u092a\u0928\u0940 \u0915\u0940\u092e\u0924 \u0915\u0940 \u092c\u094b\u0932\u0940 \u0932\u0917\u093e\u0924\u0947 \u0939\u0948\u0902\u0964","LIVE SEAT SHARING \u2022 INSTANT JOIN":"\u0932\u093e\u0907\u0935 \u0938\u0940\u091f \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u093e \u2022 \u0924\u0941\u0930\u0902\u0924 \u091c\u0941\u0921\u093c\u0947\u0902","Live Status":"\u0932\u093e\u0907\u0935 \u0938\u094d\u0925\u093f\u0924\u093f","Loading complete booking details...":"\u092a\u0942\u0930\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948...","Loading dashboard...":"\u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u093e \u0939\u0948...","Loading Duty Profile...":"\u0921\u094d\u092f\u0942\u091f\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948...","Loading fleet vacant statuses...":"\u092b\u094d\u0932\u0940\u091f \u0915\u0940 \u0916\u093e\u0932\u0940 \u0938\u094d\u0925\u093f\u0924\u093f\u092f\u093e\u0901 \u0932\u094b\u0921 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\u09
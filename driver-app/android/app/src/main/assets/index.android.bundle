\u0c40.:","End odometer photo":"\u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c13\u0c21\u0c4b\u0c2e\u0c40\u0c1f\u0c30\u0c4d \u0c2b\u0c4b\u0c1f\u0c4b","End OTP:":"\u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41 OTP:","End speedometer image is required to end trip":"\u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d \u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c38\u0c4d\u0c2a\u0c40\u0c21\u0c4b\u0c2e\u0c40\u0c1f\u0c30\u0c4d \u0c2b\u0c4b\u0c1f\u0c4b \u0c05\u0c35\u0c38\u0c30\u0c02","Enter 10-digit mobile number (e.g. 9876543210)":"10 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f (\u0c09\u0c26\u0c3e. 9876543210)","Enter 6-digit code":"6 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c15\u0c4b\u0c21\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Enter 6-Digit Email Code":"6 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Enter a positive number of kilometers":"\u0c38\u0c30\u0c48\u0c28 \u0c15\u0c3f\u0c32\u0c4b\u0c2e\u0c40\u0c1f\u0c30\u0c4d\u0c32 \u0c38\u0c02\u0c16\u0c4d\u0c2f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Enter a referral code":"\u0c30\u0c46\u0c2b\u0c30\u0c32\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Enter a valid 10-digit alternate mobile number starting with 6-9":"6-9 \u0c24\u0c4b \u0c2e\u0c4a\u0c26\u0c32\u0c2f\u0c4d\u0c2f\u0c47 \u0c38\u0c30\u0c48\u0c28 10 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c3e\u0c2e\u0c4d\u0c28\u0c3e\u0c2f \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Enter a valid 10-digit mobile number starting with 6-9":"6-9 \u0c24\u0c4b \
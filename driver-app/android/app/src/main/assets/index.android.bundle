1\u0cbf","Please select a Cab from your registered fleet before submitting.":"\u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0c95\u0ccd\u0caf\u0cbe\u0cac\u0ccd \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.","Could not submit this offer.":"\u0c88 \u0c86\u0cab\u0cb0\u0ccd \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","Could not respond to this counter offer.":"\u0c88 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf-\u0c86\u0cab\u0cb0\u0ccd\u200c\u0c97\u0cc6 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cbf\u0cb8\u0cb2\u0cc1 \u0c86\u0c97\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2.","\u26a1 Newest Requests First":"\u26a1 \u0cb9\u0cca\u0cb8 \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0c97\u0cb3\u0cc1 \u0cae\u0cca\u0ca6\u0cb2\u0cc1","\ud83d\udcb0 Fare: High to Low":"\ud83d\udcb0 \u0ca6\u0cb0: \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8\u0cbf\u0c82\u0ca6 \u0c95\u0ca1\u0cbf\u0cae\u0cc6","\ud83c\udff7\ufe0f Fare: Low to High":"\ud83c\udff7\ufe0f \u0ca6\u0cb0: \u0c95\u0ca1\u0cbf\u0cae\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1","\ud83d\udee3\ufe0f KM Limit: Longest First":"\ud83d\udee3\ufe0f \u0c95\u0cbf.\u0cae\u0cc0. \u0cae\u0cbf\u0ca4\u0cbf: \u0c89\u0ca6\u0ccd\u0ca6\u0ca6\u0ccd\u0ca6\u0cc1 \u0cae\u0cca\u0ca6\u0cb2\u0cc1","\ud83d\ude97 All Car Categories & Models":"\ud83d\ude97 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c95\u0cbe\u0cb0\u0cc1 \u0cb5\u0cb0\u0ccd\u0c97 & \u0cae\u0cbe\u0ca6\u0cb0\u0cbf\u0c97\u0cb3\u0cc1","\ud83d\ude97 Category: {category}":"\ud83d\ude97 \u0cb5\u0cb0\u0ccd\u0c97: {category}","\ud83d\ude97 All Car Categories":"\ud83d\ude97 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c95\u0cbe\u0cb0\u0cc1 \u0cb5\u0cb0\u0ccd\u0c97\u0c97\u0cb3\u0cc1","1. Route & Intermediate Stops":"1. \u0cae\u0cbe\
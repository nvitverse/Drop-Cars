094d\u091c \u0915\u0930\u0947\u0902","Enter amount (e.g. 1000)":"\u0930\u093e\u0936\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 1000)","Enter at least a bank account or UPI ID before saving":"\u0938\u0947\u0935 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u092e \u0938\u0947 \u0915\u092e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u092f\u093e UPI ID \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter at least a bank account, UPI Number, or UPI ID before saving":"\u0938\u0947\u0935 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u092e \u0938\u0947 \u0915\u092e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e, UPI \u0928\u0902\u092c\u0930 \u092f\u093e UPI ID \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter bank account details or UPI ID for instant payout settlements.":"\u0924\u0941\u0930\u0902\u0924 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u092f\u093e UPI ID \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Enter bank account number":"\u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0938\u0902\u0916\u094d\u092f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter driver password":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter Driving Licence Number":"\u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter full name":"\u092a\u0942\u0930\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter full name as on licence":"\u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u092a\u0930 \u0932\u093f\u0916\u093e \u092a\u0942\u0930\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter mobile number":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter New Total Fare (\u20b9)":"\u0928\u092f\u093e \u0915\u0941\u0932 \u0915\u093f\u0930\u093e\u092f\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 (\u20b9)","Enter OTP":"OTP \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter password":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter referral code":"\u0930\u0947\u092b\u093c\u0930\u0932 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter the 6-digit code sent to your email":"\u0906\u092a\u0915\u0947 \u0908\u092e\u0947\u0932 \u092a\u0930 \u092d\u0947\u091c\u093e \u0917\u092f\u093e 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter the 6-digit code sent to your email and set your new password.":"\u0906\u092a\u0915\u0947 \u0908\u092e\u0947\u0932 \u092a\u0930 \u092d\u0947\u091c\u093e \u0917\u092f\u093e 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u0914\u0930 \u0928\u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964","Enter the 6-digit code sent to your saved email, and set your new password.":"\u0938\u0947\u0935 \u0915\u093f\u090f \u0917\u090f \u0908\u092e\u0947\u0932 \u092a\u0930 \u092d\u0947\u091c\u093e \u0917\u092f\u093e 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u0914\u0930 \u0928\u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964","Enter the 6-digit code sent to your saved email, and your new password.":"\u0938\u0947\u0935 \u0915\u093f\u090f \u0917\u090f \u0908\u092e\u0947\u0932 \u092a\u0930 \u092d\u0947\u091c\u093e \u0917\u092f\u093e 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u0914\u0930 \u0928\u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Enter the exact full name as printed on the driving licence to ensure auto-verification succeeds.":"\u0911\u091f\u094b-\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0938\u092b\u0932 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u092a\u0930 \u091b\u092a\u093e \u0939\u0941\u0906 \u0920\u0940\u0915 \u0935\u0939\u0940 \u092a\u0942\u0930\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Enter UPI ID (e.g. driver@upi / 9876543210@ybl)":"UPI ID \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 driver@upi / 9876543210@ybl)","Enter your current password to confirm":"\u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Enter your new 10-digit mobile number. Drop Cars Admin will review & verify your request.":"\u0905\u092a\u0928\u093e \u0928\u092f\u093e 10 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964 Drop Cars \u090f\u0921\u092e\u093f\u0928 \u0906\u092a\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902\u0917\u0947\u0964","Enter your new number and current password to confirm.":"\u0905\u092a\u0928\u093e \u0928\u092f\u093e \u0928\u0902\u092c\u0930 \u0914\u0930 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0915\u0947 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902\u0964","Enter your official name as printed on your Aadhaar or PAN card. Name updates require Admin Review.":"\u0906\u0927\u093e\u0930 \u092f\u093e PAN \u0915\u093e\u0930\u094d\u0921 \u092a\u0930 \u091b\u092a\u093e \u0939\u0941\u0906 \u0905\u092a\u0928\u093e \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964 \u0928\u093e\u092e \u092c\u0926\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0921\u092e\u093f\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964","Enter your registered fleet, agency, or business name. Updates require Admin Review.":"\u0905\u092a\u0928\u093e \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092b\u094d\u0932\u0940\u091f, \u090f\u091c\u0947\u0902\u0938\u0940 \u092f\u093e \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u0915\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964 \u092c\u0926\u0932\u093e\u0935 \u0915\u0947 \u0932\u093f\u090f \u090f\u0921\u092e\u093f\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964","Enter your registered mobile number to receive a 6-digit reset code via Email.":"\u0908\u092e\u0947\u0932 \u092a\u0930 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0930\u0940\u0938\u0947\u091f \u0915\u094b\u0921 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Error:":"\u0924\u094d\u0930\u0941\u091f\u093f:","Error: {0}":"\u0924\u094d\u0930\u0941\u091f\u093f: {0}","Estimated Time":"\u0905\u0928\u0941\u092e\u093e\u0928\u093f\u0924 \u0938\u092e\u092f","Estimated Time (optional)":"\u0905\u0928\u0941\u092e\u093e\u0928\u093f\u0924 \u0938\u092e\u092f (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)","Every trip you accepted from the Drop Cars booking market, from acceptance to completion, in one place.":"Drop Cars \u092c\u0941\u0915\u093f\u0902\u0917 \u092e\u093e\u0930\u094d\u0915\u0947\u091f \u0938\u0947 \u0906\u092a\u0915\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0940 \u0939\u0930 \u091f\u094d\u0930\u093f\u092a, \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0942\u0930\u0940 \u0939\u094b\u0928\u0947 \u0924\u0915, \u090f\u0915 \u0939\u0940 \u091c\u0917\u0939\u0964","Exact Door No, Destination Landmark or Maps link":"\u0938\u0939\u0940 \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0928\u0902\u092c\u0930, \u0917\u0902\u0924\u0935\u094d\u092f \u0932\u0948\u0902\u0921\u092e\u093e\u0930\u094d\u0915 \u092f\u093e Maps \u0932\u093f\u0902\u0915","Exact Door No, Street, Landmark or Maps link":"\u0938\u0939\u0940 \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0928\u0902\u092c\u0930, \u0917\u0932\u0940, \u0932\u0948\u0902\u0921\u092e\u093e\u0930\u094d\u0915 \u092f\u093e Maps \u0932\u093f\u0902\u0915",Exclusive:"\u0935\u093f\u0936\u0947\u0937","Exclusive for Trusted Partners \u2022 Auto-matches incoming trips":"\u0938\u093f\u0930\u094d\u092b\u093c \u091f\u094d\u0930\u0938\u094d\u091f\u0947\u0921 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u2022 \u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u091f\u094d\u0930\u093f\u092a \u0905\u092a\u0928\u0947 \u0906\u092a \u092e\u0948\u091a \u0939\u094b\u0924\u0940 \u0939\u0948\u0902","Exclusive Partner":"\u0935\u093f\u0936\u0947\u0937 \u092a\u093e\u0930\u094d\u091f\u0928\u0930",Executed:"\u0928\u093f\u0937\u094d\u092a\u093e\u0926\u093f\u0924","Expected: \u20b9":"\u0905\u092a\u0947\u0915\u094d\u0937\u093f\u0924: \u20b9",Expired:"\u0938\u092e\u092f \u0938\u092e\u093e\u092a\u094d\u0924","Expires {0}":"{0} \u0915\u094b \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u093e","Expiry Date Required":"\u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0924\u093f\u0925\u093f \u091c\u093c\u0930\u0942\u0930\u0940","Explain the reason for correction. Drop Cars verification team will review your request.":"\u0938\u0941\u0927\u093e\u0930 \u0915\u093e \u0915\u093e\u0930\u0923 \u092c\u0924\u093e\u090f\u0901\u0964 Drop Cars \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u091f\u0940\u092e \u0906\u092a\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0917\u0940\u0964","Explain why you are requesting this change (e.g. business name update, new mobile number)":"\u0907\u0938 \u092c\u0926\u0932\u093e\u0935 \u0915\u093e \u0915\u093e\u0930\u0923 \u092c\u0924\u093e\u090f\u0901 (\u091c\u0948\u0938\u0947 \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u0915\u093e \u0928\u093e\u092e \u092c\u0926\u0932\u0928\u093e, \u0928\u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930)","Explore App Configuration":"\u0910\u092a \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930\u0947\u0936\u0928 \u0926\u0947\u0916\u0947\u0902","Explore App Features":"\u0910\u092a \u0915\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 \u0926\u0947\u0916\u0947\u0902","extra charges listed above":"\u090a\u092a\u0930 \u0938\u0942\u091a\u0940\u092c\u0926\u094d\u0927 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0936\u0941\u0932\u094d\u0915","Extra charges paid directly (not part of the trip total)":"\u0938\u0940\u0927\u0947 \u091a\u0941\u0915\u093e\u090f \u0917\u090f \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0936\u0941\u0932\u094d\u0915 (\u091f\u094d\u0930\u093f\u092a \u0915\u0941\u0932 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0928\u0939\u0940\u0902)","Extra Driver Allowance (Vendor)":"\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092d\u0924\u094d\u0924\u093e (\u0935\u0947\u0902\u0921\u0930)","Face Match Check":"\u091a\u0947\u0939\u0930\u093e \u092e\u093f\u0932\u093e\u0928 \u091c\u093e\u0901\u091a","Failed to accept booking. Please try again.":"\u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Failed to add money":"\u092a\u0948\u0938\u0947 \u091c\u094b\u0921\u093c \u0928\u0939\u0940\u0902 \u0938\u0915\u0947","Failed to assign cab and driver.":"\u0915\u0948\u092c \u0914\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0905\u0938\u093e\u0907\u0928 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0947\u0964","Failed to create Razorpay order":"Razorpay \u0911\u0930\u094d\u0921\u0930 \u0928\u0939\u0940\u0902 \u092c\u0928 \u0938\u0915\u093e","Failed to deduct money":"\u092a\u0948\u0938\u0947 \u0915\u093e\u091f\u0947 \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0947","Failed to delete car driver":"\u0915\u093e\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0939\u091f\u093e\u092f\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e","Failed to fetch car driver":"\u0915\u093e\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u093e","Failed to fetch car driver by mobile":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0947 \u0915\u093e\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u093e","Failed to fetch cars: {0}":"\u0917\u093e\u0921\u093c\u093f\u092f\u093e\u0901 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0940\u0902: {0}","Failed to fetch completed orders":"\u092a\u0942\u0930\u0947 \u0939\u0941\u090f \u0911\u0930\u094d\u0921\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0947","Failed to fetch dashboard data":"\u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u093e","Failed to fetch drivers by vehicle owner":"\u0935\u093e\u0939\u0928 \u092e\u093e\u0932\u093f\u0915 \u0915\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0947","Failed to fetch drivers: {0}":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0947: {0}","Failed to fetch future rides":"\u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u091f\u094d\u0930\u093f\u092a \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0940\u0902","Failed to fetch pending orders":"\u0932\u0902\u092c\u093f\u0924 \u0911\u0930\u094d\u0921\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0947","Failed to fetch Rides":"\u091f\u094d\u0930\u093f\u092a \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0940\u0902","Failed to fetch vehicle owner details":"\u0935\u093e\u0939\u0928 \u092e\u093e\u0932\u093f\u0915 \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u093e","Failed to get Expo token":"Expo \u091f\u094b\u0915\u0928 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u093e","Failed to get push notification token":"\u092a\u0941\u0936 \u0928\u094b\u091f\u093f\u092b\u093c\u093f\u0915\u0947\u0936\u0928 \u091f\u094b\u0915\u0928 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u093e","Failed to get token":"\u091f\u094b\u0915\u0928 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u093e","Failed to get tokens":"\u091f\u094b\u0915\u0928 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0947","Failed to load drivers and vehicles.":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0914\u0930 \u0917\u093e\u0921\u093c\u093f\u092f\u093e\u0901 \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940\u0902\u0964","Failed to process payment. Please try again.":"\u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Failed to refresh user data":"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0921\u0947\u091f\u093e \u0930\u093f\u092b\u093c\u094d\u0930\u0947\u0936 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","Failed to remove vacant status. Please try again.":"\u0916\u093e\u0932\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0939\u091f\u093e\u0908 \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0940\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Failed to renew vacant status.":"\u0916\u093e\u0932\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u093e \u0928\u0935\u0940\u0928\u0940\u0915\u0930\u0923 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964","Failed to retrieve user profile: {0}":"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u0940: {0}","Failed to save authentication data":"\u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0921\u0947\u091f\u093e \u0938\u0947\u0935 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","Failed to search drivers":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0916\u094b\u091c\u0947 \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0947","Failed to select image photo.":"\u092b\u094b\u091f\u094b \u091a\u0941\u0928\u0940 \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0940\u0964","Failed to send request. Please try again.":"\u0905\u0928\u0941\u0930\u094b\u0927 \u092d\u0947\u091c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Failed to send test notification":"\u091f\u0947\u0938\u094d\u091f \u0928\u094b\u091f\u093f\u092b\u093c\u093f\u0915\u0947\u0936\u0928 \u092d\u0947\u091c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e","Failed to send verification email.":"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0908\u092e\u0947\u0932 \u092d\u0947\u091c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e\u0964","Failed to send verification email. Please try again.":"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0908\u092e\u0947\u0932 \u092d\u0947\u091c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Failed to set driver offline":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u094b \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0947","Failed to set driver online":"\u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u094b \u0911\u0928\u0932\u093e\u0907\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0947","Failed to set offline: {0}":"\u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0947: {0}","Failed to set online: {0}":"\u0911\u0928\u0932\u093e\u0907\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0947: {0}","Failed to sign in car driver":"\u0915\u093e\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0938\u093e\u0907\u0928 \u0907\u0928 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","Failed to sign up car driver":"\u0915\u093e\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0938\u093e\u0907\u0928 \u0905\u092a \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e","Failed to update car driver profile":"\u0915\u093e\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0940","Failed to upload document. Please try again.":"\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0905\u092a\u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964","Fare as posted (estimate)":"\u092a\u094b\u0938\u094d\u091f \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0915\u093f\u0930\u093e\u092f\u093e (\u0905\u0928\u0941\u092e\u093e\u0928)","Fare Breakdown & Pricing":"\u0915\u093f\u0930\u093e\u092f\u093e \u0935\u093f\u0935\u0930\u0923 \u0914\u0930 \u0915\u0940\u092e\u0924","Fare details":"\u0915\u093f\u0930\u093e\u092f\u093e \u0935\u093f\u0935\u0930\u0923","Fare for Booking #{0} updated to \u20b9{1} and re-broadcasted to nearby drivers!":"\u092c\u0941\u0915\u093f\u0902\u0917 #{0} \u0915\u093e \u0915\u093f\u0930\u093e\u092f\u093e \u20b9{1} \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0914\u0930 \u092a\u093e\u0938 \u0915\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u094b \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u0938\u093e\u0930\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e!","Fare Inclusions (Optional)":"\u0915\u093f\u0930\u093e\u092f\u0947 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)","Fare Price Increased! \u26a1":"\u0915\u093f\u0930\u093e\u092f\u093e \u092c\u0922\u093c\u093e! \u26a1","Final Agreed Fare":"\u0905\u0902\u0924\u093f\u092e \u0924\u092f \u0915\u093f\u0930\u093e\u092f\u093e","Final amount: \u20b9":"\u0905\u0902\u0924\u093f\u092e \u0930\u093e\u0936\u093f: \u20b9","Final fare includes all trip charges. No extra km rate deductions.":"\u0905\u0902\u0924\u093f\u092e \u0915\u093f\u0930\u093e\u092f\u0947 \u092e\u0947\u0902 \u091f\u094d\u0930\u093f\u092a \u0915\u0947 \u0938\u092d\u0940 \u0936\u0941\u0932\u094d\u0915 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0915\u093f\u092e\u0940 \u0926\u0930 \u0915\u0940 \u0915\u091f\u094c\u0924\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u0940\u0964","Final trip amount (customer)":"\u0905\u0902\u0924\u093f\u092e \u091f\u094d\u0930\u093f\u092a \u0930\u093e\u0936\u093f (\u0917\u094d\u0930\u093e\u0939\u0915)","Fitness (FC)":"\u092b\u093c\u093f\u091f\u0928\u0947\u0938 (FC)","Fleet Car":"\u092b\u094d\u0932\u0940\u091f \u0915\u093e\u0930","Fleet Driver Account":"\u092b\u094d\u0932\u0940\u091f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0916\u093e\u0924\u093e","Fleet owner":"\u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915","Fleet owner on duty":"\u0921\u094d\u092f\u0942\u091f\u0940 \u092a\u0930 \u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915","Fleet Owner Portal":"\u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u092a\u094b\u0930\u094d\u091f\u0932","Fleet Partner:":"\u092b\u094d\u0932\u0940\u091f \u092a\u093e\u0930\u094d\u091f\u0928\u0930:","Fleet Status":"\u092b\u094d\u0932\u0940\u091f \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f","Fleet Vacant Cities":"\u092b\u094d\u0932\u0940\u091f \u0915\u0947 \u0916\u093e\u0932\u0940 \u0936\u0939\u0930","For password reset - verified with a code":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0930\u0940\u0938\u0947\u091f \u0915\u0947 \u0932\u093f\u090f - \u0915\u094b\u0921 \u0938\u0947 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924","For the ~{0} km route between {1} and {2}, the maximum seat contribution cap is \u20b9{3} to keep seat sharing fair and affordable.":"{1} \u0914\u0930 {2} \u0915\u0947 \u092c\u0940\u091a ~{0} \u0915\u093f\u092e\u0940 \u0915\u0947 \u0930\u093e\u0938\u094d\u0924\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0938\u0940\u091f \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u093e \u0909\u091a\u093f\u0924 \u0914\u0930 \u0915\u093f\u092b\u093c\u093e\u092f\u0924\u0940 \u0930\u0916\u0928\u0947 \u0939\u0947\u0924\u0941 \u0905\u0927\u093f\u0915\u0924\u092e \u0938\u0940\u091f \u092f\u094b\u0917\u0926\u093e\u0928 \u20b9{3} \u0939\u0948\u0964",From:"\u0938\u0947","Front Side":"\u0906\u0917\u0947 \u0915\u0940 \u0924\u0930\u092b\u093c","Front side of Aadhaar":"\u0906\u0927\u093e\u0930 \u0915\u0940 \u0906\u0917\u0947 \u0915\u0940 \u0924\u0930\u092b\u093c","Front Side Photo":"\u0906\u0917\u0947 \u0915\u0940 \u0924\u0930\u092b\u093c \u0915\u0940 \u092b\u094b\u091f\u094b","FRONT SIDE PHOTO":"\u0906\u0917\u0947 \u0915\u0940 \u0924\u0930\u092b\u093c \u0915\u0940 \u092b\u094b\u091f\u094b","Front View Photo":"\u0938\u093e\u092e\u0928\u0947 \u0915\u0947 \u0926\u0943\u0936\u094d\u092f \u0915\u0940 \u092b\u094b\u091f\u094b","full \u20b9{0}":"\u092a\u0942\u0930\u093e \u20b9{0}","Full Name":"\u092a\u0942\u0930\u093e \u0928\u093e\u092e","Full Name (Per Govt ID)":"\u092a\u0942\u0930\u093e \u0928\u093e\u092e (\u0938\u0930\u0915\u093e\u0930\u0940 ID \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930)",Gallery:"\u0917\u0948\u0932\u0930\u0940","GENERATING...":"\u092c\u0928 \u0930\u0939\u093e \u0939\u0948...","Get help and support":"\u0938\u0939\u093e\u092f\u0924\u093e \u0914\u0930 \u0938\u092a\u094b\u0930\u094d\u091f \u092a\u093e\u090f\u0901","Get notified about new trips":"\u0928\u0908 \u091f\u094d\u0930\u093f\u092a \u0915\u0940 \u0938\u0942\u091a\u0928\u093e \u092a\u093e\u090f\u0901","Go Off Duty":"\u0921\u094d\u092f\u0942\u091f\u0940 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902","Go on duty & execute assigned rides":"\u0921\u094d\u092f\u0942\u091f\u0940 \u092a\u0930 \u0906\u090f\u0901 \u0914\u0930 \u0905\u0938\u093e\u0907\u0928 \u0915\u0940 \u0917\u0908 \u091f\u094d\u0930\u093f\u092a \u092a\u0942\u0930\u0940 \u0915\u0930\u0947\u0902","Go On Duty for Live Bookings":"\u0932\u093e\u0907\u0935 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0921\u094d\u092f\u0942\u091f\u0940 \u092a\u0930 \u0906\u090f\u0901","Go online to start receiving and accepting new duty bookings.":"\u0928\u0908 \u0921\u094d\u092f\u0942\u091f\u0940 \u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u093e\u0928\u0947 \u0914\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0911\u0928\u0932\u093e\u0907\u0928 \u091c\u093e\u090f\u0901\u0964","Go to Booking & Accept":"\u092c\u0941\u0915\u093f\u0902\u0917 \u092a\u0930 \u091c\u093e\u090f\u0901 \u0914\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902","Go to home screen!":"\u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u091c\u093e\u090f\u0901!","Go to the duty-driver side of the app":"\u0910\u092a \u0915\u0947 \u0921\u094d\u092f\u0942\u091f\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0935\u093e\u0932\u0947 \u0939\u093f\u0938\u094d\u0938\u0947 \u092e\u0947\u0902 \u091c\u093e\u090f\u0901","Got It":"\u0938\u092e\u091d \u0917\u092f\u093e","Got It, Refresh List":"\u0938\u092e\u091d \u0917\u092f\u093e, \u0938\u0942\u091a\u0940 \u0930\u093f\u092b\u093c\u094d\u0930\u0947\u0936 \u0915\u0930\u0947\u0902","Got it!":"\u0938\u092e\u091d \u0917\u092f\u093e!","Got It!":"\u0938\u092e\u091d \u0917\u092f\u093e!","Govt Photo ID Verification":"\u0938\u0930\u0915\u093e\u0930\u0940 \u092b\u094b\u091f\u094b ID \u0938\u0924\u094d\u092f\u093e\u092a\u0928","Guest Rider":"\u0905\u0924\u093f\u0925\u093f \u092f\u093e\u0924\u094d\u0930\u0940",Hatchback:"\u0939\u0948\u091a\u092c\u0948\u0915","Hatchback (Swift, i10, WagonR)":"\u0939\u0948\u091a\u092c\u0948\u0915 (Swift, i10, WagonR)","Have a referral code? Enter it here":"\u0930\u0947\u092b\u093c\u0930\u0932 \u0915\u094b\u0921 \u0939\u0948? \u092f\u0939\u093e\u0901 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Have a referrer code?":"\u0930\u0947\u092b\u093c\u0930\u0930 \u0915\u094b\u0921 \u0939\u0948?","Help Bot":"\u0939\u0947\u0932\u094d\u092a \u092c\u0949\u091f","HELP BOT":"\u0939\u0947\u0932\u094d\u092a \u092c\u0949\u091f","Help Bot for instant duty answers, plus a real chat with whoever posted each trip (a vendor, another fleet owner, or Drop Cars Admin) and quick ways to reach or call the customer.":"\u0921\u094d\u092f\u0942\u091f\u0940 \u0915\u0947 \u0924\u0941\u0930\u0902\u0924 \u091c\u0935\u093e\u092c \u0915\u0947 \u0932\u093f\u090f \u0939\u0947\u0932\u094d\u092a \u092c\u0949\u091f, \u0938\u093e\u0925 \u0939\u0940 \u0939\u0930 \u091f\u094d\u0930\u093f\u092a \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 (\u0935\u0947\u0902\u0921\u0930, \u0926\u0942\u0938\u0930\u0947 \u092b\u094d\u0932\u0940\u091f \u092e\u093e\u0932\u093f\u0915 \u092f\u093e Drop Cars \u090f\u0921\u092e\u093f\u0928) \u0938\u0947 \u0938\u0940\u0927\u0940 \u091a\u0948\u091f \u0914\u0930 \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0947 \u0906\u0938\u093e\u0928 \u0924\u0930\u0940\u0915\u0947\u0964","Help Bot is typing...":"\u0939\u0947\u0932\u094d\u092a \u092c\u0949\u091f \u091f\u093e\u0907\u092a \u0915\u0930 \u0930\u0939\u093e \u0939\u0948...","Help Bot, trip contacts & support":"\u0939\u0947\u0932\u094d\u092a \u092c\u0949\u091f, \u091f\u094d\u0930\u093f\u092a \u0938\u0902\u092a\u0930\u094d\u0915 \u0914\u0930 \u0938\u092a\u094b\u0930\u094d\u091f","Help Center":"\u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947\u0902\u0926\u094d\u0930","Hi, I would like to request Booking #DC{0} with my {1} ({2}). Please approve if suitable.":"\u0928\u092e\u0938\u094d\u0924\u0947, \u092e\u0948\u0902 \u0905\u092a\u0928\u0940 {1} ({2}) \u0915\u0947 \u0938\u093e\u0925 \u092c\u0941\u0915\u093f\u0902\u0917 #DC{0} \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901\u0964 \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u0939\u094b \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u092e\u0902\u091c\u093c\u0942\u0930 \u0915\u0930\u0947\u0902\u0964","Hidden until a few hours before pickup. Turn on to show it to the driver now.":"\u092a\u093f\u0915\u0905\u092a \u0938\u0947 \u0915\u0941\u091b \u0918\u0902\u091f\u0947 \u092a\u0939\u0932\u0947 \u0924\u0915 \u091b\u093f\u092a\u093e \u0930\u0939\u0947\u0917\u093e\u0964 \u0905\u092d\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0915\u094b \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964","Hide details":"\u0935\u093f\u0935\u0930\u0923 \u091b\u093f\u092a\u093e\u090f\u0901","Hide fare details":"\u0915\u093f\u0930\u093e\u092f\u093e \u0935\u093f\u0935\u0930\u0923 \u091b\u093f\u092a\u093e\u090f\u0901","High Customer Rating":"\u090a\u0901\u091a\u0940 \u0917\u094d\u0930\u093e\u0939\u0915 \u0930\u0947\u091f\u093f\u0902\u0917","Hill Charges":"\u092a\u0939\u093e\u0921\u093c\u0940 \u0936\u0941\u0932\u094d\u0915","Hills Charges":"\u092a\u0939\u093e\u0921\u093c\u0940 \u0936\u0941\u0932\u094d\u0915","Holder Name:":"\u0916\u093e\u0924\u093e\u0927\u093e\u0930\u0915:","Hourly / Local":"\u0918\u0902\u091f\u0947 / \u0932\u094b\u0915\u0932","House/Door No, Street name":"\u092e\u0915\u093e\u0928/\u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0928\u0902\u092c\u0930, \u0917\u0932\u0940 \u0915\u093e \u0928\u093e\u092e","How do you want to add this photo?":"\u0906\u092a \u092f\u0939 \u092b\u094b\u091f\u094b \u0915\u0948\u0938\u0947 \u091c\u094b\u0921\u093c\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?","How it works:":"\u092f\u0939 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948:","How was the customer?":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0948\u0938\u093e \u0930\u0939\u093e?","hrs)":"\u0918\u0902\u091f\u0947)","I agree to the Booking Terms & Cancellation Penalty Policy":"\u092e\u0948\u0902 \u092c\u0941\u0915\u093f\u0902\u0917 \u0915\u0940 \u0936\u0930\u094d\u0924\u0947\u0902 \u0914\u0930 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u091c\u0941\u0930\u094d\u092e\u093e\u0928\u0947 \u0915\u0940 \u0928\u0940\u0924\u093f \u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u0942\u0901","I'll try to answer instantly first - type your question, or tap an option below. Only 'Talk to a person' goes to a human, and that's reviewed, not instant.":"\u092e\u0948\u0902 \u092a\u0939\u0932\u0947 \u0924\u0941\u0930\u0902\u0924 \u091c\u0935\u093e\u092c \u0926\u0947\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0942\u0901\u0917\u093e - \u0905\u092a\u0928\u093e \u0938\u0935\u093e\u0932 \u0932\u093f\u0916\u0947\u0902 \u092f\u093e \u0928\u0940\u091a\u0947 \u0915\u094b\u0908 \u0935\u093f\u0915\u0932\u094d\u092a \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u0938\u093f\u0930\u094d\u092b\u093c '\u0915\u093f\u0938\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0947\u0902' \u0907\u0902\u0938\u093e\u0928 \u0924\u0915 \u091c\u093e\u0924\u093e \u0939\u0948, \u0914\u0930 \u0909\u0938\u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0939\u094b\u0924\u0940 \u0939\u0948, \u0924\u0941\u0930\u0902\u0924 \u0928\u0939\u0940\u0902\u0964","Identity Verification Failed?":"\u092a\u0939\u091a\u093e\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0935\u093f\u092b\u0932 \u0939\u0941\u0906?","IFSC Code:":"IFSC \u0915\u094b\u0921:",Ignore:"\u0928\u091c\u093c\u0930\u0905\u0902\u0926\u093e\u091c\u093c \u0915\u0930\u0947\u0902","Image URLs not received from server":"\u0938\u0930\u094d\u0935\u0930 \u0938\u0947 \u092b\u094b\u091f\u094b URL \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0947","In-App Chat":"\u0910\u092a \u092e\u0947\u0902 \u091a\u0948\u091f",Included:"\u0936\u093e\u092e\u093f\u0932","Included in the fare":"\u0915\u093f\u0930\u093e\u092f\u0947 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932","Included in the trip fare":"\u091f\u094d\u0930\u093f\u092a \u0915\u093f\u0930\u093e\u092f\u0947 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932","Incorrect password. Please try again.":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0917\u0932\u0924 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\
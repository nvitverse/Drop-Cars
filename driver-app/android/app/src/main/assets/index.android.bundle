"\u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u0923 \u091a\u0941\u0928\u0947\u0902 \u092f\u093e \u0932\u093f\u0916\u0947\u0902:","Select photo for {0}":"{0} \u0915\u0947 \u0932\u093f\u090f \u092b\u094b\u091f\u094b \u091a\u0941\u0928\u0947\u0902","Select State Code":"\u0930\u093e\u091c\u094d\u092f \u0915\u094b\u0921 \u091a\u0941\u0928\u0947\u0902","Select the driver to assign:":"\u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u091a\u0941\u0928\u0947\u0902:","Select the reason for your request for account":"\u0916\u093e\u0924\u0947 \u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u093e \u0915\u093e\u0930\u0923 \u091a\u0941\u0928\u0947\u0902","Select the vehicle to offer (Driver:":"\u0911\u092b\u093c\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0917\u093e\u0921\u093c\u0940 \u091a\u0941\u0928\u0947\u0902 (\u0921\u094d\u0930\u093e\u0907\u0935\u0930:","Select Till Date":"\u0905\u0902\u0924\u093f\u092e \u0924\u093e\u0930\u0940\u0916\u093c \u091a\u0941\u0928\u0947\u0902","Select Till Time":"\u0905\u0902\u0924\u093f\u092e \u0938\u092e\u092f \u091a\u0941\u0928\u0947\u0902","Select Vehicle for {0}":"{0} \u0915\u0947 \u0932\u093f\u090f \u0917\u093e\u0921\u093c\u0940 \u091a\u0941\u0928\u0947\u0902","Select whether you are driving yourself or switching to another driver account.":"\u091a\u0941\u0928\u0947\u0902 \u0915\u093f \u0906\u092a \u0916\u0941\u0926 \u091a\u0932\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u092f\u093e \u0926\u0942\u0938\u0930\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u092c\u0926\u0932 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",Selected:"\u091a\u0941\u0928\u093e \u0917\u092f\u093e","Selected Date:":"\u091a\u0941\u0928\u0940 \u0917\u0908 \u0924\u093e\u0930\u0940\u0916\u093c:","Selected Driver:":"\u091a\u0941\u0928\u093e \u0917\u092f\u093e \u0921\u094d\u0930\u0
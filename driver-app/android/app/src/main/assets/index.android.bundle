__d(function(e,t,a,i,r,o,l){r.exports={tabBar:{home:"\u0cae\u0cc1\u0c96\u0caa\u0cc1\u0c9f",myRides:"\u0ca8\u0ca8\u0ccd\u0ca8 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1",dropMarket:"\u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0cae\u0cbe\u0cb0\u0ccd\u0c95\u0cc6\u0c9f\u0ccd",chats:"\u0c9a\u0cbe\u0c9f\u0ccd",duty:"\u0ca1\u0ccd\u0caf\u0cc2\u0c9f\u0cbf"},terms:{modalTitle:"\u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb7\u0cb0\u0ca4\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0cc1"},welcome:{steps:[{title:"Drop Cars \u0c97\u0cc6 \u0cb8\u0ccd\u0cb5\u0cbe\u0c97\u0ca4!",subtitle:"\u0caa\u0ccd\u0cb0\u0cc0\u0cae\u0cbf\u0caf\u0c82 \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb9\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cad\u0cbe\u0cb0\u0ca4\u0ca6\u0cbe\u0ca6\u0ccd\u0caf\u0c82\u0ca4\u0ca6 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0c9c\u0ccb\u0ca1\u0cbf\u0cb8\u0cbf. \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4, \u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf\u0caa\u0cb0 \u0cb8\u0cbe\u0cb0\u0cbf\u0c97\u0cc6 \u0cb8\u0cc7\u0cb5\u0cc6 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe \u0ca8\u0c82\u0cac\u0cbf\u0c95\u0cc6\u0caf \u0c97\u0cb3\u0cbf\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf."},{title:"\u0cb9\u0c82\u0ca4 1: \u0cab\u0ccd\u0cb2\u0cc0\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf",subtitle:"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cb5\u0cbe\u0c97\u0cbf \u0c87\u0cb0\u0cbf\u0cb8\u0cbf",description:"\u0cae\u0cbe\u0ca8\u0ccd\u0caf RC, \u0cb5\u0cbf\u0cae\u0cc6, \u0caa\u0cb0\u0ccd\u0cae\u0cbf\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cab\u0cbf\u0c9f\u0ccd\u200c\u0ca8\u0cc6\u0cb8\u0ccd\u200c\u0ca8\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb5\u0cbe\u0cb9\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0cbf. \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0ca6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf. \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3 \u0c85\u0cb5\u0ca7\u0cbf \u0cae\u0cc1\u0c97\u0cbf\u0caf\u0ca6\u0c82\u0ca4\u0cc6 \u0ca8\u0ccb\u0ca1\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cc7\u0c95\u0cc1."},{title:"\u0cb9\u0c82\u0ca4 2: \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cbf \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cbf",subtitle:"\u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0cb5\u0cbe\u0cb9\u0ca8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cac\u0cc7\u0c95\u0cc1",description:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0c95\u0ccd\u0c95\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cc1\u0cb5 \u0cb2\u0cad\u0ccd\u0caf \u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0caa\u0ccd\u0caa\u0cbf. \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0cb5\u0cbe\u0cb9\u0ca8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc7 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1. \u0c85\u0ca8\u0ca7\u0cbf\u0c95\u0cc3\u0ca4 \u0c95\u0ccd\u0caf\u0cbe\u0cac\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6 \u0c95\u0c9f\u0ccd\u0c9f\u0cc1\u0ca8\u0cbf\u0c9f\u0ccd\u0c9f\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cb7\u0cc7\u0ca7."},{title:"\u0cb9\u0c82\u0ca4 3: \u0c96\u0cbe\u0ca4\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0 \u0c9c\u0cb5\u0cbe\u0cac\u0ccd\u0ca6\u0cbe\u0cb0\u0cbf",subtitle:"\u0c92\u0caa\u0ccd\u0caa\u0cbf\u0ca6 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c97\u0cc6 100% \u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0c9c\u0cb5\u0cbe\u0cac\u0ccd\u0ca6\u0cbe\u0cb0\u0cbf",description:"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0c92\u0caa\u0ccd\u0caa\u0cc1\u0cb5 \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cc1 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0ca3\u0cc6, \u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0ca4\u0cc6, \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd \u0ca8\u0ca1\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0ca8\u0cb7\u0ccd\u0c9f/\u0c85\u0caa\u0c98\u0cbe\u0ca4\u0c95\u0ccd\u0c95\u0cc6 100% \u0c95\u0cbe\u0ca8\u0cc2\u0ca8\u0cc1, \u0cb9\u0ca3\u0c95\u0cbe\u0cb8\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c95\u0ccd\u0cb0\u0cbf\u0cae\u0cbf\u0ca8\u0cb2\u0ccd \u0c9c\u0cb5\u0cbe\u0cac\u0ccd\u0ca6\u0cbe\u0cb0\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6. Drop Cars \u0c97\u0cc6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb9\u0cca\u0ca3\u0cc6 \u0c87\u0cb2\u0ccd\u0cb2."},{title:"\u0ca8\u0cbf\u0caf\u0cae\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0ca8\u0cc0\u0ca4\u0cbf\u0c97\u0cb3\u0cc1",subtitle:"\u0c95\u0cbe\u0ca8\u0cc2\u0ca8\u0cc1 \u0cb0\u0c95\u0ccd\u0cb7\u0ca3\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0ca4\u0cbe \u0c85\u0ca8\u0cc1\u0cb8\u0cb0\u0ca3\u0cc6",description:"\u0c8e\u0cb2\u0ccd\u0cb2\u0cb
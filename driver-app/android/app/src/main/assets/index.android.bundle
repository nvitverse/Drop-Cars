e\u0c2f\u0c02 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3e? \u0c2e\u0c40\u0c30\u0c41 Drop Cars \u0c39\u0c46\u0c32\u0c4d\u0c2a\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c28\u0c47\u0c30\u0c41\u0c17\u0c3e \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","Need Help":"\u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3f","Need Help / Contact Support":"\u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3f / \u0c38\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c4d\u200c\u0c28\u0c41 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Need Help?":"\u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c15\u0c3e\u0c35\u0c3e\u0c32\u0c3e?",Needs:"\u0c05\u0c35\u0c38\u0c30\u0c02","Needs {0} \u2022 View Options":"{0} \u0c05\u0c35\u0c38\u0c30\u0c02 \u2022 \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32\u0c41 \u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f","Needs a {0} ({1} Seats)":"{0} ({1} \u0c38\u0c40\u0c1f\u0c4d\u0c32\u0c41) \u0c05\u0c35\u0c38\u0c30\u0c02","Needs Review":"\u0c38\u0c2e\u0c40\u0c15\u0c4d\u0c37 \u0c05\u0c35\u0c38\u0c30\u0c02","Net Earning From Posting":"\u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c28\u0c3f\u0c15\u0c30 \u0c38\u0c02\u0c2a\u0c3e\u0c26\u0c28","Network Error":"\u0c28\u0c46\u0c1f\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c15\u0c4d \u0c32\u0c4b\u0c2a\u0c02","Network error while uploading. Please check your connection and try again.":"\u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c38\u0c47\u0c1f\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c28\u0c46\u0c1f\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c15\u0c4d \u0c32\u0c4b\u0c2a\u0c02. \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c1a\u0c42\u0c38\u0c3f \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","Network error. Please check your internet connection.":"\u0c28\u0c46\u0c1f\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c15\u0c4d \u0c32\u0c4b\u0c2a\u0c02. \u0c2e\u0c40 \u0c07\u0c02\u0c1f\u0c30\u0c4d\u0c28\u0c46\u0c1f\u0c4d \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f.","Never miss a booking":"\u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c2e\u0c3f\u0c38\u0c4d \u0c05\u0c35\u0c4d\u0c35\u0c15\u0c02\u0c21\u0c3f","Never miss a booking again":"\u0c07\u0c15\u0c2a\u0c48 \u0c0f \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c2e\u0c3f\u0c38\u0c4d \u0c05\u0c35\u0c4d\u0c35\u0c15\u0c02\u0c21\u0c3f","New 10-Digit Primary Mobile Number":"\u0c15\u0c4a\u0c24\u0c4d\u0c24 10 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c2a\u0c4d\u0c30\u0c27\u0c3e\u0c28 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d","New Booking Bubble":"\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c2c\u0c2c\u0c41\u0c32\u0c4d","New bookings in your city will automatically appear here in real-time":"\u0c2e\u0c40 \u0c28\u0c17\u0c30\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41 \u0c30\u0c3f\u0c2f\u0c32\u0c4d \u0c1f\u0c48\u0c2e\u0c4d\u200c\u0c32\u0c4b \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c06\u0c1f\u0c4b\u0c2e\u0c47\u0c1f\u0c3f\u0c15\u0c4d\u200c\u0c17\u0c3e \u0c15\u0c28\u0c3f\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f","New Email Address":"\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e","New Fleet?":"\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2b\u0c4d\u0c32\u0c40\u0c1f\u0c4d \u0c2f\u0c1c\u0c2e\u0c3e\u0c28\u0c3f\u0c35\u0c3e?","New Mobile Number":"\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d","New Password":"\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d","Next 24 Hrs":"\u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f 24 \u0c17\u0c02\u0c1f\u0c32\u0c41","Next 3 Days":"\u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f 3 \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c41","Next 7 Days":"\u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f 7 \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c41","Night Allowance":"\u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f \u0c05\u0c32\u0c35\u0c46\u0c28\u0c4d\u0c38\u0c4d","Night Charges":"\u0c30\u0c3e\u0c24\u0c4d\u0c30\u0c3f \u0c1b\u0c3e\u0c30\u0c4d\u0c1c\u0c40\u0c32\u0c41",No:"\u0c15\u0c3e\u0c26\u0c41","No {0} Upcoming Rides":"{0} \u0c30\u0c3e\u0c2c\u0c4b\u0c2f\u0c47 \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u200c\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41","No access token received from server":"\u0c38\u0c30\u0c4d\u0c35\u0c30\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c30\u0c3e\u0c32\u0c47\u0c26\u0c41","No active assignment found for this booking.":"\u0c08 \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c15\u0c41 \u0c2f\u0c3e\u0c15\u0c4d\u0c1f\u0c3f\u0c35\u0c4d \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c2a\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41.","No active trips right now - once you accept a booking, its Vendor/Owner chat and the customer's call option will appear here.":"\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 \u0c2f\u0c3e\u0c15\u0c4d\u0c1f\u0c3f\u0c35\u0c4d \u0c1f\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u200c\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41 - \u0c2c\u0c41\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c17\u0c3e\u0c28\u0c47, \u0c26\u0c3e\u0c28\u0c3f \u0c35\u0c46\u0c02\u0c21\u0c30\u0c4d/\u0c2f\u0c1c\u0c2e\u0c3e\u0c28\u0c3f \u0c1a\u0c3e\u0c1f\u0c4d, \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c15\u0c3e\u0c32\u0c4d \u0c0e\u0c02\u0c2a\u0c3f\u0c15 \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c15\u0c28\u0c3f\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f.","No address registered":"\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c15\u0c3e\u0c32\u0c47\u0c26\u0c41","No authentication token found":"\u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41","No authentication token found. Please login first.":"\u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c23\u0c40\u0c15\u0c30\u0c23 \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41. \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c05\u0c35\u0c4d\u0c35\u0c02\u0c21\u0c3f.","No available drivers found. Add a driver first in My Drivers.":"\u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u0c32\u0c41 \u0c32\u0c47\u0c30\u0c41. \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c28\u0c3e \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u0c32\u0c32\u0c4b \u0c12\u0c15 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","No available drivers found. Please complete verification or add a driver first.":"\u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u0c32\u0c41 \u0c32\u0c47\u0c30\u0c41. \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c12\u0c15 \u0c21\u0c4d\u0c30\u0c48\u0c35\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","No available vehicles found. Add a car first in My Cabs.":"\u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c35\u0c3e\u0c39\u0c28\u0c3e\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41. \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c28\u0c3e \u0c15\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d\u200c\u0c32\u0c32\u0c4b \u0c12\u0c15 \u0c15\u0c3e\u0c30\u0c41 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","No cars available. Add vehicles in My Cars.":"\u0c15\u0c3e\u0c30\u0c4d\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41. \u0c28\u0c3e \u0c15\u0c3e\u0c30\u0c4d\u0c32\u0c32\u0c4b \u0c35\u0c3e\u0c39\u0c28\u0c3e\u0c32\u0c41 \u0c1c\u0c4b\u0c2
0ccd \u0c87\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Restart now":"\u0c88\u0c97\u0cb2\u0cc7 \u0cae\u0cb0\u0cc1\u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf","Retake Back":"\u0cb9\u0cbf\u0c82\u0cad\u0cbe\u0c97 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf","Retake Front":"\u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cbf\u0cb0\u0cbf","Return Date & Time":"\u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 & \u0cb8\u0cae\u0caf","Return Schedule":"\u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5 \u0cb5\u0cc7\u0cb3\u0cbe\u0caa\u0c9f\u0ccd\u0c9f\u0cbf","Return/Drop Date":"\u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5/\u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95","Return/Drop Time":"\u0cb9\u0cbf\u0c82\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cc1\u0cb5/\u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd \u0cb8\u0cae\u0caf","Review Booking":"\u0cac\u0cc1\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf","Reviewed by Support - not instant":"\u0cb8\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd \u0ca4\u0c82\u0ca1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 - \u0ca4\u0c95\u0ccd\u0cb7\u0ca3\u0cb5\u0cb2\u0ccd\u0cb2","Ride Auto-Assigned!":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca4\u0cbe\u0ca8\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","Ride Declined":"\u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Ride from {0} to {1} has been auto-assigned to {2}. \u26a0\ufe0f Any cancellation after auto-assignment incurs a \u20b9500 fee.":"{0} \u0cb0\u0cbf\u0c82\u0ca6 {1} \u0cb5\u0cb0\u0cc6\u0c97\u0cbf\u0ca8 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd {2} \u0c97\u0cc6 \u0ca4\u0cbe\u0ca8\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u26a0\ufe0f \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0ca8\u0cc6\u0caf \u0ca8\u0c82\u0ca4\u0cb0 \u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6 \u20b9500 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95.","Ride was declined within 10s with \u20b90 penalty.":"10 \u0cb8\u0cc6\u0c95\u0cc6\u0c82\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0ca8\u0cbf\u0cb0\u0cbe\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6, \u20b90 \u0ca6\u0c82\u0ca1.","rides at the moment.":"\u0cb8\u0ca6\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cc1.",Rotate:"\u0ca4\u0cbf\u0cb0\u0cc1\u0c97\u0cbf\u0cb8\u0cbf","ROUND TRIP":"\u0cb9\u0ccb\u0c97\u0cbf \u0cac\u0cb0\u0cc1\u0cb5","ROUTE DETAILS":"\u0cae\u0cbe\u0cb0\u0ccd\u0c97 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1","Route Request allows Trusted Partners to specify routes and auto-dispatch drivers for matching trips. Upgrade to Trusted Partner to unlock.":"\u0cb0\u0cc2\u0c9f\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0c9f\u0ccd\u0cb0\u0cb8\u0ccd\u0c9f\u0cc6\u0ca1\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc2\u0c9a\u0cbf\u0cb8\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cc1\u0cb5 \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0caf\u0c82 \u0ca1\u0cbf\u0cb8\u0ccd\u0caa\u0ccd\u0caf\u0cbe\u0c9a\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c85\u0ca8\u0ccd\u200c\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c9f\u0ccd\u0cb0\u0cb8\u0ccd\u0c9f\u0cc6\u0ca1\u0ccd \u0caa\u0cbe\u0cb0\u0ccd\u0c9f\u0ccd\u0ca8\u0cb0\u0ccd \u0c86\u0c97\u0cbf \u0c85\u0caa\u0ccd\u200c\u0c97\u0ccd\u0cb0\u0cc7\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.","Route request deactivated.":"\u0cb0\u0cc2\u0c9f\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0ca8\u0cbf\u0cb7\u0ccd\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","ROUTE REQUEST MATCH DETECTED":"\u0cb0\u0cc2\u0c9f\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cbe\u0ca3\u0cbf\u0c95\u0cc6 \u0caa\u0ca4\u0ccd\u0ca4\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Save Details":"\u0cb5\u0cbf\u0cb5\u0cb0 \u0c89\u0cb3\u0cbf\u0cb8\u0cbf","Save Name":"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cbf","Save Password":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c89\u0cb3\u0cbf\u0cb8\u0cbf","Save Vacant Status":"\u0c96\u0cbe\u0cb2\u0cbf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf \u0c89\u0cb3\u0cbf\u0cb8\u0cbf",Saved:"\u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Saved \ud83c\udf89":"\u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6 \ud83c\udf89","Scanning customer pickup points near your live location. When a local ride matches, an alert will sound with instant 1-tap accept.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb2\u0cc8\u0cb5\u0ccd \u0cb8\u0ccd\u0ca5\u0cb3\u0ca6 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0caa\u0cbf\u0c95\u0caa\u0ccd \u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6. \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0c9f\u0ccd\u0cb0\u0cbf\u0caa\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0ca6\u0cbe\u0c97, \u0c92\u0c82\u0ca6\u0cc7 \u0c92\u0ca4\u0ccd\u0ca4\u0cbf\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c92\u0caa\u0ccd\u0caa\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5 \u0cb8\u0ccc\u0cb2\u0cad\u0ccd\u0caf\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6 \u0cae\u0cca\u0cb3\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Search cha
e\u0bcd\u0b9a\u0bb2\u0bcd \u0b86\u0ba4\u0bb0\u0bb5\u0bc1","Email Verification Required \ud83d\udce7":"\u0bae\u0bbf\u0ba9\u0bcd\u0ba9\u0b9e\u0bcd\u0b9a\u0bb2\u0bcd \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0ba4\u0bc7\u0bb5\u0bc8 \ud83d\udce7","Email Verified! \u2713":"\u0bae\u0bbf\u0ba9\u0bcd\u0ba9\u0b9e\u0bcd\u0b9a\u0bb2\u0bcd \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1! \u2713",Enable:"\u0b87\u0baf\u0b95\u0bcd\u0b95\u0bc1","End KM must be provided and greater than 0":"\u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1 \u0b95\u0bbf.\u0bae\u0bc0. \u0b95\u0bca\u0b9f\u0bc1\u0b95\u0bcd\u0b95 \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd, \u0b85\u0ba4\u0bc1 0-\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc7\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95 \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd","End KM:":"\u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1 \u0b95\u0bbf.\u0bae\u0bc0.:","End odometer photo":"\u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1 \u0b93\u0b9f\u0bcb\u0bae\u0bc0\u0b9f\u0bcd\u0b9f\u0bb0\u0bcd \u0baa\u0b9f\u0bae\u0bcd","End OTP:":"\u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1 OTP:","End speedometer image is required to end trip":"\u0b9a\u0bb5\u0bbe\u0bb0\u0bbf\u0baf\u0bc8 \u0bae\u0bc1\u0b9f\u0bbf\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1 \u0bb8\u0bcd\u0baa\u0bc0\u0b9f\u0bcb\u0bae\u0bc0\u0b9f\u0bcd\u0b9f\u0bb0\u0bcd \u0baa\u0b9f\u0bae\u0bcd \u0ba4\u0bc7\u0bb5\u0bc8","Enter 10-digit mobile number (e.g. 9876543210)":"10 \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bae\u0bca\u0baa\u0bc8\u0bb2\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bc8 \u0b89\u0bb3\u0bcd\u0bb3\u0bbf\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd (\u0b8e.\u0b95\u0bbe. 9876543210)","Enter 6-digit code":"6 \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0bc1\u0bb1\u0bbf\u0baf\u0bc0\u0b9f\u0bcd\u0b9f\u0bc8 \u0b89\u0bb3\u0bcd\u0bb3\u0bbf\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd","Enter 6-Digit Email Code":"6 \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bae\u0bbf\u0ba9\u0bcd\u0b
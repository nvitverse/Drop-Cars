w eligible to accept this booking!":"\u0935\u0947\u0902\u0921\u0930 \u0928\u0947 \u092c\u0941\u0915\u093f\u0902\u0917 #DC{1} \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0940 {0} \u092e\u0902\u091c\u093c\u0942\u0930 \u0915\u0930 \u0926\u0940 \u0939\u0948\u0964 \u0905\u092c \u0906\u092a \u092f\u0939 \u092c\u0941\u0915\u093f\u0902\u0917 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092f\u094b\u0917\u094d\u092f \u0939\u0948\u0902!","Vendor Net Price":"\u0935\u0947\u0902\u0921\u0930 \u0936\u0941\u0926\u094d\u0927 \u0915\u0940\u092e\u0924","Vendor Quick Replies & Actions":"\u0935\u0947\u0902\u0921\u0930 \u0915\u0947 \u0924\u094d\u0935\u0930\u093f\u0924 \u091c\u0935\u093e\u092c \u0914\u0930 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0907\u092f\u093e\u0901","Verification code sent to":"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u094b\u0921 \u092d\u0947\u091c\u093e \u0917\u092f\u093e","Verification Code Sent! \ud83d\udce7":"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u094b\u0921 \u092d\u0947\u091c\u093e \u0917\u092f\u093e! \ud83d\udce7","Verification Failed":"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0935\u093f\u092b\u0932","Verification failed.":"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0935\u093f\u092b\u0932\u0964","Verified Driver":"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0921\u094d\u0930\u093e\u0907\u0935\u0930","Verified Fleet Partner":"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u092b\u094d\u0932\u0940\u091f \u092a\u093e\u0930\u094d\u091f\u0928\u0930","Verified Partner":"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u092a\u093e\u0930\u094d\u091f\u0928\u0930","Verify & Save":"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u0947\u0935 \u0915\u0930\u0947\u0902","Verify Code":"\u0915\u094b\u0921 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902","Verify Code & Submit":"\u0915\u094b\u0921 \u0938\u0924\u094d\u092f\u093e
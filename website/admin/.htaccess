RewriteEngine On
RewriteBase /admin/

# ================================================================
# ADMIN SECURITY HEADERS
# ================================================================
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
    Header always set Pragma "no-cache"
</IfModule>

Options -MultiViews -Indexes

# ================================================================
# BLOCK ALL DIRECT FILE ACCESS TO PAGES/CONFIG
# ================================================================
RewriteRule ^(pages|config|includes|sql)/ - [F,L,NC]

# ================================================================
# ADMIN ROUTING
# ================================================================
# If the request is for a PHP file that doesn't exist in root but exists in pages/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} ^/admin/([a-zA-Z0-9-]+)\.php$
RewriteRule ^([a-zA-Z0-9-]+)\.php$ index.php?page=$1 [L,QSA,R=301]

# Generic router for pretty URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)/?$ index.php?page=$1 [L,QSA]
